; Test game for Frotz analyzer development
; Features:
; - Main puzzle: get key, unlock door, escape
; - Deadly trap: touching the orb kills you
; - Irrelevant objects: book, coin (red herrings)
; - Multiple rooms with different hazards

(world
  :name "Test Game"
  :player @player
  :intro "You wake up in a small cell. There's a door to the north and a pit to the east.")

(victory :when (= (loc @player) @outside))

(defeat death
  :when (:dead @player)
  :context ((message "You have died.")))

; === Rooms ===

(room @cell
  :description "Cell"
  :ldesc "A small, damp cell with stone walls. A heavy door leads north. A dark pit opens to the east."
  :properties (:lit true)
  :exits ((north :to @outside :via @cell-door)
          (east :to @pit)))

(room @outside
  :description "Outside"
  :ldesc "Fresh air! You've escaped!"
  :properties (:lit true)
  :exits ((south :to @cell)))

(room @pit
  :description "Pit"
  :ldesc "A deep pit with something glowing at the bottom."
  :properties (:lit true)
  :exits ((west :to @cell)
          (down :to @pit-bottom)))

(room @pit-bottom
  :description "Pit Bottom"
  :ldesc "The bottom of the pit. Sharp rocks surround you. A glowing orb pulses ominously."
  :properties (:lit true)
  :exits ((up :to @pit)))

; === Objects ===

(object @player
  :location @cell
  :description "yourself"
  :properties (:person true :dead false))

; --- Main puzzle objects ---

(object @key
  :location @cell
  :description "brass key"
  :ldesc "A small brass key lies on the floor."
  :behaviors (
    :take (fn () '((move @key @player) (success :message "You pick up the key.")))
    :examine (fn () (success :message "A small brass key, tarnished with age."))))

(object @cell-door
  :location @cell
  :description "heavy door"
  :properties (:locked true :open false)
  :behaviors (
    :examine (fn ()
      (if (:locked @cell-door)
        (success :message "A heavy wooden door, locked tight.")
        (success :message "A heavy wooden door, now unlocked.")))

    :unlock (fn ()
      (cond
        ((not (:locked @cell-door))
          (success :message "It's already unlocked."))
        ((not (held? @key))
          (blocked :reason no-key :message "You don't have anything to unlock it with."))
        (true
          '((set @cell-door :locked false)
            (success :message "You unlock the door with the brass key.")))))

    :lock (fn ()
      (cond
        ((:locked @cell-door)
          (success :message "It's already locked."))
        ((not (held? @key))
          (blocked :reason no-key :message "You don't have the key."))
        (true
          '((set @cell-door :locked true)
            (success :message "You lock the door.")))))

    :open (fn ()
      (cond
        ((:open @cell-door)
          (success :message "It's already open."))
        ((:locked @cell-door)
          (blocked :reason locked :message "The door is locked."))
        (true
          '((set @cell-door :open true)
            (success :message "You open the door.")))))

    :close (fn ()
      (if (not (:open @cell-door))
        (success :message "It's already closed.")
        '((set @cell-door :open false)
          (success :message "You close the door."))))

    :through (fn ()
      (cond
        ((:locked @cell-door)
          (blocked :reason locked :message "The door is locked."))
        ((not (:open @cell-door))
          (blocked :reason closed :message "The door is closed."))
        (true (success))))))

; --- Deadly trap ---

(object @orb
  :location @pit-bottom
  :description "glowing orb"
  :ldesc "A strange orb pulses with an eerie light."
  :properties (:touched false)
  :behaviors (
    :examine (fn () (success :message "The orb pulses hypnotically. It looks dangerous to touch."))
    :take (fn ()
      '((set @player :dead true)
        (set @orb :touched true)
        (success :message "As your fingers touch the orb, dark energy surges through you. Everything goes black.")))
    :touch (fn ()
      '((set @player :dead true)
        (set @orb :touched true)
        (success :message "Dark energy courses through your body. You collapse.")))))

; --- Irrelevant objects (red herrings) ---

(object @book
  :location @cell
  :description "dusty book"
  :ldesc "A dusty book lies in the corner."
  :properties (:read false)
  :behaviors (
    :take (fn () '((move @book @player) (success :message "You pick up the dusty book.")))
    :read (fn ()
      '((set @book :read true)
        (success :message "The book contains ancient recipes. Nothing useful.")))
    :examine (fn () (success :message "An old cookbook, covered in dust."))))

(object @coin
  :location @pit
  :description "silver coin"
  :ldesc "A silver coin glints on a ledge."
  :properties (:flipped false)
  :behaviors (
    :take (fn () '((move @coin @player) (success :message "You pocket the silver coin.")))
    :flip (fn ()
      '((set @coin :flipped (not (:flipped @coin)))
        (success :message "You flip the coin. It lands heads.")))
    :examine (fn () (success :message "A silver coin with a strange symbol."))))

(object @rock
  :location @pit-bottom
  :description "sharp rock"
  :ldesc "Sharp rocks litter the ground."
  :behaviors (
    :take (fn () '((move @rock @player) (success :message "You pick up a sharp rock.")))
    :examine (fn () (success :message "A jagged rock. Could be used as a crude weapon."))))
