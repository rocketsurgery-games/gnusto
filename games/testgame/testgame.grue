; Test game for Frotz analyzer development
; Features:
; - Main puzzle: get key, unlock door, escape
; - Deadly trap: touching the orb kills you
; - Irrelevant objects: book, coin (red herrings)
; - Multiple rooms with different hazards
;
; Extended features for clustering/analysis testing:
; - Alternate solution: lockpick OR key can unlock door
; - Consumable item: lockpick breaks after one use (irreversible)
; - Black hole: dropping key in pit makes game unwinnable
; - Conditional puzzle: safe requires EITHER combination OR crowbar

(world
  :name "Test Game"
  :player @player
  :intro "You wake up in a small cell. There's a door to the north and a pit to the east.")

; Victory requires escaping WITH the treasure from the treasury
; This forces the player to:
; 1. Go to pit to get coin
; 2. Bribe guard with coin
; 3. Enter treasury and take treasure
; 4. Return and escape through the cell door
(victory :when (and (= (loc @player) @outside)
                    (held? @treasure)))

(defeat death
  :when (:dead @player)
  :context ((message "You have died.")))

; === Rooms ===

(room @cell
  :description "Cell"
  :ldesc "A small, damp cell with stone walls. A heavy door leads north. A dark pit opens to the east. Passages lead south, west, and up."
  :properties (:lit true)
  :exits ((north :to @outside :via @cell-door)
          (east :to @pit)
          (south :to @guard-post)
          (west :to @corridor-south)
          (up :to @furnace-room)))

(room @outside
  :description "Outside"
  :ldesc "Fresh air! You've escaped!"
  :properties (:lit true)
  :exits ((south :to @cell)))

(room @pit
  :description "Pit"
  :ldesc "A deep pit with something glowing at the bottom."
  :properties (:lit true)
  :exits ((west :to @cell)
          (down :to @pit-bottom)))

(room @pit-bottom
  :description "Pit Bottom"
  :ldesc "The bottom of the pit. Sharp rocks surround you. A glowing orb pulses ominously."
  :properties (:lit true)
  :exits ((up :to @pit)))

; === Objects ===

(object @player
  :location @cell
  :description "yourself"
  :properties (:person true :dead false))

; --- Main puzzle objects ---

(object @key
  :location @cell
  :description "brass key"
  :ldesc "A small brass key lies on the floor."
  :behaviors (
    :take (fn () '((move @key @player) (success :message "You pick up the key.")))
    :drop (fn ()
      (cond
        ; Dropping in pit-bottom loses the key forever (black hole trigger)
        ((= (loc @player) @pit-bottom)
          '((move @key @abyss)
            (success :message "The key tumbles into a crack between the rocks and disappears forever.")))
        (true
          '((move @key (loc @player))
            (success :message "You drop the key.")))))
    :examine (fn () (success :message "A small brass key, tarnished with age."))))

; Lockpick - alternate solution that breaks after use
(object @lockpick
  :location @pit
  :description "rusty lockpick"
  :ldesc "A rusty lockpick lies wedged in a crack."
  :properties (:broken false)
  :behaviors (
    :take (fn () '((move @lockpick @player) (success :message "You carefully extract the lockpick.")))
    :examine (fn ()
      (if (:broken @lockpick)
        (success :message "A broken lockpick. Useless now.")
        (success :message "A rusty but functional lockpick. Looks fragile.")))))

(object @cell-door
  :location @cell
  :description "heavy door"
  :properties (:locked true :open false)
  :behaviors (
    :examine (fn ()
      (if (:locked @cell-door)
        (success :message "A heavy wooden door, locked tight.")
        (success :message "A heavy wooden door, now unlocked.")))

    :unlock (fn ()
      (cond
        ((not (:locked @cell-door))
          (success :message "It's already unlocked."))
        ; Can unlock with key (reusable)
        ((held? @key)
          '((set @cell-door :locked false)
            (success :message "You unlock the door with the brass key.")))
        ; OR with lockpick (breaks after use - irreversible!)
        ((and (held? @lockpick) (not (:broken @lockpick)))
          '((set @cell-door :locked false)
            (set @lockpick :broken true)
            (success :message "You pick the lock. The rusty lockpick snaps as the door clicks open.")))
        (true
          (blocked :reason no-tool :message "You don't have anything to unlock it with."))))

    :lock (fn ()
      (cond
        ((:locked @cell-door)
          (success :message "It's already locked."))
        ((not (held? @key))
          (blocked :reason no-key :message "You don't have the key."))
        (true
          '((set @cell-door :locked true)
            (success :message "You lock the door.")))))

    :open (fn ()
      (cond
        ((:open @cell-door)
          (success :message "It's already open."))
        ((:locked @cell-door)
          (blocked :reason locked :message "The door is locked."))
        (true
          '((set @cell-door :open true)
            (success :message "You open the door.")))))

    :close (fn ()
      (if (not (:open @cell-door))
        (success :message "It's already closed.")
        '((set @cell-door :open false)
          (success :message "You close the door."))))

    :through (fn ()
      (cond
        ((:locked @cell-door)
          (blocked :reason locked :message "The door is locked."))
        ((not (:open @cell-door))
          (blocked :reason closed :message "The door is closed."))
        (true (success))))))

; --- Deadly trap ---

(object @orb
  :location @pit-bottom
  :description "glowing orb"
  :ldesc "A strange orb pulses with an eerie light."
  :properties (:touched false)
  :behaviors (
    :examine (fn () (success :message "The orb pulses hypnotically. It looks dangerous to touch."))
    :take (fn ()
      '((set @player :dead true)
        (set @orb :touched true)
        (success :message "As your fingers touch the orb, dark energy surges through you. Everything goes black.")))
    :touch (fn ()
      '((set @player :dead true)
        (set @orb :touched true)
        (success :message "Dark energy courses through your body. You collapse.")))))

; --- Irrelevant objects (red herrings) ---

(object @book
  :location @cell
  :description "dusty book"
  :ldesc "A dusty book lies in the corner."
  :properties (:read false)
  :behaviors (
    :take (fn () '((move @book @player) (success :message "You pick up the dusty book.")))
    :read (fn ()
      '((set @book :read true)
        (success :message "The book contains ancient recipes. Nothing useful.")))
    :examine (fn () (success :message "An old cookbook, covered in dust."))))

(object @coin
  :location @pit
  :description "silver coin"
  :ldesc "A silver coin glints on a ledge."
  :properties (:flipped false)
  :behaviors (
    :take (fn () '((move @coin @player) (success :message "You pocket the silver coin.")))
    :flip (fn ()
      '((set @coin :flipped (not (:flipped @coin)))
        (success :message "You flip the coin. It lands heads.")))
    :examine (fn () (success :message "A silver coin with a strange symbol."))))

(object @rock
  :location @pit-bottom
  :description "sharp rock"
  :ldesc "Sharp rocks litter the ground."
  :behaviors (
    :take (fn () '((move @rock @player) (success :message "You pick up a sharp rock.")))
    :examine (fn () (success :message "A jagged rock. Could be used as a crude weapon."))))

; === Extended puzzle: Safe with OR-condition ===
; The safe contains a gem needed for... nothing yet, but demonstrates OR prerequisites

(object @safe
  :location @cell
  :description "small safe"
  :ldesc "A small safe is bolted to the wall."
  :properties (:open false :damaged false)
  :behaviors (
    :examine (fn ()
      (cond
        ((:damaged @safe)
          (success :message "The safe has been pried open. It's damaged beyond repair."))
        ((:open @safe)
          (success :message "The safe door hangs open."))
        (true
          (success :message "A small wall safe with a combination dial."))))

    ; Open with combination (non-destructive, reversible)
    :dial (fn (?combo)
      (cond
        ((:open @safe)
          (success :message "The safe is already open."))
        ((:damaged @safe)
          (success :message "The safe is broken open. The dial doesn't work anymore."))
        ((= ?combo "1234")  ; The correct combination
          '((set @safe :open true)
            (success :message "Click! The safe swings open.")))
        (true
          (success :message "Nothing happens. Wrong combination."))))

    ; Force open with crowbar (destructive, irreversible, but works!)
    :force (fn ()
      (cond
        ((:open @safe)
          (success :message "The safe is already open."))
        ((not (held? @crowbar))
          (blocked :reason no-crowbar :message "You'd need something to pry it with."))
        (true
          '((set @safe :open true)
            (set @safe :damaged true)
            (success :message "With a loud crack, you pry the safe open. The mechanism is ruined.")))))

    :close (fn ()
      (cond
        ((not (:open @safe))
          (success :message "It's already closed."))
        ((:damaged @safe)
          (success :message "The safe is too damaged to close properly."))
        (true
          '((set @safe :open false)
            (success :message "You close the safe.")))))))

(object @crowbar
  :location @pit
  :description "rusty crowbar"
  :ldesc "A rusty crowbar leans against the wall."
  :behaviors (
    :take (fn () '((move @crowbar @player) (success :message "You pick up the heavy crowbar.")))
    :examine (fn () (success :message "A heavy iron crowbar, rusted but sturdy."))))

(object @gem
  :location @safe
  :description "sparkling gem"
  :behaviors (
    :take (fn ()
      (if (not (:open @safe))
        (blocked :reason safe-closed :message "The gem is inside the closed safe.")
        '((move @gem @player) (success :message "You take the sparkling gem."))))
    :examine (fn () (success :message "A brilliant gem that catches the light."))))

; === Limbo location for permanently lost items ===
(room @abyss
  :description "The Void"
  :ldesc "Items lost forever end up here."
  :properties (:lit false))

; ============================================================================
; LH-INSPIRED PATTERNS FOR ANALYZER TESTING
; ============================================================================

; === Pattern 1: Wearable Item (like LH gloves) ===
; The furnace room has a hot lever that requires gloves to pull

(room @furnace-room
  :description "Furnace Room"
  :ldesc "A sweltering room dominated by a massive furnace. A metal lever protrudes from the wall. Stairs lead down."
  :properties (:lit true)
  :visible (@hot-lever)  ; Lever is scenery, always visible here
  :exits ((down :to @cell)))

(object @gloves
  :location @pit
  :description "thick gloves"
  :ldesc "A pair of thick work gloves lies here."
  :properties (:wearable true :worn false :takeable true)
  :behaviors (
    :take (fn ()
      '((move @gloves @player)
        (success :message "You pick up the thick gloves.")))
    :wear (fn ()
      (cond
        ((not (held? @gloves))
          (blocked :reason not-held :message "You're not holding the gloves."))
        ((:worn @gloves)
          (success :message "You're already wearing them."))
        (true
          '((set @gloves :worn true)
            (success :message "You put on the thick gloves.")))))
    :remove (fn ()
      (if (not (:worn @gloves))
        (success :message "You're not wearing them.")
        '((set @gloves :worn false)
          (success :message "You take off the gloves."))))
    :examine (fn ()
      (if (:worn @gloves)
        (success :message "Thick work gloves. You're wearing them.")
        (success :message "Thick work gloves, good for handling hot objects.")))))

(object @hot-lever
  :location nil  ; Visible via room's :visible list
  :description "metal lever"
  :properties (:pulled false :nodesc true)
  :behaviors (
    :examine (fn ()
      (if (:pulled @hot-lever)
        (success :message "The lever is in the down position. Heat radiates from it.")
        (success :message "A metal lever glowing with heat. It controls something.")))
    :pull (fn ()
      (cond
        ((:pulled @hot-lever)
          (success :message "The lever is already pulled."))
        ((and (held? @gloves) (:worn @gloves))
          '((set @hot-lever :pulled true)
            (success :message "Protected by the gloves, you pull the hot lever. A distant clunk echoes.")))
        ((held? @gloves)
          (blocked :reason gloves-not-worn
            :message "You're holding the gloves but not wearing them. That won't protect you."))
        (true
          '((set @player :dead true)
            (success :message "You grab the lever and immediately smell burning flesh. The pain is unbearable.")))))))

; === Pattern 2: Navigation Barrier (like LH floor-waxer barrier) ===
; A guard blocks passage unless you show them something (the gem)

(room @guard-post
  :description "Guard Post"
  :ldesc "A small checkpoint. A bored guard stands here blocking the passage south."
  :properties (:lit true)
  :exits ((north :to @cell)
          (south :to @treasury :via @guard-barrier)))

(object @guard
  :location @guard-post
  :description "bored guard"
  :properties (:bribed false)
  :behaviors (
    :examine (fn ()
      (if (:bribed @guard)
        (success :message "The guard counts coins, ignoring you.")
        (success :message "A guard in worn armor. Looks corruptible.")))
    :give (fn (?obj)
      (cond
        ((:bribed @guard)
          (success :message "The guard waves you off. 'I already let you through.'"))
        ; Must be holding the coin to give it
        ((and (= ?obj @coin) (held? @coin))
          '((set @guard :bribed true)
            (move @coin @guard)
            (success :message "The guard pockets the coin with a wink. 'Go on through.'")))
        (true
          (success :message "The guard isn't interested in that."))))))

(object @guard-barrier
  :location @guard-post
  :description "passage"
  :properties ()
  :behaviors (
    :through (fn ()
      (if (:bribed @guard)
        (success)
        (blocked :reason guard-blocks
          :message "The guard steps in front of you. 'No one passes without... consideration.'")))))

(room @treasury
  :description "Treasury"
  :ldesc "A small room with a pedestal in the center. A golden treasure rests on the pedestal."
  :properties (:lit true)
  :exits ((north :to @guard-post)))

(object @treasure
  :location @treasury
  :description "golden treasure"
  :ldesc "A glittering golden treasure sits on the pedestal."
  :properties (:takeable true)
  :behaviors (
    :take (fn () '((move @treasure @player) (success :message "You take the golden treasure. It's heavy but valuable!")))
    :examine (fn () (success :message "A beautiful golden artifact, encrusted with jewels."))))

; === Pattern 3: Global Object / nodesc (like LH power-cord) ===
; A wire runs through multiple rooms and needs to be cut

(room @corridor-north
  :description "North Corridor"
  :ldesc "A long corridor. Wires run along the ceiling."
  :properties (:lit true)
  :visible (@wire)
  :exits ((south :to @corridor-south)))

(room @corridor-south
  :description "South Corridor"
  :ldesc "The corridor continues. The same wires run overhead."
  :properties (:lit true)
  :visible (@wire)
  :exits ((north :to @corridor-north)
          (east :to @cell)))

(object @wire
  :location nil  ; Global - visible from rooms with it in :visible
  :description "electrical wire"
  :properties (:nodesc true :severed false)
  :behaviors (
    :examine (fn ()
      (if (:severed @wire)
        (success :message "The wire hangs in two pieces, no longer dangerous.")
        (success :message "A thick electrical wire running along the ceiling. Looks dangerous.")))
    :cut (fn ()
      (cond
        ((:severed @wire)
          (success :message "It's already been cut."))
        ((not (held? @rock))
          (blocked :reason no-tool
            :message "You'd need something to cut it with."))
        (true
          '((set @wire :severed true)
            (success :message "You throw the rock at the wire, severing it in a shower of sparks!")))))))

; === Pattern 4: Timed Event (like LH maint-attack) ===
; After pulling the lever, something happens in 3 turns

(event alarm-triggers
  :on-turn
    (cond
      ((:alerted @guard)
        '((dequeue alarm-triggers)
          (success)))
      (true
        '((set @guard :alerted true)
          (success :message "ALARM! The guard snaps to attention!")))))
