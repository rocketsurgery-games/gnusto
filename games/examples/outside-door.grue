; outside-door example
; Demonstrates behavioral DSL with the exterior door from Lurking Horror
;
; This door exhibits complex location-dependent behavior:
; - From outside at certain locations: door opens (push-bar)
; - From outside elsewhere: locked
; - From inside: opens but auto-closes
; - @master-key doesn't work (electronic lock)

(world
  :name "Outside Door Example"
  :description "Demonstrates complex door behavior from Lurking Horror")

; === PLAYER ===

(object @player
  :location @mass-ave
  :flags (PERSON)
  :properties
    ((score 0)
     (moves 0)))

; === ROOMS ===

(room @mass-ave
  :description "The windswept intersection of Mass Ave and Memorial Drive"
  :flags (OUTSIDE LIT)
  :exits
    ((in :to @lobby :via @outside-door)
     (east :to @smith-st)
     (south :to @great-court)))

(room @smith-st
  :description "Smith Street, along the side of the building"
  :flags (OUTSIDE LIT)
  :exits
    ((in :to @lobby :via @outside-door)
     (west :to @mass-ave)))

(room @great-court
  :description "The great court, surrounded by imposing buildings"
  :flags (OUTSIDE LIT)
  :exits
    ((in :to @lobby :via @outside-door)
     (north :to @mass-ave)))

(room @courtyard
  :description "A small courtyard with a locked door"
  :flags (OUTSIDE LIT)
  :exits
    ((in :to @lobby :via @outside-door)))

(room @cs-roof
  :description "The roof of the computer science building"
  :flags (OUTSIDE LIT)
  :exits
    ((down :to @lobby :via @outside-door)))

(room @lobby
  :description "The building's main lobby, quiet at this hour"
  :flags (INSIDE LIT)
  :exits
    ((out :to @mass-ave :via @outside-door)
     (north :to @hallway)))

(room @hallway
  :description "A long corridor stretching into darkness"
  :flags (INSIDE LIT)
  :exits
    ((south :to @lobby)))

; === OBJECTS ===

(object @outside-door
  :description "A heavy exterior door with an electronic lock"
  :location @mass-ave
  :flags (DOOR LOCKED OPENABLE FIXED)
  :properties
    ((lock-type electronic))

  :behaviors (
    ; OPEN behavior - depends on which side you're on and where
    :open (cond
      ; Outside at push-bar locations: door opens freely
      ((and (room-has-flag? OUTSIDE)
            (in-room? @player @mass-ave @smith-st @courtyard @cs-roof))
        (success :context ((mechanism push-bar))))

      ; Outside elsewhere: locked
      ((room-has-flag? OUTSIDE)
        (blocked :reason locked-from-outside))

      ; Inside: opens but auto-closes (no state change)
      (true
        (success :context ((note auto-closing)))))

    ; UNLOCK behavior - electronic lock rejects physical keys
    :unlock (cond
      ; Outside with master key at push-bar locations: wrong key type
      ((and (room-has-flag? OUTSIDE)
            (in-room? @player @mass-ave @smith-st @courtyard @cs-roof)
            (= ?with @master-key))
        (blocked :reason wrong-key-type
                 :context ((detail electronic-lock)
                           (expected card-key))))

      ; Outside elsewhere: just locked
      ((room-has-flag? OUTSIDE)
        (blocked :reason locked-from-outside))

      ; Inside with master key: success
      ((and (has-flag ?self LOCKED)
            (= ?with @master-key))
        (success :effects ((clear-flag! ?self LOCKED))))

      ; Inside without key: need a key
      ((has-flag ?self LOCKED)
        (blocked :reason need-key))

      ; Already unlocked
      (true
        (blocked :reason not-locked)))

    ; CLOSE behavior - always succeeds (spring-loaded)
    :close (cond
      (true
        (success :context ((note spring-loaded)))))

    ; THROUGH behavior - delegates to movement
    :through (cond
      ((room-has-flag? OUTSIDE)
        (default :action (go :direction in)))

      (true
        (default :action (go :direction out))))

    ; EXAMINE behavior - describe based on location
    :examine (cond
      ((room-has-flag? OUTSIDE)
        (success :context ((visible-features (electronic-lock push-bar))
                           (apparent-state locked))))

      (true
        (success :context ((visible-features (electronic-lock))
                           (apparent-state
                             (if (has-flag ?self LOCKED) locked unlocked))))))))

(object @master-key
  :description "A worn brass key on a GBS keyring"
  :location @player
  :flags (TAKEABLE)
  :properties
    ((key-type physical)))

(object @card-key
  :description "A white plastic card with a magnetic stripe"
  :location @hallway
  :flags (TAKEABLE)
  :properties
    ((key-type electronic)))

; === WIN/LOSE CONDITIONS ===

; For this example, victory is reaching the hallway
(victory
  :when (= (loc @player) @hallway)
  :context ((ending reached-inside)))

; No defeat conditions in this simple example
