; The endgame: gather every treasure into the trophy case, which reveals the
; ancient map and opens the secret path southwest to the Stone Barrow. Entering
; the barrow wins the game.
;
; ZIL: SCORE-UPD sets WON-FLAG when SCORE hits SCORE-MAX (350), reveals the MAP,
; and whispers "Look to your treasures for the final secret." West of House then
; offers the SW/IN path to the Stone Barrow (STONE-BARROW-FCN wins on entry).
;
; DETERMINISTIC CONVERSION: rather than tracking an exact 350-point score (whose
; per-treasure values are fiddly), the win gate is simply "every treasure is in
; the trophy case", tested with the recursive `inside?` builtin (so a treasure
; tucked inside the coffin or egg still counts). A background watcher event
; delivers the "final secret" whisper and reveals the map the turn the case is
; complete; the barrow path opens on the same condition; standing in the barrow
; is the victory.

; The nineteen treasures of the Great Underground Empire.
(defn all-treasures-deposited? ()
  (and (inside? @painting @trophy-case)
       (inside? @bag-of-coins @trophy-case)
       (inside? @chalice @trophy-case)
       (inside? @egg @trophy-case)
       (inside? @canary @trophy-case)
       (inside? @trident @trophy-case)
       (inside? @jade @trophy-case)
       (inside? @bracelet @trophy-case)
       (inside? @diamond @trophy-case)
       (inside? @torch @trophy-case)
       (inside? @coffin @trophy-case)
       (inside? @sceptre @trophy-case)
       (inside? @skull @trophy-case)
       (inside? @trunk @trophy-case)
       (inside? @bar @trophy-case)
       (inside? @emerald @trophy-case)
       (inside? @scarab @trophy-case)
       (inside? @pot-of-gold @trophy-case)
       (inside? @bauble @trophy-case)))

; Background watcher (queued via the world :start-events): the turn the case is
; complete, reveal the map and whisper the final hint.
(event endgame-watch
  :on-turn
    (cond
      ((and (all-treasures-deposited?) (not (:endgame-announced @player)))
        '((set @player :endgame-announced true)
          (set @map :invisible false)
          (narrate "An almost inaudible voice whispers in your ear, \"Look to your treasures for the final secret.\"")
          (success)))
      (true (success))))

; The ancient map — appears in the trophy case once the collection is complete.
(object @map
  :location @trophy-case
  :description "ancient map"
  :properties (:takeable true :readable true :invisible true)
  :behaviors (
    :examine (fn () (redirect :action (do @map :read)))
    :read (fn ()
      '((narrate "The map shows a forest with three clearings. The largest clearing contains a house. Three paths leave the large clearing. One of these paths, leading southwest, is marked \"To Stone Barrow\".")
        (success)))))

; The secret path barrier: passable only once every treasure is deposited.
(object @barrow-path
  :description "path"
  :location nil
  :properties (:nodesc true)
  :behaviors (
    :through (fn ()
      (cond
        ((all-treasures-deposited?) (success))
        (true (blocked :message "You can't go that way."))))))

(room @stone-barrow
  :description "Stone Barrow"
  :ldesc "You are standing in front of a massive barrow of stone. In the east face is a huge stone door
  which is open. You cannot see into the dark of the tomb."
  :rdesc "A massive ancient barrow of grey stone at the forest's edge at dusk, a huge open stone door in its east face leading into impenetrable darkness; the secret path behind you. Empty of people."
  :properties (:lit true :outside true)
  :exits
    ((ne :to @west-of-house)
     ; Entering the tomb is the end of the adventure.
     (in :to @stone-barrow-interior :via @barrow-door)
     (west :to @stone-barrow-interior :via @barrow-door)))

; Passing through the barrow door into the tomb is the victory (the interior is
; never actually entered as a room; the victory condition fires on arrival).
(object @barrow-door
  :description "stone door"
  :location @stone-barrow
  :properties (:nodesc true)
  :behaviors (
    :examine (fn () '((focus @barrow-door "It's a huge stone door in the east face of the barrow, standing open on darkness.") (success)))
    :through (fn () (success))))

; A sentinel "room" for the tomb interior; reaching it satisfies (victory ...).
; :on-enter also emits an explicit (victory true) so the win is signalled the
; instant you step inside (mirrors how death is signalled via (death true)).
(room @stone-barrow-interior
  :description "Stone Barrow"
  :ldesc "You have entered the tomb of the last of the Great Underground Empire's implementers. Your
  quest is complete."
  :properties (:lit true)
  :exits ((out :to @stone-barrow))
  :behaviors (
    :on-enter (fn (?from)
      '((narrate "Inside the Stone Barrow you have completed your quest. You have conquered the Great Underground Empire!")
        (success :context ((victory true)))))))
