; The Maze, the Cyclops Room, and the Strange Passage.
;
; West of the Troll Room lies the maze of twisty little passages (all alike),
; whose non-Euclidean exits and one-way "diode" passages are copied verbatim
; from the ZIL. Maze 5 holds a dead adventurer's remains (coins, keys, a rusty
; knife). The maze leads to the Cyclops Room; naming the cyclops's father's
; nemesis ("Ulysses"/"Odysseus") routs him, opening the stairs up to the thief's
; Treasure Room AND smashing the east wall open into the Strange Passage — the
; shortcut that finally unlocks the Living Room's nailed door (ZIL MAGIC-FLAG).
;
; ZIL: 1dungeon.zil (MAZE-1..15, DEAD-END-1..4, GRATING-ROOM, CYCLOPS-ROOM,
; STRANGE-PASSAGE, TREASURE-ROOM; SKELETON/BONES, BAG-OF-COINS, KEYS,
; RUSTY-KNIFE); 1actions.zil (MAZE-DIODES, CYCLOPS-FCN); gverbs.zil (V-ODYSSEUS).
;
; All maze rooms are dark (MAZEBIT, no ONBIT): the lantern is mandatory here.
; MAZE-DIODES one-way passages are plain exits to their fixed target (the target
; has no reverse exit, so backtracking is impossible — the ZIL "diode"). The
; grating up to the surface is deferred to the forest slice. The thief and the
; Treasure Room loot are the next slice.


; === The maze ===

(room @maze-1 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((east :to @troll-room) (north :to @maze-1) (south :to @maze-2) (west :to @maze-4)))

(room @maze-2 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((south :to @maze-1) (down :to @maze-4) (east :to @maze-3)))  ; down = one-way diode

(room @maze-3 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((west :to @maze-2) (north :to @maze-4) (up :to @maze-5)))

(room @maze-4 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((west :to @maze-3) (north :to @maze-1) (east :to @dead-end-1)))

(room @dead-end-1 :description "Dead End" :ldesc "You have come to a dead end in the maze." :properties (:lit false)
  :exits ((south :to @maze-4)))

(room @maze-5 :description "Maze"
  :ldesc "This is part of a maze of twisty little passages, all alike. A skeleton, probably the remains
  of a luckless adventurer, lies here."
  :properties (:lit false)
  :exits ((east :to @dead-end-2) (north :to @maze-3) (sw :to @maze-6))
  :visible (@skeleton))

(room @dead-end-2 :description "Dead End" :ldesc "You have come to a dead end in the maze." :properties (:lit false)
  :exits ((west :to @maze-5)))

(room @maze-6 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((down :to @maze-5) (east :to @maze-7) (west :to @maze-6) (up :to @maze-9)))

(room @maze-7 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((up :to @maze-14) (west :to @maze-6) (down :to @dead-end-1)  ; down = one-way diode
          (east :to @maze-8) (south :to @maze-15)))

(room @maze-8 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((ne :to @maze-7) (west :to @maze-8) (se :to @dead-end-3)))

(room @dead-end-3 :description "Dead End" :ldesc "You have come to a dead end in the maze." :properties (:lit false)
  :exits ((north :to @maze-8)))

(room @maze-9 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((north :to @maze-6) (down :to @maze-11)  ; down = one-way diode
          (east :to @maze-10) (south :to @maze-13) (west :to @maze-12) (nw :to @maze-9)))

(room @maze-10 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((east :to @maze-9) (west :to @maze-13) (up :to @maze-11)))

(room @maze-11 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((ne :to @grating-room) (down :to @maze-10) (nw :to @maze-13) (sw :to @maze-12)))

(room @grating-room :description "Grating Room"
  :ldesc "You are in a small room near the maze. There are twisty passages in the immediate vicinity."
  :properties (:lit false)
  :exits ((sw :to @maze-11)
          (up :to @grating-clearing :via @grate))   ; grating -> surface (forest slice)
  :visible (@grate))

(room @maze-12 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((down :to @maze-5)  ; down = one-way diode
          (sw :to @maze-11) (east :to @maze-13) (up :to @maze-9) (north :to @dead-end-4)))

(room @dead-end-4 :description "Dead End" :ldesc "You have come to a dead end in the maze." :properties (:lit false)
  :exits ((south :to @maze-12)))

(room @maze-13 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((east :to @maze-9) (down :to @maze-12) (south :to @maze-10) (west :to @maze-11)))

(room @maze-14 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((west :to @maze-15) (nw :to @maze-14) (ne :to @maze-7) (south :to @maze-7)))

(room @maze-15 :description "Maze" :ldesc "This is part of a maze of twisty little passages, all alike." :properties (:lit false)
  :exits ((west :to @maze-14) (south :to @maze-7) (se :to @cyclops-room)))

; === Skeleton loot (Maze 5) ===

(object @skeleton
  :description "skeleton"
  :location nil
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @skeleton "It's the skeleton of a luckless adventurer who came before you.") (success)))
    ; Disturbing the remains curses you in ZIL (SKELETON: your treasures vanish to
    ; the Land of the Living Dead). Deferred; for now it simply resists.
    :take (fn () (blocked :message "You can't be serious."))
    :move (fn () '((narrate "A ghost appears and warns you not to disturb the remains.") (success)))))

(object @bag-of-coins
  :location @maze-5
  :description "leather bag of coins"
  :properties (:takeable true :treasure true :value 10 :tvalue 5)
  :behaviors (
    :examine (fn () '((focus @bag-of-coins "An old leather bag, bulging with coins.") (success)))))

(object @skeleton-key
  :location @maze-5
  :description "skeleton key"
  :properties (:takeable true :tool true)
  :behaviors (
    :examine (fn () '((focus @skeleton-key "It's an old skeleton key.") (success)))))

(object @rusty-knife
  :location @maze-5
  :description "rusty knife"
  ; The rusty knife is cursed: attacking with it is fatal (RUSTY-KNIFE-FCN).
  ; The death curse is deferred; taking it while armed warns you.
  :properties (:takeable true :weapon true :tool true)
  :behaviors (
    :take (fn ()
      (cond
        ((held? @sword)
          '((move @rusty-knife @player)
            (narrate "As you touch the rusty knife, your sword gives a single pulse of blinding blue light.")
            (success)))
        (true '((move @rusty-knife @player) (narrate "Taken.") (success)))))
    :examine (fn () '((focus @rusty-knife "It's an old, rusty knife.") (success)))))

; === The grating (to the surface — deferred) ===

(object @grate
  :description "grating"
  :location nil
  :properties (:nodesc true :openable true)
  :behaviors (
    :examine (fn ()
      (cond
        ((:open @grate) '((focus @grate "The grating is open.") (success)))
        (true '((focus @grate "It's a grating in the ceiling, closed.") (success)))))
    :through (fn ()
      (cond
        ((:open @grate) (success))
        (true (blocked :message "The grating is closed."))))))

; === Cyclops Room ===

(room @cyclops-room
  :description "Cyclops Room"
  :ldesc "This room has an exit on the northwest, and a staircase leading up."
  :rdesc "A dark stone chamber at the heart of the maze, a passage northwest and a stone staircase leading up, the east wall solid granite; lantern-lit. Empty of people."
  :properties (:lit false)
  :exits
    ((nw :to @maze-15)
     (east :to @strange-passage :via @cyclops-wall)   ; solid rock until the cyclops flees
     (up :to @treasure-room :via @cyclops))            ; the cyclops blocks the stairs
  :visible (@cyclops @cyclops-wall))

; ZIL CYCLOPS: unkillable. Routed by naming Odysseus (flees, smashing the east
; wall -> MAGIC-FLAG, and clearing the stairs -> CYCLOPS-FLAG), or lulled to
; sleep by feeding him the hot-pepper lunch and then water (clears the stairs
; only). :subdued = CYCLOPS-FLAG (stairs clear); (:magic @wooden-door) = MAGIC-FLAG.
(object @cyclops
  :location @cyclops-room
  :description "cyclops"
  :ldesc "A cyclops, who looks prepared to eat horses (much less mere adventurers), blocks the staircase. From his state of health, and the bloodstains on the walls, you gather that he is not very friendly, though he likes people."
  :properties (:person true :subdued false :fed false)
  :behaviors (
    :odysseus (fn ()
      (cond
        ((:subdued ?self)
          '((narrate "The cyclops is no longer a threat.") (success)))
        (true
          '((set @cyclops :subdued true)
            (set @wooden-door :magic true)
            (move @cyclops nil)
            (narrate "The cyclops, hearing the name of his father's deadly nemesis, flees the room by knocking down the wall on the east of the room.")
            (success)))))

    ; The stairs-up barrier.
    :through (fn ()
      (cond
        ((:subdued ?self) (success))
        (true (blocked :message "The cyclops doesn't look like he'll let you past."))))

    :give (fn (?item)
      (cond
        ((:subdued ?self)
          '((narrate "He's fast asleep.") (success)))
        ((= ?item @lunch)
          '((move @lunch nil)
            (set @cyclops :fed true)
            (narrate "The cyclops says \"Mmm Mmm. I love hot peppers! But oh, could I use a drink. Perhaps I could drink the blood of that thing.\" From the gleam in his eye, it could be surmised that you are \"that thing\".")
            (success)))
        ((and (= ?item @water) (:fed ?self))
          '((move @water nil)
            (set @cyclops :subdued true)
            (narrate "The cyclops takes the water and drinks it. A moment later, he lets out a yawn that nearly blows you over, and then falls fast asleep.")
            (success)))
        ((= ?item @water)
          '((narrate "The cyclops apparently is not thirsty and refuses your generous offer.") (success)))
        ((= ?item @garlic)
          '((narrate "The cyclops may be hungry, but there is a limit.") (success)))
        (true
          '((narrate "The cyclops is not so stupid as to eat THAT!") (success)))))

    :attack (fn (?weapon)
      '((narrate "The cyclops shrugs but otherwise ignores your pitiful attempt.") (success)))
    :mung (fn ()
      '((narrate "\"Do you think I'm as stupid as my father was?\", he says, dodging.") (success)))

    :examine (fn ()
      (cond
        ((:subdued ?self) '((focus @cyclops "The cyclops is sleeping like a baby, albeit a very ugly one.") (success)))
        (true '((focus @cyclops "A hungry cyclops is standing at the foot of the stairs.") (success)))))
    :take (fn () (blocked :message "The cyclops doesn't take kindly to being grabbed."))
    :listen (fn () '((narrate "You can hear his stomach rumbling.") (success)))))

; The smashable east wall (barrier for cyclops-room east -> strange passage).
(object @cyclops-wall
  :description "east wall"
  :location nil
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      (cond
        ((:magic @wooden-door)
          '((focus @cyclops-wall "There is a cyclops-sized hole in the east wall.") (success)))
        (true '((focus @cyclops-wall "The east wall is solid rock.") (success)))))
    :through (fn ()
      (cond
        ((:magic @wooden-door) (success))
        (true (blocked :message "The east wall is solid rock."))))))

; === Strange Passage (the Living Room shortcut) ===

(room @strange-passage
  :description "Strange Passage"
  :ldesc "This is a long passage. To the west is one entrance. On the east there is an old wooden door,
  with a large opening in it (about cyclops sized)."
  :rdesc "A long straight stone corridor, an opening to the west and a battered wooden door at the east end with a large cyclops-sized hole smashed through it; lantern-lit. Empty of people."
  :properties (:lit false)
  :exits
    ((west :to @cyclops-room)
     (in :to @cyclops-room)
     (east :to @living-room :via @wooden-door)))

; === Treasure Room (shell — the thief and loot are the next slice) ===

(room @treasure-room
  :description "Treasure Room"
  :ldesc "This is a large room, whose east wall is solid granite. A number of discarded bags, which
  crumble at your touch, are scattered about on the floor. There is an exit down a staircase."
  :rdesc "A cramped robber's den of solid granite, the floor littered with crumbling discarded bags, a staircase leading down; its own dim light. Empty of people."
  :properties (:lit true)
  :exits
    ((down :to @cyclops-room)))
