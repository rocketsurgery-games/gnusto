; Tests for Maintenance Man & Floor Waxer puzzle

; === Floor Waxer Tests ===


(test-group "floor waxer initial state"
  :setup ((move @player @inf-2))

  (test "waxer starts at inf-2"
    (do @floor-waxer :examine)
    (assert (outcome? success))
    (assert (loc? @floor-waxer @inf-2)))

  (test "maintenance man starts on waxer"
    (do @maintenance-man :examine)
    (assert (outcome? success))
    (assert (loc? @maintenance-man @floor-waxer)))
)

(test-group "waxer blocking"
  :setup ((move @player @inf-2) (move @floor-waxer @inf-2) (move @maintenance-man @floor-waxer) (set @power-cord :severed false))

  (test "waxer blocks east passage when present"
    (go :direction east)
    (assert (outcome? blocked)))

  (test "can move west when waxer present"
    (go :direction west)
    (assert (outcome? success))
    (assert (player-at? @inf-1)))
)

(test-group "power cord"
  :setup ((move @player @inf-1) (move @axe @player) (set @power-cord :severed false))

  (test "can examine cord"
    (do @power-cord :examine)
    (assert (outcome? success)))

  (test "cannot take cord"
    (do @power-cord :take)
    (assert (outcome? blocked)))

  (test "cannot cut cord without axe"
    :setup ((move @axe @inf-1))
    (do @power-cord :cut)
    (assert (outcome? blocked)))

  (test "can cut cord with axe"
    (do @power-cord :cut)
    (assert (outcome? success))
    (assert (prop? @power-cord severed true)))
)

(test-group "plastic container"
  :setup ((move @player @inf-1) (move @plastic-container @inf-1))

  (test "container starts in inf-1"
    (do @plastic-container :examine)
    (assert (outcome? success))
    (assert (loc? @plastic-container @inf-1)))

  (test "can examine container"
    (do @plastic-container :examine)
    (assert (outcome? success)))

  (test "can read container"
    (do @plastic-container :read)
    (assert (outcome? success)))

  (test "can take container"
    (do @plastic-container :take)
    (assert (outcome? success))
    (assert (held? @plastic-container)))
)

(test-group "floor wax"
  :setup ((move @player @inf-3) (move @plastic-container @player) (move @floor-wax @plastic-container) (set @plastic-container :open true))

  (test "wax starts in container"
    (do @plastic-container :examine)
    (assert (outcome? success))
    (assert (loc? @floor-wax @plastic-container)))

  (test "can examine wax in open container"
    (do @floor-wax :examine)
    (assert (outcome? success)))

  (test "can pour wax on floor"
    (do @floor-wax :pour)
    (assert (outcome? success))
    (assert (loc? @floor-wax @inf-3)))
)

(test-group "emergency cabinet"
  :setup ((move @player @inf-4) (set @emergency-cabinet :rmung false) (set @emergency-cabinet :open false) (move @axe @emergency-cabinet))

  (test "cabinet in inf-4"
    (do @emergency-cabinet :examine)
    (assert (outcome? success))
    (assert (loc? @emergency-cabinet @inf-4)))

  (test "can examine cabinet"
    (do @emergency-cabinet :examine)
    (assert (outcome? success)))

  (test "can read cabinet"
    (do @emergency-cabinet :read)
    (assert (outcome? success)))

  (test "cannot open cabinet without breaking"
    (do @emergency-cabinet :open)
    (assert (outcome? blocked)))

  (test "cannot break cabinet with bare hands"
    (do @emergency-cabinet :break)
    (assert (outcome? blocked)))

  (test "can break cabinet with gloves"
    :setup ((move @gloves @player))
    (do @emergency-cabinet :break)
    (assert (outcome? success))
    (assert (:rmung @emergency-cabinet)))
)

(test-group "axe"
  :setup ((move @player @inf-4) (move @axe @emergency-cabinet) (set @emergency-cabinet :rmung false))

  (test "cannot take axe through glass"
    (do @axe :take)
    (assert (outcome? blocked)))

  (test "can take axe after breaking glass"
    :setup ((set @emergency-cabinet :rmung true))
    (do @axe :take)
    (assert (outcome? success))
    (assert (held? @axe)))
)

(test-group "maintenance man combat"
  :setup ((move @player @inf-3) (move @floor-waxer @inf-3) (move @maintenance-man @inf-3) (set @power-cord :severed true) (move @axe @player))

  (test "cannot attack with hands"
    :setup ((move @axe @inf-1))
    (do @maintenance-man :attack)
    (assert (outcome? blocked)))

  (test "can attack with axe when off waxer"
    (do @maintenance-man :attack)
    (assert (outcome? success))
    (assert (loc? @maintenance-man nil)))
)

(test-group "loose maintenance man blocking"
  :setup ((move @player @inf-3) (move @floor-waxer @inf-5) (move @maintenance-man @inf-3) (set @power-cord :severed true) (set @maintenance-man :person true))

  (test "loose maintenance man blocks passage"
    (go :direction east)
    (assert (outcome? blocked)))

  (test "can pass if floor wax present"
    :setup ((move @floor-wax @inf-3))
    (go :direction east)
    (assert (outcome? success))
    (assert (player-at? @inf-4)))
)
