; Brown Building - Skyscraper with weather dome on roof
; Contains the flier creature encounter and hand puzzle.
;
; Rooms:
;   @brown-building - Lobby
;   @courtyard - Outside courtyard
;   @great-court - Great Court (locked door north)
;   @brown-basement - Basement (connects to tunnels)
;   @brown-top-floor - Top of stairwell
;   @brown-roof - Skyscraper roof with weather dome
;   @inside-dome - Weather observation station with peach tree
;
; Key puzzles:
;   - Roof access via unlocked door (master key)
;   - Flier creature encounter (triggered by smooth-stone or hand)
;   - Hand puzzle: dig in tub to find mummified hand, feed to flier

; === State Globals ===

(globals
  :flier-count 0)          ; Stage counter for flier approach (1-5+)

; === Stub Rooms (connected areas not in scope) ===

(room @brown-tunnel
  :description "Brown Tunnel"
  :ldesc "This is a narrow tunnel leading from the Brown Building basement."
  :flags ()  ; Dark
  :exits ((south :to @brown-basement)))

; === Main Rooms ===

(room @brown-building
  :description "Brown Building"
  :flags (ONBIT)
  :exits
    ((up :to @brown-top-floor)
     (down :to @brown-basement)
     (south :to @courtyard)
     (out :to @courtyard))
  :globals (@outside-door @brown-elevator)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description "This is the lobby of the Brown Building, an eighteen-story skyscraper which houses the Meteorology Department and other outposts of the Earth Sciences. The elevator is out of order, but a long stairway leads up to the roof, and another leads down to the basement. A revolving door leads out into the night."))))))

(room @courtyard
  :description "Small Courtyard"
  :ldesc "This courtyard is a triumph of modern architecture. It is spare, cold, angular, overwhelming in size, and bears a striking resemblance to a wind tunnel whenever the breeze picks up. Right now this is true of the whole campus, though. A huge mass lurks nearby, and an almost featureless skyscraper is to the north."
  :flags (ONBIT OUTSIDE)
  :exits
    ((in :to @brown-building)
     (north :to @brown-building))
  :globals (@outside-door)

  :behaviors (
    :on-enter (fn (?from)
      (cond
        ((not (has-flag ?from OUTSIDE))
          (success :effects ((queue! freezing))
                   :message "As you leave, the door closes and locks behind you."))
        (true (success))))))

(room @great-court
  :description "Great Court"
  :ldesc "In the spring and summer, this cheery green court is a haven from classwork. Right now, the majestic buildings of the main campus are almost invisible in the howling blizzard. A locked door bars your way to the north."
  :flags (ONBIT OUTSIDE)
  :exits ()  ; Locked door to north - no passage
  :globals (@outside-door)

  :behaviors (
    :on-enter (fn (?from)
      (cond
        ((not (has-flag ?from OUTSIDE))
          (success :effects ((queue! freezing))
                   :message "As you leave, the door closes and locks behind you."))
        (true (success))))))

(room @brown-basement
  :description "Brown Basement"
  :ldesc "This is a cluttered basement below the Brown Building. Discarded equipment nearly blocks an already narrow hallway that terminates in a stairway leading up. The passage itself continues northwest."
  :flags (ONBIT)
  :exits
    ((up :to @brown-building)
     (northwest :to @brown-tunnel)))

(room @brown-top-floor
  :description "Top Floor"
  :ldesc "This is the top of the stairway. A door leads out to the roof here, and you can hear the wind blowing beyond. There is a sign on the door."
  :flags (ONBIT)
  :exits
    ((down :to @brown-building)
     (west :to @brown-roof :via @roof-door)
     (out :to @brown-roof :via @roof-door))
  :globals (@roof-door))

(room @brown-roof
  :description "Skyscraper Roof"
  :ldesc "A low parapet surrounds a small roof here. The air conditioning cooling tower and the small protrusion containing the stairs are dwarfed by a semitransparent dome which towers above you. The blowing snow obscures all detail of the city across the river to the south."
  :flags (ONBIT OUTSIDE)
  :exits
    ((in :to @brown-top-floor :via @roof-door-exit)
     (east :to @brown-top-floor :via @roof-door-exit)
     (up :to @inside-dome))
  :globals (@roof-door @weather-dome @ladder)

  :behaviors (
    :on-enter (fn (?from)
      (success :effects ((queue! freezing))))

    :on-exit (fn (?to)
      (success :effects ((dequeue! freezing))))))

(room @inside-dome
  :description "Inside Dome"
  :ldesc "You are inside a large domed area. The dome contains equipment that makes it clear it is a weather observation station. For some reason, it also contains a small peach tree. Wind whistles outside, and snow blasts against the semitransparent material of the dome."
  :flags (ONBIT)
  :exits
    ((down :to @brown-roof :via @dome-exit)
     (out :to @brown-roof :via @dome-exit))
  :globals (@ladder)

  :behaviors (
    ; Trigger flier encounter when entering with smooth-stone
    :on-enter (fn (?from)
      (cond
        ((and (= flier-count 0) (held? @smooth-stone))
          (success :effects ((queue! flier-approach))
                   :message "As you enter the dome, you feel a chill that has nothing to do with the temperature."))
        (true (success))))

    ; Also trigger when entering with the hand
    :on-exit (fn (?to)
      (cond
        ((and (= flier-count 0) (held? @mummified-hand))
          (success :effects ((queue! flier-approach))))
        (true (success))))))

; === Door Objects ===

(object @brown-elevator
  :location @brown-building
  :description "elevator doors"
  :flags (NDESCBIT)

  :behaviors (
    :examine (fn ()
      (success :message "The elevator appears to be out of order."))

    :open (fn ()
      (blocked :reason broken :message "It's broken."))

    :enter (fn ()
      (blocked :reason broken :message "It's broken."))))

(object @roof-door
  :location @brown-top-floor
  :description "roof door"
  :flags (NDESCBIT DOORBIT OPENABLE LOCKED)

  :behaviors (
    :examine (fn ()
      (success :message
        (str "It's a heavy door leading to the roof. It is currently "
             (if (has-flag ?self OPENBIT) "open" "closed and locked")
             ".")))

    :open (fn ()
      (cond
        ((has-flag ?self OPENBIT)
          (blocked :reason already-open :message "It's already open."))
        ((has-flag ?self LOCKED)
          (blocked :reason locked :message "The door is securely locked."))
        (true
          (success :effects ((set-flag! ?self OPENBIT))
                   :message "You push the door open, revealing a windswept, snow-covered roof. Frigid wind whips snow into your face."))))

    :close (fn ()
      (cond
        ((not (has-flag ?self OPENBIT))
          (blocked :reason already-closed :message "It's already closed."))
        (true
          (success :effects ((clear-flag! ?self OPENBIT))
                   :message "You close the door, muffling the howling wind."))))

    :unlock (fn (?key)
      (cond
        ((not (= ?key @master-key))
          (blocked :reason wrong-key :message "That key doesn't fit."))
        ((not (has-flag ?self LOCKED))
          (blocked :reason already-unlocked :message "It's already unlocked."))
        (true
          (success :effects ((clear-flag! ?self LOCKED))
                   :message "The door is now unlocked."))))

    :through (fn ()
      (cond
        ((has-flag ?self LOCKED)
          (blocked :reason locked :message "The door is locked."))
        ((not (has-flag ?self OPENBIT))
          (blocked :reason closed :message "The door is closed."))
        (true (success))))))

(object @roof-door-exit
  :location @brown-roof
  :description "door"
  :flags (INVISIBLE)

  :behaviors (
    :through (fn ()
      (cond
        ((in? @flier @brown-roof)
          (blocked :reason flier-blocks
                   :message "The dark shape, its foul stench overpowering the wind, blocks your escape."))
        ((has-flag @roof-door OPENBIT)
          (success))
        (true
          (blocked :reason closed :message "The door leading inside is closed."))))))

(object @dome-exit
  :location @inside-dome
  :description "exit"
  :flags (INVISIBLE)

  :behaviors (
    :through (fn ()
      (cond
        ((in? @flier @inside-dome)
          (blocked :reason flier-blocks :message "The creature is blocking your exit."))
        (true (success))))))

(object @roof-door-sign
  :location @brown-top-floor
  :description "sign"
  :flags (NDESCBIT READBIT)

  :behaviors (
    :examine (fn ()
      (redirect :action (do ?self :read)))

    :read (fn ()
      (success :message "It says \"NO ADMITTANCE!\" In smaller, hand-written letters below, it says \"This means you!\" and below that in different handwriting, it says \"Who, me?\""))))

; === Weather Dome (scenery) ===

(object @weather-dome
  :location @brown-roof
  :description "dome"
  :flags (NDESCBIT)

  :behaviors (
    :examine (fn ()
      (success :message "The dome is large and semitransparent. It's made of some sort of milky-colored plastic. It dominates the roof. You can climb up to the entrance via a short ladder."))

    :enter (fn ()
      (redirect :action (do (loc @player) :go up)))

    :climb (fn ()
      (redirect :action (do (loc @player) :go up)))))

(object @ladder
  :location nil  ; Global, appears via room :globals
  :description "ladder"
  :flags (NDESCBIT)

  :behaviors (
    :examine (fn ()
      (success :message "It's a short metal ladder leading up to the dome entrance."))

    :climb (fn ()
      (redirect :action (do (loc @player) :go up)))))

; === Peach Tree & Tub (Hand Puzzle) ===

(object @peach-tree
  :location @inside-dome
  :description "peach tree"
  :flags (NDESCBIT)

  :behaviors (
    :examine (fn ()
      (success :message "It's a small peach tree planted in a very large tub of earth. It appears healthy, although as it is wintertime, the tree has no leaves."))

    :shake (fn ()
      (success :message "You shake it, but nothing drops. Its branches are bare."))

    :climb (fn ()
      (blocked :reason slippery
               :message "You start to climb the tree, but as you get partway up, your hands encounter a slippery substance which covers the limbs at this height. Not only is it extremely unpleasant to touch, it makes the tree too slippery to climb any further."))))

(object @tub
  :location @inside-dome
  :description "tub of dirt"
  :flags (NDESCBIT CONTBIT OPENBIT SEARCHBIT)
  :properties (:capacity 30)

  :behaviors (
    :examine (fn ()
      (success :message "The tub is full of dirt and \"condo chips\" (those pine bark chips that are spread around condos and shopping centers by the ton). The dirt has been disturbed recently."))

    :search (fn ()
      (cond
        ((not (has-flag @mummified-hand TOUCHBIT))
          (success :effects ((set-flag! @mummified-hand TOUCHBIT) (move! @mummified-hand ?self))
                   :message "You root around in the dirt for a while, when you encounter something hard. Further exploration reveals it to be a dried, chewed looking human hand."))
        (true
          (success :message "You find nothing further, which is something of a relief."))))

    :dig (fn ()
      (redirect :action (do ?self :search)))))

(object @mummified-hand
  :location nil  ; Hidden until found by searching tub
  :description "human hand"
  :flags (TAKEBIT SEARCHBIT OPENBIT CONTBIT)
  :properties (:heat 0)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description "A dried, mummified human hand lies here."))))

    :examine (fn ()
      (success :message "The hand is very old. It's dry and very light, mummified in fact. There are stains, scars, and dried blood on it. There is a tattoo on the back of it. The hand appears to have been severed by the application of very sharp teeth, perhaps an animal's."))

    :rub (fn ()
      (success :message "It's dry and cold. In fact, it's mummified."))))

(object @tattoo
  :location @mummified-hand
  :description "tattoo"
  :flags (NDESCBIT)

  :behaviors (
    :examine (fn ()
      (success :message "The tattoo is old and faded. It was done in red ink and is very artistically drawn. It depicts a strange symbol."))

    :read (fn ()
      (redirect :action (do ?self :examine)))))

; === Flier Creature ===
; A dark flying horror that's attracted to the smooth-stone and the hand.
; It will eat the hand if given or if the player has it when it attacks.

(object @flier-shape
  :location nil  ; Appears during flier approach
  :description "dark shape"
  :flags (NDESCBIT)

  :behaviors (
    :examine (fn ()
      (success :message "You can't tell much from here. It's large and dark, but the dome obscures all detail."))))

(object @flier
  :location nil  ; Appears during flier encounter
  :description "creature"
  :flags ()

  :behaviors (
    :describe (fn ()
      (success :context
        ((description "A dark shape watches balefully from nearby."))))

    :examine (fn ()
      (success :message "Like a black sheet flapping in the wind, the dark flier is hard to see. Red eyes glow like coals on its scaly, bullet-shaped head. Human-like hands clench and unclench. Sharp needles of teeth project wickedly from its twisted jaw."))

    :smell (fn ()
      (success :message "Its stench is that of a foul eater of carrion, overlaid with another smell you can't place, but which is even less appetizing."))

    :attack (fn (?weapon)
      (cond
        ((= ?weapon @smooth-stone)
          ; Smooth stone can drive it away
          (success :effects ((move! @flier nil) (set! flier-count 0) (dequeue! flier-approach))
                   :message "You hurl the stone at the creature. It strikes true! The flier shrieks in pain and fury, then flees into the storm, disappearing from view."))
        (true
          (blocked :reason ineffective
                   :message "Hissing and screeching, the creature fends off your attack. Its head jerks from side to side, watching you."))))

    :give (fn (?item)
      (cond
        ((= ?item @mummified-hand)
          ; Feeding the hand to the flier is the solution
          (success :effects ((move! @mummified-hand nil) (move! @flier nil) (set! flier-count 0) (dequeue! flier-approach))
                   :message "In a snake-like strike, the creature snaps at the mummified hand! With a disgusting gobbling noise, the flier swallows the hand, and then, its wings beating feebly against the wind, it sails away into the gale."))
        (true
          (blocked :reason not-interested :message "The creature shows no interest in that."))))))

; === Flier Approach Event ===
; Multi-stage creature approach. Each turn advances the counter.
; At stage 5+, the flier attacks and may eat the hand.

(def flier-messages-inside-dome
  '("Something smashes against the glass of the dome! You turn and see a dark shape clinging to the outside of the structure."
    "The dark shape moves. Above the howl of the wind you hear a high-pitched keening noise."
    "The shape drops out of view."
    "You hear, on the ladder outside, hard claws painfully climbing towards the dome entrance."
    "The creature enters the dome, screaming viciously at you, its claws reaching out to grasp and rend."))

(def flier-messages-on-roof
  '("You hear a strange confusion of wings, and then something dark and shapeless smashes against the dome above you!"
    "The dark shape moves. Above the howl of the wind you hear a high-pitched keening noise."
    "The shape drops, crunching into the snow almost next to you. Its scaly head turns toward you, eyes like coals staring into yours."
    "The shape rises, baring needle-sharp teeth and pumping its wings painfully in the gale."
    "The creature approaches, hissing at you as it nears."))

(event flier-approach
  :on-turn
    (let ((?stage (+ flier-count 1)))
      (set! flier-count ?stage)
      (cond
        ; Stage 1-5: Advance and show message
        ((<= ?stage 5)
          (let ((?msg (if (= (loc @player) @inside-dome)
                        (nth flier-messages-inside-dome (- ?stage 1))
                        (nth flier-messages-on-roof (- ?stage 1)))))
            (cond
              ; Stage 1: Shape appears
              ((= ?stage 1)
                (success :effects ((if (= (loc @player) @inside-dome)
                                     (move! @flier-shape @inside-dome)
                                     (move! @flier-shape @inside-dome))
                                   (move! @flier @brown-roof)
                                   (queue! flier-approach))
                         :context ((description ?msg))))
              ; Stage 3: Shape drops, flier visible
              ((= ?stage 3)
                (success :effects ((move! @flier-shape nil) (queue! flier-approach))
                         :context ((description ?msg))))
              ; Stage 5: Flier enters if in dome
              ((= ?stage 5)
                (cond
                  ((= (loc @player) @inside-dome)
                    (success :effects ((move! @flier @inside-dome) (queue! flier-approach))
                             :context ((description ?msg))))
                  (true
                    (success :effects ((queue! flier-approach))
                             :context ((description ?msg))))))
              ; Other stages
              (true
                (success :effects ((queue! flier-approach))
                         :context ((description ?msg)))))))

        ; Stage 6+: Flier attacks, may eat hand
        ((held? @mummified-hand)
          ; Hand is consumed, flier leaves
          (success :effects ((move! @mummified-hand nil) (move! @flier nil) (dequeue! flier-approach) (set! flier-count 0))
                   :context ((description "In a snake-like strike, the creature attacks! Its toothy jaws close on your hand! Not your hand, but the mummified hand you dug out of the tub! With a disgusting gobbling noise, the flier swallows the hand, and then sails away into the gale."))))

        ; No hand - player is in danger
        (true
          (blocked :reason death
                   :context ((death true)
                             (description "The creature lunges at you with terrifying speed. Its claws tear into you, and the last thing you see is its blood-red mouth descending...")))))))

