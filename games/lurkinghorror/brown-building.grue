; Brown Building - Skyscraper with weather dome on roof
; Contains the flier creature encounter and hand puzzle.
;
; Rooms:
;   @brown-building - Lobby
;   @courtyard - Outside courtyard
;   @great-court - Great Court (locked door north)
;   @brown-basement - Basement (connects to tunnels)
;   @brown-top-floor - Top of stairwell
;   @brown-roof - Skyscraper roof with weather dome
;   @inside-dome - Weather observation station with peach tree
;
; Key puzzles:
;   - Roof access via unlocked door (master key)
;   - Flier creature encounter (triggered by smooth-stone or hand)
;   - Hand puzzle: dig in tub to find mummified hand, feed to flier

; === Stub Rooms (connected areas not in scope) ===

(room @brown-tunnel
  :description "Cluttered Passage"
  :ldesc "This cluttered passage leads southeast. It is full of apparently discarded electronic equipment, old rusty file cabinets, and other detritus. A stairway also leads up."
  :properties (:lit true)
  :exits ((se :to @brown-basement)
          (up :to @nutrition-bldg)))

; === Main Rooms ===

(room @brown-building
  :description "Brown Building"
  :properties (:lit true)
  :exits
    ((up :to @brown-top-floor)
     (down :to @brown-basement)
     (south :to @courtyard)
     (out :to @courtyard))
  :visible (@outside-door @brown-elevator)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description "This is the lobby of the Brown Building, an eighteen-story skyscraper which houses the Meteorology Department and other outposts of the Earth Sciences. The elevator is out of order, but a long stairway leads up to the roof, and another leads down to the basement. A revolving door leads out into the night."))))))

(room @courtyard
  :description "Small Courtyard"
  :ldesc "This courtyard is a triumph of modern architecture. It is spare, cold, angular, overwhelming in size, and bears a striking resemblance to a wind tunnel whenever the breeze picks up. Right now this is true of the whole campus, though. A huge mass lurks nearby, and an almost featureless skyscraper is to the north."
  :properties (:lit true :outside true)
  :exits
    ((in :to @brown-building)
     (north :to @brown-building))
  :visible (@outside-door)

  :behaviors (
    :on-enter (fn (?from)
      (cond
        ((not (:outside ?from))
          '((queue freezing)
            (narrate "As you leave, the door closes and locks behind you.")
            (success)))
        (true (success))))))

(room @great-court
  :description "Great Court"
  :ldesc "In the spring and summer, this cheery green court is a haven from classwork. Right now, the majestic buildings of the main campus are almost invisible in the howling blizzard. A locked door bars your way to the north."
  :properties (:lit true :outside true)
  :exits ()  ; Locked door to north - no passage
  :visible (@outside-door)

  :behaviors (
    :on-enter (fn (?from)
      (cond
        ((not (:outside ?from))
          '((queue freezing)
            (narrate "As you leave, the door closes and locks behind you.")
            (success)))
        (true (success))))))

(room @brown-basement
  :description "Brown Basement"
  :ldesc "This is a cluttered basement below the Brown Building. Discarded equipment nearly blocks an already narrow hallway that terminates in a stairway leading up. The passage itself continues northwest."
  :properties (:lit true)
  :exits
    ((up :to @brown-building)
     (nw :to @brown-tunnel)))

(room @brown-top-floor
  :description "Top Floor"
  :ldesc "This is the top of the stairway. A door leads out to the roof here, and you can hear the wind blowing beyond. There is a sign on the door."
  :properties (:lit true)
  :exits
    ((down :to @brown-building)
     (west :to @brown-roof :via @roof-door)
     (out :to @brown-roof :via @roof-door))
  :visible (@roof-door))

(room @brown-roof
  :description "Skyscraper Roof"
  :ldesc "A low parapet surrounds a small roof here. The air conditioning cooling tower and the small protrusion containing the stairs are dwarfed by a semitransparent dome which towers above you. The blowing snow obscures all detail of the city across the river to the south."
  :properties (:lit true :outside true)
  :exits
    ((in :to @brown-top-floor :via @roof-door-exit)
     (east :to @brown-top-floor :via @roof-door-exit)
     (up :to @inside-dome))
  :visible (@roof-door @weather-dome @dome-ladder)

  :behaviors (
    :on-enter (fn (?from)
      '((queue freezing)
        (success)))

    :on-exit (fn (?to)
      '((dequeue freezing)
        (success)))))

(room @inside-dome
  :description "Inside Dome"
  :ldesc "You are inside a large domed area. The dome contains equipment that makes it clear it is a weather observation station. For some reason, it also contains a small peach tree. Wind whistles outside, and snow blasts against the semitransparent material of the dome."
  :properties (:lit true)
  :exits
    ((down :to @brown-roof :via @dome-exit)
     (out :to @brown-roof :via @dome-exit))
  :visible (@dome-ladder)

  :behaviors (
    ; Trigger flier encounter when entering with smooth-stone
    :on-enter (fn (?from)
      (cond
        ((and (= (:count @flier) 0) (held? @smooth-stone))
          '((queue flier-approach)
            (narrate "As you enter the dome, you feel a chill that has nothing to do with the temperature.")
            (success)))
        (true (success))))

    ; Also trigger when entering with the hand
    :on-exit (fn (?to)
      (cond
        ((and (= (:count @flier) 0) (held? @mummified-hand))
          '((queue flier-approach)
            (success)))
        (true (success))))))

; === Door Objects ===

(object @brown-elevator
  :location @brown-building
  :description "elevator doors"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @brown-elevator "The elevator appears to be out of order.")
        (success)))

    :open (fn ()
      (blocked :reason broken :message "It's broken."))

    :enter (fn ()
      (blocked :reason broken :message "It's broken."))))

(object @roof-door
  :location @brown-top-floor
  :description "roof door"
  :properties (:nodesc true :door true :openable true :locked true)
  :behaviors (
    :examine (fn ()
      `((focus @roof-door
          ,(str "It's a heavy door leading to the roof. It is currently "
                (if (:open ?self) "open" "closed and locked")
                "."))
        (success)))

    :open (fn ()
      (cond
        ((:open ?self)
          (blocked :reason already-open :message "It's already open."))
        ((:locked ?self)
          (blocked :reason locked :message "The door is securely locked."))
        (true
          '((set ?self :open true)
            (narrate "You push the door open, revealing a windswept, snow-covered roof. Frigid wind whips snow into your face.")
            (success)))))

    :close (fn ()
      (cond
        ((not (:open ?self))
          (blocked :reason already-closed :message "It's already closed."))
        (true
          '((set ?self :open false)
            (narrate "You close the door, muffling the howling wind.")
            (success)))))

    :unlock (fn (?key)
      (cond
        ((not (= ?key @master-key))
          (blocked :reason wrong-key :message "That key doesn't fit."))
        ((not (:locked ?self))
          (blocked :reason already-unlocked :message "It's already unlocked."))
        (true
          '((set ?self :locked false)
            (narrate "The door is now unlocked.")
            (success)))))

    :through (fn ()
      (cond
        ((:locked ?self)
          (blocked :reason locked :message "The door is locked."))
        ((not (:open ?self))
          (blocked :reason closed :message "The door is closed."))
        (true (success))))))

(object @roof-door-exit
  :location @brown-roof
  :description "door"
  :properties (:invisible true)
  :behaviors (
    :through (fn ()
      (cond
        ((in? @flier @brown-roof)
          (blocked :reason flier-blocks
                   :message "The dark shape, its foul stench overpowering the wind, blocks your escape."))
        ((:open @roof-door)
          (success))
        (true
          (blocked :reason closed :message "The door leading inside is closed."))))))

(object @dome-exit
  :location @inside-dome
  :description "exit"
  :properties (:invisible true)
  :behaviors (
    :through (fn ()
      (cond
        ((in? @flier @inside-dome)
          (blocked :reason flier-blocks :message "The creature is blocking your exit."))
        (true (success))))))

(object @roof-door-sign
  :location @brown-top-floor
  :description "sign"
  :properties (:nodesc true :readable true)
  :behaviors (
    :examine (fn ()
      (redirect :action (do ?self :read)))

    :read (fn ()
      '((narrate "It says \"NO ADMITTANCE!\" In smaller, hand-written letters below, it says \"This means you!\" and below that in different handwriting, it says \"Who, me?\"")
        (success)))))

; === Weather Dome (scenery) ===

(object @weather-dome
  :location @brown-roof
  :description "dome"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @weather-dome "The dome is large and semitransparent. It's made of some sort of milky-colored plastic. It dominates the roof. You can climb up to the entrance via a short ladder.")
        (success)))

    :enter (fn ()
      (redirect :action (do (loc @player) :go up)))

    :climb (fn ()
      (redirect :action (do (loc @player) :go up)))))

(object @dome-ladder
  :location nil  ; Global, appears via room :visible
  :description "ladder"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @dome-ladder "It's a short metal ladder leading up to the dome entrance.")
        (success)))

    :climb (fn ()
      (redirect :action (do (loc @player) :go up)))))

; === Peach Tree & Tub (Hand Puzzle) ===

(object @peach-tree
  :location @inside-dome
  :description "peach tree"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @peach-tree "It's a small peach tree planted in a very large tub of earth. It appears healthy, although as it is wintertime, the tree has no leaves.")
        (success)))

    :shake (fn ()
      '((narrate "You shake it, but nothing drops. Its branches are bare.")
        (success)))

    :climb (fn ()
      (blocked :reason slippery
               :message "You start to climb the tree, but as you get partway up, your hands encounter a slippery substance which covers the limbs at this height. Not only is it extremely unpleasant to touch, it makes the tree too slippery to climb any further."))

    :rub (fn ()
      '((narrate "It feels like wood, but there is something slippery on it higher up.")
        (success)))

    :attack (fn (?weapon)
      (blocked :reason vandalism
               :message "At the last second, you realize it would be an unspeakable act of vandalism."))))

(object @tub
  :location @inside-dome
  :description "tub of dirt"
  :properties (:nodesc true :container true :open true :searchable true :capacity 30)

  :behaviors (
    :examine (fn ()
      '((focus @tub "The tub is full of dirt and \"condo chips\" (those pine bark chips that are spread around condos and shopping centers by the ton). The dirt has been disturbed recently.")
        (success)))

    :search (fn ()
      (cond
        ((not (:touched @mummified-hand))
          '((set @mummified-hand :touched true)
            (move @mummified-hand ?self)
            (narrate "You root around in the dirt for a while, when you encounter something hard. Further exploration reveals it to be a dried, chewed looking human hand.")
            (success)))
        (true
          '((narrate "You find nothing further, which is something of a relief.") (success)))))

    :dig (fn ()
      (redirect :action (do ?self :search)))))

(object @mummified-hand
  :location nil  ; Hidden until found by searching tub
  :description "human hand"
  :rdesc "A dried, mummified severed human hand, very old and light, covered in stains, scars and dried blood, a faded tattoo on the back; the wrist looks gnawed off by sharp animal teeth. Solid black background."
  :properties (:takeable true :searchable true :open true :container true :heat 0 :last-pointed-room nil :animation-count 0 :touched false :person false)

  :behaviors (
    :describe (fn ()
      (cond
        ((:person ?self)
          ; Animated hand perches on shoulder when held
          (cond
            ((held? ?self)
              (success :context ((description "The human hand is perched on your shoulder."))))
            (true
              (success :context ((description "A human hand is here."))))))
        (true
          (success :context ((description "A dried, mummified human hand lies here."))))))

    :examine (fn ()
      (cond
        ((:person ?self)
          ; Animated hand - show stains, scars, ring if present, tattoo
          `((focus @mummified-hand
              ,(str "There are stains, scars, "
                    (if (in? @ring ?self) "a brass hyrax, " "")
                    "and a tattoo on the hand."))
            (success)))
        (true
          ; Mummified - detailed description
          '((focus @mummified-hand "The hand is very old. It's dry and very light, mummified in fact. There are stains, scars, and dried blood on it. There is a tattoo on the back of it. The hand appears to have been severed by the application of very sharp teeth, perhaps an animal's.")
            (success)))))

    :rub (fn ()
      (cond
        ((:person ?self)
          '((narrate "It's warm and dry.") (success)))
        (true
          '((narrate "It's dry and cold. In fact, it's mummified.") (success)))))

    ; Animated hand wiggles away from hostile actions
    :take (fn ()
      (cond
        ((:person ?self)
          (cond
            ((= (loc @player) @inner-lair)
              '((narrate "The human hand, muddy and wet, wiggles out of your grasp.") (success)))
            ((held? ?self)
              '((narrate "The human hand scuttles away to your other shoulder.") (success)))
            (true (default))))
        (true (default))))

    :throw (fn (?target)
      (cond
        ((:person ?self)
          (cond
            ((= (loc @player) @inner-lair)
              '((narrate "The human hand, muddy and wet, wiggles out of your grasp.") (success)))
            ((held? ?self)
              '((narrate "The human hand scuttles away to your other shoulder.") (success)))
            (true (default))))
        (true (default))))

    :attack (fn (?weapon)
      (cond
        ((:person ?self)
          (cond
            ((= (loc @player) @inner-lair)
              '((narrate "The human hand, muddy and wet, wiggles out of your grasp.") (success)))
            ((held? ?self)
              '((narrate "The human hand scuttles away to your other shoulder.") (success)))
            (true (default))))
        (true (default))))

    ; Give/show something TO the animated hand
    :give (fn (?item)
      (cond
        ((:person ?self)
          (cond
            ((in? ?self @vat)
              '((narrate "The hand is preoccupied.") (success)))
            ((:person ?item)
              '((narrate "The hand doesn't react.") (success)))
            (true
              `((narrate
                  ,(str "The hand scurries to the " (desc ?item)
                        " and touches it all over, much as a blind person would examine something."))
                (success)))))
        (true
          (blocked :reason inanimate :message "The hand doesn't react."))))))

(object @tattoo
  :location @mummified-hand
  :description "tattoo"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @tattoo "The tattoo is old and faded. It was done in red ink and is very artistically drawn. It depicts a strange symbol.")
        (success)))

    :read (fn ()
      (redirect :action (do ?self :examine)))))

; === Flier Creature ===
; A dark flying horror that's attracted to the smooth-stone and the hand.
; It will eat the hand if given or if the player has it when it attacks.

(object @flier-shape
  :location nil  ; Appears during flier approach
  :description "dark shape"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @flier-shape "You can't tell much from here. It's large and dark, but the dome obscures all detail.")
        (success)))))

(object @flier
  :location nil  ; Appears during flier encounter
  :description "creature"
  :properties (:count 0)  ; Stage counter for flier approach (1-5+)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description "A dark shape watches balefully from nearby."))))

    :examine (fn ()
      '((focus @flier "Like a black sheet flapping in the wind, the dark flier is hard to see. Red eyes glow like coals on its scaly, bullet-shaped head. Human-like hands clench and unclench. Sharp needles of teeth project wickedly from its twisted jaw.")
        (success)))

    :smell (fn ()
      '((narrate "Its stench is that of a foul eater of carrion, overlaid with another smell you can't place, but which is even less appetizing.")
        (success)))

    :attack (fn (?weapon)
      (cond
        ((= ?weapon @smooth-stone)
          ; Smooth stone can drive it away
          '((move @flier nil)
            (set @flier :count 0)
            (dequeue flier-approach)
            (narrate "You hurl the stone at the creature. It strikes true! The flier shrieks in pain and fury, then flees into the storm, disappearing from view.")
            (success)))
        (true
          (blocked :reason ineffective
                   :message "Hissing and screeching, the creature fends off your attack. Its head jerks from side to side, watching you."))))

    :give (fn (?item)
      (cond
        ((= ?item @mummified-hand)
          ; Feeding the hand to the flier is the solution
          '((move @mummified-hand nil)
            (move @flier nil)
            (set @flier :count 0)
            (dequeue flier-approach)
            (narrate "In a snake-like strike, the creature snaps at the mummified hand! With a disgusting gobbling noise, the flier swallows the hand, and then, its wings beating feebly against the wind, it sails away into the gale.")
            (success)))
        ((= ?item @smooth-stone)
          ; Smooth stone scares it but doesn't drive it away
          '((narrate "The creature edges away from the stone.") (success)))
        (true
          (blocked :reason not-interested :message "The creature shows no interest in that."))))

    :throw (fn (?item)
      (cond
        ((= ?item @smooth-stone)
          ; Throwing smooth-stone drives it away (same as attack with stone)
          (redirect :action (do ?self :attack @smooth-stone)))
        (true
          ; Flier dodges other thrown items
          `((move ?item (loc @player))
            (narrate ,(str "The creature darts to the side, dodging the " (desc ?item) "."))
            (success)))))))

; === Flier Approach Event ===
; Multi-stage creature approach. Each turn advances the counter.
; At stage 5+, the flier attacks and may eat the hand.

(def flier-messages-inside-dome
  '("Something smashes against the glass of the dome! You turn and see a dark shape clinging to the outside of the structure."
    "The dark shape moves. Above the howl of the wind you hear a high-pitched keening noise."
    "The shape drops out of view."
    "You hear, on the ladder outside, hard claws painfully climbing towards the dome entrance."
    "The creature enters the dome, screaming viciously at you, its claws reaching out to grasp and rend."))

(def flier-messages-on-roof
  '("You hear a strange confusion of wings, and then something dark and shapeless smashes against the dome above you!"
    "The dark shape moves. Above the howl of the wind you hear a high-pitched keening noise."
    "The shape drops, crunching into the snow almost next to you. Its scaly head turns toward you, eyes like coals staring into yours."
    "The shape rises, baring needle-sharp teeth and pumping its wings painfully in the gale."
    "The creature approaches, hissing at you as it nears."))

(event flier-approach
  :on-turn
    (let ((?stage (+ (:count @flier) 1))
          (?in-dome (= (loc @player) @inside-dome)))
      (cond
        ; Stage 1-5: Advance and show message
        ((<= ?stage 5)
          (let ((?msg (if ?in-dome
                        (nth flier-messages-inside-dome (- ?stage 1))
                        (nth flier-messages-on-roof (- ?stage 1)))))
            (cond
              ; Stage 1: Shape appears
              ((= ?stage 1)
                `((set @flier :count ,?stage)
                  (move @flier-shape @inside-dome)
                  (move @flier @brown-roof)
                  (queue flier-approach)
                  (narrate ,?msg)
                  (success)))
              ; Stage 3: Shape drops, flier visible
              ((= ?stage 3)
                `((set @flier :count ,?stage)
                  (move @flier-shape nil)
                  (queue flier-approach)
                  (narrate ,?msg)
                  (success)))
              ; Stage 5: Flier enters if in dome
              ((= ?stage 5)
                `((set @flier :count ,?stage)
                  ,@(if ?in-dome '((move @flier @inside-dome)) '())
                  (queue flier-approach)
                  (narrate ,?msg)
                  (success)))
              ; Other stages (2, 4)
              (true
                `((set @flier :count ,?stage)
                  (queue flier-approach)
                  (narrate ,?msg)
                  (success))))))

        ; Stage 6+: Flier attacks, may eat hand
        ((held? @mummified-hand)
          ; Hand is consumed, flier leaves
          '((move @mummified-hand nil)
            (move @flier nil)
            (dequeue flier-approach)
            (set @flier :count 0)
            (narrate "In a snake-like strike, the creature attacks! Its toothy jaws close on your hand! Not your hand, but the mummified hand you dug out of the tub! With a disgusting gobbling noise, the flier swallows the hand, and then sails away into the gale.")
            (success)))

        ; No hand - player is in danger
        (true
          (blocked :reason death
                   :context ((death true)
                             (description "The creature lunges at you with terrifying speed. Its claws tear into you, and the last thing you see is its blood-red mouth descending...")))))))
