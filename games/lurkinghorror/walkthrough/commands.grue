; === The Lurking Horror - REPL Walkthrough ===
; Agent-exposed commands only: (do), (go), (wait)
; Covers: Login -> Nightmare -> Hacker Trade -> Basement -> Great Dome -> Ritual Escape
; Run with: grue-repl games/lurkinghorror/ < walkthrough/commands.grue
;
; Status: Completes through ritual escape (professor dies, player escapes to under-alchemy-lab)
; Endgame not yet included (mummified hand, urchins, lair)

; === PHASE 1: LOGIN & NIGHTMARE ===
(do @pc :turn-on)
(do @pc :login "xyzzy")
(do @pc :password "plugh")
(do @menu-box :click)
(do @yak-window :click)
(do @odd-paper :read)
(wait)
(wait)
(wait)
(wait)
(wait)
(wait)
(wait)
(wait)
(do @smooth-stone :take)
(wait)
(wait)
(wait)
; === PHASE 2: HACKER TRADE ===
(do @hacker :ask-about @assignment)
(wait)
(go south)
(go west)
(do @refrigerator :open)
(do @carton :take)
(do @microwave :open)
(do @carton :put @microwave)
(do @microwave :close)
(do @microwave :set-timer 300)
(do @microwave :start)
(wait)
(wait)
(wait)
(wait)
(do @microwave :open)
(do @carton :take)
(go east)
(go north)
(do @hacker :ask-about @keys)
(do @hacker :give @carton)
(do @hacker :ask-for @master-key)
; === PHASE 3: GET TOOLS & CLEAR JUNK ===
(go south)
(go down)
(go down)
(go east)
(do @gloves :take)
(do @crowbar :take)
(go west)
(go west)
(do @forklift :enter)
(do @forklift :turn-on)
(go east)
(go east)
(go east)
(do @forklift :use @junk)
(do @forklift :use @junk)
(do @forklift :use @junk)
(do @forklift :use @junk)
(do @forklift :exit)
(go east)
(do @manhole-cover :pry @crowbar)
; === PHASE 4: GET KNIFE FROM CAVE ===
(go down)
(go north)
(go down)
(do @knife :take)
(go up)
(go south)
; === PHASE 5: GREAT DOME (via aero building) ===
(go up)
(go west)
(go west)
(go west)
(go west)
(go west)
(go up)
(go south)
(wait)
(wait)
(wait)
(wait)
(wait)
(go east)
(go east)
(go up)
(do @gloves :wear)
(do @tentacle :climb)
(do @dome-door :open)
(go out)
(go up)
(do @bronze-plug :pry @crowbar)
(do @note :take)
(go down)
(go in)
; === PHASE 6: ALCHEMY LAB & RITUAL ESCAPE ===
(go down)
(go down)
(wait)
(wait)
(wait)
(wait)
(wait)
(wait)
(wait)
(wait)
(wait)
(wait)
(go east)
(go east)
(wait)
(wait)
(wait)
(wait)
(wait)
(go east)
(go east)
(go south)
(do @alchemy-door :knock)
(wait)
(go south)
(do @professor :give @note)
(go south)
(wait)
(wait)
(do @pentagram :cut @knife)
(do @pentagram :exit)
(do @lab-bench :move)
(do @alchemy-trap-door :open)
(go down)
(look)
