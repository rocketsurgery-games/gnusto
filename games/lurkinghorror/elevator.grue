; === Elevator System ===
; The CS building elevator serves 4 floors: basement (0), first (1), second (2), third (3).
; The elevator has a complex state machine handling movement, door opening/closing, and call buttons.

; === Shared Visual References ===
; One reference for all elevator doors to ensure visual consistency across rooms.

; === Elevator State ===
(def floor-names '("basement" "first floor" "second floor" "third floor"))

; Lookup tables for floor dispatch
(def floor-doors '(@elevator-door-b @elevator-door-1 @elevator-door-2 @elevator-door-3))
(def floor-rooms '(@cs-basement @comp-center @cs-2nd @cs-3rd))

; All elevator doors for iteration (interior + all exterior)
(def all-elevator-doors '(@elevator-door @elevator-door-b @elevator-door-1 @elevator-door-2 @elevator-door-3))

; === Helper Functions ===

(defn elevator-at-floor? (?floor)
  "Returns true if elevator is at the given floor"
  (= (:floor @cs-elevator-room) ?floor))

(defn elevator-here? ()
  "Returns true if elevator is at the current room's floor"
  (let ((?floor (prop (loc @player) floor)))
    (and ?floor (:stopped @cs-elevator-room) (= ?floor (:floor @cs-elevator-room)))))

(defn door-at-elevator ()
  "Returns the elevator door at the elevator's current location"
  (nth floor-doors (:floor @cs-elevator-room)))

(defn this-floor-door ()
  "Returns the elevator door at the player's current floor"
  (cond
    ((here? @cs-basement) @elevator-door-b)
    ((here? @comp-center) @elevator-door-1)
    ((here? @cs-2nd) @elevator-door-2)
    ((here? @cs-3rd) @elevator-door-3)
    ((here? @cs-elevator-room) (door-at-elevator))
    (true nil)))

; Button getters
(defn go-button-pressed? (?floor)
  (nth (:go-buttons @cs-elevator-room) ?floor))

(defn up-button-pressed? (?floor)
  (nth (:up-buttons @cs-elevator-room) ?floor))

(defn down-button-pressed? (?floor)
  (nth (:down-buttons @cs-elevator-room) ?floor))

; Button setters - update the list at a specific index
(defn set-go-button! (?floor ?val)
  (set @cs-elevator-room :go-buttons (list-set (:go-buttons @cs-elevator-room) ?floor ?val)))

(defn set-up-button! (?floor ?val)
  (set @cs-elevator-room :up-buttons (list-set (:up-buttons @cs-elevator-room) ?floor ?val)))

(defn set-down-button! (?floor ?val)
  (set @cs-elevator-room :down-buttons (list-set (:down-buttons @cs-elevator-room) ?floor ?val)))

(defn clear-all-buttons-at! (?floor)
  "Clear all button presses for a floor"
  (set-go-button! ?floor false)
  (set-up-button! ?floor false)
  (set-down-button! ?floor false))

(defn any-button-pressed? (?floor)
  "Check if any button is pressed for a floor"
  (or (go-button-pressed? ?floor)
      (up-button-pressed? ?floor)
      (down-button-pressed? ?floor)))

(defn elevator-called? ()
  "Returns true if elevator is called from any floor other than current"
  (some (fn (?f) (and (any-button-pressed? ?f) (not (= (:floor @cs-elevator-room) ?f))))
        (range 4)))

(defn should-stop-at? (?floor)
  "Check if elevator should stop at a floor based on button state and direction"
  (or (go-button-pressed? ?floor)
      (and (> (:direction @cs-elevator-room) 0) (up-button-pressed? ?floor))
      (and (< (:direction @cs-elevator-room) 0) (down-button-pressed? ?floor))))

(defn pick-direction ()
  "Determine which direction elevator should go based on pending calls"
  (cond
    ; At basement - can only go up
    ((= (:floor @cs-elevator-room) 0)
      (set @cs-elevator-room :direction 1))
    ; At top floor - can only go down
    ((= (:floor @cs-elevator-room) 3)
      (set @cs-elevator-room :direction -1))
    ; In middle - check if there are calls in current direction
    (true
      (cond
        ; Going down, check if we should reverse
        ((= (:direction @cs-elevator-room) -1)
          (cond
            ((and (= (:floor @cs-elevator-room) 1) (not (any-button-pressed? 0)))
              (set @cs-elevator-room :direction 1))
            ((and (= (:floor @cs-elevator-room) 2) (not (any-button-pressed? 0)) (not (any-button-pressed? 1)))
              (set @cs-elevator-room :direction 1))))
        ; Going up, check if we should reverse
        ((= (:direction @cs-elevator-room) 1)
          (cond
            ((and (= (:floor @cs-elevator-room) 2) (not (any-button-pressed? 3)))
              (set @cs-elevator-room :direction -1))
            ((and (= (:floor @cs-elevator-room) 1) (not (any-button-pressed? 2)) (not (any-button-pressed? 3)))
              (set @cs-elevator-room :direction -1))))))))

; === Elevator Room ===
(room @cs-elevator-room
  :description "Elevator"

  :ldesc (fn ()
    (str "This is a battered, rather dirty elevator. The fake wood walls are scratched and marred "
         "with graffiti. The elevator doors are " (if (:open @elevator-door) "open" "closed")
         ". To the right of the doors is an area with floor buttons (B and 1 through 3), "
         "an open button, a close button, a stop switch, and an alarm button. Below these is "
         "an access panel which is " (if (:open @access-panel) "open" "closed") "."))

  :rdesc "The interior of a battered, dirty 1980s elevator: scratched, graffitied fake-wood panel
  walls under fluorescent light, with a control panel of floor buttons on the right wall and the
  doors straight ahead."

  :properties (:lit true :in-elevator true
               :floor 1                                   ; Current floor (0-3)
               :direction 1                               ; Direction (1=up, -1=down)
               :stopped true                              ; Whether stopped
               :go-buttons (false false false false)      ; Interior floor buttons
               :up-buttons (false false false false)      ; Exterior up buttons
               :down-buttons (false false false false))   ; Exterior down buttons

  :exits
    ((north :to @cs-elevator-room :via @elevator-exit)
     (out :to @cs-elevator-room :via @elevator-exit))

  :behaviors ())

; Virtual barrier for exiting elevator
(object @elevator-exit
  :location @cs-elevator-room
  :description "elevator exit"
  :properties (:invisible true)
  :behaviors (
    :through (fn ()
      (cond
        ((not (:stopped @cs-elevator-room))
          (blocked :reason elevator-moving :message "The elevator is still moving."))
        ((not (:open @elevator-door))
          (blocked :reason door-closed :message "The elevator doors are closed."))
        (true (redirect :to (nth floor-rooms (:floor @cs-elevator-room))))))))

; === Interior Elevator Objects ===

; The main elevator door (interior side)
(object @elevator-door
  :description "elevator doors"
  :location @cs-elevator-room
  :properties (:nodesc true :door true :openable true)

  ; Part of the elevator interior — reuse the room's image.
  :render "cs-elevator-room"

  :behaviors (
    :examine (fn ()
      `((focus @elevator-door ,(str "The elevator doors are " (if (:open ?self) "open" "closed") ".")) (success)))
    :open (fn ()
      (redirect :action (do @open-button :push)))
    :close (fn ()
      (redirect :action (do @close-button :push)))
    :through (fn ()
      (redirect :action (go north)))))

; Open button - opens doors when stopped
(object @open-button
  :description "open button"
  :location @cs-elevator-room
  :properties (:nodesc true )
  :behaviors (
    :examine (fn ()
      '((focus @open-button "It's a white button labeled \"OPEN\".") (success)))
    :push (fn ()
      (cond
        ((not (:stopped @cs-elevator-room))
          '((narrate "The elevator is still moving. Nothing happens.") (success)))
        ((:open @elevator-door)
          '((queue elevator-door-closes 2)
            (narrate "The doors stay open.")
            (success)))
        (true
          '((set (door-at-elevator) :open true)
            (set @elevator-door :open true)
            (queue elevator-door-closes 2)
            (narrate "The doors spring open.")
            (success)))))))

; Close button - closes doors
(object @close-button
  :description "close button"
  :location @cs-elevator-room
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @close-button "It's a white button labeled \"CLOSE\".") (success)))
    :push (fn () (cond
      ((not (:stopped @cs-elevator-room))
        '((narrate "The elevator is moving, the door is closed.") (success)))
      ((not (:open @elevator-door))
        '((narrate "The door is already closed.") (success)))
      (true
        '((queue elevator-door-closes 2)
          (narrate "You push the button.")
          (success)))))))

; Floor buttons (B, 1, 2, 3)
; Shared behavior functions for individual floor buttons

(defn floor-button-examine (?button)
  (let ((?floor (prop ?button floor)))
    `((focus ,?button ,(str "The " (nth floor-names ?floor) " button is "
                          (if (go-button-pressed? ?floor) "glowing" "dark") ".")) (success))))

(defn floor-button-push (?button)
  (let ((?floor (prop ?button floor)))
    (cond
      ((= (:floor @cs-elevator-room) ?floor)
        '((narrate "The button doesn't light.") (success)))
      ((go-button-pressed? ?floor)
        '((narrate "That button is already glowing.") (success)))
      (true
        (let ((?new-buttons (list-set (:go-buttons @cs-elevator-room) ?floor true)))
          (pick-direction)  ; Sets (:direction @cs-elevator-room)
          `((set @cs-elevator-room :go-buttons ,?new-buttons)
            (queue elevator-moves 1)
            (narrate ,(str "The button for the " (nth floor-names ?floor) " begins to glow."))
            (success)))))))

; Shared behaviors for individual floor buttons
(def floor-button-behaviors
  '(:examine (fn () (floor-button-examine ?self))
    :push (fn () (floor-button-push ?self))))

(def floor-labels '("B" "1" "2" "3"))

; Generic "floor buttons" object for examining all at once
(object @floor-button
  :description "floor button"
  :location @cs-elevator-room
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      (let ((?glowing (keep (fn (?f) (if (go-button-pressed? ?f)
                                        (nth floor-labels ?f)
                                        nil))
                            (range 4))))
        (if (empty? ?glowing)
          '((focus @floor-button "The floor buttons are labeled B, 1, 2, and 3. None are glowing.") (success))
          `((focus @floor-button ,(str "The floor buttons are labeled B, 1, 2, and 3. Glowing: " (join ", " ?glowing) ".")) (success)))))))

(object @basement-button
  :description "B button"
  :location @cs-elevator-room
  :properties (:nodesc true :floor 0)
  :behaviors floor-button-behaviors)

(object @button-1
  :description "1 button"
  :location @cs-elevator-room
  :properties (:nodesc true :floor 1)
  :behaviors floor-button-behaviors)

(object @button-2
  :description "2 button"
  :location @cs-elevator-room
  :properties (:nodesc true :floor 2)
  :behaviors floor-button-behaviors)

(object @button-3
  :description "3 button"
  :location @cs-elevator-room
  :properties (:nodesc true :floor 3)
  :behaviors floor-button-behaviors)

; Alarm button - just makes noise
(object @alarm-button
  :description "alarm button"
  :location @cs-elevator-room
  :properties (:nodesc true )
  :behaviors (
    :examine (fn () '((focus @alarm-button "A red button labeled \"ALARM\".") (success)))
    :push (fn ()
      '((narrate "For as long as you hold the button down, an ear-splitting alarm bell rings.") (success)))))

; Stop switch - does nothing
(object @stop-switch
  :description "stop switch"
  :location @cs-elevator-room
  :properties (:nodesc true)
  :behaviors (
    :examine (fn () '((focus @stop-switch "A small switch labeled \"STOP\".") (success)))
    :turn (fn () '((narrate "You flip the switch, but nothing happens.") (success)))
    :turn-on (fn () '((narrate "You flip the switch, but nothing happens.") (success)))
    :turn-off (fn () '((narrate "You flip the switch, but nothing happens.") (success)))))

; Access panel
(object @access-panel
  :description "access panel"
  :location @cs-elevator-room
  :properties (
    :nodesc true
    :container true
    :searchable true
    :openable true
    :capacity 20)

  :rdesc "An elevator control panel: floor buttons (B, 1, 2, 3), open and close buttons, a stop
  switch and an alarm button, with a small access panel below."

  :behaviors (
    :examine (fn ()
      `((focus @access-panel ,(str "A small access panel in the wall. It is " (if (:open ?self) "open" "closed") ".")) (success)))))

; === Call Buttons (outside elevator on each floor) ===

; Up arrow button - calls elevator to come up
(object @up-button
  :description "up-arrow"
  :location @global  ; Visible on all elevator floors
  :properties (:nodesc true )
  :behaviors (
    :examine (fn ()
      (let ((?floor (prop (loc @player) floor)))
        (if (and ?floor (up-button-pressed? ?floor))
          '((focus @up-button "The up-arrow is glowing.") (success))
          '((focus @up-button "A white button with an up arrow.") (success)))))
    :push (fn ()
      (let ((?floor (prop (loc @player) floor)))
        (cond
          ((nil? ?floor)
            (blocked :reason no-floor :message "There's no elevator here."))
          ((up-button-pressed? ?floor)
            '((narrate "That button is already glowing.") (success)))
          ((and (:stopped @cs-elevator-room) (= ?floor (:floor @cs-elevator-room)))
            ; Elevator is here - just open the doors
            '((queue elevator-door-opens 1)
              (narrate "You push the up-arrow.")
              (success)))
          (true
            ; Call the elevator
            (let ((?new-buttons (list-set (:up-buttons @cs-elevator-room) ?floor true)))
              (pick-direction)
              `((set @cs-elevator-room :up-buttons ,?new-buttons)
                (queue elevator-moves 1)
                (narrate "The up-arrow begins to glow.")
                (success)))))))))

; Down arrow button - calls elevator to come down
(object @down-button
  :description "down-arrow"
  :location @global  ; Visible on all elevator floors
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      (let ((?floor (prop (loc @player) floor)))
        (if (and ?floor (down-button-pressed? ?floor))
          '((focus @down-button "The down-arrow is glowing.") (success))
          '((focus @down-button "A white button with a down arrow.") (success)))))
    :push (fn ()
      (let ((?floor (prop (loc @player) floor)))
        (cond
          ((nil? ?floor)
            (blocked :reason no-floor :message "There's no elevator here."))
          ((down-button-pressed? ?floor)
            '((narrate "That button is already glowing.") (success)))
          ((and (:stopped @cs-elevator-room) (= ?floor (:floor @cs-elevator-room)))
            ; Elevator is here - just open the doors
            '((queue elevator-door-opens 1)
              (narrate "You push the down-arrow.")
              (success)))
          (true
            ; Call the elevator
            (let ((?new-buttons (list-set (:down-buttons @cs-elevator-room) ?floor true)))
              (pick-direction)
              `((set @cs-elevator-room :down-buttons ,?new-buttons)
                (queue elevator-moves 1)
                (narrate "The down-arrow begins to glow.")
                (success)))))))))

; === Elevator Doors (one per floor) ===
; All doors share common behavior functions - each door has a :floor property.

(defn elevator-door-examine (?door)
  (let ((?floor (prop ?door floor))
        (?here (elevator-at-floor? ?floor)))
    `((focus ,?door ,(str "The elevator doors are " (if (:open ?door) "open" "closed") "."
                          (if (and (:open ?door) ?here) " The elevator is beyond." ""))) (success))))

(defn elevator-door-open (?door)
  (let ((?floor (prop ?door floor)))
    (cond
      ((:open ?door)
        (blocked :reason already-open :message "The doors are already open."))
      ((not (elevator-at-floor? ?floor))
        (blocked :reason elevator-not-here :message "The elevator isn't here."))
      (true
        ; Note: ?door = ?self when called from behaviors
        '((set ?self :open true)
          (set @elevator-door :open true)
          (queue elevator-door-closes 2)
          (narrate "The doors slide open.")
          (success))))))

(defn elevator-door-close (?door)
  (cond
    ((not (:open ?door))
      (blocked :reason already-closed :message "The doors are already closed."))
    (true
      ; Note: ?door = ?self when called from behaviors
      '((set ?self :open false)
        (set @elevator-door :open false)
        (narrate "The doors slide closed.")
        (success)))))

(defn elevator-door-through (?door)
  (let ((?floor (prop ?door floor)))
    (cond
      ((not (:open ?door))
        (blocked :reason door-closed :message "The elevator doors aren't open."))
      ((not (elevator-at-floor? ?floor))
        (blocked :reason elevator-not-here :message "The elevator isn't here."))
      (true
        (redirect :to @cs-elevator-room)))))

; Shared behaviors for all exterior elevator doors
(def elevator-door-behaviors
  '(:examine (fn () (elevator-door-examine ?self))
    :open (fn () (elevator-door-open ?self))
    :close (fn () (elevator-door-close ?self))
    :through (fn () (elevator-door-through ?self))))

(object @elevator-door-b
  :description "elevator doors"
  :location @cs-basement
  :properties (:door true :openable true :searchable true :container true :floor 0)
  :behaviors elevator-door-behaviors)

(object @elevator-door-1
  :description "elevator doors"
  :location @comp-center
  :properties (:door true :openable true :searchable true :container true :floor 1)
  :behaviors elevator-door-behaviors)

(object @elevator-door-2
  :description "elevator doors"
  :location @cs-2nd
  :properties (
    :door true
    :openable true
    :searchable true
    :container true
    :floor 2)

  :rdesc "Closed 1980s elevator doors of brushed metal set into a university building hallway wall."

  :behaviors elevator-door-behaviors)

(object @elevator-door-3
  :description "elevator doors"
  :location @cs-3rd
  :properties (:door true :openable true :searchable true :container true :floor 3)
  :behaviors elevator-door-behaviors)

; === Elevator Movement Events ===

; Door opens event - triggered when elevator stops at a floor
(event elevator-door-opens
  :on-turn
    (cond
      ((:open @elevator-door)
        ; Doors already open, just keep them open longer
        '((queue elevator-door-closes 2) (success)))
      (true
        ; Open the doors
        (let ((?door (door-at-elevator)))
          `((set ,?door :open true)
            (set @elevator-door :open true)
            (queue elevator-door-closes 2)
            (success :context ((description ,(if (elevator-here?) "The elevator doors slide open." nil)))))))))

; Door closes event - auto-closes doors after 2 turns
(event elevator-door-closes
  :on-turn
    (cond
      ((not (:open @elevator-door))
        ; Already closed
        (success))
      ; TODO: Check for objects wedged in door
      (true
        ; Close the doors and check if elevator should move
        (let ((?door (door-at-elevator)))
          `((set ,?door :open false)
            (set @elevator-door :open false)
            ,@(if (elevator-called?) '((queue elevator-moves 1)) '())
            (success :context ((description ,(if (elevator-here?) "The elevator doors slide closed." nil)))))))))

; Main elevator movement event
(event elevator-moves
  :on-turn
    (cond
      ; Don't move if any door is open
      ((some (fn (?d) (:open ?d)) all-elevator-doors)
        '((queue elevator-moves 1) (success)))

      ; Starting to move from stopped
      ((:stopped @cs-elevator-room)
        (cond
          ((not (elevator-called?))
            ; Nothing to do
            (success))
          (true
            ; Start moving - pick direction first (side effect)
            (pick-direction)
            `((set @cs-elevator-room :stopped false)
              (queue elevator-moves 1)
              (success :context ((description ,(if (here? @cs-elevator-room)
                                                   (str "The elevator begins to move " (if (> (:direction @cs-elevator-room) 0) "upward" "downward") ".")
                                                   (if (prop (loc @player) floor) "You hear the elevator begin moving." nil)))))))))

      ; Elevator is moving
      (true
        (let ((?new-loc (+ (:floor @cs-elevator-room) (:direction @cs-elevator-room)))
              ; True direction of THIS move, captured before pick-direction's
              ; lookahead can flip :direction for the next leg.
              (?moving-up (> (:direction @cs-elevator-room) 0))
              (?new-go-buttons (list-set (:go-buttons @cs-elevator-room) (+ (:floor @cs-elevator-room) (:direction @cs-elevator-room)) false))
              (?new-up-buttons (list-set (:up-buttons @cs-elevator-room) (+ (:floor @cs-elevator-room) (:direction @cs-elevator-room)) false))
              (?new-down-buttons (list-set (:down-buttons @cs-elevator-room) (+ (:floor @cs-elevator-room) (:direction @cs-elevator-room)) false)))
          ; Pick direction based on updated state (side effect for now)
          (pick-direction)

          ; Check if we should stop at this floor
          (cond
            ((should-stop-at? ?new-loc)
              ; Stop at this floor, clear button states
              (let ((?was-go (go-button-pressed? ?new-loc)))
                `((set @cs-elevator-room :floor ,?new-loc)
                  (set @cs-elevator-room :go-buttons ,?new-go-buttons)
                  (set @cs-elevator-room :up-buttons ,?new-up-buttons)
                  (set @cs-elevator-room :down-buttons ,?new-down-buttons)
                  (set @cs-elevator-room :stopped true)
                  (queue elevator-door-opens 1)
                  (success :context ((description ,(if (here? @cs-elevator-room)
                                                       (str "The elevator slows and comes to a stop."
                                                            (if ?was-go
                                                              (str " The button for the " (nth floor-names ?new-loc) " blinks off.")
                                                              ""))
                                                       (if (prop (loc @player) floor)
                                                         "You no longer hear the elevator moving."
                                                         nil))))))))
            (true
              ; Keep moving. Give the player feedback even when they're waiting
              ; on a floor -- especially when the car passes their floor without
              ; stopping (the elevator scan can send it the "wrong" way first).
              (let ((?player-floor (prop (loc @player) floor)))
                `((set @cs-elevator-room :floor ,?new-loc)
                  (queue elevator-moves 1)
                  (success :context ((description ,(cond
                                                     ((here? @cs-elevator-room)
                                                       (str "The elevator continues to move " (if ?moving-up "upward" "downward") "."))
                                                     ((nil? ?player-floor) nil)
                                                     ((= ?new-loc ?player-floor)
                                                       (str "The elevator passes your floor, still heading " (if ?moving-up "up" "down") "."))
                                                     (true "You hear the elevator moving.")))))))))))))
