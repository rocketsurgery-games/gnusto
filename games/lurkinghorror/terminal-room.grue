(room @terminal-room
  :description "Terminal Room"
  :ldesc "This is a large room crammed with computer terminals, small computers, and printers. An exit leads south.
  Banners, posters, and signs festoon the walls. Most of the tables are covered with waste paper, old pizza boxes, and
  empty Coke cans. There are usually a lot of people here, but tonight it's almost deserted."
  :flags (ONBIT)
  :exits
    ((south :to @cs-2nd :via @hacker-exit-barrier)
     (out :to @cs-2nd :via @hacker-exit-barrier))

  :behaviors (
    ; Room entry handler - ZIL TERMINAL-ROOM-F with RARG? ENTER
    ; Triggers when player wakes from nightmare and returns here
    :on-enter (fn (?from-room)
      (cond
        ; Waking from nightmare - player fell asleep on platform, wakes at terminal
        ((= ?from-room @platform-room)
          '((queue hacker-helps)
            (set hacker-help 0)
            (success :context ((nightmare-wake true))
                     :message "You are awakened by the thump of your head hitting the keyboard.")))
        (true (success))))

    ; Room-level action interception
    ; ZIL TERMINAL-ROOM-F with RARG? BEG
    :before-action (fn (?verb ?target)
      (cond
        ; === HACKER HELPING ===
        ; When hacker is helping with PC, block certain actions on screen objects
        ((and (queued? hacker-helps)
              (or (= ?verb "click") (= ?verb "rub") (= ?verb "point") (= ?verb "help"))
              (or (= ?target "@menu-box") (= ?target "@more-box")))
          (blocked :reason hacker-interference
                   :context ((blocker @hacker))
                   :message "\"Who's the hacker here?\" he snarls."))

        ; === COMPULSION (POSSESSION) ===
        ; When possessed, override most player actions
        ; Allow: click/rub/point/push/attack on @more-box, read @odd-paper
        ; Everything else gets redirected to touching the MORE box
        ((and (queued? compulsion)
              ; These are allowed to proceed
              (not (and (or (= ?verb "click") (= ?verb "rub") (= ?verb "point") (= ?verb "push") (= ?verb "attack"))
                        (= ?target "@more-box")))
              (not (and (= ?verb "read") (= ?target "@odd-paper"))))
          (blocked :reason possessed
                   :compelled true
                   :forced-target @more-box
                   :message "Instead, you find your finger moving towards the MORE box, and you touch it. The screen feels oddly cold."))

        ; Default - allow action to proceed
        (true (default))))))

; === Barriers ===

(object @hacker-exit-barrier
  :location @terminal-room
  :description "passage"
  :flags (INVISIBLE)
  :behaviors (
    :through (fn ()
      (cond
        ((or (held? @pc) (held? @chair))
          (blocked :reason tech-property
                   :context ((blocker @hacker))
                   :message "You can't walk off with that! It's Tech property!"))
        (true
          (success))))))

; === Events ===

; Room action behaviors translated to:
; - Hacker blocks PC actions during helping: @pc :turn-off, :unplug + room :before-action
; - Compulsion event forces player to read: compulsion event + room :before-action
; - Exit barrier: @hacker-exit-barrier :through behavior
; - Room entry from @platform-room: :on-enter triggers nightmare wake-up

; I-HACKER-HELPS: Multi-stage cutscene when hacker helps with PC
; Queued by :help behavior, advances each turn player is in terminal-room
(event hacker-helps
  (def stage1-desc "The hacker wanders over, trying to look nonchalant. \"Losing, huh?\" he asks wittily. He glances at your terminal, which displays a pattern of snow and unusual characters. He appears somewhat excited.")
  (def stage2-desc "The hacker, mumbling under his breath, begins a flurry of activity. First the screen returns to something nearly normal, then windows begin popping up like toadstools after a rain.")
  (def stage3-desc "The hacker types furiously. After a while he says, \"Chomping file system. Your directory has gone seriously west. I fixed it.\" He checks the screen. \"It was mixed up on the file server with some files from the Department of Alchemy.\" He grunts. \"People's names for their nodes are getting weird. This one is called 'Lovecraft.'\" He pauses. \"Your paper is gone, though. Sorry. Maybe they could help you down there.\"")
  (def stage4-desc "The hacker wanders back to his terminal and returns to his hacking.")

  (defn stage (n desc)
    (success
      :effects ((inc! hacker-help))
      :stage n
      :description desc))

  :location @terminal-room
  :on-turn (condp = hacker-help
    0 (stage 1 stage1-desc)
    1 (stage 2 stage2-desc)
    2 (stage 3 stage3-desc)
    (success
      :effects ((dequeue! hacker-helps) (move! @hacker @terminal-room))
      :stage 4
      :description stage4-desc)))

; I-FOOD-HINT: Hints about feeding the hacker (re-queues itself)
; Queued when player asks for something and hasn't fed hacker yet
(event food-hint
  (defn hint (msg)
    (success
      :effects ((inc! food-hint) (queue! food-hint 2))
      :context ((hint msg))))

  :location @terminal-room
  :on-turn (condp = food-hint
    1 (hint "I could stand a little snack, though.")
    2 (hint "I don't know where I can get something to eat, what with all the snow.")
    3 (hint "I'd hate to leave, with the machines so empty. On the other hand, I'm seriously starving.")
    4 (success
        :effects ((set! food-hint 0) (dequeue! food-hint))
        :context ((hint "Why don't you see if you can cons up some food? Then I might be able to do something for you.")))
    (success :effects ((dequeue! food-hint)))))

; I-COMPULSION: Possession event - player is compelled to read the odd paper
; Triggered by reading @odd-paper. Advances through 4 pages of disturbing content,
; then teleports player to @yuggoth (nightmare realm). Player cannot resist.
(event compulsion
  (def page1-desc "The paper appears to be a facsimile overlaid with occasional typescript. The text is mostly in a sort of \"Olde English\" you've never seen before. What you read is a combination of incomprehensible gibberish, latinate pseudowords, debased Hebrew and Arabic scripts, and an occasional disquieting phrase in English.")
  (def page2-desc "The second page is much like the first, but around the edges, not when you look at it straight, it's almost readable. There is something about a \"summoning,\" or a \"visitor.\"")
  (def page3-desc "The third page is in the same script as the first, but laid out like a poem. There are woodcut illustrations which are queasily disturbing.\n\nThere is a translation, or notes for one, typed between the lines of the poem:\n\n\"He returns, he is called back (?)\nThe loyal ones (acolytes?) make a sacrifice\nThose who survive will meet him (be absorbed? eaten?)\nThey will live, yet die\nForever will be (is?) nothing to them (to him?)\n\n\"His place (lair? burrow?) must be prepared\nHis food (offerings?) must be prepared\nCall him forth (invite him?) with great power\nOnly an acceptable (tasteful?) sacrifice will call him forth\nHe will be grateful (satiated?)\"\n\nThe rest is even more fragmentary.")
  (def page4-desc "The fourth page is a photograph. You try to recoil from the screen, but cannot. Fascinated and repelled at the same time, you wonder: is that a mouth, and what is in it?")

  (defn read-page (p desc)
    (success
      :effects ((inc! comp-cnt) (set-prop! @odd-paper read-page true))
      :page p
      :description desc))

  :location @terminal-room
  :on-turn (condp = comp-cnt
    0 (read-page 1 page1-desc)
    1 (read-page 2 page2-desc)
    2 (read-page 3 page3-desc)
    3 (success
        :effects ((inc! comp-cnt) (dequeue! compulsion)
                  (move! @more-box nil) (move! @menu-box @pc)
                  (move! @player @yuggoth))
        :page 4
        :description page4-desc
        :transition "You faint, and when you awaken...")
    (success :effects ((dequeue! compulsion)))))

