; terminal-room - Starting location for The Lurking Horror
;
; This is a minimal world file for testing the @terminal-room
; and @hacker-exit-barrier behavior.

(world
  :name "Terminal Room Test"
  :description "Test world for @terminal-room conversion")

; === Globals ===
; State variables for hacker interactions
(globals
  :hacker-trade false   ; Set when player proposes food-for-key trade
  :lair-cnt 0           ; Possession counter (0-7+) - affects hacker responses
  :hacker-help 0        ; Help stage counter (0-4) for I-HACKER-HELPS
  :food-hint 0          ; Food hint counter for I-FOOD-HINT
  :comp-cnt 0)          ; Compulsion page counter (0-4) for I-COMPULSION

; === Turn-Based Events ===

; I-HACKER-HELPS: Multi-stage cutscene when hacker helps with PC
; Queued by :help behavior, advances each turn player is in terminal-room
(event hacker-helps
  :location @terminal-room
  :on-turn (cond
    ((= hacker-help 0)
      (success
        :effects ((inc! hacker-help))
        :context ((stage 1)
                  (description "The hacker wanders over, trying to look nonchalant. \"Losing, huh?\" he asks wittily. He glances at your terminal, which displays a pattern of snow and unusual characters. He appears somewhat excited."))))
    ((= hacker-help 1)
      (success
        :effects ((inc! hacker-help))
        :context ((stage 2)
                  (description "The hacker, mumbling under his breath, begins a flurry of activity. First the screen returns to something nearly normal, then windows begin popping up like toadstools after a rain."))))
    ((= hacker-help 2)
      (success
        :effects ((inc! hacker-help))
        :context ((stage 3)
                  (description "The hacker types furiously. After a while he says, \"Chomping file system. Your directory has gone seriously west. I fixed it.\" He checks the screen. \"It was mixed up on the file server with some files from the Department of Alchemy.\" He grunts. \"People's names for their nodes are getting weird. This one is called 'Lovecraft.'\" He pauses. \"Your paper is gone, though. Sorry. Maybe they could help you down there.\""))))
    (true
      (success
        :effects ((dequeue! hacker-helps) (move! @hacker @terminal-room))
        :context ((stage 4)
                  (description "The hacker wanders back to his terminal and returns to his hacking."))))))

; I-FOOD-HINT: Hints about feeding the hacker (re-queues itself)
; Queued when player asks for something and hasn't fed hacker yet
(event food-hint
  :location @terminal-room
  :on-turn (cond
    ((= food-hint 1)
      (success
        :effects ((inc! food-hint) (queue! food-hint 2))
        :context ((hint "I could stand a little snack, though."))))
    ((= food-hint 2)
      (success
        :effects ((inc! food-hint) (queue! food-hint 2))
        :context ((hint "I don't know where I can get something to eat, what with all the snow."))))
    ((= food-hint 3)
      (success
        :effects ((inc! food-hint) (queue! food-hint 2))
        :context ((hint "I'd hate to leave, with the machines so empty. On the other hand, I'm seriously starving."))))
    ((>= food-hint 4)
      (success
        :effects ((set! food-hint 0) (dequeue! food-hint))
        :context ((hint "Why don't you see if you can cons up some food? Then I might be able to do something for you."))))
    (true
      (success :effects ((dequeue! food-hint))))))

; I-COMPULSION: Possession event - player is compelled to read the odd paper
; Triggered by reading @odd-paper. Advances through 4 pages of disturbing content,
; then teleports player to @yuggoth (nightmare realm). Player cannot resist.
(event compulsion
  :location @terminal-room
  :on-turn (cond
    ; Page 1: First glimpse of the strange text
    ((= comp-cnt 0)
      (success
        :effects ((inc! comp-cnt) (queue! compulsion 1) (set-prop! @odd-paper read-page true))
        :context ((page 1)
                  (description "The paper appears to be a facsimile overlaid with occasional typescript. The text is mostly in a sort of \"Olde English\" you've never seen before. What you read is a combination of incomprehensible gibberish, latinate pseudowords, debased Hebrew and Arabic scripts, and an occasional disquieting phrase in English."))))
    ; Page 2: Hints of summoning
    ((= comp-cnt 1)
      (success
        :effects ((inc! comp-cnt) (queue! compulsion 1) (set-prop! @odd-paper read-page true))
        :context ((page 2)
                  (description "The second page is much like the first, but around the edges, not when you look at it straight, it's almost readable. There is something about a \"summoning,\" or a \"visitor.\""))))
    ; Page 3: The poem/ritual
    ((= comp-cnt 2)
      (success
        :effects ((inc! comp-cnt) (queue! compulsion 1) (set-prop! @odd-paper read-page true))
        :context ((page 3)
                  (description "The third page is in the same script as the first, but laid out like a poem. There are woodcut illustrations which are queasily disturbing.\n\nThere is a translation, or notes for one, typed between the lines of the poem:\n\n\"He returns, he is called back (?)\nThe loyal ones (acolytes?) make a sacrifice\nThose who survive will meet him (be absorbed? eaten?)\nThey will live, yet die\nForever will be (is?) nothing to them (to him?)\n\n\"His place (lair? burrow?) must be prepared\nHis food (offerings?) must be prepared\nCall him forth (invite him?) with great power\nOnly an acceptable (tasteful?) sacrifice will call him forth\nHe will be grateful (satiated?)\"\n\nThe rest is even more fragmentary."))))
    ; Page 4: The photograph - triggers nightmare transport
    ((= comp-cnt 3)
      (success
        :effects ((inc! comp-cnt) (dequeue! compulsion)
                  (move! @more-box nil) (move! @menu-box @pc)
                  (move! @player @yuggoth))
        :context ((page 4)
                  (description "The fourth page is a photograph. You try to recoil from the screen, but cannot. Fascinated and repelled at the same time, you wonder: is that a mouth, and what is in it?")
                  (transition "You faint, and when you awaken..."))))
    ; Default - shouldn't happen but dequeue to be safe
    (true
      (success :effects ((dequeue! compulsion))))))

; === Player ===

(object @player
  :location @terminal-room
  :flags (PERSON))

; === Rooms ===

; Room action behaviors translated to:
; - Hacker blocks PC actions during helping: @pc :turn-off, :unplug + room :before-action
; - Compulsion event forces player to read: compulsion event + room :before-action
; - Exit barrier: @hacker-exit-barrier :through behavior
;
; NOT YET IMPLEMENTED:
; - Room entry from @platform-room (wake from nightmare, queue hacker-helps)

(room @terminal-room
  :description "Terminal Room"
  :ldesc "This is a large room crammed with computer terminals, small computers, and printers. An exit leads south.
  Banners, posters, and signs festoon the walls. Most of the tables are covered with waste paper, old pizza boxes, and
  empty Coke cans. There are usually a lot of people here, but tonight it's almost deserted."
  :flags (ONBIT)
  :exits
    ((south :to @cs-2nd :via @hacker-exit-barrier)
     (out :to @cs-2nd :via @hacker-exit-barrier))

  :behaviors (
    ; Room-level action interception
    ; ZIL TERMINAL-ROOM-F with RARG? BEG
    :before-action (fn (?verb ?target)
      (cond
        ; === HACKER HELPING ===
        ; When hacker is helping with PC, block certain actions on screen objects
        ((and (queued? hacker-helps)
              (in? ?verb (click rub point help))
              (in? ?target (@menu-box @more-box)))
          (blocked :reason hacker-interference
                   :context ((blocker @hacker))
                   :message "\"Who's the hacker here?\" he snarls."))

        ; === COMPULSION (POSSESSION) ===
        ; When possessed, override most player actions
        ; Allow: click/rub/point/push/attack on @more-box, read @odd-paper
        ; Everything else gets redirected to touching the MORE box
        ((and (queued? compulsion)
              ; These are allowed to proceed
              (not (and (in? ?verb (click rub point push attack)) (= ?target @more-box)))
              (not (and (= ?verb read) (= ?target @odd-paper))))
          (blocked :reason possessed
                   :context ((compelled true) (forced-target @more-box))
                   :message "Instead, you find your finger moving towards the MORE box, and you touch it. The screen feels oddly cold."))

        ; Default - allow action to proceed
        (true (default))))))

(room @cs-2nd
  :description "Second Floor"
  :ldesc "This is the second floor of the CS building."
  :flags (ONBIT)
  :exits
    ((north :to @terminal-room)))

; Stub for nightmare realm - player is teleported here by compulsion event
; Full definition would be in converted/rooms.grue
(room @yuggoth
  :description "Nightmare Realm"
  :ldesc "You find yourself in a dark, alien landscape. The geometry is wrong - angles that shouldn't exist, shadows that move against the light."
  :flags ()
  :exits ())

; === Objects ===

(object @pc
  :description "pc"
  :fdesc "A really whiz-bang pc is right inside the door."
  :location @terminal-room
  :flags (TAKEBIT TRYTAKEBIT OPENBIT CONTBIT SEARCHBIT SURFACEBIT)
  :properties (:size 30 :unplugged false)

  :behaviors (
    ; EXAMINE - Show PC description with power state and screen contents
    :examine (fn ()
      (cond
        ((has-flag ?self POWER)
          (success :context ((power on) (screen-contents (first-in ?self)))
                   :message "This is a beyond-state-of-the-art personal computer. It has a 1024 by 1024 pixel color monitor, a mouse, an attached hard disk, and a local area network connection. Fortunately, one of its features is a prominent HELP key."))
        (true
          (success :context ((power off))
                   :message "This is a beyond-state-of-the-art personal computer. It has a 1024 by 1024 pixel color monitor, a mouse, an attached hard disk, and a local area network connection. Fortunately, one of its features is a prominent HELP key. It is currently turned off."))))

    ; LISTEN - Hums when powered on
    :listen (fn ()
      (cond
        ((has-flag ?self POWER)
          (success :message "It hums contentedly."))
        (true
          (blocked :reason not-powered :message "It's silent."))))

    ; TAKE - When hacker helps, redirect to unplug; otherwise auto-unplug
    :take (fn ()
      (cond
        ((queued? hacker-helps)
          (redirect :action (do @pc :unplug)
                    :context ((hacker-blocks true))))
        ((prop ?self unplugged)
          (default))  ; Normal take when already unplugged
        ((has-flag ?self POWER)
          ; Taking while on: turn off and unplug
          (success :effects ((clear-flag! ?self POWER) (set-prop! ?self unplugged true) (move! ?self ?actor))
                   :context ((auto-unplug true) (was-powered true))
                   :message "You take it, turning it off and unplugging it first."))
        (true
          ; Taking while off but plugged in: just unplug
          (success :effects ((set-prop! ?self unplugged true) (move! ?self ?actor))
                   :context ((auto-unplug true))
                   :message "You take it, unplugging it first."))))

    ; PUT-ON / PUT - Not a good surface
    :put-on (fn (?item)
      (cond
        (true
          (blocked :reason not-a-surface :message "That's not a good surface for that."))))

    ; READ - Show screen contents
    :read (fn ()
      (cond
        ((and (queued? hacker-helps) (< (prop @player hacker-help-stage) 3))
          (blocked :reason hacker-working :message "There's nothing recognizable on the screen."))
        ((not (has-flag ?self POWER))
          (blocked :reason not-powered :message "The screen is dark."))
        ; Check for objects on screen (in PC container)
        ((in? @odd-paper ?self)
          (redirect :action (do @odd-paper :read)))
        ((in? @menu-box ?self)
          (redirect :action (do @menu-box :read)))
        ((in? @more-box ?self)
          (redirect :action (do @more-box :read)))
        ((in? @yak-window ?self)
          (redirect :action (do @yak-window :read)))
        (true
          (blocked :reason nothing-on-screen :message "There's nothing to read on the screen now."))))

    ; TURN-ON (LAMP-ON) - Power up computer
    :turn-on (fn ()
      (cond
        ((prop ?self unplugged)
          (blocked :reason unplugged :message "It's unplugged. You should plug it in first."))
        ((has-flag ?self POWER)
          (blocked :reason already-on :message "It's on. Maybe you didn't notice."))
        (true
          (success :effects ((set-flag! ?self POWER))
                   :context ((booting true))
                   :message "The computer powers up, goes through a remarkably fast self-check, and greets you, requesting a login. The only sound you hear is a very low hum."))))

    ; TURN-OFF (LAMP-OFF) - Power down computer
    :turn-off (fn ()
      (cond
        ((queued? hacker-helps)
          (blocked :reason hacker-interference
                   :context ((blocker @hacker))
                   :message "The hacker stops you. \"You'll mung the bits, chomper!\""))
        ((not (has-flag ?self POWER))
          (blocked :reason already-off :message "It's already off."))
        (true
          (success :effects ((clear-flag! ?self POWER))
                   :message "The computer powers off."))))

    ; PLUG-IN - Plug in computer
    :plug-in (fn ()
      (cond
        ((not (prop ?self unplugged))
          (blocked :reason already-plugged :message "It's already plugged in."))
        (true
          (success :effects ((set-prop! ?self unplugged false))
                   :message "You plug in the computer."))))

    ; UNPLUG - Unplug computer
    :unplug (fn ()
      (cond
        ((prop ?self unplugged)
          (blocked :reason already-unplugged :message "It's already unplugged."))
        ((queued? hacker-helps)
          (blocked :reason hacker-interference
                   :context ((blocker @hacker))
                   :message "The hacker stops you. \"You'll mung the bits, chomper!\""))
        ((has-flag ?self POWER)
          ; Unplug while on: turn off first
          (success :effects ((clear-flag! ?self POWER) (set-prop! ?self unplugged true))
                   :context ((was-powered true))
                   :message "Okay, it's unplugged now."))
        (true
          (success :effects ((set-prop! ?self unplugged true))
                   :message "Okay, it's unplugged now."))))

    ; SIT-AT - Redirect to sitting in chair if present
    :sit-at (fn ()
      (cond
        ((here? @chair)
          (redirect :action (do @chair :sit)))
        (true
          (blocked :reason no-chair :message "There's no chair here."))))))

(object @chair
  :description "chair"
  :fdesc "Nearby is one of those ugly molded plastic chairs."
  :location @terminal-room
  :flags (TAKEBIT VEHBIT SEARCHBIT CONTBIT OPENBIT FURNITURE SURFACEBIT)
  :properties (:size 100)

  :behaviors (
    :examine (fn ()
      (cond
        (true
          (success :message "It's a molded plastic chair, a cheap knock-off of a designer chair, and even more uncomfortable."))))

    :take (fn ()
      (cond
        ((in? @hacker @chair)
          (blocked :reason in-use :message "It's in use."))
        (true
          (default))))

    :sit (fn ()
      (cond
        ((in? @hacker @chair)
          (blocked :reason occupied :message "The hacker is already using it."))
        ((in? ?actor @chair)
          (blocked :reason already-there :message "You are."))
        (true
          (success :effects ((move! ?actor @chair)) :message "You are now sitting in the chair."))))

    :stand (fn ()
      (cond
        ((in? ?actor @chair)
          (success :effects ((move! ?actor (loc @chair))) :message "You get out of the chair."))
        (true
          (blocked :reason not-in-vehicle :message "You're not in the chair."))))))

