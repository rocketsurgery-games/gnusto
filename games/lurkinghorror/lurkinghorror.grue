(world
  :name "The Lurking Horror"
  :description "Conversion of Infocom's _The Lurking Horror_ to FrotzLM / Grue"

  :intro "You've waited until the last minute again. This time it's the end of the term, so all the
  TechNet terminals in the dorm are occupied. So, off you go to the old Comp Center. Too bad it's
  the worst storm of the winter (Murphy's Law, right?), and you practically froze to death slogging
  over here from the dorm. Not to mention jumping at every shadow, what with all the recent
  disappearances. Time to find a free machine, get to work, and write that twenty page paper."

  :player @player

  ; Visual style for all generated illustrations (graphic-novel horror).
  :visual-style (
      :prompt "Style: broad alla prima brush strokes, suitable only as a rough mockup for a human
      artist, but little detail."

      :palette "desaturated dark blues and teals, sickly fluorescent greens, warm incandescent highlights"

      ; Structured swatches: the single source of the colour identity. Drives both
      ; the web chrome (CSS --game-* vars) and the art briefs (filfre), so the
      ; generated art and the UI can't drift apart.
      :swatches (:bg "#080d10" :panel "#101c22" :panel-2 "#16262d"
                 :ink "#04070a" :line "#2c4650"
                 :accent "#8fe06a" :accent-glow "#c4ff8a" :warm "#e6a45c"
                 :paper "#e7e0cd" :paper-ink "#1b1813"
                 :text "#dbe6e3" :text-dim "#8aa0a0")

      ; Default aspect ratio
      :aspect-ratio "1:1"

      ; Per-kind specialization. :prompt is additive over the base style;
      ; :aspect-ratio overrides the default. Rooms breathe as wide establishing
      ; stages; objects/characters are isolated on a flat black field so every
      ; variant (and every object) composites consistently into the dark UI.
      :kinds (:room   (:aspect-ratio "16:9"
                       :prompt "Wide establishing shot of the empty location; environment only, no people, cinematic framing with room to breathe.")
              :object (:prompt "A single subject, centered, isolated on a flat pure-black background; no scene, no props, no floor, even studio lighting."))))


; Victory: Defeat the Frob
; The frob starts at nil (limbo), appears at @inner-lair when the mass is electrocuted,
; and goes back to nil when defeated. We check count>=2 to distinguish "defeated" from "not yet
; appeared".
(victory :when (and (= (loc @frob) nil) (>= (:count @frob) 2)))

; Defeat: Player dies (marked by :dead property)
(defeat death
  :when (:dead @player)
  :context ((message "You have died.")))

(object @player
  :location @terminal-room
  :properties (
    :person true
    :dead false
    :freeze-count 0
    :score 0
    :moves 0))
