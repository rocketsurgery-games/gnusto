(object @hacker
  :description "hacker"
  :location @terminal-room

  ; TODO: Deal with different states the hacker can be in.
  :render "hacker.png"

  :properties (
    :searchable true
    :person true
    :open true
    :container true
    :trade false
    :lair-cnt 0
    :help-stage 0
    :food-hint 0
    :comp-cnt 0
  )

  (def hacker-desc "The hacker sits comfortably on an office chair facing a terminal table,
    or perhaps it's just a pile of old listings as tall as a terminal table. He is typing madly,
    using just two fingers, but achieves speeds that typists using all ten fingers only dream of.
    He is apparently debugging a large assembly language program, as the screen of his terminal
    looks like a spray of completely random characters. The hacker is dressed in blue jeans,
    an old work shirt, and what might once have been running shoes. Hanging from his belt is an
    enormous ring of keys. He is in need of a bath.")

  :behaviors (
    :describe (fn () (cond
      ((here? @terminal-room) '((success "Sitting at a terminal is a hacker whom you recognize.")))
      ((here? @inner-lair)    '((success "A muddy, scratched-up hacker stands tiredly here.")))
      (true '((success "A hacker is here.")))))

    :examine (fn () (cond
      ((here? @inner-lair) '((success "He's muddy, wet, and tired looking.")))
      (true                `((success ,hacker-desc))))) ; Normal state - at his own terminal

    :smell (fn () '((success "Either the hacker, his clothing, or both are in need of cleaning.")))
    :listen (fn () '((success "He is humming something. It sounds classical, perhaps Bach?")))

    :thank (fn () (cond
      ((held? @master-key) '((narrate "He blushes.") (success "player has master key")))
      (true                '((success)))))

    ; ?item is the object being shown to the hacker
    :show (fn (?item) (cond
      ; Show food
      ((:food ?item) '((say @hacker "Winnage! I could do with some of that.") (success "shown food")))

      ; Show specific items
      ((= ?item @smooth-stone)  '((say @hacker "Odd-looking thing. Are you a rock-jock?") (success "shown stone")))
      ((= ?item @hand)          '((say @hacker "Mondo grosso!") (success "shown hand")))
      ((= ?item @dead-rat)      '((say @hacker "I have enough of those in my basement. Get rid of it!") (success "shown rat")))
      (true                     '((narrate "He more or less grunts at you, but shows little interest in it.") (success "shown item")))))

    ; ?item is the object being given to the hacker
    :give (fn (?item) (cond
      ; Give overcooked chinese food
      ((and (= ?item @carton) (in? @chinese-food @carton) (:rmung @chinese-food))
        '((move @carton nil)
          (say @hacker "Ouch! This is ridiculous! You've overcooked it. Look at those poor shrimp! It's ruined, chomper!")
          (narrate "He throws it away.")
          (success "gave overcooked food")))

      ; Give hot chinese food (heat >= 12) - if trade was proposed, loan the key
      ((and (= ?item @carton) (in? @chinese-food @carton) (>= (prop @chinese-food heat) 12) (:trade @hacker))
        '((move @carton @hacker)
          (move @chinese-food nil)
          (set @hacker :trade false)
          (move @master-key ?actor)
          (say @hacker "Ah! Serious food!")
          (narrate "He plunges into the food with all the delicacy and table manners of a shark at a feeding frenzy. Soon a satisfied expression appears on his face.")
          (say @hacker "Well, I suppose I could loan you the master key for a while. Just don't get into trouble, okay? I'll find you later, when I'm done with all this, and get it back.")
          (narrate "He hands you the key.")
          (success "gave hot food, traded for key")))

      ; Give hot chinese food (heat >= 12) - no trade proposed
      ((and (= ?item @carton) (in? @chinese-food @carton) (>= (prop @chinese-food heat) 12))
        '((move @carton @hacker)
          (move @chinese-food nil)
          (say @hacker "Ah! Serious food!")
          (narrate "He plunges into the food with all the delicacy and table manners of a shark at a feeding frenzy. Soon a satisfied expression appears on his face.")
          (say @hacker "Now, what was it you were wanting?")
          (success "gave hot food")))

      ; Give cold chinese food
      ((and (= ?item @carton) (in? @chinese-food @carton) (= (prop @chinese-food heat) 0))
        '((say @hacker "Yuck! This is cold!")
          (narrate "He thrusts it back into your hands.")
          (blocked "food is cold")))

      ; Give lukewarm chinese food
      ((and (= ?item @carton) (in? @chinese-food @carton))
        '((say @hacker "Yuck! This isn't warm enough!")
          (narrate "He thrusts it back into your hands.")
          (blocked "food is lukewarm")))

      ; Give snack (not eaten)
      ((and (= ?item @snack) (not (:rmung @snack)))
        '((move @snack @hacker)
          (say @hacker "Hey, thanks!")
          (narrate "He stuffs it down in no time.")
          (say @hacker "I could really do with some Chinese food, though.")
          (success "gave snack")))

      ; Give coke
      ((= ?item @coke)
        '((say @hacker "I only drink Diet Coke.")
          (say @hacker "I could really do with some Chinese food, though.")
          (blocked "hacker only drinks diet coke")))

      ; Default give
      (true '((say @hacker "No thanks, keep it for now.") (blocked "hacker not interested")))))

    ; "trade food for key" - sets up the trade, food must be given afterward
    ; ?offer is what player is offering, ?want is what player wants
    :trade (fn (?offer ?want) (cond
      ; Valid trade: food for key (either direction)
      ((or (and (= ?offer @chinese-food) (= ?want @master-key))
           (and (= ?offer @carton) (= ?want @master-key))
           (and (= ?offer @master-key) (= ?want @chinese-food))
           (and (= ?offer @master-key) (= ?want @carton)))
        '((set @hacker :trade true)
          (say @hacker "You give me the food first.")
          (success "trade proposed")))

      ; Invalid trade
      (true '((say @hacker "That's not a good trade.") (blocked "bad trade")))))

    ; Player asking hacker for things
    ; ?item is the object being requested
    :ask-for (fn (?item) (cond
      ; Ask for keyring (with carton given - slightly different wording)
      ((and (= ?item @keyring) (in? @carton @hacker))
        '((say @hacker "Well, I can't give you all my keys, I need them.")
          (narrate "He fondles his keyring proudly.")
          (blocked "hacker needs his keys")))

      ; Ask for keyring (without carton given)
      ((= ?item @keyring)
        '((say @hacker "Well, I can't give you my keys, I need them.")
          (narrate "He fondles his keyring proudly.")
          (blocked "hacker needs his keys")))

      ; Ask for master key - key not visible (suspicious)
      ((and (= ?item @master-key) (not (:touched @master-key)))
        '((say @hacker "Who said anything about any master keys?")
          (narrate "he asks suspiciously.")
          (blocked "master key not yet revealed")))

      ; Ask for master key - player already fed hacker (loan it)
      ((and (= ?item @master-key) (in? @carton @hacker))
        '((set @hacker :trade false)
          (move @master-key ?actor)
          (say @hacker "Well, I suppose I could loan you the master key for a while. Just don't get into trouble, okay? I'll find you later, when I'm done with all this, and get it back.")
          (narrate "He hands you the key.")
          (success "hacker loaned master key")))

      ; Ask for master key - no food given yet
      ((= ?item @master-key)
        '((say @hacker "Fat chance! This is a master key! What have you done for me lately?")
          (blocked "hacker wants food first")))

      ; Ask for other keys
      ((:key ?item)
        '((say @hacker "Those are boring old keys. They don't open anything interesting.")
          (blocked "hacker won't give boring keys")))

      ; Ask for anything else
      (true '((say @hacker "I don't have that.") (blocked "hacker doesn't have item")))))

    :hello (fn () (cond
      ((here? @terminal-room) '((say @hacker "Greetingage.") (narrate "He turns back to his hacking.") (success "greeted")))
      (true                   '((say @hacker "Greetingage.") (success "greeted")))))

    ; ?topic is the thing being asked about
    :ask-about (fn (?topic :entity) (cond
      ; Possessed state (lair-cnt > 6) - he's not himself
      ((> (:lair-cnt @hacker) 6)
        '((say @hacker "Meld!") (success "possessed state")))
      ((= ?topic @hacker)
        '((narrate "He's reluctant to boast.") (success "asked about himself")))

      ; About keys/keyring - reveals master key!
      ((or (= ?topic @keyring) (= ?topic @keys))
        '((set @master-key :touched true)
          (move @master-key @keyring)
          (say @hacker "I've accumulated a few keys over the years. I'm a licensed locksmith, which helps. I can get into any room at Tech.")
          (narrate "He pulls the keyring out on its chain, and shows off a key you hadn't noticed before.")
          (say @hacker "This is a master key.")
          (success "revealed master key")))

      ; About food
      ((or (= ?topic @chinese-food) (= ?topic @snack) (= ?topic @food))
        '((say @hacker "Yeah! I'd love some yummy Chinese food. Szechuan style. Ummm!") (success "asked about food")))

      ; About the master key - depends on whether it's been revealed (TOUCHBIT)
      ((and (= ?topic @master-key) (not (:touched @master-key)))
        '((say @hacker "Who said anything about any master keys?")
          (narrate "he asks suspiciously.")
          (success "asked about unrevealed key")))
      ((= ?topic @master-key)
        '((say @hacker "That's one of my best keys. It's a Tech master key. Not that it really opens every door at Tech, but I'd say three out of five, at least. Naturally, some labs are off-limits even to this key.")
          (success "asked about master key")))

      ; About missing students
      ((= ?topic @students)
        '((say @hacker "Missing students? I knew one of them slightly. Not the sort who would go away, you know? He was sort of hackeresque, not dumb for an undergrad, either. Not the type to disappear.")
          (success "asked about students")))

      ; About the program/PC - state dependent on hacker-help global
      ((or (= ?topic @program) (= ?topic @pc))
        '((say @hacker "You should consult the documentation.")
          (narrate "He's preoccupied with his own debugging.")
          (success "asked about program")))

      ; About Lovecraft
      ((= ?topic @lovecraft)
        '((say @hacker "Wasn't he a fantasy author?") (success "asked about lovecraft")))

      ; About the smooth stone
      ((= ?topic @smooth-stone)
        '((say @hacker "I've never seen one like that. Pretty tasteful, I'd say.") (success "asked about stone")))

      ; About urchins
      ((= ?topic @urchins)
        '((say @hacker "There are always urchins around. I remember one or two who became hackers.") (success "asked about urchins")))

      ; About repeater/cable (offers to help)
      ((or (= ?topic @repeater) (= ?topic @cable))
        '((say @hacker "I'll fix it!") (success "asked about repeater")))

      ; Default - doesn't know
      (true '((narrate "The hacker studiously ignores you, loath to admit there is something he doesn't know about.") (success "asked about unknown")))))

    :tell-about (fn (?topic)
      (redirect :action (do @hacker :ask-about ?topic)))

    :follow (fn () (cond
      ((here? @inner-lair) '((say @hacker "I'm here, aren't I?") (success "already here")))
      (true                '((say @hacker "I haven't got time. I have new versions of the system, the assembler, the editor, and the debugger to finish hacking.")
                             (blocked "hacker is busy")))))

    :help (fn () (cond
      ; Already helping
      ((queued? hacker-helps)
        '((say @hacker "I'm looking at it. Be patient. This isn't some little micro. We're on a hairy OS on a hairy net.")
          (success "already helping")))

      ; Already helped (help-stage >= 3 means stage 3 was reached)
      ((>= (:help-stage @hacker) 3)
        '((say @hacker "I already looked at it. The bug is fixed in the sources. Your paper is gone, unless those Alchemy chompers have a copy.")
          (success "already helped")))

      ; In terminal room - start helping
      ((= (loc ?actor) @terminal-room)
        '((queue hacker-helps)
          (set @hacker :help-stage 0)
          (say @hacker "Be patient!")
          (success "started helping")))

      ; Not in terminal room
      (true '((say @hacker "Help? I'm not a T.A. I've got work to do.") (blocked "hacker is busy")))))

    :attack (fn () '((narrate "The hacker retreats.") (say @hacker "I know karate!") (narrate "he says, somewhat unconvincingly.") (blocked "hacker retreats")))
    :kill (fn () '((narrate "The hacker retreats.") (say @hacker "I know karate!") (narrate "he says, somewhat unconvincingly.") (blocked "hacker retreats")))))

