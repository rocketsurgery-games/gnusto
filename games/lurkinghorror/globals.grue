; === Global Objects ===
; These objects are always accessible regardless of location.
; From globals.zil - The Lurking Horror

; ============================================================
; PLAYER BODY PARTS
; ============================================================

(object @hands
  :description "your hands"
  :location @global  ; Always accessible
  :properties (:nodesc true :tool true :touched true )
  :behaviors (
    :examine (fn ()
      '((focus @hands "They're still attached to your wrists.") (success)))
    :default (fn (?verb)
      (cond
        ((= ?verb :rub)
          '((narrate "You rub your hands together for warmth.") (success)))
        (true (default))))))

(object @feet
  :description "your feet"
  :location @global
  :properties (:nodesc true :tool true :touched true )
  :behaviors (
    :examine (fn ()
      '((focus @feet "They're at the ends of your legs, as usual.") (success)))))

(object @head
  :description "your head"
  :location @global
  :properties (:nodesc true )
  :behaviors (
    :examine (fn ()
      '((focus @head "It's on your shoulders.") (success)))))

(object @eyes
  :description "your eyes"
  :location @global
  :properties (:nodesc true )
  :behaviors (
    :open (fn ()
      '((narrate "They are.") (success)))
    :close (fn ()
      '((narrate "That won't help.") (success)))))

(object @me
  :description "yourself"
  :location @global
  :properties (:nodesc true :person true :touched true )
  :behaviors (
    :examine (fn ()
      ; TODO: V-DIAGNOSE - show status/health
      '((focus @me "You look tired but determined.") (success)))
    :listen (fn ()
      '((narrate "Yes?") (success)))
    :wake (fn ()
      '((narrate "You already are.") (success)))
    :follow (fn ()
      '((narrate "You're getting ahead of yourself.") (success)))
    :look-behind (fn ()
      (cond
        ((< (random 100) 80)
          '((narrate "You look back over your shoulder. There's nothing there.") (success)))
        ((< (random 100) 80)
          '((narrate "You look back over your shoulder. Was that a flicker of movement in the distance?") (success)))
        (true
          '((narrate "You look back over your shoulder. You see something duck back into the shadows.") (success)))))))

; ============================================================
; ENVIRONMENTAL GLOBALS
; ============================================================

(object @light
  :description "light"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :turn-on (fn ()
      (cond
        ((:lit (loc (player)))
          '((narrate "It's already light.") (success)))
        (true
          (blocked :reason no-source :message "You need a light source!"))))
    :turn-off (fn ()
      (blocked :reason waste :message "That would be a waste of time."))))

(object @ceiling
  :description "ceiling"
  :location @global
  :properties (:nodesc true :touched true)
  :behaviors (
    :look-under (fn ()
      ; In ZIL this redirects to V-LOOK; we just return success since look is special
      '((narrate "You look around the room.") (success)))))

(object @air
  :description "air"
  :location @global
  :properties (:nodesc true))
  ; No :examine - falls through to default "You see nothing special about the air."

(object @ground
  :description "floor"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @ground "It's still there.") (success)))
    :look-under (fn ()
      '((narrate "You never did master X-rays. Freshman physics was such a drag.") (success)))
    :climb (fn ()
      (blocked :reason waste :message "That would be a waste of time."))))

(object @dirt
  :description "dirt"
  :location @global
  :properties (:nodesc true))
  ; No :examine - falls through to default "You see nothing special about the dirt."

(object @corridor
  :description "passage"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :through (fn ()
      ; V-WALK-AROUND in ZIL
      '((narrate "Walking around reveals nothing new. To move elsewhere, just type the desired direction.") (success)))
    :walk-to (fn ()
      '((narrate "Walking around reveals nothing new. To move elsewhere, just type the desired direction.") (success)))))

(object @noise
  :description "noise"
  :location @global
  :properties (:nodesc true)
  ; No :examine - falls through to default "You see nothing special about the noise."
  :behaviors (
    :listen (fn ()
      '((narrate "You listen carefully.") (success)))))

(object @snow
  :description "snow"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      (cond
        ((:outside (loc (player)))
          '((focus @snow "It's still coming down.") (success)))
        (true
          '((focus @snow "You are inside.") (success)))))))

; ============================================================
; WALLS
; ============================================================

(object @wall
  :description "wall"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @wall "It looks like a wall.") (success)))
    :push (fn ()
      (blocked :reason solid :message "You can't pull down a wall that easily."))
    :pull (fn ()
      (blocked :reason solid :message "You can't pull down a wall that easily."))))

(object @north-wall
  :description "north wall"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @north-wall "It looks like a wall.") (success)))
    :default (fn (?verb)
      (redirect :action (do @wall ?verb)))))

(object @south-wall
  :description "south wall"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @south-wall "It looks like a wall.") (success)))
    :default (fn (?verb)
      (redirect :action (do @wall ?verb)))))

(object @east-wall
  :description "east wall"
  :location @global
  :properties (:nodesc true )
  :behaviors (
    :examine (fn ()
      '((focus @east-wall "It looks like a wall.") (success)))
    :default (fn (?verb)
      (redirect :action (do @wall ?verb)))))

(object @west-wall
  :description "west wall"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @west-wall "It looks like a wall.") (success)))
    :default (fn (?verb)
      (redirect :action (do @wall ?verb)))))

; ============================================================
; ROOM / LOCATION REFERENCE
; ============================================================

(object @global-room
  :description "room"
  :location @global
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      ; In ZIL this redirects to V-LOOK
      '((focus @global-room "You look around the room.") (success)))
    :look-inside (fn ()
      '((narrate "You look around the room.") (success)))
    :leave (fn ()
      ; Would need movement redirect - not supported yet
      (blocked :reason need-direction :message "Which way do you want to go?"))
    :exit (fn ()
      (blocked :reason need-direction :message "Which way do you want to go?"))
    :turn-on (fn ()
      ; "turn on room" -> "turn on light"
      (redirect :action (do @light :turn-on)))))

(object @global-hole
  :description "hole"
  :location @global
  :properties (:nodesc true :touched true)
  :behaviors (
    :reach-in (fn ()
      '((narrate "You find nothing of interest.") (success)))))

; ============================================================
; SLEEP
; ============================================================

(object @global-sleep
  :description "sleep"
  :location @global
  :properties (:nodesc true )
  :behaviors (
    :take (fn ()
      ; "take sleep" -> "sleep"
      (redirect :action (sleep)))
    :walk-to (fn ()
      ; "go to sleep" -> "sleep"
      (redirect :action (sleep)))
    :find (fn ()
      '((narrate "Sleep anywhere.") (success)))))
