(room MUDDY-TUNNEL
  :description "Muddy Tunnel"
  :ldesc "The tunnel you came through continues down, barely large enough to
enter. It is made of sticky gelatinous mud that's been pushed by
something into a semblance of a passage."
  :exits
    (
      (down :to LARGE-CHAMBER)
      (east :to TUNNEL-ENTRANCE)
      (up :to TUNNEL-ENTRANCE)
    )
)

(room NUTRITION-BLDG
  :description "Fruits and Nuts"
  :ldesc "This is the central corridor of the
Nutrition Building. The main building is south, and a stairway leads
down."
  :flags (ONBIT)
  :exits
    (
      (down :to BROWN-TUNNEL)
      (south :to INF-5)
    )
)

; [NEEDS-TRANSLATION] Room ON-DOME: ACTION ON-DOME-F
(room ON-DOME
  :description "On the Great Dome"
  :ldesc "This is the very top of the Great Dome, a favorite place for Tech
fraternities to install cows, Volkswagen Beetles, giant birthday candles,
and other bizarre objects. The top is flat, round, and about five feet
in diameter. It's very windy, which has kept the snow from
accumulating here. The only way off is down."
  :flags (ONBIT OUTSIDE)
  :exits
    (
      (down :to DOME-ROOF)
    )

  ; --- Room ACTION Routine ---
  ; <ROUTINE ON-DOME-F (RARG)
  ;   <COND
  ;       (<RARG? ENTER> <TELL
  ;         ,YOU-SCRAMBLE-UP
  ;         "icy surface of the dome, almost slipping a few
  ;   times, but finally you make it to the top."
  ;         CR
  ;         CR>)
  ;       (<RARG? BEG> <COND
  ;         (<AND <VERB? WALK> <NOT
  ;           <EQUAL? ,P-WALK-DIR ,P?DOWN>>> <TELL "There is nowhere to go but down." CR>)
  ;         (ELSE <ROOF-BEGS>)>)>
  ; >
  ; --- End Room ACTION Routine ---
)

