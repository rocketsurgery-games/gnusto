; PC Tests


(test-group "take/drop"

  (test "take PC"
    (do @pc :take)
    (assert (outcome? success))
    (assert (held? @pc)))

  (test "cannot take non-takeable object"
    (do @hacker :take)
    (assert (outcome? blocked))
    (assert (reason? not-takeable)))

  (test "drop PC"
    :setup ((move! @pc @player))
    (do @pc :drop)
    (assert (outcome? success))
    (assert (loc? @pc @terminal-room)))

  (test "cannot drop object not held"
    (do @pc :drop)
    (assert (outcome? blocked))
    (assert (reason? not-held)))
)
