; === Tests for Brown Building and Great Dome areas ===
; Tests room connectivity, hand puzzle, and tentacle climb.

; === Room Connectivity Tests ===


(test "brown-building connects to courtyard"
  :setup ((move! @player @brown-building))
  (go :direction south)
  (assert (outcome? success))
  (assert (player-at? @courtyard)))

(test "brown-building connects to top-floor via stairs"
  :setup ((move! @player @brown-building))
  (go :direction up)
  (assert (outcome? success))
  (assert (player-at? @brown-top-floor)))

(test "roof-door blocks access when locked"
  :setup ((move! @player @brown-top-floor) (set @roof-door :locked true) (set @roof-door :open false))
  (go :direction west)
  (assert (outcome? blocked))
  (assert (reason? locked)))

(test "can unlock roof-door with master key"
  :setup ((move! @player @brown-top-floor) (set @roof-door :locked true) (move! @master-key @player))
  (do @roof-door :unlock @master-key)
  (assert (outcome? success))
  (assert (no-flag? @roof-door locked)))

(test "can access roof after unlocking door"
  :setup ((move! @player @brown-top-floor) (set @roof-door :locked false) (set @roof-door :open true))
  (go :direction west)
  (assert (outcome? success))
  (assert (player-at? @brown-roof)))

(test "tub search reveals mummified hand"
  :setup ((move! @player @inside-dome) (set @mummified-hand :touched false) (move! @mummified-hand nil))
  (do @tub :search)
  (assert (outcome? success))
  (assert (:touched @mummified-hand))
  (assert (loc? @mummified-hand @tub)))

(test "second search finds nothing"
  :setup ((move! @player @inside-dome) (set @mummified-hand :touched true))
  (do @tub :search)
  (assert (outcome? success)))

(test "hand has tattoo"
  :setup ((move! @mummified-hand @player))
  (do @tattoo :examine)
  (assert (loc? @tattoo @mummified-hand)))

(test "flier can be driven away with smooth-stone"
  :setup ((move! @player @brown-roof) (move! @flier @brown-roof) (move! @smooth-stone @player))
  (do @flier :attack @smooth-stone)
  (assert (outcome? success))
  (assert (loc? @flier nil)))

(test "flier eats hand when given"
  :setup ((move! @player @inside-dome) (move! @flier @inside-dome) (move! @mummified-hand @player))
  (do @flier :give @mummified-hand)
  (assert (outcome? success))
  (assert (loc? @mummified-hand nil))
  (assert (loc? @flier nil)))

(test "flier blocks exit from dome"
  :setup ((move! @player @inside-dome) (move! @flier @inside-dome))
  (go :direction out)
  (assert (outcome? blocked))
  (assert (reason? flier-blocks)))

(test "cannot climb tentacle without gloves - burns"
  :setup ((move! @player @great-dome) (set @tentacle :invisible false) (set @gloves :wearable false))
  (go :direction up)
  (assert (outcome? blocked))
  (assert (reason? burns)))

(test "can climb tentacle with gloves"
  :setup ((move! @player @great-dome) (set @tentacle :invisible false) (set @gloves :wearable true))
  (go :direction up)
  (assert (outcome? success))
  (assert (player-at? @top-of-dome)))

(test "creature flees when reaching top-of-dome"
  :setup ((move! @player @great-dome) (set @tentacle :invisible false) (set @dome-ladder :touched false) (move! @dome-ladder nil) (move! @gloves @player) (set @gloves :wornbit true))
  (go :direction up)
  (assert (outcome? success))
  (assert (player-at? @top-of-dome))
  (assert (:invisible @tentacle))
  (assert (:touched @dome-ladder))
  (assert (loc? @dome-ladder @top-of-dome)))

(test "bronze plug starts in socket"
  :setup ((set @bronze-plug :rmung false))
  (do @bronze-plug :examine)
  (assert (loc? @bronze-plug @on-dome)))

(test "prying plug reveals secret hole"
  :setup ((move! @player @on-dome) (set @bronze-plug :rmung false) (move! @secret-hole nil))
  (do @bronze-plug :pry nil)
  (assert (outcome? success))
  (assert (:rmung @bronze-plug))
  (assert (loc? @secret-hole @on-dome)))

(test "note is in secret hole"
  :setup ()
  (do @note :examine)
  (assert (loc? @note @secret-hole)))

(test "can rub peach tree"
  :setup ((move! @player @inside-dome))
  (do @peach-tree :rub)
  (assert (outcome? success)))

(test "can't attack peach tree"
  :setup ((move! @player @inside-dome) (move! @axe @player))
  (do @peach-tree :attack @axe)
  (assert (outcome? blocked))
  (assert (reason? vandalism)))

(test "giving smooth-stone to flier makes it edge away"
  :setup ((move! @player @brown-roof) (move! @flier @brown-roof) (move! @smooth-stone @player))
  (do @flier :give @smooth-stone)
  (assert (outcome? success))
  (assert (loc? @flier @brown-roof)))

(test "throwing non-stone item at flier dodges"
  :setup ((move! @player @brown-roof) (move! @flier @brown-roof) (move! @carton @player))
  (do @flier :throw @carton)
  (assert (outcome? success))
  (assert (loc? @carton @brown-roof)))
