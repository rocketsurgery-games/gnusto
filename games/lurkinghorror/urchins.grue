; === Urchins & Underground Tunnels ===
; From frob.zil - The Lurking Horror
; The muddy tunnels below steam tunnels, and the urchin encounters.
;
; Rooms:
;   @muddy-tunnel - Narrow muddy passage leading down
;   @large-chamber - Wide spot with slots containing urchins
;
; Key puzzles:
;   - Show/give mummified hand to individual urchin -> he drops bolt cutters and flees
;   - Cut urchin-wire with bolt cutters -> frees urchins, they collapse and stop blocking
;   - Urchins block passage down to lair until freed

; === Rooms ===

(room @muddy-tunnel
  :description "Muddy Tunnel"
  :ldesc "The tunnel you came through continues down, barely large enough to enter. It is made of sticky gelatinous mud that's been pushed by something into a semblance of a passage."
  :exits
    ((up :to @tunnel-entrance)
     (east :to @tunnel-entrance)
     (down :to @large-chamber))
  :visible (@lair-pool))

(room @large-chamber
  :description "Large Chamber"
  :exits
    ((up :to @muddy-tunnel)
     (down :to @lair-1 :via @urchins-barrier))
  :visible (@global-hole)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (str "This is a wide spot in the tunnel, just as wet and muddy as elsewhere. The walls are slimy as well. Numerous slots or indentations about two feet wide and a foot high open here and there. "
               (cond
                 ((:freed @urchins)
                   "Stubs of the wire still enter each of the slots.")
                 ((in? @urchins @slots)
                   "Thin, wire or ropelike growths emerge from a hole further down and enter each of the slots. There is background noise here, almost loud enough to hear clearly.")
                 ((= (loc @urchins) @large-chamber)
                   (str "Thin, wire or ropelike growths emerge from a hole further down and envelop the head of each urchin. The urchins are "
                        (if (:freed @urchins)
                          "catatonic."
                          "saying or chanting something repetitive and monotonal, almost machinelike.")))
                 (true
                   "There is a hole leading down.")))))))))

; === Urchins Barrier (blocks passage to lair) ===

(object @urchins-barrier
  :location @large-chamber
  :description "urchins"
  :properties (:invisible true)
  :behaviors (
    :through (fn ()
      (cond
        ((:freed @urchins)
          '((narrate "A few of the urchins grab feebly at you as you pass, but none is a serious barrier.") (success)))
        ((in? @urchins @slots)
          (blocked :reason blocked
                   :message "Something is blocking the downward passage. It's moving, slowly and painfully, trying to climb up."))
        (true
          (blocked :reason blocked
                   :message "The urchins lurch, almost as one, into your way, grabbing at you feebly but effectively. Their pale, limp hands can't grab you, but they can stop you. There is no way past."))))))

; === Slots (container for urchins) ===

(object @slots
  :location @large-chamber
  :description "slots"
  :properties (:nodesc true :open true :container true)
  :behaviors (
    :examine (fn ()
      `((focus @slots
          ,(str "The slots are narrow burrows apparently dug by hand out of the mud of the chamber walls."
               (if (in? @urchins @slots)
                 " Most of the slots have a thin wire or rope heading into them. You begin to be quite certain that there is something moving inside the slot you are looking at."
                 "")))
        (success)))

    :enter (fn ()
      `((narrate
          ,(str "You squeeze your way into one of the slots. The mud coats you with a cold, slimy coat which makes it barely possible to breathe."
               (if (in? @urchins @slots)
                 " You are about halfway in when your hands touch something fleshy in front of you. It's cold and dead. On the other hand, it moves."
                 "")
               " You slide out with all the speed you can muster."))
        (success)))

    :look-inside (fn ()
      '((narrate "You can't see anything but the wet walls of the burrow.") (success)))

    :reach-in (fn ()
      (cond
        ((not (in? @urchins @slots))
          '((narrate "There is nothing in the slots but cold, wet mud.") (success)))
        (true
          '((narrate "You reach inside, oblivious to the cold clammy mud. At first you feel nothing, but just at the limit of your stretch, you feel flesh. It's cold and dead. You jerk your hand back out.") (success)))))

    :listen (fn ()
      (cond
        ((in? @urchins @slots)
          '((narrate "The noise, as you listen more carefully, resolves itself into voices. They are chanting, but the words are unknown to you.") (success)))
        (true
          '((narrate "You hear nothing.") (success)))))))

; === Urchins (group in large chamber) ===

(object @urchins
  :location @slots  ; Start in slots, emerge later
  :description "urchins"
  :properties (:invisible true :person true :freed false)  ; Start invisible in slots

  :behaviors (
    :describe (fn ()
      (cond
        ((in? ?self @slots)
          (success))  ; Don't describe when in slots
        (true
          (success :context ((description "There are urchins here."))))))

    :examine (fn ()
      `((focus @urchins
          ,(str "These are not normal looking urchins. Their clothes are muddy and tattered. They are barefoot in midwinter, and covered with mud. Around their heads are draped the "
               (if (:freed @urchins) "stubs of the " "")
               "ropy growths that you've been noticing in this area. Although their eyes are open, they stare catatonically."))
        (success)))

    :talk-to (fn ()
      (cond
        ((:freed @urchins)
          '((narrate "There is no response. It's as though they don't hear you.") (success)))
        (true
          '((narrate "The urchins turn to you in unison. They smile, revealing red, broken teeth. They never stop their deep-voiced, incomprehensible chant.") (success)))))

    :attack (fn ()
      '((narrate "They ignore you.") (success)))

    :search (fn ()
      '((narrate "They ignore you.") (success)))

    :wake (fn ()
      '((narrate "They seem quite awake.") (success)))

    :listen (fn ()
      '((narrate "The strange chant never stops. They don't move their lips to make it. It resonates deep within their chests.") (success)))

    :give (fn (?item)
      '((narrate "They ignore your offer, caught up in something only they can sense.") (success)))))

; === Urchin Wire (controls urchins, can be cut) ===

(object @urchin-wire
  :location @large-chamber
  :description "wire"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @urchin-wire "These are thin, fibrous, ropy growths. They look very tough.") (success)))

    :follow (fn ()
      `((narrate
          ,(str "They go from the "
               (if (in? @urchins @slots) "slots" "urchins")
               " down the tunnel."))
        (success)))

    :cut (fn (?tool)
      (cond
        ((or (not ?tool) (= ?tool nil))
          (blocked :reason need-tool :message "You'll need something to cut with."))
        ((= ?tool @bolt-cutters)
          `((set @urchins :freed true)
            (set @urchins :invisible false)
            (move @urchins @large-chamber)
            (move @urchin-wire nil)
            (narrate ,(str "You strain and push the two handles of the bolt cutter together with all your strength. At first it looks like nothing will happen, but then, with a loud click, the jaws cut the wire!\n\nThe wire, as though under tension, rapidly begins to curl up, disappearing down the tunnel and away. "
                           (if (in? @urchins @slots)
                             "Urchins burst forth from the slots. "
                             "")
                           "The effect on the urchins is electric (perhaps literally). They twitch, jerk spasmodically, and fall to the ground almost in unison. They have lost all interest in you."))
            (success)))
        ((or (:weapon ?tool) (:tool ?tool))
          '((narrate "That drives the wire into the mud, but doesn't cut it.") (success)))
        (true
          (blocked :reason wrong-tool :message "That won't cut through this wire."))))))

; === Individual Urchin (wanders around, has bolt cutters) ===

(object @urchin
  :location @aero-lobby  ; Starts in aero lobby
  :description "urchin"
  :properties (:person true :searchable true :open true :container true :rmung false)
  :behaviors (
    :describe (fn ()
      (success :context
        ((description "Slouching nearby is an urchin. He's a youngish teenager wearing a ski hat, running shoes, and a bulky, suspiciously bumpy, threadbare parka. He's jumpy, and looks suspiciously at you."))))

    :examine (fn ()
      '((focus @urchin "This is an urchin. He's a youngish teenager wearing a ski hat, running shoes, and a bulky, suspiciously bumpy, threadbare parka. He's jumpy, and looks suspiciously at you.") (success)))

    :smell (fn ()
      '((narrate "He smells damp. There is also a slight odor of fast food.") (success)))

    :talk-to (fn ()
      '((say @urchin "I don't hafta say anything. I ain't done nothing.")
        (narrate "He seems very nervous about talking to you.")
        (success)))

    :ask-about (fn (?topic)
      (cond
        ((= ?topic @urchin)
          '((say @urchin "I just came in to get out of the snow. I wouldn't come in here if it wasn't snowing.")
            (narrate "He seems very nervous about talking to you.")
            (success)))
        ((= ?topic @urchins)
          '((say @urchin "The word is out on the street, man. Don't go to Tech, or you're gonna be gone, ya know? I wouldn't be here myself if I had a warm place to go.")
            (narrate "He seems very nervous about talking to you.")
            (success)))
        (true
          '((narrate "He doesn't reply. He seems very nervous about talking to you.") (success)))))

    :attack (fn ()
      (cond
        ((not (:rmung @urchin))
          '((set @urchin :rmung true)
            (narrate "The urchin backs off, and then draws a very large switchblade out of his parka. He waves it menacingly at you.")
            (success)))
        (true
          '((narrate "The urchin laughs in your face, fending you off with his switchblade.") (success)))))

    ; Show/give mummified hand -> urchin drops bolt cutters and flees
    :give (fn (?item)
      (cond
        ((and (= ?item @mummified-hand) (:person @mummified-hand))
          ; Hand is "alive" (twitching) - this scares the urchin
          '((move @urchin nil)
            (set @bolt-cutters :invisible false)
            (move @bolt-cutters (loc @player))
            (narrate "The urchin sees the hand twitching.")
            (say @urchin "I heard what happens around here! I'm not gettin' fed to a monster!")
            (narrate "He lets loose a scream of fear and zooms away. Something drops from beneath his parka as he departs. He slows for a moment, decides not to retrieve it, and is quickly out of sight.")
            (success)))
        (true
          '((say @urchin "You expect me to believe garbage like that?")
            (narrate "the urchin sneers. He seems very nervous about talking to you.")
            (success)))))

    :show (fn (?item)
      ; Same as give for the hand
      (cond
        ((and (= ?item @mummified-hand) (:person @mummified-hand))
          (redirect :action (do @urchin :give ?item)))
        (true
          '((narrate "The urchin glances at it suspiciously but shows no interest. He seems very nervous about talking to you.") (success)))))))

; === Urchin Clothes (for examining) ===

(object @urchin-clothes
  :location @urchin
  :description "clothes"
  :properties (:nodesc true :trytake true :takeable true)
  :behaviors (
    :examine (fn ()
      '((focus @urchin-clothes "It bulges in odd places.") (success)))

    :take (fn ()
      (blocked :reason refused :message "\"Hey! Keep off, sucker!\""))

    :search (fn ()
      (blocked :reason refused :message "\"Hey! Keep off, sucker! You can't scare me!\""))))

; === Bolt Cutters (in urchin, starts invisible) ===

(object @bolt-cutters
  :location @urchin
  :description "bolt cutters"
  :properties (:invisible true :takeable true :tool true :weapon true :size 10)

  :behaviors (
    :examine (fn ()
      '((focus @bolt-cutters "This is a heavy duty bolt or chain cutter, standard equipment for local bicycle thieves. It will defeat any but the heaviest bicycle chains.") (success)))

    :cut (fn (?target)
      (cond
        ((not ?target)
          '((narrate "What do you want to cut?") (success)))
        (true
          ; Let the target object handle cutting
          (redirect :action (do ?target :cut @bolt-cutters)))))))

; Note: @lair-1 and the full lair maze are defined in lair.grue
