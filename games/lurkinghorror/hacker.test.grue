; Hacker Tests
; Tests for conversation, giving, and trading with the hacker.

; =============================================================================
; CONVERSATION - ask-about
; =============================================================================


(test-group "ask-about"

  (test "about keys reveals master key"
    (do @hacker :ask-about @keys)
    (assert (outcome? success))
    (assert (:touched @master-key)))

  (test "about keys again - already revealed"
    :setup ((set @master-key :touched true))
    (do @hacker :ask-about @keys)
    (assert (outcome? success)))

  (test "about food"
    (do @hacker :ask-about @food)
    (assert (outcome? success)))

  (test "when possessed - responds with Meld"
    :setup ((set-prop! @hacker lair-cnt 7))
    (do @hacker :ask-about @keys)
    (assert (outcome? success)))
)

(test-group "give items"

  (test "give snack - accepted"
    :setup ((move! @snack @player))
    (do @hacker :give @snack)
    (assert (outcome? success))
    (assert (loc? @snack @hacker)))

  (test "give coke - rejected"
    :setup ((move! @coke @player))
    (do @hacker :give @coke)
    (assert (outcome? blocked))
    (assert (reason? "hacker only drinks diet coke")))
)

(test-group "trade"

  (test "propose food for key"
    (do @hacker :trade @carton @master-key)
    (assert (outcome? success))
    (assert (prop? @hacker trade true)))

  (test "propose bad trade - rejected"
    (do @hacker :trade @coke @master-key)
    (assert (outcome? blocked))
    (assert (reason? "bad trade")))
)

(test-group "ask-for"

  (test "master key - not revealed yet"
    (do @hacker :ask-for @master-key)
    (assert (outcome? blocked))
    (assert (reason? "master key not yet revealed")))

  (test "master key - revealed but no quid pro quo"
    :setup ((set @master-key :touched true))
    (do @hacker :ask-for @master-key)
    (assert (outcome? blocked))
    (assert (reason? "hacker wants food first")))
)
