; Kitchen & Microwave Tests
; Tests for the food puzzle - heating chinese food to trade with the hacker.

; =============================================================================
; NAVIGATION
; =============================================================================



(test-group "navigation"
  :setup ((move! @player @cs-2nd))

  (test "can go from cs-2nd to kitchen"
    (go :direction west)
    (assert (outcome? success))
    (assert (player-at? @kitchen)))

  (test "can go from kitchen to cs-2nd"
    :setup ((move! @player @kitchen))
    (go :direction east)
    (assert (outcome? success))
    (assert (player-at? @cs-2nd)))
)

(test-group "refrigerator"
  :setup ((move! @player @kitchen))

  (test "starts closed"
    (do @refrigerator :examine)
    (assert (outcome? success))
    (assert (not (:open @refrigerator))))

  (test "can open"
    (do @refrigerator :open)
    (assert (outcome? success))
    (assert (:open @refrigerator)))

  (test "can take carton when open"
    :setup ((set @refrigerator :open true))
    (do @carton :take)
    (assert (outcome? success))
    (assert (held? @carton)))

  (test "can read sign"
    (do @refrigerator :read)
    (assert (outcome? success)))

  (test "can't look inside when closed"
    (do @refrigerator :look-inside)
    (assert (outcome? blocked)))

  (test "can look inside when open"
    :setup ((set @refrigerator :open true))
    (do @refrigerator :look-inside)
    (assert (outcome? success)))
)

(test-group "microwave open/close"
  :setup ((move! @player @kitchen))

  (test "starts closed"
    (do @microwave :examine)
    (assert (outcome? success))
    (assert (not (:open @microwave))))

  (test "can open"
    (do @microwave :open)
    (assert (outcome? success))
    (assert (:open @microwave)))

  (test "can close"
    :setup ((set @microwave :open true))
    (do @microwave :close)
    (assert (outcome? success))
    (assert (not (:open @microwave))))

  (test "can't open when already open"
    :setup ((set @microwave :open true))
    (do @microwave :open)
    (assert (outcome? blocked)))

  (test "can't close when already closed"
    (do @microwave :close)
    (assert (outcome? blocked)))
)

(test-group "microwave set-timer"
  :setup ((move! @player @kitchen))

  (test "set to 2 minutes"
    (do @microwave :set-timer 120)
    (assert (outcome? success))
    (assert (prop? @microwave timer 120)))

  (test "set to 30 seconds"
    (do @microwave :set-timer 30)
    (assert (outcome? success))
    (assert (prop? @microwave timer 30)))

  (test "can't set over 1 hour"
    (do @microwave :set-timer 3601)
    (assert (outcome? blocked)))
)

(test-group "microwave set-temp"
  :setup ((move! @player @kitchen))

  (test "set to high"
    (do @microwave :set-temp high)
    (assert (outcome? success))
    (assert (prop? @microwave temp 4)))

  (test "set to medium"
    (do @microwave :set-temp medium)
    (assert (outcome? success))
    (assert (prop? @microwave temp 3)))

  (test "set to low"
    (do @microwave :set-temp low)
    (assert (outcome? success))
    (assert (prop? @microwave temp 2)))

  (test "set to warm"
    (do @microwave :set-temp warm)
    (assert (outcome? success))
    (assert (prop? @microwave temp 1)))

  (test "can't change while running"
    :setup ((queue! microwave-running))
    (do @microwave :set-temp high)
    (assert (outcome? blocked)))
)

(test-group "microwave start/stop/clear"
  :setup ((move! @player @kitchen))

  (test "can start with timer set"
    :setup ((set-prop! @microwave timer 120))
    (do @microwave :start)
    (assert (outcome? success))
    (assert (queued? microwave-running)))

  (test "start defaults temp to high"
    :setup ((set-prop! @microwave timer 120) (set-prop! @microwave temp 0))
    (do @microwave :start)
    (assert (outcome? success))
    (assert (prop? @microwave temp 4)))

  (test "can't start without timer"
    (do @microwave :start)
    (assert (outcome? blocked)))

  (test "can't start with door open"
    :setup ((set-prop! @microwave timer 120) (set @microwave :open true))
    (do @microwave :start)
    (assert (outcome? blocked)))

  (test "can't start when already running"
    :setup ((queue! microwave-running))
    (do @microwave :start)
    (assert (outcome? blocked)))

  (test "can stop running"
    :setup ((queue! microwave-running))
    (do @microwave :stop)
    (assert (outcome? success))
    (assert (not-queued? microwave-running)))

  (test "can't stop when already stopped"
    (do @microwave :stop)
    (assert (outcome? blocked)))

  (test "clear resets timer"
    :setup ((set-prop! @microwave timer 120))
    (do @microwave :clear)
    (assert (outcome? success))
    (assert (prop? @microwave timer 0)))

  (test "can't clear while running"
    :setup ((queue! microwave-running))
    (do @microwave :clear)
    (assert (outcome? blocked)))
)

(test-group "microwave safety interlock"
  :setup ((move! @player @kitchen))

  (test "opening door stops running microwave"
    :setup ((queue! microwave-running))
    (do @microwave :open)
    (assert (outcome? success))
    (assert (:open @microwave))
    (assert (not-queued? microwave-running)))
)

(test-group "microwave-running event"
  :setup ((move! @player @kitchen) (queue! microwave-running))

  (test "decrements timer by 60"
    :setup ((set-prop! @microwave timer 180))
    (wait)
    (assert (outcome? success))
    (assert (prop? @microwave timer 120))
    (assert (queued? microwave-running)))

  (test "stops when timer reaches 0"
    :setup ((set-prop! @microwave timer 60))
    (wait)
    (assert (outcome? success))
    (assert (prop? @microwave timer 0))
    (assert (not-queued? microwave-running)))

  (test "heats chinese food"
    :setup ((set-prop! @microwave timer 120) (set-prop! @microwave temp 4) (move! @chinese-food @microwave) (set-prop! @chinese-food heat 0))
    (wait)
    (assert (outcome? success))
    (assert (prop? @chinese-food heat 4)))

  (test "doesn't fire outside kitchen"
    :setup ((move! @player @cs-2nd) (set-prop! @microwave timer 120))
    (wait)
    (assert (prop? @microwave timer 120)))
)

(test-group "overcooking"
  :setup ((move! @player @kitchen) (move! @chinese-food @microwave) (set-prop! @microwave temp 4) (set-prop! @microwave timer 60) (queue! microwave-running))

  (test "chinese food gets RMUNGBIT when heat > 20"
    :setup ((set-prop! @chinese-food heat 18))
    (wait)
    (assert (outcome? success))
    (assert (prop? @chinese-food heat 22))
    (assert (:rmung @chinese-food)))

  (test "not overcooked at heat 20"
    :setup ((set-prop! @chinese-food heat 16))
    (wait)
    (assert (outcome? success))
    (assert (prop? @chinese-food heat 20))
    (assert (not (:rmung @chinese-food))))
)

(test-group "item-cooling event"
  :setup ((move! @player @kitchen) (queue! item-cooling))

  (test "decrements heat"
    :setup ((set-prop! @chinese-food heat 12) (move! @chinese-food @player))
    (wait)
    (assert (outcome? success))
    (assert (prop? @chinese-food heat 11)))

  (test "doesn't cool food in running microwave"
    :setup ((move! @chinese-food @microwave) (set-prop! @chinese-food heat 12) (set-prop! @microwave timer 120) (set-prop! @microwave temp 4) (queue! microwave-running))
    (wait)
    (assert (prop? @chinese-food heat 16)))

  (test "re-queues itself"
    :setup ((set-prop! @chinese-food heat 5) (move! @chinese-food @player))
    (wait)
    (assert (queued? item-cooling)))

  (test "doesn't cool below 0"
    :setup ((set-prop! @chinese-food heat 0) (move! @chinese-food @player))
    (wait)
    (assert (prop? @chinese-food heat 0)))
)

(test "heat chinese food to trading temperature"
  :setup ((move! @player @kitchen) (move! @chinese-food @microwave) (set-prop! @chinese-food heat 0) (set-prop! @microwave timer 0) (set-prop! @microwave temp 0))
  (do @microwave :set-timer 180)
  (assert (prop? @microwave timer 180))
  (do @microwave :set-temp high)
  (assert (prop? @microwave temp 4))
  (do @microwave :start)
  (assert (queued? microwave-running))
  (wait)
  (assert (prop? @microwave timer 120))
  (assert (prop? @chinese-food heat 4))
  (wait)
  (assert (prop? @microwave timer 60))
  (assert (prop? @chinese-food heat 8))
  (wait)
  (assert (prop? @microwave timer 0))
  (assert (prop? @chinese-food heat 12))
  (assert (not-queued? microwave-running)))

(test-group "put items in containers"
  :setup ((move! @player @kitchen) (move! @carton @player) (set @microwave :open true))

  (test "can put item in open container"
    (do @carton :put @microwave)
    (assert (outcome? success))
    (assert (in? @carton @microwave)))

  (test "can't put item in closed container"
    :setup ((set @microwave :open false))
    (do @carton :put @microwave)
    (assert (outcome? blocked)))

  (test "can't put item in non-container"
    (do @carton :put @readout)
    (assert (outcome? blocked)))

  (test "can't put item not being held"
    :setup ((move! @carton @kitchen))
    (do @carton :put @microwave)
    (assert (outcome? blocked)))
)

(test-group "heating food in carton in microwave"
  :setup ((move! @player @kitchen) (move! @carton @microwave) (move! @chinese-food @carton) (set-prop! @chinese-food heat 0) (set-prop! @microwave timer 120) (set-prop! @microwave temp 4) (queue! microwave-running))

  (test "heats chinese food inside carton"
    (wait)
    (assert (outcome? success))
    (assert (prop? @chinese-food heat 4)))

  (test "overcooks food inside carton"
    :setup ((set-prop! @chinese-food heat 18))
    (wait)
    (assert (prop? @chinese-food heat 22))
    (assert (:rmung @chinese-food)))
)

(test-group "chinese food behaviors"
  :setup ((move! @player @kitchen) (move! @carton @player) (move! @chinese-food @carton))

  (test "can examine chinese food"
    (do @chinese-food :examine)
    (assert (outcome? success)))

  (test "can taste chinese food"
    (do @chinese-food :taste)
    (assert (outcome? success)))

  (test "can't take food out of carton (spill)"
    (do @chinese-food :take)
    (assert (outcome? blocked)))

  (test "can eat chinese food"
    (do @chinese-food :eat)
    (assert (outcome? success))
    (assert (loc? @chinese-food nil)))
)

(test-group "carton behaviors"
  :setup ((move! @player @kitchen) (move! @carton @player) (move! @chinese-food @carton))

  (test "can examine carton"
    (do @carton :examine)
    (assert (outcome? success)))

  (test "can read carton symbol"
    (do @carton :read)
    (assert (outcome? success)))

  (test "can't eat carton"
    (do @carton :eat)
    (assert (outcome? blocked)))
)

(test-group "snack behaviors"
  :setup ((move! @player @kitchen) (move! @snack @player) (set @snack :open false) (set @snack :rmung false))

  (test "can examine snack"
    (do @snack :examine)
    (assert (outcome? success)))

  (test "can read snack"
    (do @snack :read)
    (assert (outcome? success)))

  (test "can open snack"
    (do @snack :open)
    (assert (outcome? success))
    (assert (:open @snack)))

  (test "can eat snack (opens and eats)"
    :setup ((set @snack :open false))
    (do @snack :eat)
    (assert (outcome? success))
    (assert (:open @snack))
    (assert (:rmung @snack)))

  (test "can't eat empty snack"
    :setup ((set @snack :rmung true))
    (do @snack :eat)
    (assert (outcome? blocked)))

  (test "can't eat too hot snack"
    :setup ((set @snack :open true) (set-prop! @snack heat 15))
    (do @snack :eat)
    (assert (outcome? blocked)))
)

(test-group "coke behaviors"
  :setup ((move! @player @kitchen) (move! @coke @player) (set-prop! @coke size 5))

  (test "can examine coke"
    (do @coke :examine)
    (assert (outcome? success)))

  (test "can taste coke"
    (do @coke :taste)
    (assert (outcome? success)))

  (test "can drink coke"
    (do @coke :drink)
    (assert (outcome? success))
    (assert (prop? @coke size 4)))

  (test "can drink until empty"
    :setup ((set-prop! @coke size 2))
    (do @coke :drink)
    (assert (outcome? success))
    (assert (prop? @coke size 1)))

  (test "can't drink empty coke"
    :setup ((set-prop! @coke size 1))
    (do @coke :drink)
    (assert (outcome? blocked)))

  (test "can open/close coke"
    (do @coke :open)
    (assert (outcome? success)))
)
