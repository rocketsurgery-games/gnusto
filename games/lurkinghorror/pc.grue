; Screen objects that can appear on the PC (in priority order)
(def screen-objects '(@odd-paper @menu-box @more-box @yak-window))

(defn current-screen-content ()
  "Find the first screen object currently in the PC, or nil"
  (some (fn (?o) (if (in? ?o @pc) ?o nil)) screen-objects))

(object @pc
  :description "PC"
  :fdesc "A really whiz-bang pc is right inside the door."
  :location @terminal-room
  :rdesc "A late-1980s workstation PC in the corner of a computer lab: a CRT monitor with overlapping text windows on the screen, a keyboard, and a mouse."

  ; Login state: logged-in becomes true after valid password, username is set to login ID (or true for invalid)
  :properties (
    :takeable true
    :trytake true
    :open true
    :container true
    :searchable true
    :surface true
    :size 30
    :unplugged false
    :logged-in false
    :username false
    :powered false)

  (def pc-desc "This is a beyond-state-of-the-art personal computer. It has a 1024 by 1024 pixel color monitor, a mouse, an attached hard disk, and a local area network connection. Fortunately, one of its features is a prominent HELP key.")
  (def login-please "\"LOGIN PLEASE:\"")
  (def password-please "PASSWORD PLEASE:\"")

  :behaviors (
    ; EXAMINE - Show PC description with power state and screen contents
    ; ZIL: "On the screen you see a <FIRST? PC>." when powered and has screen content
    :examine (fn ()
      (let ((?screen (current-screen-content)))
        (cond
          ; PC is off
          ((not (:powered ?self))
            `((focus @pc ,(str pc-desc " It is currently turned off.")) (success)))
          ; PC is on with screen content
          (?screen
            `((focus @pc ,(str pc-desc " On the screen you see " ?screen ".")) (success)))
          ; PC is on but no screen content (pre-login state)
          (true
            `((focus @pc ,pc-desc) (success))))))

    ; LISTEN - Hums when powered on
    :listen (fn ()
      (cond
        ((:powered ?self)
          '((narrate "It hums contentedly.") (success)))
        (true
          (blocked :reason not-powered :message "It's silent."))))

    ; TAKE - When hacker helps, redirect to unplug; otherwise auto-unplug
    :take (fn ()
      (cond
        ((queued? hacker-helps)
          (redirect :action (do @pc :unplug)
                    :context ((hacker-blocks true))))
        ((prop ?self unplugged)
          (default))  ; Normal take when already unplugged
        ((:powered ?self)
          ; Taking while on: turn off and unplug
          '((set ?self :powered false)
            (set-prop ?self unplugged true)
            (move ?self ?actor)
            (narrate "You take it, turning it off and unplugging it first.")
            (success)))
        (true
          ; Taking while off but plugged in: just unplug
          '((set-prop ?self unplugged true)
            (move ?self ?actor)
            (narrate "You take it, unplugging it first.")
            (success)))))

    ; PUT-ON / PUT - Not a good surface
    :put-on (fn (?item)
      (blocked :reason not-a-surface :message "That's not a good surface for that."))

    ; READ - Show screen contents
    :read (fn ()
      (let ((?screen (current-screen-content)))
        (cond
          ((and (queued? hacker-helps) (< (prop @player hacker-help-stage) 3))
            (blocked :reason hacker-working :message "There's nothing recognizable on the screen."))
          ((not (:powered ?self))
            (blocked :reason not-powered :message "The screen is dark."))
          (?screen
            (redirect :action (do ?screen :read)))
          (true
            (blocked :reason nothing-on-screen :message "There's nothing to read on the screen now.")))))

    ; TURN-ON (LAMP-ON) - Power up computer
    :turn-on (fn ()
      (cond
        ((prop ?self unplugged)
          (blocked :reason unplugged :message "It's unplugged. You should plug it in first."))
        ((:powered ?self)
          (blocked :reason already-on :message "It's on. Maybe you didn't notice."))
        (true
          `((set ?self :powered true)
            (narrate ,(str "The computer powers up, goes through a remarkably fast self-check, and greets you, requesting " login-please " The only sound you hear is a very low hum."))
            (success)))))

    ; TURN-OFF (LAMP-OFF) - Power down computer and reset login state
    :turn-off (fn ()
      (cond
        ((queued? hacker-helps)
          (blocked :reason hacker-interference
                   :context ((blocker @hacker))
                   :message "The hacker stops you. \"You'll mung the bits, chomper!\""))
        ((not (:powered ?self))
          (blocked :reason already-off :message "It's already off."))
        (true
          '((set ?self :powered false)
            (set @pc :logged-in false)
            (set @pc :username false)
            (move @menu-box nil)
            (move @more-box nil)
            (move @yak-window nil)
            (narrate "The computer powers off. It no longer makes a sound.")
            (success)))))

    ; PLUG-IN - Plug in computer
    :plug-in (fn ()
      (cond
        ((not (prop ?self unplugged))
          (blocked :reason already-plugged :message "It's already plugged in."))
        (true
          '((set-prop ?self unplugged false)
            (narrate "You plug in the computer.")
            (success)))))

    ; UNPLUG - Unplug computer and reset login state
    :unplug (fn ()
      (cond
        ((prop ?self unplugged)
          (blocked :reason already-unplugged :message "It's already unplugged."))
        ((queued? hacker-helps)
          (blocked :reason hacker-interference
                   :context ((blocker @hacker))
                   :message "The hacker stops you. \"You'll mung the bits, chomper!\""))
        ((:powered ?self)
          ; Unplug while on: turn off first, reset login state
          '((set ?self :powered false)
            (set-prop ?self unplugged true)
            (set @pc :logged-in false)
            (set @pc :username false)
            (move @menu-box nil)
            (move @more-box nil)
            (move @yak-window nil)
            (narrate "Okay, it's unplugged now.")
            (success)))
        (true
          '((set-prop ?self unplugged true)
            (narrate "Okay, it's unplugged now.")
            (success)))))

    ; SIT-AT - Redirect to sitting in chair if present
    :sit-at (fn ()
      (cond
        ((here? @chair)
          (redirect :action (do @chair :sit)))
        (true
          (blocked :reason no-chair :message "There's no chair here."))))

    ; TYPE - Multi-step login flow: routes to :login or :password based on state
    ; In ZIL this was V-TYPE redirecting via NEW-VERB to V-LOGIN or V-PASSWORD
    :type (fn (?value :string)
      (cond
        ((prop ?self unplugged)
          (blocked :reason unplugged :message "Login on what?"))
        ((not (:powered ?self))
          (blocked :reason not-powered :message "It would help if you turned on the computer first."))
        ((not (:username @pc))
          ; No username yet - redirect to login
          (redirect :action (do ?self :login ?value)))
        ((not (:logged-in @pc))
          ; Have username but not logged in - redirect to password
          (redirect :action (do ?self :password ?value)))
        (true
          ; Already logged in - syntax error (with smiley face!)
          '((narrate "Nothing interesting happens, except that a yellow smiling face appears in a small box next to the legend \"Sorry, Syntax Error. Hope you have a nice day anyway.\"")
            (success)))))

    ; LOGIN - First step of login flow
    ; The parser converts "872325412" to "xyzzy" and that's the valid login ID.
    ; Any other input sets username to true but will fail at password stage.
    :login (fn (?value :string)
      (cond
        ((prop ?self unplugged)
          (blocked :reason unplugged :message "Login on what?"))
        ((not (:powered ?self))
          (blocked :reason not-powered :message "It would help if you turned on the computer first."))
        ((or (= ?value "xyzzy") (= ?value "872325412"))
          ; Valid login ID (xyzzy or the actual ID 872325412)
          `((set @pc :username "xyzzy")
            (narrate ,(str "The computer responds \"" password-please))
            (success)))
        (true
          ; Wrong login - accept but will fail at password stage
          `((set @pc :username true)
            (narrate ,(str "The computer responds \"" password-please))
            (success)))))

    ; PASSWORD - Second step of login flow
    ; Only "uhlersoth" or "plugh" work, and only if username was "xyzzy" (valid login)
    :password (fn (?value :string)
      (cond
        ((prop ?self unplugged)
          (blocked :reason unplugged :message "Login on what?"))
        ((not (:powered ?self))
          (blocked :reason not-powered :message "It would help if you turned on the computer first."))
        ((and (= (:username @pc) "xyzzy")
              (or (= ?value "plugh") (= ?value "uhlersoth")))
          ; Valid password with valid login - success!
          '((set @pc :logged-in true)
            (move @menu-box ?self)
            (narrate "The computer responds \"Good evening. You're here awfully late.\" It displays a list of pending tasks, one of which is in blinking red letters, with large arrows pointing to it. The task reads \"Classics Paper,\" some particularly ominous words next to it say \"DUE TOMORROW!\" and more reassuringly, a menu box next to that reads \"Edit Classics Paper.\"")
            (success)))
        (true
          ; Invalid password or wrong login - reset and fail
          `((set @pc :username false)
            (set @pc :logged-in false)
            (narrate ,(str "The computer responds \"INVALID LOGIN\" and then " login-please))
            (success)))))))

; === PC Physical Components ===
; These are physical parts of the PC that can be interacted with.

(object @mouse
  :description "mouse"
  :location @pc
  :properties (:nodesc true)
  :behaviors (
    :examine (fn () '((focus @mouse "It's a plastic pointing device.") (success)))
    :take (fn () (blocked :reason attached :message "It's attached to the computer."))
    :move (fn () '((narrate "It rolls smoothly.") (success)))
    ; CLICK - redirect to the click target
    :click (fn (?target)
      (cond
        (?target (redirect :action (do ?target :click)))
        (true (blocked :reason no-target :message "You have to click something with the mouse."))))))

(object @help-key
  :description "HELP key"
  :location @pc
  :properties (:nodesc true :readable true :text "It says \"HELP\" in reassuring blue letters.")
  :behaviors (
    :examine (fn () '((focus @help-key "It says \"HELP\" in reassuring blue letters.") (success)))
    :read (fn () '((narrate "It says \"HELP\" in reassuring blue letters.") (success)))
    ; CLICK/PUSH - show contextual help based on PC state
    :click (fn ()
      (cond
        ((not (:powered @pc))
          '((narrate "Well, nothing happens. Perhaps you should turn on the computer?") (success)))
        ((not (:logged-in @pc))
          (cond
            ((not (:username @pc))
              '((narrate "You push the friendly-looking HELP key. A spritely little box appears on the screen, which reads: \"You should \"LOGIN your-user-id\" and then \"PASSWORD your-password\".\"") (success)))
            (true
              '((narrate "You push the friendly-looking HELP key. A spritely little box appears on the screen, which reads: \"PASSWORD your-password\".\"") (success)))))
        ((in? @more-box @pc)
          (cond
            ((not (prop @odd-paper read-page))
              '((narrate "You push the friendly-looking HELP key. A spritely little box appears on the screen, which reads: \"Please read the page on the screen and then click the MORE box.\"") (success)))
            (true
              '((narrate "You push the friendly-looking HELP key. A spritely little box appears on the screen, which reads: \"Please click the MORE box.\"\"") (success)))))
        ((in? @yak-window @pc)
          '((narrate "You push the friendly-looking HELP key. A spritely little box appears on the screen, which reads: \"Please click the box representing the file you wish to edit or view. I notice that one file is marked as urgent, so you should probably click its box.\"") (success)))
        ((in? @menu-box @pc)
          '((narrate "You push the friendly-looking HELP key. A spritely little box appears on the screen, which reads: \"You should click the menu box, as you previously set it up as an urgent task.\"") (success)))
        (true
          '((narrate "You push the friendly-looking HELP key. A spritely little box appears on the screen, which reads: \"I can't help you at this point.\"") (success)))))))

; === PC Screen Objects ===
; These represent on-screen UI elements that appear on the PC.
; Flow: @menu-box -> click -> @yak-window -> click -> @odd-paper + @more-box
; Reading @odd-paper triggers I-COMPULSION (possession mechanic)

(object @menu-box
  :description "menu box"
  :location nil  ; Appears on PC after successful login
  :properties (:nodesc true :readable true :text "Edit Classics Paper.")

  :behaviors (
    :examine (fn () '((focus @menu-box "The most immediate thing you see is the red menu box that refers to an urgent task.") (success)))
    :read (fn () '((narrate "It says \"Edit Classics Paper\" in an urgent-looking shade of red.") (success)))

    ; CLICK - open the YAK editor
    :click (fn ()
      '((move @menu-box nil)
        (move @yak-window @pc)
        (narrate "The menu box is replaced by the YAK text editor and menu boxes listing the titles of your files. The one for your paper is highlighted in a rather urgent-looking shade of red.")
        (success)))))

(object @yak-window
  :description "YAK editor"
  :location nil  ; Appears after clicking menu-box
  :properties (:nodesc true :readable true :text "YAK 5.3")

  :behaviors (
    :examine (fn () '((focus @yak-window "There's a box for your paper.") (success)))
    :read (fn () '((narrate "There's a box for your paper.") (success)))

    ; CLICK - open the paper (reveals the odd text)
    :click (fn ()
      (cond
        ; First time - odd paper appears
        ((not (:touched @odd-paper))
          '((move @yak-window nil)
            (move @odd-paper @pc)
            (move @more-box @pc)
            (set @odd-paper :touched true)
            (narrate "You click the box for your paper, and the box grows reassuringly until it fills most of the screen. Unfortunately, the text that fills it bears no resemblance to your paper. The title is the same, but after that, there is something different, very different.")
            (success)))

        ; Already seen - paper is lost
        (true
          '((say @hacker "Your paper is lost!")
            (narrate "Nothing happens.")
            (success)))))))

(object @odd-paper
  :description "classics paper"
  :location nil  ; Appears after clicking yak-window
  :properties (:readable true :nodesc true :read-page false :touched false)

  :behaviors (
    :examine (fn ()
      (redirect :action (do @odd-paper :read)))

    ; READ - triggers possession (I-COMPULSION)
    :read (fn ()
      (cond
        ; Queue compulsion event and show the strange text
        ((not (queued? compulsion))
          '((queue compulsion 2)
            (set-prop @odd-paper read-page true)
            (narrate "As you look at it more closely, you find it hard to focus on the screen, but impossible to look away. Your finger strays toward the \"MORE\" box...")
            (success)))

        ; Already reading/possessed
        (true
          '((set-prop @odd-paper read-page true)
            (narrate "You click the \"MORE\" box and read what appears.")
            (success)))))))

(object @more-box
  :description "more box"
  :location nil  ; Appears with odd-paper
  :properties (:readable true :nodesc true)

  :behaviors (
    :examine (fn () '((focus @more-box "It says \"MORE\" in a subdued typeface.") (success)))
    :read (fn () '((narrate "It says \"MORE\" in a subdued typeface.") (success)))

    ; CLICK - advance through the strange document
    :click (fn ()
      (cond
        ; Haven't read the page yet
        ((not (prop @odd-paper read-page))
          (blocked :reason not-read-yet
                   :message "You haven't read the page yet. You probably shouldn't touch the MORE box until then."))

        ; Read the page - advance
        (true
          '((set-prop @odd-paper read-page false)
            (narrate "You touch the MORE box, and a new page appears.")
            (success)))))))
