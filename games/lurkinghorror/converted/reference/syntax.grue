; === SYNTAX REFERENCE ===
; Verb patterns defining valid command structures.

; $SOUND (no args) -> V-$SOUND
; LOGIN OBJECT -> V-LOGIN
; LOGIN ON OBJECT -> V-LOGIN
; LOGIN AS OBJECT -> V-LOGIN
; PASSWORD OBJECT -> V-PASSWORD
; #RANDOM OBJECT -> V-$RANDOM
; #COMMAND (no args) -> V-$COMMAND
; #RECORD (no args) -> V-$RECORD
; #UNRECORD (no args) -> V-$UNRECORD
; VERBOSE (no args) -> V-VERBOSE
; BRIEF (no args) -> V-BRIEF
; SUPER (no args) -> V-SUPER-BRIEF
; DIAGNOSE (no args) -> V-DIAGNOSE
; I (no args) -> V-INVENTORY
; QUIT (no args) -> V-QUIT
; RESTAR (no args) -> V-RESTART
; RESTOR (no args) -> V-RESTORE
; SAVE (no args) -> V-SAVE
; SCORE (no args) -> V-SCORE
; SCRIPT (no args) -> V-SCRIPT
; UNSCRIPT (no args) -> V-UNSCRIPT
; VERSION (no args) -> V-VERSION
; $VERIFY (no args) -> V-$VERIFY
; $VERIFY OBJECT -> V-$VERIFY
; ANSWER (no args) -> V-ANSWER
; ANSWER OBJECT -> V-REPLY
; APPLY OBJECT TO OBJECT [HELD, MANY, HAVE] -> V-PUT PRE=PRE-PUT
; ASK FOR OBJECT -> V-ASK-FOR PRE=PRE-ASK-FOR
; ASK OBJECT FOR OBJECT [FIND, PERSON] -> V-ASK-FOR PRE=PRE-ASK-FOR
; ASK ABOUT OBJECT -> V-ASK-ABOUT PRE=PRE-ASK-ABOUT
; ASK OBJECT ABOUT OBJECT [FIND, PERSON] -> V-ASK-ABOUT PRE=PRE-ASK-ABOUT
; ATTACK OBJECT [FIND, PERSON, ON-GROUND, IN-ROOM] -> V-ATTACK
; ATTACK OBJECT WITH OBJECT [FIND, PERSON, ON-GROUND, IN-ROOM, FIND, WEAPONBIT, HELD, CARRIED, HAVE] -> V-ATTACK
; BITE OBJECT -> V-BITE
; BLOW OUT OBJECT -> V-LAMP-OFF
; BOARD OBJECT [FIND, VEHBIT, ON-GROUND, IN-ROOM] -> V-BOARD PRE=PRE-BOARD
; BURN OBJECT WITH OBJECT [HELD, CARRIED, ON-GROUND, IN-ROOM, HELD, CARRIED, ON-GROUND, IN-ROOM, HAVE] -> V-BURN
; BURN DOWN OBJECT WITH OBJECT [HELD, CARRIED, ON-GROUND, IN-ROOM, HELD, CARRIED, ON-GROUND, IN-ROOM, HAVE] -> V-BURN
; CLIMB OBJECT [ON-GROUND, IN-ROOM] -> V-CLIMB-FOO
