; HANG OBJECT FROM OBJECT -> V-PUT-ON
; TYPE OBJECT -> V-TYPE
; TYPE LOGIN OBJECT -> V-LOGIN
; TYPE PASSWORD OBJECT -> V-PASSWORD
; WEDGE OBJECT WITH OBJECT -> V-WEDGE
; WEDGE OBJECT IN OBJECT -> V-SWEDGE PRE=PRE-SWEDGE
; WEDGE OBJECT BETWEEN OBJECT -> V-SWEDGE PRE=PRE-SWEDGE
; DIE (no args) -> V-DIE
; HACK (no args) -> V-HACK
; HACK OBJECT -> V-HACK
; COOK OBJECT -> V-COOK

