; --- NUMBER? ---
; <ROUTINE NUMBER? (PTR "AUX" CNT BPTR CHR SUM)
;   <SETG P-TIME? <>>
;   <SETG P-MINUTES 0>
;   <SET
;       CNT
;       <GETB
;         <REST
;           ,P-LEXV
;           <* .PTR 2>>
;         2>>
;   <SET
;       BPTR
;       <GETB
;         <REST
;           ,P-LEXV
;           <* .PTR 2>>
;         3>>
;   <REPEAT
;       ()
;       <COND
;         (<L?
;           <SET
;             CNT
;             <- .CNT 1>>
;           0> <RETURN>)
;         (T <SET
;           CHR
;           <GETB ,P-INBUF .BPTR>> <COND
;           (<EQUAL? .CHR % <ASCII !:>> <SETG P-TIME? T> <SETG
;             P-MINUTES
