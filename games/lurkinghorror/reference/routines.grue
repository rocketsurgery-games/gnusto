;       (<HERE? .THIS-SIDE> <TELL "comes loose and drops to the ground">)
;       (ELSE <TELL "drops to the floor on the other side">)>
; >

; --- BRICK-WALL-CONT ---
; <ROUTINE BRICK-WALL-CONT (RARG)
;   <COND
;       (<VERB? TAKE MOVE> <TELL
;         ,YOU-CANT
;         S
;         "get a good grip on "
;         THE
;         ,PRSO
;         " with your fingers."
;         CR>)>
; >

; --- BRICK-WALL-DESC ---
; <ROUTINE BRICK-WALL-DESC (RARG OBJ)
;   <COND
;       (<RARG? OBJDESC?> <COND
;         (<OR ,BRICK-WALL-FLAG <HOLE-IN-BRICKS?>> <RTRUE>)
;         (ELSE <RFATAL>)>)
;       (ELSE <TELL "The "> <COND (<HERE? ,STEAM-TUNNEL-EAST> <TELL "southern ">)> <TELL 'BRICK-WALL> <COND
;         (,BRICK-WALL-FLAG <TELL " has an enormous hole ripped in it.">)
;         (ELSE <TELL " has a hole in it."> <COND
;           (<NOT
;             <FSET? ,ROD ,INVISIBLE>> <TELL-ABOUT-ROD>)>)> <RFATAL>)>
; >

; --- BUFFER-PRINT ---
; <ROUTINE BUFFER-PRINT (BEG END CP "AUX" NOSP WRD 1ST? PN Q?)
;   <REPEAT
;       ()
;       <COND
;         (<EQUAL? .BEG .END> <RETURN>)
;         (T <SET
;           WRD
;           <GET .BEG 0>> <COND
;           (<EQUAL? .WRD ,W?COMMA> <TELL ", ">)
;           (.NOSP <SET NOSP <>>)
;           (ELSE <TELL " ">)> <COND
;           (<EQUAL? .WRD ,W?PERIOD ,W?COMMA> <SET NOSP T>)
;           (<EQUAL? .WRD ,W?ME> <PRINTD ,ME> <SET PN T>)
;           (<EQUAL? .WRD ,W?INTNUM> <PRINTN ,P-NUMBER> <SET PN T>)
;           (T <COND (<AND .1ST? <NOT .PN> .CP> <TELL "the ">)> <COND
;             (<OR ,P-OFLAG ,P-MERGED> <PRINTB .WRD>)
;             (<AND
;               <EQUAL? .WRD ,W?IT>
;               <ACCESSIBLE? ,P-IT-OBJECT>> <PRINTD ,P-IT-OBJECT>)
;             (<AND
;               <EQUAL? .WRD ,W?HIM>
;               <ACCESSIBLE? ,P-HIM-OBJECT>> <PRINTD ,P-HIM-OBJECT>)
;             (T <WORD-PRINT
;               <GETB .BEG 2>
;               <GETB .BEG 3>>)> <SET 1ST? <>>)>)>
;       <SET
;         BEG
;         <REST .BEG ,P-WORDLEN>>>
; >

; --- BUT-MERGE ---
; <ROUTINE BUT-MERGE (TBL "AUX" LEN BUTLEN CNT MATCHES OBJ NTBL)
;   <SET
;       LEN
;       <GET .TBL ,P-MATCHLEN>>
;   <PUT ,P-MERGE ,P-MATCHLEN 0>
;   <REPEAT
;       ()
;       <COND
;         (<DLESS? LEN 0> <RETURN>)
;         (<ZMEMQ
;           <SET
;             OBJ
;             <GET .TBL .CNT>>
;           ,P-BUTS>)
;         (T <PUT
;           ,P-MERGE
;           <+ .MATCHES 1>
;           .OBJ> <SET
;           MATCHES
;           <+ .MATCHES 1>>)>
;       <SET
;         CNT
;         <+ .CNT 1>>>
;   <PUT ,P-MERGE ,P-MATCHLEN .MATCHES>
;   <SET NTBL ,P-MERGE>
;   <SETG P-MERGE .TBL>
;   .NTBL
; >

; --- BUTTON-GLOWING ---
; <ROUTINE BUTTON-GLOWING (OBJ BIT "AUX" F)
;   <COND
;       (<AND
;         <GLOBAL-IN? .OBJ ,HERE>
;         <BTST
;           <GET ,BUTTONS .F>
;           .BIT>> <TELL CTHE .OBJ " is glowing. ">)>
; >

