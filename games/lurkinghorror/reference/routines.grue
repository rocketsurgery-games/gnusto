;       (<FSET? .OBJ ,INVISIBLE> <RFALSE>)
;       (<EQUAL? .OBJ ,WINNER> <RFALSE>)
;       (<AND
;         <EQUAL? .OBJ <LOC ,WINNER>>
;         <NOT
;           <EQUAL? ,HERE <LOC ,WINNER>>>> <RFALSE>)
;       (<AND
;         <NOT .CONT?>
;         <FSET? .OBJ ,NDESCBIT>> <RFALSE>)
;       (,D-BIT <COND
;         (<G? ,D-BIT 0> <COND (<FSET? .OBJ ,D-BIT> <RTRUE>) (ELSE <RFALSE>)>)
;         (<NOT
;           <FSET? .OBJ <- ,D-BIT>>> <RTRUE>)
;         (ELSE <RFALSE>)>)
;       (ELSE <RTRUE>)>
; >

; --- DESCRIBE-BOX ---
