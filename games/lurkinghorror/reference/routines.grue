; --- DESCRIBE-OBJECTS ---
; <ROUTINE DESCRIBE-OBJECTS ("AUX" O STR AV TMP)
;   <SET O <FIRST? ,HERE>>
;   <COND (<NOT .O> <RFALSE>)>
;   <REPEAT
;       ()
;       <COND
;         (<NOT .O> <RETURN>)
;         (<AND
;           <DESCRIBABLE? .O>
;           <NOT
;             <FSET? .O ,TOUCHBIT>>
;           <SET
;             STR
;             <GETP .O ,P?FDESC>>> <THIS-IS-IT .O> <CRLF> <TELL .STR> <COND
;           (<FSET? .O ,CONTBIT> <DESCRIBE-CONTENTS
;             .O
;             T
;             <+ ,D-ALL? ,D-PARA?>>)> <CRLF>)>
;       <SET O <NEXT? .O>>>
;   <SET O <FIRST? ,HERE>>
;   <REPEAT
;       ()
;       <COND
;         (<NOT .O> <RETURN>)
;         (<OR
;           <NOT <DESCRIBABLE? .O>>
;           <AND
;             <GETP .O ,P?FDESC>
;             <NOT
;               <FSET? .O ,TOUCHBIT>>>> T)
;         (<AND
;           <SET
;             STR
;             <GETP .O ,P?DESCFCN>>
;           <SET
;             TMP
;             <APPLY .STR ,M-OBJDESC? .O>>> <COND
;           (<NOT
;             <EQUAL? .TMP ,M-FATAL>> <THIS-IS-IT .O> <CRLF> <COND
;             (<SET
;               STR
;               <APPLY .STR ,M-OBJDESC .O>> <COND
;               (<AND
;                 <FSET? .O ,CONTBIT>
;                 <N==? .STR ,M-FATAL>> <DESCRIBE-CONTENTS
;                 .O
;                 T
;                 <+ ,D-ALL? ,D-PARA?>>)>)> <CRLF>)>)
;         (<SET
;           STR
;           <GETP .O ,P?LDESC>> <THIS-IS-IT .O> <CRLF> <TELL .STR> <COND
;           (<FSET? .O ,CONTBIT> <DESCRIBE-CONTENTS
;             .O
;             T
;             <+ ,D-ALL? ,D-PARA?>>)> <CRLF>)>
;       <SET O <NEXT? .O>>>
;   <DESCRIBE-CONTENTS ,HERE <> <>>
;   <COND
;       (<AND .AV <NOT
;         <EQUAL? ,HERE .AV>>> <DESCRIBE-CONTENTS .AV <> <>>)>
; >

; --- DESCRIBE-REST ---
