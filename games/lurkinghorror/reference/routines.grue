;       (<AND
;         <NOT .FORCE?>
;         <EQUAL? ,AWAKE -1>> <TELL "You try to sleep, but you can't relax." CR>)
;       (<QUEUED? I-FREEZE-TO-DEATH> <TELL "You would freeze to death before you woke." CR>)
