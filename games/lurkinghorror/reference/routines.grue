; === UNREFERENCED ROUTINES ===
; These routines are not directly tied to rooms or objects.
; They may be utility functions, event handlers, or game logic.

; --- A-PRSI? ---
; <ROUTINE A-PRSI? ()
;   <TELL A ,PRSI "?" CR>
; >

; --- A-PRSO ---
; <ROUTINE A-PRSO ()
;   <TELL A ,PRSO ,PERIOD>
; >

; --- A-PRSO? ---
; <ROUTINE A-PRSO? ()
;   <TELL A ,PRSO "?" CR>
; >

; --- ABSTRACT-VERB? ---
; <ROUTINE ABSTRACT-VERB? ()
;   <VERB?
;       ASK-ABOUT
;       ASK-FOR
;       FIND
;       TELL-ME-ABOUT
;       TELL-ABOUT
;       WHAT
;       WHERE>
; >

; --- ACCESSIBLE? ---
; <ROUTINE ACCESSIBLE? (OBJ "AUX" L)
;   <COND
;       (<FSET? .OBJ ,INVISIBLE> <RFALSE>)
;       (<EQUAL? .OBJ ,PSEUDO-OBJECT> <COND (<EQUAL? ,LAST-PSEUDO-LOC ,HERE> <RTRUE>) (T <RFALSE>)>)
;       (<NOT .L> <RFALSE>)
;       (<EQUAL? .L ,GLOBAL-OBJECTS> <RTRUE>)
;       (<AND
;         <EQUAL? .L ,LOCAL-GLOBALS>
;         <GLOBAL-IN? .OBJ ,HERE>> <RTRUE>)
;       (<NOT
;         <EQUAL? <META-LOC .OBJ> ,HERE <LOC ,WINNER>>> <RFALSE>)
;       (<EQUAL? .L ,WINNER ,HERE <LOC ,WINNER>> <RTRUE>)
;       (<AND
;         <FSET? .L ,OPENBIT>
;         <ACCESSIBLE? .L>> <RTRUE>)
;       (T <RFALSE>)>
; >

