; --- PREP-TO-WORD ---
; <ROUTINE PREP-TO-WORD (PREP "AUX" CNT SIZE)
;   <SET
;       SIZE
;       <GET ,PREPOSITIONS 0>>
;   <REPEAT
;       ()
;       <COND
;         (<DLESS? SIZE 0> <RFALSE>)
;         (<EQUAL?
;           <GET ,PREPOSITIONS .CNT>
;           .PREP> <RETURN
;           <GET
;             ,PREPOSITIONS
;             <- .CNT 1>>>)
;         (ELSE <SET
;           CNT
;           <+ .CNT 2>>)>>
; >

