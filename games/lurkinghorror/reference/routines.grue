; --- DESCRIBE-ROOM ---
; <ROUTINE DESCRIBE-ROOM ("AUX" V? STR AV "OPT" LOOK?)
;   <COND
;       (<NOT ,LIT> <TELL "It is pitch black." CR> <RFALSE>)>
;   <COND (<IN? ,HERE ,ROOMS> <TELL 'HERE>)>
;   <SET AV <LOC ,WINNER>>
;   <COND
;       (<FSET? .AV ,VEHBIT> <COND
;         (<FSET? .AV ,SURFACEBIT> <TELL ", on ">)
;         (ELSE <TELL ", in ">)> <TELL THE .AV>)>
;   <CRLF>
;   <SET
;       V?
;       <OR
;         .LOOK?
;         <EQUAL? ,VERBOSITY 2>>>
;   <COND
;       (<NOT
;         <FSET? ,HERE ,TOUCHBIT>> <FSET ,HERE ,TOUCHBIT> <COND (,VERBOSITY <SET V? T>)>)>
;   <SETG DESCRIBED-ROOM? .V?>
;   <COND
;       (.V? <COND
;         (<AND
;           <NOT
;             <EQUAL? ,HERE .AV>>
;           <FSET? .AV ,VEHBIT>
;           <APPLY
;             <GETP .AV ,P?ACTION>
;             ,M-LOOK>> <RTRUE>)
;         (<APPLY
;           <GETP ,HERE ,P?ACTION>
;           ,M-LOOK> <RTRUE>)
;         (<SET
;           STR
;           <GETP ,HERE ,P?LDESC>> <TELL .STR CR>)>)>
;   T
; >

