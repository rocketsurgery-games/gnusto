;             .ONE
;             <+ ,E-UP ,E-GO>>
;           <BTST
;             .TWO
;             <+ ,E-UP ,E-GO>>
;           <BTST
;             .THREE
;             <+ ,E-UP ,E-GO>>> <RFALSE>)
