;       ()
;       <PUTB
;         .DEST
;         .CNT
;         <GETB .SRC .CNT>>
;       <COND (<DLESS? CNT 0> <RETURN>)>>
; >

; --- INF-EAST-EXIT ---
; <ROUTINE INF-EAST-EXIT (L)
;   <COND
