; --- CCOUNT ---
; <ROUTINE CCOUNT (OBJ "AUX" CNT X)
;   <MAP-CONTENTS
;       (X .OBJ)
;       (END <RETURN .CNT>)
;       <COND
;         (<AND
;           <EQUAL? .X ,HAND>
;           <FSET? ,HAND ,PERSON>>)
;         (<FSET? .X ,WEARBIT>)
;         (ELSE <SET
;           CNT
;           <+ .CNT 1>>)>>
; >

; --- CHAIN-DESC ---
; <ROUTINE CHAIN-DESC (RARG OBJ)
;   <COND
;       (<RARG? OBJDESC?> <COND
;         (<AND
;           <NOT <HELD? ,CHAIN>>
;           <OR
;             <AND ,CHAIN-HOOKED? <HERE? ,CS-BASEMENT>>
;             <AND ,CHAIN-LOOPED? <HERE? ,ELEVATOR-PIT>>>> <RFATAL>)
;         (ELSE <RTRUE>)>)
;       (ELSE <TELL "There is "> <COND
;         (<OR
;           <AND <HERE? ,ELEVATOR-PIT> ,CHAIN-LOOPED?>
;           <AND
;             <HERE? ,CS-BASEMENT ,ELEVATOR-PIT>
;             ,CHAIN-HOOKED?>> <TELL "one end of ">)> <TELL "a greasy length of chain "> <COND (<NOT
;         <FSET? ,CHAIN ,TOUCHBIT>> <TELL "coiled ">)> <TELL "on the floor here.">)>
; >

; --- CHAIN-IN-DOOR? ---
; <ROUTINE CHAIN-IN-DOOR? ()
;   <COND
;       (<AND
;         ,CHAIN-HOOKED?
;         <EQUAL? <META-LOC ,HOOK> ,HERE>
;         <OR
;           <HELD? ,CHAIN>
;           <IN? ,CHAIN ,HERE>>> ,CHAIN)>
; >

; --- CHAIN-NOISES ---
