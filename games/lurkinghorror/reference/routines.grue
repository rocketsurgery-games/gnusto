; --- MULTIPLE-EXCEPTION? ---
; <ROUTINE MULTIPLE-EXCEPTION? (OBJ1 "AUX" L)
;   <COND
;       (<EQUAL? .OBJ1 ,NOT-HERE-OBJECT> <SETG
;         P-NOT-HERE
;         <+ ,P-NOT-HERE 1>> <RTRUE>)
;       (<AND <VERB? TAKE> ,PRSI <NOT
;         <IN? ,PRSO ,PRSI>>> <RTRUE>)
;       (<NOT <ACCESSIBLE? .OBJ1>> <RTRUE>)
;       (<EQUAL? ,P-GETFLAGS ,P-ALL> <COND
;         (<AND ,PRSI <PRSO? ,PRSI>> <RTRUE>)
;         (<AND <VERB? TAKE> <NOT ,PRSI>> <COND
;           (<OR
;             <AND
;               <NOT
;                 <EQUAL? .L ,WINNER ,HERE ,PRSI>>
;               <NOT
;                 <EQUAL? .L <LOC ,WINNER>>>
;               <NOT
;                 <FSET? .L ,SURFACEBIT>>
;               <NOT
;                 <FSET? .L ,SEARCHBIT>>>
;             <AND
;               <NOT
;                 <FSET? .OBJ1 ,TAKEBIT>>
;               <NOT
;                 <FSET? .OBJ1 ,TRYTAKEBIT>>>> <RTRUE>)
;           (<OR
;             <FSET? .L ,PERSON>
;             <FSET? <LOC .L> ,PERSON>> <RTRUE>)
;           (<HELD? ,PRSO> <RTRUE>)
;           (<AND
;             <PRSO? DOME-LADDER>
;             <OR ,LADDER-TOP? ,LADDER-BOTTOM?>> <RTRUE>)
;           (<AND
;             <PRSO? CHAIN CHAIN-1 CHAIN-2>
;             <OR ,CHAIN-HOOKED? ,CHAIN-LOOPED?>
;             <NOT
;               <EQUAL? .L ,ELEVATOR-PIT ,CS-BASEMENT>>> <RTRUE>)
;           (<AND <PRSO? PADLOCK> ,PADLOCK-ON?> <RTRUE>)>)
;         (<VERB? DROP GIVE> <COND
;           (<NOT
;             <IN? .OBJ1 ,WINNER>> <RTRUE>)
;           (<FSET? .OBJ1 ,WEARBIT> <RTRUE>)>)
;         (<AND
;           <VERB? PUT>
;           <NOT
;             <IN? ,PRSO ,WINNER>>
;           <HELD? ,PRSO ,PRSI>> <RTRUE>)>)>
; >

; --- NEW-ADJ ---
; <ROUTINE NEW-ADJ ("AUX" N "OPT" WV WRD)
;   <COND
;       (<NOT .WV> <SETG P-NAM <>> <PUT ,P-ADJT 0 0> <PUT ,P-ADJNT 0 0>)
;       (ELSE <SET
;         N
;         <GET ,P-ADJT 0>> <COND (<L? .N 4> <SET
;         N
;         <+ .N 1>>)> <PUT ,P-ADJT 0 .N> <PUT ,P-ADJT .N .WV> <PUT ,P-ADJNT 0 .N> <PUT ,P-ADJNT .N .WRD>)>
; >

