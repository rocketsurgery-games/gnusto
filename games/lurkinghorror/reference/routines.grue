; --- AN-OPEN/CLOSED ---
; <ROUTINE AN-OPEN/CLOSED (DOOR)
;   <COND
;       (<FSET? .DOOR ,OPENBIT> <TELL "an open ">)
;       (ELSE <TELL "a closed ">)>
;   <TELL D .DOOR>
; >

