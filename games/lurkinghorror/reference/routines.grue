; --- LIT? ---
; <ROUTINE LIT? (RM "AUX" OHERE LIT "OPT" RMBIT)
;   <SETG P-GWIMBIT ,ONBIT>
;   <SET OHERE ,HERE>
;   <SETG HERE .RM>
;   <COND
;       (<AND
;         .RMBIT
;         <FSET? .RM ,ONBIT>> <SET LIT ,HERE>)
;       (<AND
;         <HERE? ,ELEVATOR-PIT>
;         <OR
;           <FSET? ,ELEVATOR-DOOR-B ,OPENBIT>
;           <FSET? ,ELEVATOR-DOOR-1 ,OPENBIT>>> <SET LIT ,CS-BASEMENT>)
;       (<AND
;         <HERE? ,UNDER-ALCHEMY-LAB>
;         <FSET? ,ALCHEMY-TRAP-DOOR ,OPENBIT>
;         <FSET? ,ALCHEMY-LAB ,ONBIT>> <SET LIT ,ALCHEMY-LAB>)
;       (<AND
;         <FSET? ,WINNER ,ONBIT>
;         <HELD? ,WINNER .RM>> <SET LIT ,WINNER>)
;       (T <PUT ,P-MERGE ,P-MATCHLEN 0> <SETG P-TABLE ,P-MERGE> <SETG P-SLOCBITS -1> <COND
;         (<EQUAL? .OHERE .RM> <DO-SL ,WINNER 1 1> <COND
;           (<AND
;             <NOT
;               <EQUAL? ,WINNER ,PLAYER>>
;             <IN? ,PLAYER .RM>> <DO-SL ,PLAYER 1 1>)>)> <COND
;         (<AND
;           <FSET? <LOC ,WINNER> ,VEHBIT>
;           <NOT
;             <FSET? <LOC ,WINNER> ,OPENBIT>>> <DO-SL <LOC ,WINNER> 1 1>)> <DO-SL .RM 1 1> <COND
;         (<G?
;           <GET ,P-TABLE ,P-MATCHLEN>
;           0> <SET
;           LIT
;           <GET ,P-TABLE 1>>)>)>
;   <SETG HERE .OHERE>
;   <SETG P-GWIMBIT 0>
;   .LIT
; >

; --- LOOK-IN-CONTAINER ---
; <ROUTINE LOOK-IN-CONTAINER ()
;   <COND
;       (<NOT
;         <FSET? ,PRSO ,OPENBIT>> <TELL-OPEN-CLOSED ,PRSO> <RTRUE>)
