; --- V-FIND ---
; <ROUTINE V-FIND ("AUX" L "OPT" WHERE)
;   <COND
;       (<INTRINSIC? ,PRSO> <TELL "Nearby, I'm sure">)
;       (<IN? ,PRSO ,PLAYER> <TELL "You have it">)
;       (<OR
;         <IN? ,PRSO ,HERE>
;         <PRSO? ,PSEUDO-OBJECT>> <TELL "Right in front of you">)
;       (<OR
;         <IN? ,PRSO ,LOCAL-GLOBALS>
;         <IN? ,PRSO ,GLOBAL-OBJECTS>> <TELL "It could be lurking right behind you">)
;       (ELSE <SET L <LOC ,PRSO>> <COND
;         (<AND
;           <EQUAL? .L ,URCHIN>
;           <VISIBLE? .L>> <TELL "Maybe an urchin ripped it off">)
;         (<AND
;           <FSET? .L ,PERSON>
;           <VISIBLE? .L>> <TELL "I think " THE .L " has it">)
;         (<ACCESSIBLE? ,PRSO> <TELL "It's in " THE .L>)
;         (.WHERE <TELL "Beats me">)
;         (T <TELL ,YOU-HAVE-TO "do that yourself">)>)>
