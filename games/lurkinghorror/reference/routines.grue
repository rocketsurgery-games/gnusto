; --- YOU-SEE-NO ---
; <ROUTINE YOU-SEE-NO (OBJ)
;   <TELL "You see no " D .OBJ "." CR>
; >

; --- ZMEMQ ---
; <ROUTINE ZMEMQ (ITM TBL "AUX" CNT "OPT" SIZE)
;   <COND (<NOT .TBL> <RFALSE>)>
;   <COND
;       (<NOT
;         <L? .SIZE 0>> <SET CNT 0>)
;       (ELSE <SET
;         SIZE
;         <GET .TBL 0>>)>
;   <REPEAT
;       ()
;       <COND
;         (<EQUAL?
;           .ITM
;           <GET .TBL .CNT>> <RETURN
;           <REST
;             .TBL
;             <* .CNT 2>>>)
;         (<IGRTR? CNT .SIZE> <RFALSE>)>>
; >

; --- ZMEMQB ---
; <ROUTINE ZMEMQB (ITM TBL SIZE "AUX" CNT)
;   <REPEAT
;       ()
;       <COND
;         (<EQUAL?
;           .ITM
;           <GETB .TBL .CNT>> <RTRUE>)
;         (<IGRTR? CNT .SIZE> <RFALSE>)>>
; >

