;         (ELSE <TELL S "There is an open " "manhole here.">)> <RFATAL>)>
; >

; --- MANY-CHECK ---
; <ROUTINE MANY-CHECK ("AUX" LOSS TMP)
;   <COND
;       (<AND
;         <G?
;           <GET ,P-PRSO ,P-MATCHLEN>
;           1>
;         <NOT
;           <BTST
;             <GETB ,P-SYNTAX ,P-SLOC1>
;             ,SMANY>>> <SET LOSS 1>)
;       (<AND
;         <G?
;           <GET ,P-PRSI ,P-MATCHLEN>
;           1>
;         <NOT
;           <BTST
;             <GETB ,P-SYNTAX ,P-SLOC2>
;             ,SMANY>>> <SET LOSS 2>)>
;   <COND
;       (.LOSS <TELL ,YOU-CANT "use multiple "> <COND (<EQUAL? .LOSS 2> <TELL "in">)> <TELL "direct objects with \""> <SET
;         TMP
;         <GET ,P-ITBL ,P-VERBN>> <COND
;         (<ZERO? .TMP> <TELL "tell">)
;         (<OR ,P-OFLAG ,P-MERGED> <PRINTB
;           <GET .TMP 0>>)
;         (T <WORD-PRINT
;           <GETB .TMP 2>
;           <GETB .TMP 3>>)> <TELL "\"." CR> <RFALSE>)
;       (T)>
; >

