;           <GET ,P-LEXV 1>
;           ,W?RESTAR> <RESTART> <TELL ,FAILED>)
;         (<EQUAL?
;           <GET ,P-LEXV 1>
;           ,W?RESTOR> <COND (<RESTORE> <TELL ,OKAY>) (T <TELL ,FAILED>)>)
;         (<EQUAL?
