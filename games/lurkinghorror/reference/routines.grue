;         <FSET? ,PRSO ,PERSON>> <TO-A-PRSO?>)
;       (<OR
;         <PRSI? <> ,HANDS>
;         <NOT
;           <FSET? ,PRSI ,WEAPONBIT>>> <TELL "Trying to " .STR " " THE ,PRSO " with "> <COND
;         (<NOT
;           <PRSI? <> ,HANDS>> <TELL A ,PRSI>)
;         (ELSE <TELL "your bare hands">)> <TELL " is suicidal." CR>)
;       (<NOT
;         <IN? ,PRSI ,WINNER>> <NOT-HOLDING ,PRSI>)
;       (T <NOT-TRAINED>)>
; >

; --- IN-DARK? ---
; <ROUTINE IN-DARK? ("AUX" OLIT "OPT" DIE?)
;   <SET OLIT ,LIT>
;   <SETG LIT <LIT? ,HERE>>
;   <COND
;       (<AND .OLIT <NOT ,LIT>> <TELL ", leaving you in the dark." CR> <COND
;         (.DIE? <CRLF> <TELL "Not alone, however. "> <JIGS-UP
;           "One should never assume the dark is safe.
;   Something just grabbed you from behind and dragged you
;   off to its lair.">)
;         (ELSE <RTRUE>)>)
;       (ELSE <TELL ,PERIOD>)>
; >

; --- IN-TUNNEL? ---
; <ROUTINE IN-TUNNEL? ("AUX" L "OPT" WHO)
;   <COND (<NOT .WHO> <SET WHO ,PLAYER>)>
;   <SET L <LOC .WHO>>
;   <COND
;       (<EQUAL?
;         .L
;         ,TUNNEL-WEST
;         ,TUNNEL
;         ,TUNNEL-EAST
;         ,STEAM-TUNNEL
;         ,STEAM-TUNNEL-EAST> <RTRUE>)
;       (<AND
;         <EQUAL? .L ,ELEVATOR-PIT>
;         ,BRICK-WALL-FLAG> <RTRUE>)>
; >

; --- INBUF-ADD ---
; <ROUTINE INBUF-ADD (LEN BEG SLOT "AUX" DBEG CTR TMP)
;   <COND
;       (<SET
;         TMP
;         <GET ,OOPS-TABLE ,O-END>> <SET DBEG .TMP>)
;       (T <SET
;         DBEG
;         <+
;           <GETB
;             ,AGAIN-LEXV
;             <SET
;               TMP
;               <GET ,OOPS-TABLE ,O-LENGTH>>>
;           <GETB
;             ,AGAIN-LEXV
;             <+ .TMP 1>>>>)>
;   <PUT
;       ,OOPS-TABLE
;       ,O-END
;       <+ .DBEG .LEN>>
;   <REPEAT
;       ()
;       <PUTB
;         ,OOPS-INBUF
;         <+ .DBEG .CTR>
;         <GETB
;           ,P-INBUF
;           <+ .BEG .CTR>>>
;       <SET
;         CTR
;         <+ .CTR 1>>
;       <COND (<EQUAL? .CTR .LEN> <RETURN>)>>
;   <PUTB ,AGAIN-LEXV .SLOT .DBEG>
;   <PUTB
;       ,AGAIN-LEXV
;       <- .SLOT 1>
;       .LEN>
; >

; --- INBUF-STUFF ---
; <ROUTINE INBUF-STUFF (SRC DEST "AUX" CNT)
;   <SET
;       CNT
;       <-
;         <GETB .SRC 0>
;         1>>
