; Terminal Room Tests
; Tests for the hacker-exit-barrier, hacker-helps event, compulsion, etc.

; =============================================================================
; BASIC MOVEMENT - hacker-exit-barrier
; =============================================================================
; The @hacker-exit-barrier prevents the player from leaving the terminal room
; while carrying "Tech property" (@pc or @chair).



(test-group "basic movement"

  (test "can exit south without carrying anything"
    (go :direction south)
    (assert (outcome? success))
    (assert (player-at? @cs-2nd)))

  (test "can exit out without carrying anything"
    :setup ((move! @player @terminal-room))
    (go :direction out)
    (assert (outcome? success))
    (assert (player-at? @cs-2nd)))
)

(test-group "blocked when carrying tech property"

  (test "blocked when carrying PC - south"
    :setup ((move! @pc @player))
    (go :direction south)
    (assert (outcome? blocked))
    (assert (reason? tech-property)))

  (test "blocked when carrying PC - out"
    :setup ((move! @pc @player))
    (go :direction out)
    (assert (outcome? blocked))
    (assert (reason? tech-property)))

  (test "blocked when carrying chair - south"
    :setup ((move! @chair @player))
    (go :direction south)
    (assert (outcome? blocked))
    (assert (reason? tech-property)))

  (test "can leave after putting PC back"
    :setup ((move! @pc @player) (move! @pc @terminal-room))
    (go :direction south)
    (assert (outcome? success))
    (assert (player-at? @cs-2nd)))
)

(test "take PC then blocked at exit"
  (do @pc :take)
  (assert (outcome? success))
  (assert (held? @pc))
  (go :direction south)
  (assert (outcome? blocked))
  (assert (reason? tech-property)))

(test "take PC, drop PC, then exit"
  (do @pc :take)
  (assert (outcome? success))
  (do @pc :drop)
  (assert (outcome? success))
  (assert (loc? @pc @terminal-room))
  (go :direction south)
  (assert (outcome? success))
  (assert (player-at? @cs-2nd)))

(test-group "hacker-helps event"

  (test "ask hacker for help queues event"
    (do @hacker :help)
    (assert (outcome? success))
    (assert (queued? hacker-helps))
    (assert (prop? @hacker help-stage 0)))

  (test "event fires in terminal room"
    :setup ((queue! hacker-helps) (set-prop! @hacker help-stage 0))
    (wait)
    (assert (outcome? success))
    (assert (context? stage 1))
    (assert (prop? @hacker help-stage 1)))

  (test "event doesn't fire outside terminal room"
    :setup ((queue! hacker-helps) (set-prop! @hacker help-stage 0) (move! @player @cs-2nd))
    (wait)
    (assert (prop? @hacker help-stage 0)))

  (test "asking for help when already helping"
    :setup ((queue! hacker-helps))
    (do @hacker :help)
    (assert (outcome? success))
    (assert (queued? hacker-helps)))

  (test "asking for help when already helped"
    :setup ((set-prop! @hacker help-stage 3))
    (do @hacker :help)
    (assert (outcome? success)))
)

(test "hacker-helps full 4-stage sequence"
  :setup ((queue! hacker-helps) (set-prop! @hacker help-stage 0))
  (wait)
  (assert (outcome? success))
  (assert (context? stage 1))
  (assert (prop? @hacker help-stage 1))
  (assert (queued? hacker-helps))
  (wait)
  (assert (outcome? success))
  (assert (context? stage 2))
  (assert (prop? @hacker help-stage 2))
  (assert (queued? hacker-helps))
  (wait)
  (assert (outcome? success))
  (assert (context? stage 3))
  (assert (prop? @hacker help-stage 3))
  (assert (queued? hacker-helps))
  (wait)
  (assert (outcome? success))
  (assert (context? stage 4))
  (assert (not-queued? hacker-helps))
  (assert (loc? @hacker @terminal-room)))

(test-group "hacker blocks PC actions during help"
  :setup ((queue! hacker-helps))

  (test "can't turn off PC"
    :setup ((set @pc :powered true))
    (do @pc :turn-off)
    (assert (outcome? blocked))
    (assert (reason? hacker-interference)))

  (test "can't unplug PC"
    (do @pc :unplug)
    (assert (outcome? blocked))
    (assert (reason? hacker-interference)))

  (test "can't click on menu-box"
    (do @menu-box :click)
    (assert (outcome? blocked))
    (assert (reason? hacker-interference))
    (assert (context? blocker @hacker)))

  (test "can't rub more-box"
    :setup ((move! @more-box @pc))
    (do @more-box :rub)
    (assert (outcome? blocked))
    (assert (reason? hacker-interference)))

  (test "examine is allowed"
    (do @pc :examine)
    (assert (outcome? success)))
)

(test "nightmare wake-up via lurker sequence"
  :setup ((move! @player @platform-room) (move! @smooth-stone @platform-room) (set @smooth-stone :touched false) (set-prop! @lurker count 0))
  (do @smooth-stone :take)
  (assert (outcome? success))
  (assert (held? @smooth-stone))
  (assert (queued? lurker-appears))
  (wait)
  (assert (outcome? success))
  (assert (prop? @lurker count 1))
  (assert (queued? lurker-appears))
  (wait)
  (assert (outcome? success))
  (assert (prop? @lurker count 2))
  (assert (queued? lurker-appears))
  (wait)
  (assert (outcome? success))
  (assert (player-at? @terminal-room))
  (assert (queued? hacker-helps))
  (assert (not-queued? lurker-appears)))

(test-group "nightmare wake-up"

  (test "entering from cs-2nd does not trigger wake-up"
    :setup ((move! @player @cs-2nd))
    (go :direction north)
    (assert (outcome? success))
    (assert (player-at? @terminal-room))
    (assert (not-queued? hacker-helps)))
)

(test-group "compulsion blocking"
  :setup ((queue! compulsion))

  (test "blocks unrelated actions"
    (do @chair :examine)
    (assert (outcome? blocked))
    (assert (reason? possessed))
    (assert (context? compelled true))
    (assert (context? forced-target @more-box)))

  (test "allows click on more-box"
    :setup ((move! @more-box @pc) (set-prop! @odd-paper read-page true))
    (do @more-box :click)
    (assert (outcome? success)))

  (test "allows read odd-paper"
    :setup ((move! @odd-paper @pc))
    (do @odd-paper :read)
    (assert (outcome? success)))
)

(test-group "compulsion event"

  (test "page 1"
    :setup ((queue! compulsion) (set-prop! @hacker comp-cnt 0))
    (wait)
    (assert (outcome? success))
    (assert (context? page 1))
    (assert (prop? @hacker comp-cnt 1)))
)

(test "compulsion full 4-page sequence"
  :setup ((queue! compulsion) (set-prop! @hacker comp-cnt 0))
  (wait)
  (assert (outcome? success))
  (assert (context? page 1))
  (assert (prop? @hacker comp-cnt 1))
  (assert (queued? compulsion))
  (wait)
  (assert (outcome? success))
  (assert (context? page 2))
  (assert (prop? @hacker comp-cnt 2))
  (assert (queued? compulsion))
  (wait)
  (assert (outcome? success))
  (assert (context? page 3))
  (assert (prop? @hacker comp-cnt 3))
  (assert (queued? compulsion))
  (wait)
  (assert (outcome? success))
  (assert (context? page 4))
  (assert (not-queued? compulsion))
  (assert (player-at? @yuggoth)))
