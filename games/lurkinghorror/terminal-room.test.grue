; Tests for @terminal-room and @hacker-exit-barrier
;
; The @hacker-exit-barrier prevents the player from leaving
; the terminal room while carrying "Tech property" (@pc or @chair).
; The hacker stops you with "You can't walk off with that!"

; === Basic movement (no tech property) ===

(test "can exit south without carrying anything"
  :action (go :direction south)
  :expect ((outcome? success)
           (player-at? @cs-2nd)))

(test "can exit out without carrying anything"
  :setup ((move! @player @terminal-room))
  :action (go :direction out)
  :expect ((outcome? success)
           (player-at? @cs-2nd)))

; === Blocked when carrying @pc ===

(test "blocked when carrying PC - south"
  :setup ((move! @pc @player))
  :action (go :direction south)
  :expect ((outcome? blocked)
           (reason? tech-property)))

(test "blocked when carrying PC - out"
  :setup ((move! @pc @player))
  :action (go :direction out)
  :expect ((outcome? blocked)
           (reason? tech-property)))

; === Blocked when carrying @chair ===

(test "blocked when carrying chair - south"
  :setup ((move! @chair @player))
  :action (go :direction south)
  :expect ((outcome? blocked)
           (reason? tech-property)))

; === Can leave after putting down tech property ===

(test "can leave after putting PC back"
  :setup ((move! @pc @player)
          (move! @pc @terminal-room))
  :action (go :direction south)
  :expect ((outcome? success)
           (player-at? @cs-2nd)))

; === Take/drop behavior ===

(test "take PC"
  :action (do :verb take :object @pc)
  :expect ((outcome? success)
           (held? @pc)))

(test "cannot take object not here"
  :setup ((move! @pc @cs-2nd))
  :action (do :verb take :object @pc)
  :expect ((outcome? blocked)
           (reason? not-here)))

(test "cannot take object already held"
  :setup ((move! @pc @player))
  :action (do :verb take :object @pc)
  :expect ((outcome? blocked)
           (reason? already-held)))

(test "cannot take non-takeable object"
  :action (do :verb take :object @hacker)
  :expect ((outcome? blocked)
           (reason? not-takeable)))

(test "drop PC"
  :setup ((move! @pc @player))
  :action (do :verb drop :object @pc)
  :expect ((outcome? success)
           (loc? @pc @terminal-room)))

(test "cannot drop object not held"
  :action (do :verb drop :object @pc)
  :expect ((outcome? blocked)
           (reason? not-held)))

; === @chair behaviors ===

(test "examine chair"
  :action (do :verb examine :object @chair)
  :expect ((outcome? success)))

(test "take chair - blocked when hacker in it"
  :setup ((move! @hacker @chair))
  :action (do :verb take :object @chair)
  :expect ((outcome? blocked)
           (reason? in-use)))

(test "take chair - success when hacker not in it"
  :action (do :verb take :object @chair)
  :expect ((outcome? success)
           (held? @chair)))

(test "sit in chair - success"
  :action (do :verb sit :object @chair)
  :expect ((outcome? success)
           (loc? @player @chair)))

(test "sit in chair - blocked when hacker using it"
  :setup ((move! @hacker @chair))
  :action (do :verb sit :object @chair)
  :expect ((outcome? blocked)
           (reason? occupied)))

(test "sit in chair - blocked when already sitting"
  :setup ((move! @player @chair))
  :action (do :verb sit :object @chair)
  :expect ((outcome? blocked)
           (reason? already-there)))

(test "stand from chair"
  :setup ((move! @player @chair))
  :action (do :verb stand :object @chair)
  :expect ((outcome? success)
           (loc? @player @terminal-room)))

; === Take/drop with barrier ===

(test-sequence "take PC then blocked at exit"
  (step :action (do :verb take :object @pc)
        :expect ((outcome? success)
                 (held? @pc)))
  (step :action (go :direction south)
        :expect ((outcome? blocked)
                 (reason? tech-property))))

(test-sequence "take PC, drop PC, then exit"
  (step :action (do :verb take :object @pc)
        :expect ((outcome? success)))
  (step :action (do :verb drop :object @pc)
        :expect ((outcome? success)
                 (loc? @pc @terminal-room)))
  (step :action (go :direction south)
        :expect ((outcome? success)
                 (player-at? @cs-2nd))))

; =============================================================================
; TURN-BASED EVENTS - hacker-helps
; =============================================================================
; The hacker-helps event is a 4-stage cutscene triggered by :help behavior.
; Each turn, while the player is in terminal-room, the event advances.

(test "ask hacker for help queues event"
  :action (do :verb help :object @hacker)
  :expect ((outcome? success)
           (queued? hacker-helps)
           (global? hacker-help 0)))

(test "hacker-helps event fires in terminal room"
  :setup ((queue! hacker-helps) (set! hacker-help 0))
  :action (process-events)
  :expect ((outcome? success)
           (context? stage 1)
           (global? hacker-help 1)))

(test-sequence "hacker-helps full 4-stage sequence"
  ; Stage 0->1: "The hacker wanders over..."
  (step :setup ((queue! hacker-helps) (set! hacker-help 0))
        :action (process-events)
        :expect ((outcome? success)
                 (context? stage 1)
                 (global? hacker-help 1)
                 (queued? hacker-helps)))
  ; Stage 1->2: "The hacker, mumbling..."
  (step :action (process-events)
        :expect ((outcome? success)
                 (context? stage 2)
                 (global? hacker-help 2)
                 (queued? hacker-helps)))
  ; Stage 2->3: "The hacker types furiously..."
  (step :action (process-events)
        :expect ((outcome? success)
                 (context? stage 3)
                 (global? hacker-help 3)
                 (queued? hacker-helps)))
  ; Stage 3->done: "The hacker wanders back..." + event dequeues
  (step :action (process-events)
        :expect ((outcome? success)
                 (context? stage 4)
                 (not-queued? hacker-helps)
                 (loc? @hacker @terminal-room))))

(test "hacker-helps event doesn't fire outside terminal room"
  :setup ((queue! hacker-helps) (set! hacker-help 0) (move! @player @cs-2nd))
  :action (process-events)
  :expect ((context? events-processed 0)
           (global? hacker-help 0)))

(test "asking for help when already helping"
  :setup ((queue! hacker-helps))
  :action (do :verb help :object @hacker)
  :expect ((outcome? success)
           (queued? hacker-helps)))

(test "asking for help when already helped"
  :setup ((set! hacker-help 3))
  :action (do :verb help :object @hacker)
  :expect ((outcome? success)))

; =============================================================================
; CONVERSATION - ask-about and tell-about
; =============================================================================
; Note: Conversation behaviors use ?topic binding for the conversation topic.

(test "ask hacker about keys reveals master key"
  :action (do :verb ask-about :object @hacker :topic @keys)
  :expect ((outcome? success)
           (has-flag? @master-key TOUCHBIT)))

(test "ask hacker about keys again - already revealed"
  :setup ((set-flag! @master-key TOUCHBIT))
  :action (do :verb ask-about :object @hacker :topic @keys)
  :expect ((outcome? success)))

(test "ask hacker about food"
  :action (do :verb ask-about :object @hacker :topic @food)
  :expect ((outcome? success)))

(test "hacker is possessed - responds with Meld"
  :setup ((set! lair-cnt 7))
  :action (do :verb ask-about :object @hacker :topic @keys)
  :expect ((outcome? success)))

; =============================================================================
; GIVE/TRADE PUZZLE - trading food for master key
; =============================================================================
; NOTE: These tests are DISABLED pending resolution of the binding design issue.
; The hacker's :give, :trade, :ask-for behaviors use ?object to refer to the
; item being transferred, but ?object is not a standard binding. The behaviors
; are on @hacker, so ?self = @hacker, leaving no standard way to pass the item.
;
; Options to fix:
; 1. Add standard ?item binding for "give X to Y" where X is the item
; 2. Change behaviors to use ?with ("give with X")
; 3. Move behaviors to the item objects with special dispatch
;
; See frotzlm-0l8 for tracking issue.
;
; (test "propose trade - food for key" ...)
; (test "give cold food - rejected" ...)
; etc.

; =============================================================================
; HACKER BLOCKING PC ACTIONS DURING HELP
; =============================================================================

(test "can't turn off PC while hacker helps"
  :setup ((queue! hacker-helps) (set-flag! @pc POWER))
  :action (do :verb turn-off :object @pc)
  :expect ((outcome? blocked)
           (reason? hacker-interference)))

(test "can't unplug PC while hacker helps"
  :setup ((queue! hacker-helps))
  :action (do :verb unplug :object @pc)
  :expect ((outcome? blocked)
           (reason? hacker-interference)))
