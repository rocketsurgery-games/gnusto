; === Aero Building & Tomb ===
; From cs.zil - The Lurking Horror
; The Aeronautical Engineering Building and the secret tomb beneath

; ============================================================
; ROOMS
; ============================================================

(room @aero-lobby
  :description "Aero Lobby"
  :ldesc "This is the lobby of the Aeronautical Engineering Building. Stairs lead down and a corridor heads south towards the main building."
  :flags (ONBIT)
  :exits ((south :to @inf-1)
          (down :to @aero-stairs)))

(room @aero-stairs
  :description "Stairway"
  :ldesc "A dimly lit stairway leads up and down from here. A corridor continues east."
  :flags (ONBIT)
  :exits ((up :to @aero-lobby)
          (east :to @aero-basement)
          (down :to @sub-basement)))

(room @sub-basement
  :description "Subbasement"
  :ldesc "This is the subbasement of the Aeronautical Engineering Building. A stairway leads up. A narrow crack in the northwest corner of the room opens into a larger space."
  :flags (ONBIT)
  :exits ((up :to @aero-stairs)
          (nw :to @tomb :via @tomb-squeeze-barrier)))

(room @tomb
  :description "Tomb"
  :flags (ONBIT)
  :exits ((se :to @sub-basement :via @tomb-squeeze-barrier)
          (out :to @sub-basement :via @tomb-squeeze-barrier)
          (down :to @tunnel :via @tomb-hatch-barrier))
  :globals (@graffiti @padlock @access-hatch)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (str "This is a tiny, narrow, ill-fitting room. It appears to have been a left over space from the joining of two preexisting buildings. It is roughly coffin shaped. The walls are covered by decades of overlaid graffiti, but there is one which is painted in huge fluorescent letters that were apparently impossible for later artists to completely deface. On the floor is a rusty access hatch"
               (cond
                 ((= (:attached-to @padlock) @access-hatch) " locked with a huge padlock")
                 ((has-flag @access-hatch OPENBIT) " which is open")
                 (true ""))
               ".")))))))

; ============================================================
; BARRIERS
; ============================================================

; Tomb squeeze - narrow crack that blocks if carrying heavy items
(object @tomb-squeeze-barrier
  :location @sub-basement
  :description "narrow crack"
  :flags (INVISIBLE)

  :behaviors (
    :through (fn (?dest ?from)
      ; Check if player is carrying anything heavy
      ; TODO: Original ZIL checked total inventory size; for now just check forklift
      (cond
        ((held? @forklift)
          (blocked :reason too-bulky
                   :message "It's too tight a fit carrying that."))
        (true (success))))))

; Access hatch barrier in tomb - checks if hatch is open
(object @tomb-hatch-barrier
  :location @tomb
  :description "access hatch"
  :flags (INVISIBLE)

  :behaviors (
    :through (fn (?dest ?from)
      (cond
        ((= (:attached-to @padlock) @access-hatch)
          (blocked :reason locked :message "The padlock locks the hatch in place."))
        ((not (has-flag @access-hatch OPENBIT))
          (blocked :reason closed :message "The access hatch is closed."))
        (true (success))))))

; ============================================================
; OBJECTS
; ============================================================

; Graffiti - appears in tomb
(object @graffiti
  :location nil  ; Global - appears via room description
  :description "graffiti"
  :flags (NDESCBIT)

  :behaviors (
    :examine (fn ()
      (cond
        ((= (loc @player) @tomb)
          (success :message "It reads \"The Tomb of the Unknown Tool.\""))
        (true
          (blocked :reason not-here :message "You don't see any notable graffiti here."))))))

; Padlock - starts locked to access hatch
(object @padlock
  :location @access-hatch
  :description "padlock"
  :flags (NDESCBIT TAKEBIT TRYTAKEBIT LOCKED OPENABLE)
  :properties (:attached-to @access-hatch)  ; Track what padlock is attached to (nil = not attached)

  :behaviors (
    :examine (fn ()
      (success :message
        (str "The padlock has been spray painted many times by graffiti artists. It's currently fluorescent purple. In spite of the many coats of paint, the lock manages to be rusty and, in fact, almost slimy-looking. The padlock is "
             (if (has-flag ?self LOCKED)
               (str "locked"
                    (if (= (:attached-to @padlock) @access-hatch)
                      " to the hatch"
                      ""))
               "unlocked")
             ".")))

    :take (fn ()
      (cond
        ((= (:attached-to @padlock) @access-hatch)
          (blocked :reason locked :message "The padlock locks the hatch in place."))
        ((held? ?self)
          (blocked :reason already-have :message "You already have it."))
        (true
          '((move ?self @player)
            (success)))))

    ; Bolt cutters are needed to unlock
    :unlock (fn ()
      (cond
        ((not (has-flag ?self LOCKED))
          (success :message "The padlock is already unlocked."))
        (true
          (blocked :reason need-tool :message "You'll need some way to cut through that lock."))))

    :cut (fn ()
      (cond
        ((not (held? @bolt-cutters))
          (blocked :reason need-tool :message "You don't have anything that could cut through that."))
        ((not (has-flag ?self LOCKED))
          (success :message "The padlock is already cut open."))
        (true
          '((clear-flag ?self LOCKED)
            (set @padlock :attached-to nil)
            (move ?self (loc @player))
            (success :message "The bolt cutters slice through the rusty hasp with a satisfying crunch. The padlock falls to the floor.")))))))

; Note: @bolt-cutters is now defined in urchins.grue (obtained from individual urchin)
