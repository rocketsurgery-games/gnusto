; Kitchen - Food puzzle area
; The player must heat the chinese food in the microwave to trade with the hacker.
; See hacker.grue for the trade logic.

; Shared definitions for microwave display
(def temp-names '("off" "warm" "low" "medium" "high"))

(defn format-timer ()
  "Format microwave timer as M:SS string"
  (let ((timer (:timer @microwave))
        (mins (/ timer 60))
        (secs (mod timer 60)))
    (str mins ":" (if (< secs 10) "0" "") secs)))

; Items that can be heated in the microwave
(def heatable-items '(@chinese-food @carton))

(defn heat-microwave-contents-effects ()
  "Return effects to heat items in microwave and check for overcooking.
   Returns a list of effects to be spliced into an effect list."
  ; Compute predicted new heat for overcook check (check happens AFTER heating)
  (let ((temp (:temp @microwave))
        (new-food-heat (+ (prop @chinese-food heat) temp)))
    `(; Heat chinese food if in microwave
      ,@(if (inside? @chinese-food @microwave)
            `((set-prop @chinese-food heat ,new-food-heat))
            '())
      ; Heat carton if in microwave
      ,@(if (inside? @carton @microwave)
            `((set-prop @carton heat ,(+ (prop @carton heat) temp)))
            '())
      ; Overcook chinese food if heat > 20 (after this heating)
      ,@(if (and (inside? @chinese-food @microwave) (> new-food-heat 20))
            '((set @chinese-food :rmung true))
            '()))))

(room @kitchen
  :description "Kitchen"
  :ldesc "This is a filthy kitchen. The exit is to the east. On the wall near a counter are a
  refrigerator and a microwave."
  :rdesc "A grubby 1980s university break-room kitchen: a dirty counter under fluorescent light, no
  windows, a refrigerator and a microwave against the wall."

  :properties (:lit true)
  :exits ((east :to @cs-2nd)))

; === Microwave Oven ===
; Container that heats its contents when running.
; Opening the door stops the microwave (safety interlock).
(object @microwave
  :description "microwave oven"
  :location @kitchen
  :properties (:nodesc true :searchable true :container true :transparent true :openable true :capacity 30 :timer 0 :temp 0)

  :render (fn ()
    (cond
      ((:open self) :open)
      ((queued? microwave-running) :running)
      (true :closed)))
  :rdesc (:open    "A 1980s microwave oven, door open, interior visible, mounted above a kitchen counter."
          :running "A 1980s microwave oven running, interior light on, mounted above a kitchen counter."
          :closed  "A 1980s microwave oven, door closed, mounted above a kitchen counter.")

  :behaviors (
    :examine (fn ()
      `((focus @microwave
          ,(if (queued? microwave-running)
            "The microwave oven hangs over the kitchen counter. It has more complicated controls
            than your PC. There is an LED readout above the controls. The microwave is on."
            (str "The microwave oven hangs over the kitchen counter. It has more complicated
                 controls than your PC. There is an LED readout above the controls. The microwave is off
                 and it's "
                 (if (:open ?self) "open" "closed")
                 ".")))
        (success)))

    :open (fn ()
      (cond
        ((:open ?self)
          (blocked :reason already-open))
        ((queued? microwave-running)
          ; Microwave is running - turn it off when opening
          '((set ?self :open true)
            (dequeue microwave-running)
            (narrate "The microwave oven shuts off, and is now open.")
            (success)))
        (true
          '((set ?self :open true)
            (narrate "The microwave oven is now open.")
            (success)))))

    :close (fn ()
      (cond
        ((not (:open ?self))
          (blocked :reason already-closed))
        (true
          '((set ?self :open false)
            (narrate "The microwave oven is now closed.")
            (success)))))

    ; === LLM Interface Behaviors ===
    ; These are the primary way to interact with the microwave.

    ; Set timer: (do @microwave :set-timer 300) for 5 minutes (300 seconds)
    ; Parameter is in SECONDS - 60 = 1 minute, 300 = 5 minutes
    :set-timer (fn (?seconds :number)
      (let ((mins (/ ?seconds 60))
            (secs (mod ?seconds 60))
            (display (str mins ":" (if (< secs 10) "0" "") secs)))
        (cond
          ((> ?seconds 3600)
            (blocked :reason too-long
                     :context ((description "You can't set it for that long a time."))))
          (true
            `((set @microwave :timer ,?seconds)
              (narrate ,(str "The timer display now reads " display "."))
              (success))))))

    ; Set temperature: (do @microwave :set-temp warm/low/medium/high)
    :set-temp (fn (?level :symbol)
      (cond
        ((queued? microwave-running)
          (blocked :reason running
                   :context ((description "Nothing happens."))))
        ((= ?level 'warm)
          '((set @microwave :temp 1)
            (narrate "The bottom of the display now reads \"WARM\".")
            (success)))
        ((= ?level 'low)
          '((set @microwave :temp 2)
            (narrate "The bottom of the display now reads \"LOW\".")
            (success)))
        ((= ?level 'medium)
          '((set @microwave :temp 3)
            (narrate "The bottom of the display now reads \"MEDIUM\".")
            (success)))
        ((= ?level 'high)
          '((set @microwave :temp 4)
            (narrate "The bottom of the display now reads \"HIGH\".")
            (success)))
        (true
          (blocked :reason unknown-temp
                   :context ((description "Unknown temperature setting. Use warm, low, medium, or high."))))))

    ; Start the microwave: (do @microwave :start)
    :start (fn ()
      (cond
        ((queued? microwave-running)
          (blocked :reason already-running
                   :context ((description "It's already started."))))
        ((:open ?self)
          (blocked :reason door-open
                   :context ((description "Nothing happens, as there's a safety interlock engaged when the door is open."))))
        ((= (:timer @microwave) 0)
          (blocked :reason no-time
                   :context ((description "Nothing happens, as there's no time set on it yet."))))
        ((= (:temp @microwave) 0)
          ; No temp set - default to high (4)
          '((set @microwave :temp 4)
            (queue microwave-running)
            (narrate "The microwave starts up. The timer begins counting down.")
            (success)))
        (true
          '((queue microwave-running)
            (narrate "The microwave starts up. The timer begins counting down.")
            (success)))))

    ; Stop the microwave: (do @microwave :stop)
    :stop (fn ()
      (cond
        ((queued? microwave-running)
          `((dequeue microwave-running)
            (narrate ,(str "The microwave stops. The timer display now reads " (format-timer) "."))
            (success)))
        (true
          (blocked :reason already-off
                   :context ((description "It's already off."))))))

    ; Clear the timer: (do @microwave :clear)
    :clear (fn ()
      (cond
        ((queued? microwave-running)
          (blocked :reason running
                   :context ((description "Nothing happens."))))
        (true
          '((set @microwave :timer 0)
            (narrate "The timer clears to zero.")
            (success)))))

    ; Aliases for turn-on/turn-off
    :turn-on (fn () (redirect :action (do @microwave :start)))
    :turn-off (fn () (redirect :action (do @microwave :stop)))

    :unplug (fn ()
      (blocked :reason inaccessible
               :context ((description "You can't get to the plug."))))))

; === Microwave Controls ===
; Physical buttons: 0-9 (digits), WM/LO/MED/HI (temp), START/STOP/CLEAR
;
; LLM interface uses explicit behaviors on @microwave:
;   (do @microwave :set-timer 120)     ; set to 2:00 (120 seconds)
;   (do @microwave :set-temp high)     ; set temperature (warm/low/medium/high)
;   (do @microwave :start)             ; start cooking
;   (do @microwave :stop)              ; stop cooking
;   (do @microwave :clear)             ; clear timer

(object @controls
  :description "microwave controls"
  :location @kitchen
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      `((focus @controls ,(str "There are controls labelled 0 to 9, WM, LO, MED, HI, START, CLEAR, and STOP. "
                          "The timer display now reads " (format-timer) "."
                          " The display shows \"" (nth temp-names (:temp @microwave)) "\"."))
        (success)))

    ; Redirect push to the microwave's explicit behaviors
    :push (fn ()
      '((narrate "You can set the timer, temperature, and start/stop the microwave.")
        (success)))))

; === LED Readout/Display ===

(object @readout
  :description "display"
  :location @kitchen
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      `((focus @readout ,(str "The display is currently displaying "
                          (if (= (:timer @microwave) 0)
                            "the current time"
                            (format-timer))
                          " and the word \"" (nth temp-names (:temp @microwave)) "\"."))
        (success)))))

; === Kitchen Counter ===

(object @kitchen-counter
  :description "kitchen counter"
  :location @kitchen
  :properties (:nodesc true :open true :container true :searchable true :surface true :capacity 200))

; === Refrigerator ===
; Contains the chinese food carton.

(object @refrigerator
  :description "refrigerator"
  :location @kitchen
  :properties (:nodesc true :searchable true :container true :openable true :readable true :capacity 200)

  :render (fn ()
    (if (:open self) :open :closed))
  :rdesc (:open   "An old white refrigerator, door open, revealing cluttered shelves with soggy lunch bags and old food containers."
          :closed "An old white refrigerator with notes and papers stuck to the front, door closed.")

  :behaviors (
    :examine (fn ()
      `((focus @refrigerator ,(str "This is a medium-sized refrigerator whose door is "
                          (if (:open ?self) "open" "closed")
                          ". There is a sign on the front."))
        (success)))

    :read (fn ()
      '((narrate "\"Everything in this fridge must have a name and date on it!\" (The sign has neither.)")
        (success)))

    :look-inside (fn ()
      (cond
        ((:open ?self)
          '((narrate "The interior of the refrigerator is appalling. There are soggy lunch bags, ancient sandwiches and other less identifiable items.")
            (success)))
        (true
          (blocked :reason closed
                   :context ((description "You have to open it to look in it."))))))

    :unplug (fn ()
      (blocked :reason inaccessible
               :context ((description "You can't get to the plug."))))))

; === Microwave Running Event ===
; Each turn: decrement timer by 60 seconds, heat contents.
; When timer hits 0, stop automatically.
;
; Heating formula (from ZIL): heat += microwave-temp each turn
; Chinese food is "hot enough" at heat >= 12, "overcooked" (RMUNGBIT) at heat > 20
; See heatable-items definition at top of file.

(event microwave-running
  :location @kitchen
  :on-turn
    (let ((new-timer (- (:timer @microwave) 60)))
      (if (<= new-timer 0)
          `((set @microwave :timer 0)
            (dequeue microwave-running)
            ,@(heat-microwave-contents-effects)
            (narrate "The microwave stops.")
            (success :context ((timer-display "0:00"))))
          `((set @microwave :timer ,new-timer)
            ,@(heat-microwave-contents-effects)
            (success :context ((timer-display ,(str (/ new-timer 60) ":"
                                                    (if (< (mod new-timer 60) 10) "0" "")
                                                    (mod new-timer 60)))))))))

; === Cooling Event ===
; Items with a :heat property cool down over time when not being heated.
; Runs globally (not location-gated), queued at game start.
; ZIL: I-COOL runs every 2 turns, decrements heat by 1 every 3 turns.
; Simplified: decrement heat by 1 each time this fires (queued every 2 turns).

(event item-cooling
  :on-turn
    (let ((should-cool (and (> (prop @chinese-food heat) 0)
                            (not (and (inside? @chinese-food @microwave) (queued? microwave-running)))))
          (new-heat (- (prop @chinese-food heat) 1)))
      `(; Cool chinese food if not in running microwave
        ; Use inside? for recursive check - food in carton in microwave also counts
        ,@(if should-cool
              `((set-prop @chinese-food heat ,new-heat))
              '())
        ; Re-queue ourselves for 2 turns from now
        (queue item-cooling 2)
        (success))))
