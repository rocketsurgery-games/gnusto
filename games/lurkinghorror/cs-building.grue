; CS Building - Main floors
; The Computer Science building has 3 floors plus basement and roof.
; Elevator system is in a separate file (elevator.grue).

; === Ground Floor ===

(room @comp-center
  :description "Computer Center"
  :ldesc "This is the lobby of the Computer Center. An elevator and call buttons are to the south. Stairs lead up and down. To the north is Smith Street."
  :properties (:on true :floor 1)
  :exits
    ((north :to @smith-st)
     (out :to @smith-st)
     (up :to @cs-2nd)
     (down :to @cs-basement)
     (south :to @cs-elevator-room :via @elevator-door-1)
     (in :to @cs-elevator-room :via @elevator-door-1))
  :globals (@up-button @down-button))

; === Second Floor (already exists in cs-2nd.grue, update exits) ===
; cs-2nd.grue defines @cs-2nd with exits to @terminal-room and @kitchen

; === Third Floor ===

(room @cs-3rd
  :description "Third Floor"
  :ldesc "This is the third floor of the Computer Center. An elevator and call button are on the south side of the hallway. To the north is a glass wall beyond which you can see a computer room crammed with computer equipment. A stairway leads up."
  :properties (:on true :floor 3)
  :exits
    ((north :to @cs-3rd :via @glass-wall-barrier)  ; blocked by glass wall
     (up :to @cs-roof)
     (out :to @cs-roof)
     (down :to @cs-2nd)
     (south :to @cs-elevator-room :via @elevator-door-3)
     (in :to @cs-elevator-room :via @elevator-door-3))
  :globals (@down-button))

(object @glass-wall-barrier
  :location @cs-3rd
  :description "glass wall"
  :properties (:invisible true)
  :behaviors (
    :through (fn ()
      (blocked :reason glass-wall :message "There is a glass wall in the way."))))

; === Roof ===

(room @cs-roof
  :description "Roof"
  :ldesc "This is the roof of the Computer Center. A door leads to the stairway. The roof is covered with tarred pea gravel and drifted snow. The wind howls around your ears. To the south and southeast you can dimly see the looming shapes of the Great Dome and the Brown Building."
  :properties (:on true :outside true)
  :exits
    ((down :to @cs-3rd)
     (in :to @cs-3rd)))

; === Basement ===
; Full implementation of objects in cs-basement.grue

(room @cs-basement
  :description "Basement"
  :ldesc "Bare concrete walls line a wide corridor leading east and west. The elevator is to the south. Stairs lead up. From floor to ceiling run wire channels and steam pipes."
  :properties (:on true :floor 0)
  :exits
    ((up :to @comp-center)
     (east :to @temporary-basement)
     (west :to @aero-basement)
     (south :to @cs-elevator-room :via @elevator-door-b)
     (in :to @cs-elevator-room :via @elevator-door-b))
  :globals (@up-button))

; === Smith Street (outside) ===

(room @smith-st
  :description "Smith Street"
  :ldesc "Smith Street runs east and west along the north side of the main campus area. At the moment, it is an arctic wasteland of howling wind and drifting snow. On the other side of the street, barely visible, are the lidless eyes of streetlights. The street hasn't been plowed, or if it has been, it did no good."
  :properties (:on true :outside true)
  :exits
    ((south :to @comp-center)
     (in :to @comp-center)
     (east :to @smith-st-2)
     (west :to @smith-st :via @snow-drifts-west))  ; blocked by snow

  :behaviors (
    :on-enter (fn (?from-room)
      (cond
        ; Coming from inside - start freezing
        ((not (:outside ?from-room))
          '((queue freezing)
            (success)))
        (true (success))))))

(room @smith-st-2
  :description "Smith Street"
  :ldesc "Smith Street runs west towards the computer center here. To the south is a dilapidated grey wooden building. The street is an impassable sea of blowing and drifting snow."
  :properties (:on true :outside true)
  :exits
    ((west :to @smith-st)
     (east :to @smith-st-2 :via @snow-drifts-east)  ; blocked by snow
     (south :to @temporary-lab)
     (in :to @temporary-lab))

  :behaviors (
    :on-enter (fn (?from-room)
      (cond
        ((not (:outside ?from-room))
          '((queue freezing)
            (success)))
        (true (success))))))

; === Snow Drift Barriers ===
; Impenetrable snow blocks the street in both directions.

(def snow-drift-behaviors
  '(:through (fn ()
      (blocked :reason snow-drifts :message "Impenetrable snow drifts block the street."))))

(object @snow-drifts-west
  :location @smith-st
  :description "snow drifts"
  :properties (:invisible true)
  :behaviors snow-drift-behaviors)

(object @snow-drifts-east
  :location @smith-st-2
  :description "snow drifts"
  :properties (:invisible true)
  :behaviors snow-drift-behaviors)

; === Freezing Event ===
; When outside in the blizzard, player gradually freezes to death.
; Each stage fires after 4 turns, death after stage 5.
; The :freeze-count property is on @player in lurkinghorror.grue.

(event freezing
  (def messages
    '("Bitter, bone-cracking cold assaults you continuously. The temperature and the blizzard conditions are both horrible."
      "You can feel the cold worming its way through your layers of clothing and biting into your flesh."
      "You can no longer feel the tips of your fingers. As for your toes, they have long since ceased to report."
      "Your eyes are icing up."
      "Each breath you take is like swallowing knives."))

  :on-turn
    (cond
      ; Only freeze if player is outside
      ((not (:outside (loc @player)))
        '((dequeue freezing)
          (set @player :freeze-count 0)
          (success)))
      ; Death after 5 stages
      ((>= (:freeze-count @player) 5)
        (blocked :reason death
                 :context ((death true)
                           (description "You are suffused with a warm, blissful numbness. It is marred only by the knowledge that before you wake again, you will die."))))
      ; Advance freezing
      (true
        (let ((?new-count (+ (:freeze-count @player) 1)))
          `((set @player :freeze-count ,?new-count)
            (queue freezing 4)
            (success :context ((description ,(nth messages (:freeze-count @player))))))))))

; === Office Door ===
; Offices are always inaccessible - this is just flavor.

(object @office-door
  :description "office"
  :location nil  ; Global object, appears in rooms with offices
  :properties (:nodesc true :door true :openable true)
  :behaviors (
    :examine (fn () (success :message "The offices are dark and locked."))
    :open (fn () (blocked :reason locked :message "The offices are inaccessible."))
    :knock (fn () (blocked :reason no-answer :message "No one answers."))))

