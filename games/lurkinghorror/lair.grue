    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-11
  :description "Wet Tunnel"
  :exits
    ((east :to @lair-9)
     (up :to @lair-11)     ; Loop
     (south :to @lair-11)) ; Loop
  :visible (@pool)
  :properties (:point "east")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

; Shared description function for lair maze rooms
(defn lair-describe ()
  (success :context
    ((description "You are lost in narrow, wet tunnels burrowed through the mud. Muddy, oily water covers the floor."))))

; === Outer Lair (slime curtain) ===

(room @outer-lair
  :description "Wet Tunnel"
  :properties (:lit true :point "south")  ; Lit by phosphorescence
  :exits
    ((up :to @lair-5)
     (in :to @inner-lair :via @curtain-door)
     (south :to @inner-lair :via @curtain-door))
  :visible (@curtain-door @pool)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (str "You are lost in narrow, wet tunnels burrowed through the mud. Muddy, oily water covers the floor."
               (if (in? @slime-curtain @outer-lair)
                 " A curtain of moldy slime covers the south wall."
                 (str " There is an ancient door in the south wall. "
                      (if (:open @curtain-door) "It is open." "It is closed."))))))))

    ; Block south movement if curtain present
    :before-action (fn (?verb ?target)
      (cond
        ((and (= ?verb "go") (= ?target "south") (in? @slime-curtain @outer-lair))
          (redirect :action (do @slime-curtain :through)))
        (true (success))))))

; === Inner Lair (final boss room) ===

(room @inner-lair
  :description "Inner Lair"
  :properties (:lit true :point "down")  ; Wan sourceless light
  :exits
    ((up :to @outer-lair :via @curtain-door))
  :visible (@curtain-door @pool)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (str "The floor here is a stagnant, slime infested pool of water. It feels to "
               (if (not (:wearable @boots)) "your sodden feet to " "")
               "be about six inches deep."
               (if (in? @mass @inner-lair)
                 " Ropes or wires tumble down the slope, where they enter a large whitish mass which takes up much of the chamber. The noise is loud here, and comes from the mass, which undulates in synchrony with the noise."
                 "")
               " Wan, sourceless light illuminates the chamber.")))))

    :on-enter (fn (?from)
      ; Lock door, start hacker sequence, hand dives into pool
      '((set @curtain-door :locked true)
        (set @curtain-door :open false)
        (move @hacker @lair-5)
        (queue hacker-returns 2)
        (queue hand-dives -1)
        (success :message "As you enter, the door closes and locks behind you.")))

    :before-action (fn (?verb ?target)
      (cond
        ((and (= ?verb "listen") (not ?target))
          (redirect :action (do @mass :listen)))
        (true (success))))))

; === Pool (global for lair rooms) ===

(object @pool
  :location nil  ; Global
  :description "pool"
  :properties (:nodesc true :vehicle true)
  :behaviors (
    :examine (fn ()
      (cond
        ((= (loc @player) @inner-lair)
          (success :message "The floor is covered by a pool of stagnant water. Near your feet there is a slightly deeper part that seems to have something in it."))
        (true
          (success :message "It's a pool of rather yucky water."))))

    :enter (fn ()
      (blocked :reason already-in :message "You're already standing in it! It covers most of the floor!"))

    :swim (fn ()
      (blocked :reason already-in :message "You're already standing in it! It covers most of the floor!"))

    :look-inside (fn ()
      (cond
        ((= (loc @player) @inner-lair)
          (success :message "You can't see a thing, as the water is foul and murky."))
        (true
          (success :message "It's about as clear as mud."))))

    :reach-in (fn ()
      (cond
        ((= (loc @player) @inner-lair)
          (cond
            ((in? @high-voltage @inner-lair)
              (success :message "You find nothing you would wish to touch again."))
            ((queued? hand-dives)
              '((dequeue hand-dives)
                (move @high-voltage @inner-lair)
                (success :message "You root around blindly in the gooey, slimy water. You feel something thick and slippery! A tentacle? No, it's cold and dead. It seems to be a line of some kind, just below the surface.")))
            (true
              (success :message "You find nothing."))))
        (true
          (success :message "It feels greasy, cold, and generally unpleasant."))))

    :search (fn ()
      (redirect :action (do @pool :reach-in)))

    :drink (fn ()
      (cond
        ((= (loc @player) @inner-lair)
          (blocked :reason disgusting :message "You couldn't bear to drink the water from this pool."))
        (true
          (blocked :reason disgusting :message "The water looks unfit to drink."))))))

; === Slime Curtain ===

(object @slime-curtain
  :location @outer-lair
  :description "slime curtain"
  :properties (:nodesc true :slime-count 0 :nitrogen-count 0)  ; slime progression on player, nitrogen pours

  :behaviors (
    :examine (fn ()
      (success :message "The entire south wall is covered with a curtain of moldy phosphorescent slime. There is something about the slime that makes it appear unhealthy, as though the influences here are bad for anything living."))

    :through (fn ()
      ; Touching the curtain without gloves gets slime on you
      (cond
        ((and (held? @gloves) (:wearable @gloves))
          (success :message "The curtain is very slick and wet. Some of it sticks to your gloves."))
        ((in? @crawling-slime @player)
          (let ((?new-cnt (+ (:slime-count @slime-curtain) 1)))
            `((set @slime-curtain :slime-count ,?new-cnt)
              (success :message "More slime flows onto you."))))
        (true
          '((move @crawling-slime @player)
            (queue slime-attack -1)
            (success :message "The feel is greasy, wet, and at first cold. Then you get a burning sensation, like that from a sea-nettle sting. You jerk away, but some of the slime sticks to you!")))))

    :take (fn ()
      (redirect :action (do @slime-curtain :through)))

    :touch (fn ()
      (redirect :action (do @slime-curtain :through)))

    :attack (fn (?weapon)
      (redirect :action (do @slime-curtain :through)))

    ; Pour nitrogen on curtain to freeze it
    ; Requires 3 pours to fully destroy the curtain
    :pour (fn (?liquid)
      (cond
        ((= ?liquid @nitrogen)
          (let ((?new-cnt (+ (:nitrogen-count @slime-curtain) 1)))
            (cond
              ((< ?new-cnt 3)
                ; Partial freeze - nitrogen is NOT consumed, can pour again
                `((set @slime-curtain :nitrogen-count ,?new-cnt)
                  (success :message "The liquid splashes onto the curtain, and a cold mist fills the room. The slime begins to freeze. Patches of it shatter and fall, but the rest of the slime oozes into the ruined spots, and the curtain appears unharmed.")))
              (true
                ; Final pour - nitrogen IS consumed, curtain destroyed
                `((set @slime-curtain :nitrogen-count ,?new-cnt)
                  (move @nitrogen nil)
                  (dequeue nitrogen-evaporates)
                  (move @slime-curtain nil)
                  (set @curtain-door :invisible false)
                  (success :message "The liquid splashes onto the curtain, and a cold mist fills the room. Nearly the entire curtain solidifies, shatters, and drops to the ground, revealing an ancient wooden door."))))))
        (true
          (blocked :reason wrong-liquid :message "That doesn't seem to have any effect."))))))

; === Crawling Slime (hazard) ===

(def slime-parts '("wrist" "elbow" "bicep" "shoulder" "neck"))

(object @crawling-slime
  :location nil  ; Appears when touching curtain
  :description "crawling slime"
  :behaviors (
    :describe (fn ()
      (cond
        ((in? ?self @player)
          (success :context
            ((description (str "There is slime crawling up your arm. It has reached your "
                              (nth slime-parts (:slime-count @slime-curtain)) ".")))))
        (true (success))))

    :examine (fn ()
      (success :message "It's flowing, dark-green, and undulates slowly as it crawls up your arm."))

    :drop (fn ()
      (blocked :reason stuck :message "You try to scrape it off, but to no avail. It just flows back into place around your arm."))

    :attack (fn ()
      (blocked :reason ineffective :message "There is no effect. You only succeed in hurting your arm."))

    :pour (fn (?liquid)
      (cond
        ((= ?liquid @nitrogen)
          (blocked :reason death
                   :context ((death true)
                             (description "You succeed in pouring the freezing liquid all over your arm. This kills the slime. It also kills you, but then, one must make sacrifices, right?"))))
        (true
          (blocked :reason ineffective :message "That has no effect on the slime."))))))

; Slime attack event - progresses slime up player's arm
(event slime-attack
  :on-turn
    (let ((?new-cnt (+ (:slime-count @slime-curtain) 1)))
      (cond
        ((not (in? @crawling-slime @player))
          '((dequeue slime-attack)
            (success)))
        ((> ?new-cnt 5)
          '((dequeue slime-attack)
            (blocked :reason death
                     :context ((death true)
                               (description "The slime engulfs your nose! You cough, choke, and begin to suffocate! You fall to the floor, splashing in the water. You either suffocate or drown. After you're dead, it makes no difference.")))))
        (true
          `((set @slime-curtain :slime-count ,?new-cnt)
            (success :context
              ((description ,(str "The slime is creeping slowly up your arm! It's reached your "
                                  (nth slime-parts ?new-cnt) ".")))))))))

; === Curtain Door ===

(object @curtain-door
  :location @outer-lair
  :description "ancient door"
  :properties (:invisible true :nodesc true :door true :locked true :openable true)
  :behaviors (
    :examine (fn ()
      (success :message
        (str "This door, blackened by age, is built of ancient, rotting timbers, but still looks very strong. It is set in a rough-hewn arch. Oddly, in addition to an old, rusted-away lock, there is another which looks new and shiny. "
             (if (:open ?self) "It is open." "It is closed."))))

    :open (fn ()
      (cond
        ((:open ?self)
          (blocked :reason already-open :message "It's already open."))
        ((:locked ?self)
          (blocked :reason locked :message "The door is securely locked."))
        (true
          '((set ?self :open true)
            (success :message "The door creaks open.")))))

    :close (fn ()
      (cond
        ((not (:open ?self))
          (blocked :reason already-closed :message "It's already closed."))
        (true
          '((set ?self :open false)
            (success :message "You close the door.")))))

    :unlock (fn (?key)
      (cond
        ((= (loc @player) @inner-lair)
          (blocked :reason wrong-side :message "The lock doesn't appear to work from this side!"))
        ((not (= ?key @master-key))
          (blocked :reason wrong-key :message "That key doesn't fit."))
        ((not (:locked ?self))
          (blocked :reason already-unlocked :message "It's already unlocked."))
        (true
          '((set ?self :locked false)
            (success :message "The door is now unlocked.")))))

    :lock (fn (?key)
      (cond
        ((not (= ?key @master-key))
          (blocked :reason wrong-key :message "That key doesn't fit."))
        ((:locked ?self)
          (blocked :reason already-locked :message "It's already locked."))
        (true
          '((set ?self :locked true)
            (success :message "The door is now locked.")))))

    :attack (fn (?weapon)
      (cond
        ((or (not ?weapon) (= ?weapon @hands))
          (blocked :reason tough :message "You only bruise your hands."))
        (true
          (blocked :reason tough :message "The door is surprisingly solid."))))

    :through (fn ()
      (cond
        ((in? @slime-curtain @outer-lair)
          (blocked :reason hidden :message "You don't see any door here."))
        ((:locked ?self)
          (blocked :reason locked :message "The door is locked."))
        ((not (:open ?self))
          (blocked :reason closed :message "The door is closed."))
        (true (success))))))

; === The Mass ===

(object @mass
  :location @inner-lair
  :description "whitish mass"
  :properties (:nodesc true :person true)
  :behaviors (
    :examine (fn ()
      (success :message "The mass is strangely, even wrongly, shaped. It is hard to get a fix on what's wrong with it, but it doesn't look like it could or should exist in any sane universe. It quivers and bubbles as though air were pumping through it. Many wires, tentacles, and combinations of the two enter the mass from all sides, making it almost fuzzy in appearance."))

    :listen (fn ()
      (success :message "You listen closely to the sounds, which are loud and at first seem random. The more you listen, the more you sense a strange regularity to them. You get impressions, one after another, of electronic music, a simple sine wave pattern, and telephone crosstalk. They are all overlaid with speech, or something like speech, nearer random babbling, or many people talking at once. You can't understand any of it, but it's so near intelligibility that you feel that if you moved closer, you just might get it."))

    :talk-to (fn ()
      (success :message "When you speak, the noise stops, if only briefly. When it resumes, it's more insistent."))

    :give (fn (?item)
      (success :message "There is no reaction that you can detect."))

    :show (fn (?item)
      (success :message "There is no reaction that you can detect."))

    :attack (fn (?weapon)
      (cond
        ((or (not ?weapon) (= ?weapon @hands))
          (blocked :reason death
                   :context ((death true)
                             (description "You approach the mass and grab onto it. Immediately, your mind is overwhelmed with visions and vistas it cannot assimilate. As the mass pulls you into itself, it all becomes clearer, but it's much too late by then."))))
        ((= ?weapon @high-voltage)
          (cond
            ((:rmung @high-voltage)
              ; Tentacles grab you even avoiding the exposed wire
              (blocked :reason death
                       :context ((death true)
                                 (description "Deftly avoiding the exposed wire, the tentacles grab you and pull you into the rippling slime. Immediately, your mind is overwhelmed with visions and vistas it cannot assimilate. As the mass pulls you into itself, it all becomes clearer, but it's much too late by then."))))
            (true
              (blocked :reason death
                       :context ((death true)
                                 (description "The tentacles grab you and pull you into the rippling slime. Immediately, your mind is overwhelmed with visions and vistas it cannot assimilate. As the mass pulls you into itself, it all becomes clearer, but it's much too late by then."))))))
        ((:weapon ?weapon)
          `((move ?weapon nil)
            (success :message ,(str "The " (desc ?weapon) " is engulfed by the mass and disappears. The mass itself is unchanged."))))
        (true
          (blocked :reason ineffective :message "That has no effect on the mass."))))

    :touch (fn ()
      (redirect :action (do @mass :attack @hands)))

    :rub (fn ()
      (redirect :action (do @mass :attack @hands)))))

; === Repeater Box (network interface) ===

(object @repeater
  :location @inner-lair
  :description "metal box"
  :properties (:transparent true :container true :searchable true :openable true)
  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (str "Set on the wall, incongruous in its surroundings, is a metal box. "
               "On one side a coaxial cable enters the box. On the other, a cablelike appendage leads from the box "
               (if (in? @mass @inner-lair) "to the mass" "and ends in a blackened stump")
               ". "
               (if (:open ?self)
                 "The cover is off the box, revealing electronic innards."
                 "There is a metal cover on the box."))))))

    :examine (fn ()
      (success :message
        (str "On one side a coaxial cable enters the box. On the other, a cablelike appendage leads from the box "
             (if (in? @mass @inner-lair) "to the mass" "and ends in a blackened stump")
             ". "
             (if (:open ?self)
               (str "The cover is off the box, revealing electronic innards. Most prominent are a socket "
                    (if (in? @input-cable @input-socket)
                      "into which the coaxial cable is plugged"
                      "(now empty) next to which a coaxial cable hangs")
                    ", and a connector into which the glistening output appendage disappears.")
               "There is a metal cover on the box."))))

    :open (fn ()
      (redirect :action (do @repeater-cover :take)))

    :close (fn ()
      (redirect :action (do @repeater-cover :put @repeater)))))

(object @repeater-cover
  :location @repeater
  :description "metal cover"
  :properties (:takeable true :openable true)
  :behaviors (
    :examine (fn ()
      (success :message "It's a metal cover with simple finger screws to hold it on."))

    :take (fn ()
      (cond
        ((:open @repeater)
          (blocked :reason already-open :message "You already opened it."))
        (true
          `((set @repeater :open true)
            (take ?self)
            (success :message ,(str "You remove the cover, revealing a plethora of electronic innards. Most prominent are a socket "
                                    (if (in? @input-cable @input-socket)
                                      "into which the coaxial cable is plugged"
                                      "(now empty) next to which a coaxial cable hangs")
                                    ", and a connector into which the glistening output appendage disappears."))))))

    :put (fn (?container)
      (cond
        ((= ?container @repeater)
          (cond
            ((not (:open @repeater))
              (blocked :reason already-closed :message "It's already screwed on tightly."))
            (true
              '((set @repeater :open false)
                (move ?self @repeater)
                (success :message "You screw it back on.")))))
        (true (default))))

    :close (fn ()
      (redirect :action (do @repeater-cover :put @repeater)))))

(object @input-cable
  :location @input-socket
  :description "coaxial cable"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      (success :message
        (str "This looks like pretty standard coax to you. It appears almost spontaneously from high in the wall, and enters the box, where "
             (if (:open @repeater)
               (str "it's "
                    (cond
                      ((and (:rmung ?self) (not (in? ?self @input-socket)))
                       "ends next to an empty socket.")
                      ((:rmung ?self)
                       "cut.")
                      ((not (in? ?self @input-socket))
                       "hanging loose next to a socket.")
                      (true
                       "plugged into the socket.")))
               "it disappears from sight."))))

    :unplug (fn ()
      (cond
        ((in? ?self @input-socket)
          '((move ?self @repeater)
            (success :message "You unscrew the cable. It now hangs unconnected inside the box.")))
        (true
          (blocked :reason already-unplugged :message "It's already unplugged."))))

    :take (fn ()
      (cond
        ((in? ?self @input-socket)
          (redirect :action (do ?self :unplug)))
        (true
          (blocked :reason fixed :message "It's threaded through the box: impossible to take."))))

    :plug (fn (?socket)
      (cond
        ((= ?socket @input-socket)
          (cond
            ((in? ?self @input-socket)
              (blocked :reason already-plugged :message "It's already plugged in."))
            ((first (contents @input-socket))
              (blocked :reason occupied :message "There's already something in the socket."))
            (true
              '((move ?self @input-socket)
                (success :message "You screw it back on.")))))
        (true
          (blocked :reason wrong-socket :message "That doesn't fit there."))))

    :cut (fn (?tool)
      (cond
        ((:rmung ?self)
          (blocked :reason already-cut :message "It's already cut."))
        ((or (= ?tool @bolt-cutters) (= ?tool @axe))
          '((set ?self :rmung true)
            (success :message "You neatly snip the cable in two.")))
        (true
          (blocked :reason wrong-tool :message "That won't cut through this cable."))))))

(object @input-socket
  :location @repeater
  :description "socket"
  :properties (:nodesc true :open true :container true :searchable true)
  :behaviors (
    :examine (fn ()
      (cond
        ((in? @input-cable @input-socket)
          (success :message "It has a coaxial cable plugged into it."))
        ((in? @high-voltage @input-socket)
          (success :message "It has a power line jammed into it."))
        (true
          (success :message "It's empty."))))))

(object @output-cable
  :location @repeater
  :description "cablelike appendage"
  :properties (:nodesc true :rmung false)
  :behaviors (
    :examine (fn ()
      (cond
        ((in? @mass @inner-lair)
          (success :message
            (str "This is a cablelike appendage of the mass in the end of the cave. It enters the box and "
                 (cond
                   ((:rmung ?self)
                    "is cut.")
                   ((:open @repeater)
                    "connects to a connector inside it.")
                   (true
                    "disappears from sight."))
                 " The cable twitches periodically.")))
        (true
          (success :message "The cablelike appendage ends in a blackened stump."))))

    :unplug (fn ()
      (blocked :reason fused :message "There is no way to do that. The appendage and its socket blend together indistinguishably."))

    :take (fn ()
      (redirect :action (do @output-cable :unplug)))

    :cut (fn (?tool)
      (cond
        ((:rmung ?self)
          (blocked :reason already-cut :message "It's already cut."))
        ((not (:open @repeater))
          (blocked :reason protected :message "The tentacle whips out of your way."))
        ((or (= ?tool @bolt-cutters) (= ?tool @axe))
          '((set ?self :rmung true)
            (success :message "You cut the tentacle in two inside the box, where it can't get away, precipitating a deafening shriek from the direction of the mass.")))
        (true
          (blocked :reason wrong-tool :message "That won't cut through this appendage."))))

    :attack (fn (?weapon)
      (redirect :action (do @output-cable :cut ?weapon)))))

; === High Voltage Power Line ===

(object @high-voltage
  :location nil  ; Found by searching pool in inner-lair
  :description "power line"
  :properties (:takeable true :weapon true :cut-count 0 :rmung false :powered false)  ; Counter for axe hits when cutting

  :behaviors (
    :examine (fn ()
      (cond
        ((:rmung ?self)
          (success :message "This is one end of a high voltage power line. The conductors are visible within the slashed outer insulation."))
        ((:powered ?self)
          (success :message "This is a thick, hard cable. It reminds you of a high voltage power line."))
        (true
          (success :message "It's still under the water."))))

    :take (fn ()
      (cond
        ((:rmung ?self)
          ; Line is cut - dangerous to take without gloves
          (cond
            ((:powered ?self)
              '((dequeue line-in-water)
                (dequeue hand-dives)
                (take ?self)
                (success :message "You carefully grab the line just as it's about to drop into the water.")))
            ((and (held? @gloves) (:wearable @gloves))
              '((dequeue line-in-water)
                (dequeue hand-dives)
                (take ?self)
                (success :message "Taken.")))
            (true
              '((dequeue line-in-water)
                (dequeue hand-dives)
                (blocked :reason death
                         :context ((death true)
                                   (description "As you foolishly reach into the water for the line, your hands become electrified. Nanoseconds later, the rest of you does as well.")))))))
        (true
          ; Pull line out of water
          '((set ?self :powered true)
            (take ?self)
            (success :message "You pull a length of the line out of the water. It's like holding a large, heavy snake.")))))

    :drop (fn ()
      (cond
        ((:rmung ?self)
          `((move ?self ,(loc @player))
            (queue line-in-water 2)
            (success :message "You release the line.")))
        (true
          `((move ?self ,(loc @player))
            (success :message "You release the line.")))))

    :cut (fn (?tool)
      (cond
        ((:rmung ?self)
          (blocked :reason already-cut :message "It's already cut."))
        ((not (:powered ?self))
          (blocked :reason underwater :message "You splash around in the water, to no avail. You can't see the line."))
        ((= ?tool @axe)
          (let ((?new-cnt (+ (:cut-count @high-voltage) 1)))
            (cond
              ((> ?new-cnt 2)
                `((set @high-voltage :cut-count ,?new-cnt)
                  (set ?self :rmung true)
                  (move ?self ,(loc @player))
                  (queue line-in-water 2)
                  (success :message "The line parts! The two ends begin to sink towards the water as they straighten out.")))
              ((= ?new-cnt 2)
                `((set @high-voltage :cut-count ,?new-cnt)
                  (success :message "Your blow cuts through more insulation and into the conductors.")))
              (true
                `((set @high-voltage :cut-count ,?new-cnt)
                  (success :message "You strike the line with the axe, making a deep gash in the insulation."))))))
        ((= ?tool @bolt-cutters)
          (blocked :reason too-thick :message "The jaws of the bolt cutter won't open far enough to fit around the line."))
        (true
          (blocked :reason inadequate :message "You'd probably have as much success trying to bite it in two."))))

    :plug (fn (?socket)
      (cond
        ((= ?socket @input-socket)
          (cond
            ((not (:rmung ?self))
              (blocked :reason no-end :message "There's no end to the line that you could plug in."))
            ((first (contents @input-socket))
              (blocked :reason occupied :message (str "There's already something in the socket.")))
            (true
              ; This is the key action - plugging in the power line!
              (plug-power-line))))
        (true
          (blocked :reason wrong-socket :message "That doesn't fit there."))))))

; Function to handle plugging the power line into the socket
(defn plug-power-line ()
  (cond
    ((not (and (held? @gloves) (:wearable @gloves)))
      ; No gloves - sparks burn hands
      `((move @high-voltage ,(loc @player))
        (queue line-in-water 2)
        (success :message "You shove the exposed conductors into the socket, producing a shower of sparks! The sparks burn your hands! You jerk back, dropping the line!")))
    ((not (:wearable @boots))
      ; No boots - electrocuted through water
      (blocked :reason death
               :context ((death true)
                         (description "You shove the exposed conductors into the socket, producing a shower of sparks! You are standing in electrified water. You are even grounded. Do you know what this means? Can you say \"dead?\""))))
    ((:rmung @output-cable)
      ; Output cable already cut - just fries the stump
      '((move @high-voltage @input-socket)
        (success :message "You shove the exposed conductors into the socket, producing a shower of sparks! The stump of the tentacle still connected to the connector shrivels and fries.")))
    ((not (queued? frob-appears))
      ; This triggers the endgame!
      `((move @high-voltage @input-socket)
        (dequeue hacker-returns)
        (queue frob-appears -1)
        (success :message ,(str "You shove the exposed conductors into the socket, producing a shower of sparks! The tentacle connected to the other socket begins to jerk and twitch spasmodically. The mass it's connected to quivers, and a horrible noise, almost like a huge machine running without oil, issues from the thing."
                               (if (and (in? @hacker @inner-lair) (not (:invisible @hacker)))
                                 " The hacker screams soundlessly and drops into the water."
                                 "")
                               "\n\nThe mass begins to change shape, compacting, darkening. You can briefly see human outlines within the grey, gelatinous mass. They surround something larger, of a shape not human, not animal, like nothing you've seen before."))))
    (true
      '((move @high-voltage @input-socket)
        (success :message "You shove the exposed conductors into the socket, producing a shower of sparks!")))))

; Event: power line drops into water
(event line-in-water
  :on-turn
    (cond
      ((:powered @high-voltage)
        (cond
          ((not (:wearable @boots))
            '((set @high-voltage :powered false)
              (blocked :reason death
                       :context ((death true)
                                 (description "The exposed ends of the high voltage line drop into the water! Four thousand volts of electricity, only slightly attenuated by the resistance of the water, course through your body! The result is shocking.")))))
          (true
            '((set @high-voltage :powered false)
              (queue line-in-water -1)
              (success :context ((description "The exposed ends of the high voltage line drop into the water! Sparks and bubbles burst from the electrified water.")))))))
      (true
        (cond
          ((not (:wearable @boots))
            (blocked :reason death
                     :context ((death true)
                               (description "Four thousand volts of electricity, only slightly attenuated by the resistance of the water, course through your body! The result is shocking."))))
          (true
            '((queue line-in-water -1)
              (success :context ((description "Sparks and bubbles burst from the electrified water.")))))))))

; === Hand Points Event (navigation help) ===

(event hand-points
  :on-turn
    (cond
      ((and (held? @mummified-hand)
            (:person @mummified-hand)
            (in? @ring @mummified-hand)
            (not (= (loc @player) (:last-pointed-room @mummified-hand))))
        (let ((?point (get-prop (loc @player) :point))
              (?player-loc (loc @player)))
          (cond
            (?point
              `((set @mummified-hand :last-pointed-room ,?player-loc)
                (success :context ((description ,(str "The hand points its mutilated ring finger " ?point " and grips your shoulder tightly."))))))
            (true
              `((set @mummified-hand :last-pointed-room ,?player-loc)
                (success))))))
      (true (success))))

; === Hand Dives Event (in inner-lair) ===

(event hand-dives
  :on-turn
    (cond
      ((and (:person @mummified-hand) (= (loc @player) @inner-lair))
        (cond
          ((held? @mummified-hand)
            '((move @mummified-hand @inner-lair)
              (success :context ((description "Suddenly, the hand leaps from your shoulder into the slime-encrusted puddle. It dives beneath the water.")))))
          ((in? @mummified-hand @inner-lair)
            (success :context ((description "The hand repeatedly dives and bobs to the surface in one part of the pool near your feet."))))
          (true (success))))
      (true (success))))

; === Hacker Returns Event ===

(event hacker-returns
  :on-turn
    (cond
      ((in? @hacker @inner-lair)
        (let ((?stage (+ (:lair-cnt @hacker) 1)))
          (cond
            ((= ?stage 1)
              `((set @hacker :lair-cnt ,?stage)
                (success :context
                  ((description "The hacker stares at the thing in the cave. \"I got very suspicious about your problems with the net. I began to trace some coax, found some repeaters and bridges that weren't on the layout charts, and started following them. Anyway, here I am. That thing there, whatever it is, and those wires, are interfaced to the whole campus net. And that means it's tied into all the nets, commercial, government, even military, potentially.\"")))))
            ((= ?stage 2)
              `((set @hacker :lair-cnt ,?stage)
                (success :context
                  ((description "\"I guess I better do something. It could be a serious compromise of system integrity if this thing isn't dealt with.\" He peers at the mass, as if evaluating it. He then reaches into a pocket and pulls out a small pair of wire strippers.")))))
            ((= ?stage 3)
              `((set @hacker :lair-cnt ,?stage)
                (set @hacker :invisible true)
                (set @hacker :rmung true)
                (success :context
                  ((description "The hacker advances on the mass, apparently planning to cut some of the wires leading into it. As he approaches it, the sound stops completely, and the wires begin a frantic, looping, twining dance. The mass begins to flow towards the hacker almost as quickly as he walks toward it. They reach each other and begin to merge together. He screams; a long, ululating cry that echoes through the cavern. Then he is engulfed.")))))
            ((or (= ?stage 4) (= ?stage 5))
              `((set @hacker :lair-cnt ,?stage)
                (success :context
                  ((description "The mass is bulging, vibrating, and rippling.")))))
            ((= ?stage 6)
              `((set @hacker :lair-cnt ,?stage)
                (success :context
                  ((description "The mass is bulging, vibrating, and rippling. A huge tear is forming near where the hacker was absorbed.")))))
            ((= ?stage 7)
              `((set @hacker :lair-cnt ,?stage)
                (set @hacker :invisible false)
                (success :context
                  ((description "The hacker pulls himself out of the side of the mass. As he does, you think you can see many pairs of eyes appear briefly in the semitransparent mass, watching curiously. Wires and tentacles trail from his body, and tiny, almost rat-like creatures cling to his body everywhere, crawling about like ants. He walks slowly, jerkily towards you. \"Be one!\" he says, haltingly but fervently.")))))
            ((= ?stage 8)
              `((set @hacker :lair-cnt ,?stage)
                (success :context
                  ((description "The hacker grabs for you. \"Join us! Serve the master!\" he croaks. Some of the creatures leap onto you, biting at exposed skin.")))))
            ((>= ?stage 9)
              `((set @hacker :lair-cnt ,?stage)
                (blocked :reason death
                  :context ((death true)
                            (description "The hacker is surprisingly strong. He drags you toward the thing in the corner, exhorting you to join it, and at last, forcibly, you do. You are not the first, or the last.")))))
            (true (success)))))
      ((in? @hacker @outer-lair)
        '((move @hacker @inner-lair)
          (success :context ((description "You hear a stumbling noise behind you, turn and see the hacker staggering into the cavern.\n\nThe hacker stares at you, shocked. \"It's you! When I gave you my key, I never suspected you'd get this far!\"")))))
      ((in? @hacker @lair-5)
        '((queue hacker-returns -1)
          (move @hacker @outer-lair)
          (success :context ((description "You hear noises outside the door.")))))
      (true (success))))

; === The Frob (Final Creature) ===

(object @frob
  :location nil  ; Appears when mass is electrocuted
  :description "thing"
  :properties (:nodesc true :person true :count 0)  ; Counter for final encounter stages

  :behaviors (
    :examine (fn ()
      (success :message "It is not from any wholesome place. It is the stuff of nightmares. It is the thing that waits in the dark, the thing that scratches at your windows late at night. It is not death, for next to this, death is a friend to be cherished."))

    :attack (fn (?weapon)
      (cond
        ((= ?weapon @smooth-stone)
          ; Throwing the stone at the frob
          (cond
            ((= (:count @frob) 1)
              '((move @smooth-stone nil)
                (success :message "The stone hurtles through the air and is swallowed by the black nothing at its center. The creature howls in pain!")))
            ((= (:count @frob) 2)
              `((move @frob nil)
                (move @smooth-stone ,(loc @player))
                (set @smooth-stone :touched false)
                (set score 100)
                (success :context ((victory true)
                          (description "The stone smashes into the creature, sticking to its ichorous hide. The thing thrashes about, trying to bite at the stone, which is glowing brighter and brighter. Small hands issue from beneath its scales to tug in vain at the irritant. The creature begins to show gaping holes of dark, light-devouring nothingness around the stone. Its wings spread painfully, as though it were trying to fly away, and then fold. It widens its jaw in an almost human scream of agony. The black hole of its maw overwhelms it, and indeed the creature appears to be swallowing itself. At last, a grey cloud of greasy smoke surrounds the glowing stone, still suspended in midair. Then even that vanishes, and the stone drops to the ground, no longer glowing. The thing is gone.")))))
            (true
              (blocked :reason invulnerable :message "You can't force yourself to get that close to it."))))
        ((= ?weapon @high-voltage)
          (blocked :reason fear :message "You can't force yourself to get that close to it."))
        (true
          (blocked :reason ineffective :message "Defiantly, the creature shrugs off your puny attack."))))

    :throw (fn (?item)
      (cond
        ((= ?item @smooth-stone)
          (redirect :action (do @frob :attack @smooth-stone)))
        (true
          (blocked :reason ineffective :message "Defiantly, the creature shrugs off your puny attack."))))

    :give (fn (?item)
      (blocked :reason fear :message "You can't force yourself to get that close to it."))

    :talk-to (fn ()
      (blocked :reason incomprehensible :message "It has no ears that you can see, and wouldn't understand you anyway."))))

; === Frob Appears Event ===

(event frob-appears
  :on-turn
    (let ((?stage (+ (:count @frob) 1)))
      (cond
        ((= ?stage 1)
          `((set @frob :count ,?stage)
            (move @hacker nil)
            (move @mass nil)
            (set @output-cable :rmung true)
            (move @frob ,(loc @player))
            (success :context
              ((description ,(str "The gelatinous mass solidifies and compacts, leaving behind a litter of smoking debris. In the debris squats a being. Huge, misshapen, it stares at you with baleful yellow eyes. Its scaly wings beat slowly, driving a fetid stench through the stale air of the cavern. A barbed tongue slides across its broken, daggerlike fangs."
                                 (if (held? @smooth-stone)
                                   "\n\nThe smooth stone vibrates. It starts to feel warm."
                                   "")))))))
        ((= ?stage 2)
          `((set @frob :count ,?stage)
            (success :context
              ((description ,(str "The thing tenses, preparing to leap. Its mouth opens, revealing not the glistening interior, but a dead-black outline like a hole into nothingness."
                                 (if (held? @smooth-stone)
                                   "\n\nThe smooth stone is now glowing with a bright-red heat that nevertheless fails to burn you."
                                   "")))))))
        ((= ?stage 3)
          (cond
            ((in? @frob (loc @player))
              `((set @frob :count ,?stage)
                (blocked :reason death
                         :context ((death true)
                                   (description ,(str "The creature leaps, a mountain falling on you, and the darkness swallows you, never to brighten again."
                                                     (if (held? @smooth-stone)
                                                       "\n\nThe smooth stone, all that's left where you were standing, drops quietly into the pool."
                                                       "")))))))
            (true
              `((set @frob :count ,?stage)
                (success)))))
        (true (success)))))

; === Rubber Boots ===
; These start in @brown-basement and are needed for the power line puzzle

(object @boots
  :location @brown-basement
  :description "pair of rubber boots"
  :properties (:takeable true :wearable false)
  :behaviors (
    :examine (fn ()
      (success :message "They are well-used rubber boots."))

    :wear (fn ()
      (cond
        ((:wearable ?self)
          (blocked :reason already-wearing :message "You're already wearing them."))
        ((not (held? ?self))
          (blocked :reason not-held :message "You're not holding them."))
        (true
          '((set ?self :wearable true)
            (success :message "Snug, but okay.")))))

    :remove (fn ()
      (cond
        ((not (:wearable ?self))
          (blocked :reason not-wearing :message "You're not wearing them."))
        (true
          '((set ?self :wearable false)
            (success :message "You take off the boots.")))))))
