; The Lair - Final dungeon and endgame
; From frob.zil - The Lurking Horror
;
; This file contains:
;   - LAIR-1 through LAIR-11: The wet tunnel maze
;   - OUTER-LAIR: Slime curtain puzzle
;   - INNER-LAIR: Final confrontation with the Mass and Frob
;   - Repeater puzzle (cables and high voltage)
;   - Victory sequence with smooth-stone
;
; Key items needed:
;   - @nitrogen: To freeze slime curtain (from alchemy)
;   - @master-key: To unlock ancient door (from hacker)
;   - @boots: Rubber boots for electrical safety (from brown-basement)
;   - @gloves: For handling power line (from cs-basement)
;   - @axe: To cut power line (from maintenance-man)
;   - @smooth-stone: Final weapon against the Frob (from yuggoth)

; === Lair Maze Rooms ===
; Each room has a :point property indicating the "correct" direction.
; The hand (with ring) will point this direction to guide the player.

(room @lair-1
  :description "Wet Tunnel"
  :exits
    ((up :to @large-chamber)
     (south :to @lair-6)
     (north :to @lair-2)
     (east :to @lair-1))  ; Loop back
  :visible (@pool)
  :properties (:point "north")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-2
  :description "Wet Tunnel"
  :exits
    ((east :to @lair-1)
     (west :to @lair-7)
     (up :to @lair-8)
     (down :to @lair-3))
  :visible (@pool)
  :properties (:point "down")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-3
  :description "Wet Tunnel"
  :exits
    ((west :to @lair-7)
     (south :to @lair-4)
     (north :to @lair-6)
     (east :to @lair-2))
  :visible (@pool)
  :properties (:point "south")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-4
  :description "Wet Tunnel"
  :exits
    ((up :to @lair-3)
     (east :to @lair-10)
     (down :to @lair-10)
     (south :to @lair-5)
     (west :to @lair-11))
  :visible (@pool)
  :properties (:point "south")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-5
  :description "Wet Tunnel"
  :exits
    ((down :to @outer-lair)
     (up :to @lair-5)      ; Loop
     (north :to @lair-4)
     (west :to @lair-3)
     (east :to @lair-11))
  :visible (@pool)
  :properties (:point "down")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-6
  :description "Wet Tunnel"
  :exits
    ((east :to @lair-1)
     (west :to @lair-3)
     (down :to @lair-8)
     (north :to @lair-6))  ; Loop
  :visible (@pool)
  :properties (:point "west")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-7
  :description "Wet Tunnel"
  :exits
    ((west :to @lair-1)
     (down :to @lair-7)    ; Loop
     (up :to @lair-10)
     (east :to @lair-3)
     (south :to @lair-2))
  :visible (@pool)
  :properties (:point "east")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-8
  :description "Wet Tunnel"
  :exits
    ((east :to @lair-2)
     (up :to @lair-6)
     (down :to @lair-9))
  :visible (@pool)
  :properties (:point "east")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-9
  :description "Wet Tunnel"
  :exits
    ((up :to @lair-2)
     (east :to @lair-8)
     (north :to @lair-6)
     (down :to @lair-10))
  :visible (@pool)
  :properties (:point "up")

  :behaviors (
    :describe (fn () (lair-describe))
    :on-exit (fn (?to)
      '((set @mummified-hand :last-pointed-room nil) (set ?self :touched false) (success)))))

(room @lair-10
