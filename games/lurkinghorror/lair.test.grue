; Tests for Lair endgame area

; === Lair Maze Navigation ===


(test-group "lair maze structure"
  :setup ((move! @floor-waxer @inf-5) (set-prop! @urchins freed true))

  (test "lair-1 up exits to large-chamber"
    :setup ((move! @player @lair-1))
    (go :direction up)
    (assert (outcome? success))
    (assert (player-at? @large-chamber)))

  (test "lair-5 down exits to outer-lair"
    :setup ((move! @player @lair-5))
    (go :direction down)
    (assert (outcome? success))
    (assert (player-at? @outer-lair)))
)

(test-group "slime curtain"
  :setup ((move! @player @outer-lair) (move! @slime-curtain @outer-lair) (set @curtain-door :invisible true))

  (test "can examine curtain"
    (do @slime-curtain :examine)
    (assert (outcome? success)))

  (test "curtain blocks south without protection"
    (go :direction south)
    (assert (outcome? success)))

  (test "nitrogen partial freeze keeps nitrogen"
    :setup ((move! @nitrogen @flask) (set-prop! @slime-curtain nitrogen-count 0))
    (do @slime-curtain :pour @nitrogen)
    (assert (outcome? success))
    (assert (in? @slime-curtain @outer-lair))  ; Curtain still there
    (assert (in? @nitrogen @flask)))            ; Nitrogen NOT consumed

  (test "nitrogen destroys curtain on third pour"
    :setup ((move! @nitrogen @flask) (set-prop! @slime-curtain nitrogen-count 2))
    (do @slime-curtain :pour @nitrogen)
    (assert (outcome? success))
    (assert (loc? @slime-curtain nil))    ; Curtain destroyed
    (assert (loc? @nitrogen nil)))        ; Nitrogen consumed
)

(test-group "curtain door"
  :setup ((move! @player @outer-lair) (move! @slime-curtain nil) (set @curtain-door :invisible false) (set @curtain-door :locked true) (set @curtain-door :open false))

  (test "door starts locked"
    (do @curtain-door :open)
    (assert (outcome? blocked)))

  (test "master key unlocks door"
    :setup ((move! @master-key @player))
    (do @curtain-door :unlock @master-key)
    (assert (outcome? success))
    (assert (not-flag? @curtain-door LOCKED)))

  (test "can open unlocked door"
    :setup ((set @curtain-door :locked false))
    (do @curtain-door :open)
    (assert (outcome? success))
    (assert (:open @curtain-door)))

  (test "can go through open door to inner-lair"
    :setup ((set @curtain-door :locked false) (set @curtain-door :open true))
    (go :direction south)
    (assert (outcome? success))
    (assert (player-at? @inner-lair)))
)

(test-group "inner lair mass"
  :setup ((move! @player @inner-lair) (move! @mass @inner-lair))

  (test "can examine mass"
    (do @mass :examine)
    (assert (outcome? success)))

  (test "can listen to mass"
    (do @mass :listen)
    (assert (outcome? success)))

  (test "touching mass is fatal"
    (do @mass :attack @hands)
    (assert (outcome? blocked))
    (assert (death? true)))
)

(test-group "repeater puzzle"
  :setup ((move! @player @inner-lair) (move! @repeater @inner-lair) (move! @input-cable @input-socket) (set @repeater :open false))

  (test "can examine repeater"
    (do @repeater :examine)
    (assert (outcome? success)))

  (test "can take cover to open"
    (do @repeater-cover :take)
    (assert (outcome? success))
    (assert (:open @repeater)))

  (test "can unplug input cable"
    :setup ((set @repeater :open true))
    (do @input-cable :unplug)
    (assert (outcome? success))
    (assert (loc? @input-cable @repeater)))

  (test "can cut output cable with axe"
    :setup ((set @repeater :open true) (move! @axe @player))
    (do @output-cable :cut @axe)
    (assert (outcome? success))
    (assert (:rmung @output-cable)))
)

(test-group "power line"
  :setup ((move! @player @inner-lair) (move! @high-voltage @inner-lair) (set @high-voltage :powered false) (set @high-voltage :rmung false))

  (test "can take power line (pulls it up)"
    (do @high-voltage :take)
    (assert (outcome? success))
    (assert (:powered @high-voltage)))

  (test "need axe to cut line"
    :setup ((set @high-voltage :powered true) (move! @high-voltage @player))
    (do @high-voltage :cut @bolt-cutters)
    (assert (outcome? blocked)))

  (test "axe cuts line after 3 hits"
    :setup ((set @high-voltage :powered true) (move! @high-voltage @player) (move! @axe @player) (set-prop! @high-voltage cut-count 2))
    (do @high-voltage :cut @axe)
    (assert (outcome? success))
    (assert (:rmung @high-voltage)))
)

(test-group "rubber boots"
  :setup ((move! @player @brown-basement))

  (test "boots start in brown-basement"
    (do @boots :examine)
    (assert (outcome? success))
    (assert (loc? @boots @brown-basement)))

  (test "can take boots"
    (do @boots :take)
    (assert (outcome? success))
    (assert (held? @boots)))

  (test "can wear boots"
    :setup ((move! @boots @player))
    (do @boots :wear)
    (assert (outcome? success))
    (assert (:wearable @boots)))
)

(test-group "frob battle"
  :setup ((move! @player @inner-lair) (move! @frob @inner-lair) (move! @smooth-stone @player) (set-prop! @frob count 2))

  (test "throwing stone at frob wins"
    (do @frob :attack @smooth-stone)
    (assert (outcome? success))
    (assert (victory? true))
    (assert (loc? @frob nil)))

  (test "first stone hit at stage 1"
    :setup ((set-prop! @frob count 1))
    (do @frob :attack @smooth-stone)
    (assert (outcome? success))
    (assert (loc? @smooth-stone nil)))
)
