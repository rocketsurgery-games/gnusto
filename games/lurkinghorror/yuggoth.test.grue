; === Tests for Yuggoth nightmare sequence ===
; Tests dream state mechanics, stone pickup, and lurker encounter.

; === Room Connectivity Tests ===

(test "yuggoth connects to bowl-room"
  :setup ((move! @player @yuggoth))
  :action (go :direction down)
  :expect ((outcome? success)
           (player-at? @bowl-room)))

(test "bowl-room connects to platform-room"
  :setup ((move! @player @bowl-room))
  :action (go :direction in)
  :expect ((outcome? success)
           (player-at? @platform-room)))

; === Smooth Stone Tests ===

(test "smooth-stone appears in platform-room"
  :setup ((move! @player @platform-room)
          (move! @smooth-stone @platform-room))
  :action (do @smooth-stone :examine)
  :expect ((outcome? success)))

(test "taking smooth-stone works"
  :setup ((move! @player @platform-room)
          (move! @smooth-stone @platform-room)
          (clear-flag! @smooth-stone TOUCHBIT))
  :action (do @smooth-stone :take)
  :expect ((outcome? success)
           (loc? @smooth-stone @player)))

(test "stone-symbol is inside smooth-stone"
  :setup ()
  :action (do @stone-symbol :examine)
  :expect ((loc? @stone-symbol @smooth-stone)))

; === Platform Tests ===

(test "platform can be examined from bowl-room"
  :setup ((move! @player @bowl-room))
  :action (do @platform :examine)
  :expect ((outcome? success)))

(test "platform enter redirects to movement"
  :setup ((move! @player @bowl-room))
  :action (do @platform :enter)
  :expect ((outcome? success)
           (player-at? @platform-room)))
