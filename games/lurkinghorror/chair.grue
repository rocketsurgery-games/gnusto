(object @chair
  :description "chair"
  :fdesc "Nearby is one of those ugly molded plastic chairs."
  :location @terminal-room

  :rdesc "A molded blue plastic chair, a cheap knock-off of a designer chair and even more uncomfortable. Solid black background."

  :properties (
    :takeable true
    :vehicle true
    :searchable true
    :container true
    :open true
    :furniture true
    :surface true
    :size 100)

  :behaviors (
    :examine (fn ()
      (cond
        (true
          '((focus @chair "It's a molded plastic chair, a cheap knock-off of a designer chair, and even more uncomfortable.") (success)))))

    :take (fn ()
      (cond
        ((in? @hacker @chair)
          (blocked :reason in-use :message "It's in use."))
        (true
          (default))))

    :sit (fn ()
      (cond
        ((in? @hacker @chair)
          (blocked :reason occupied :message "The hacker is already using it."))
        ((in? ?actor @chair)
          (blocked :reason already-there :message "You are."))
        (true
          '((move ?actor @chair)
            (narrate "You are now sitting in the chair.")
            (success)))))

    :stand (fn ()
      (cond
        ((in? ?actor @chair)
          '((move ?actor (loc @chair))
            (narrate "You get out of the chair.")
            (success)))
        (true
          (blocked :reason not-in-vehicle :message "You're not in the chair."))))))
