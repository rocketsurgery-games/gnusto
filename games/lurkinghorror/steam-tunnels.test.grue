; Tests for steam tunnels

; === Cave Altar Tests ===


(test-group "cave altar objects"
  :setup ((move @player @cave-altar))

  (test "knife can be examined"
    (do @knife :examine)
    (assert (outcome? success))
    (assert (context? message "This small knife is clean, sharp, and has a long, thin blade and a wooden handle. Only the tip of the blade appears at all dull or used.")))

  (test "knife can be taken"
    (do @knife :take)
    (assert (outcome? success)))

  (test "slab revulsion prevents touching"
    (do @slab :touch)
    (assert (outcome? blocked)))

  (test "iron plate can be opened"
    (do @iron-plate :open)
    (assert (outcome? success)))

  (test "looking in open pit reveals truth"
    :setup ((set @iron-plate :open true))
    (do @iron-plate :look-inside)
    (assert (outcome? success))
    (assert (prop? @iron-plate pit-seen true)))
)

(test-group "cave altar after seeing pit"
  :setup ((move @player @cave-altar) (set @iron-plate :pit-seen true))

  (test "cannot look in pit after seeing it"
    (do @iron-plate :look-inside)
    (assert (outcome? blocked)))

  (test "cannot open pit after seeing it"
    (do @iron-plate :open)
    (assert (outcome? blocked)))
)

(test-group "pressure valve"
  :setup ((move @player @tunnel-east) (set @pressure-valve :open false) (set @steam-pipes :hot false))

  (test "valve can be turned on"
    (do @pressure-valve :turn)
    (assert (outcome? success))
    (assert (:open @pressure-valve))
    (assert (:hot @steam-pipes)))

  (test "valve can be turned off"
    :setup ((set @pressure-valve :open true) (set @steam-pipes :hot true))
    (do @pressure-valve :turn)
    (assert (outcome? success))
    (assert (not (:open @pressure-valve)))
    (assert (not (:hot @steam-pipes))))
)

(test-group "steam blocking"
  :setup ((move @player @tunnel) (set @pressure-valve :open true) (set @steam-pipes :hot true))

  (test "steam blocks east passage"
    (do @player :go east)
    (assert (outcome? blocked)))
)

(test-group "passage when valve closed"
  :setup ((move @player @tunnel) (set @pressure-valve :open false) (set @steam-pipes :hot false))

  (test "can pass when valve closed"
    (do @player :go east)
    (assert (outcome? success))
    (assert (loc? @player @tunnel-east)))
)

(test-group "brick wall"
  :setup ((move @player @steam-tunnel-east) (set @brick-wall :broken false))

  (test "wall can be pushed through"
    (do @brick-wall :push)
    (assert (outcome? success))
    (assert (prop? @brick-wall broken true)))

  (test "wall can be examined"
    (do @brick-wall :examine)
    (assert (outcome? success)))
)

(test-group "cable climbing"
  :setup ((move @player @tunnel) (set @cable :mounted false))

  (test "can climb onto cable"
    (do @cable :climb)
    (assert (outcome? success))
    (assert (prop? @cable mounted true)))

  (test "can drop from cable"
    :setup ((set @cable :mounted true))
    (do @cable :climb)
    (assert (outcome? success))
    (assert (prop? @cable mounted false)))
)

(test-group "access hatch"
  :setup ((move @player @tunnel) (set @access-hatch :open false))

  (test "hatch can be opened"
    (do @access-hatch :open)
    (assert (outcome? success))
    (assert (:open @access-hatch)))

  (test "hatch can be closed"
    :setup ((set @access-hatch :open true))
    (do @access-hatch :close)
    (assert (outcome? success))
    (assert (not (:open @access-hatch))))
)

(test-group "tunnel navigation"
  :setup ()

  (test "brick tunnel connects north to cave"
    :setup ((move @player @brick-tunnel))
    (do @player :go north)
    (assert (outcome? success))
    (assert (loc? @player @cave-room)))

  (test "cave room connects down to altar"
    :setup ((move @player @cave-room))
    (do @player :go down)
    (assert (outcome? success))
    (assert (loc? @player @cave-altar)))

  (test "cave altar connects up to cave room"
    :setup ((move @player @cave-altar))
    (do @player :go up)
    (assert (outcome? success))
    (assert (loc? @player @cave-room)))
)

(test-group "rats blocking"
  :setup ((move @player @tunnel-west) (move @rats @tunnel-west) (set @cable :mounted false))

  (test "rats block passage when present"
    (go :direction east)
    (assert (outcome? blocked)))

  (test "can examine rats"
    (do @rats :examine)
    (assert (outcome? success)))
)

(test-group "throw food at rats"
  :setup ((move @player @tunnel-west) (move @rats @tunnel-west) (move @chinese-food @player))

  (test "can throw food at rats"
    (do @rats :give @chinese-food)
    (assert (outcome? success))
    (assert (loc? @chinese-food nil)))
)

(test-group "steam kills rats"
  :setup ((move @player @tunnel-west) (move @rats @tunnel-west) (set @pressure-valve :open false) (queue rats-go-away))

  (test "valve kills rats and spawns dead rat"
    :setup ((set @pressure-valve :open true))
    (wait)
    (assert (outcome? success))
    (assert (loc? @rats nil))
    (assert (loc? @dead-rat @tunnel-west)))
)

(test-group "dead rat behaviors"
  :setup ((move @player @tunnel-west) (move @dead-rat @tunnel-west) (set @dead-rat :touched false))

  (test "can examine dead rat"
    (do @dead-rat :examine)
    (assert (outcome? success)))

  (test "first take shows lice"
    (do @dead-rat :take)
    (assert (outcome? success))
    (assert (:touched @dead-rat))
    (assert (held? @dead-rat)))

  (test "can step on dead rat"
    :setup ((move @dead-rat @tunnel-west))
    (do @dead-rat :step-on)
    (assert (outcome? success)))

  (test "can try to eat dead rat"
    :setup ((move @dead-rat @player))
    (do @dead-rat :eat)
    (assert (outcome? success)))
)

(test-group "rat symbol"
  :setup ((move @player @tunnel-west) (move @dead-rat @player))

  (test "can examine rat symbol"
    (do @rat-symbol :examine)
    (assert (outcome? success)))

  (test "can read rat symbol"
    (do @rat-symbol :read)
    (assert (outcome? success)))
)

(test-group "dead rat in elixir"
  :setup ((move @player @alchemy-lab) (set @alchemy-lab :lit true) (move @dead-rat @player) (move @elixir @vat))

  (test "dead rat in elixir comes to life"
    (do @vat :put @dead-rat)
    (assert (outcome? success))
    (assert (loc? @dead-rat nil)))
)
