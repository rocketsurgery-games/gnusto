; === Puzzle Objects ===
; These are stub definitions for testing the hacker trade puzzle.
; Full definitions would come from converted/objects.grue

(object @master-key
  :description "master key"
  :location @hacker  ; On hacker's keyring initially
  :flags (TAKEBIT KEYBIT)
  :properties ())

(object @keyring
  :description "keyring"
  :location @hacker
  :flags (CONTBIT)
  :properties ())

(object @carton
  :description "white carton"
  :location @player  ; Player starts with it for testing
  :flags (TAKEBIT CONTBIT OPENBIT)
  :properties ())

(object @chinese-food
  :description "chinese food"
  :location @carton  ; Inside the carton
  :flags (FOODBIT)
  :properties (:heat 0))  ; 0=cold, 12+=hot, higher=overcooked

(object @snack
  :description "snack"
  :location @terminal-room
  :flags (TAKEBIT FOODBIT)
  :properties ())

(object @coke
  :description "coke"
  :location @terminal-room
  :flags (TAKEBIT)
  :properties ())

