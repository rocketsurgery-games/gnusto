(object @master-key
  :description "master key"
  :location nil  ; Starts hidden - moves to @keyring when hacker reveals it
  :properties (
    :takeable true
    :key true
    :touched false))

(object @keyring
  :description "keyring"
  :location @hacker
  :properties (
    :container true
    :open true
    :nodesc true   ; nodesc hides from room listing; searchable makes it searchable
    :searchable true)

  :rdesc "A keyring crowded with many keys hanging from it. Solid black background.")

(object @carton
  :description "white carton"
  :location @refrigerator  ; In the kitchen refrigerator
  :properties (
    :takeable true
    :container true
    :open true
    :heat 0)  ; Heatable object - can be warmed in microwave

  :rdesc "A white Chinese-food takeout carton with a strange, occult-looking symbol on the front. Solid black background."

  :behaviors (
    :examine (fn ()
      (cond
        ((and (in? @chinese-food @carton) (> (prop @chinese-food heat) 8))
         '((focus @carton "It's a Chinese food carton with a symbol on the front. The carton feels warm.") (success)))
        (true
         '((focus @carton "It's a Chinese food carton with a symbol on the front.") (success)))))

    :read (fn ()
      '((narrate "The symbol doesn't look like Chinese, English, or any other language you know. It looks more like an occult symbol.") (success)))

    :eat (fn ()
      (blocked :reason inedible
        :message "You might find the contents more agreeable than the carton itself."))))

; Helper: temperature description for heated food/drink
(defn heat-desc (?obj)
  (let ((?h (prop ?obj heat)))
    (cond
      ((>= ?h 20) "radioactive")
      ((>= ?h 16) "volcanic")
      ((>= ?h 12) "hot")
      ((>= ?h 8) "warm")
      ((>= ?h 4) "lukewarm")
      (true "cold"))))

(object @chinese-food
  :description "Chinese food"
  :location @carton  ; Inside the carton
  :properties (:food true :heat 0 :rmung false)  ; 0=cold, 12+=hot, higher=overcooked

  :behaviors (
    :examine (fn ()
      `((focus @chinese-food ,(str "This is a carton of " (heat-desc ?self)
        " Szechuan shrimp. Lovely red peppers poke out of the sauce.")) (success)))

    :take (fn ()
      (cond
        ((in? ?self @carton)
         (blocked :reason spill
           :message "If you take it out, it will spill all over you. Why not take the carton instead?"))
        (true
         '((take ?self)
           (narrate "Taken.")
           (success)))))

    :eat (fn ()
      `((move ?self nil)
        (narrate ,(str "It's very (chemically) hot, spicy, and " (heat-desc ?self)
                       ". You immediately want to drink something to wash it down."))
        (success)))

    :taste (fn ()
      `((narrate ,(str "It's very (chemically) hot, spicy, and " (heat-desc ?self) ".")) (success)))))

(object @snack
  :description "package of Funny Bones"
  :location @kitchen-counter  ; In ZIL: (IN KITCHEN-COUNTER)
  :properties (:takeable true :food true :readable true :openable true :heat 0 :rmung false)

  :behaviors (
    :examine (fn ()
      (let ((?state (cond
                      ((:rmung ?self) "an empty")
                      ((:open ?self)
                       (if (> (prop ?self heat) 0)
                           (str "an open, " (heat-desc ?self))
                           "an open"))
                      (true "a"))))
        `((focus @snack ,(str "This is " ?state " package of Funny Bones, a snack food made with peanut butter and chocolate cake.")) (success))))

    :read (fn ()
      '((narrate "The wrapper says \"Funny Bones\" in colorful letters.") (success)))

    :open (fn ()
      (cond
        ((:open ?self)
         (blocked :reason already-open :message "It's already open."))
        (true
         '((set ?self :open true)
           (narrate "You open the package, revealing yummy junk food inside.")
           (success)))))

    :eat (fn ()
      (cond
        ((:rmung ?self)
         (blocked :reason empty :message "You already did. There's nothing left but the wrapper."))
        ((> (prop ?self heat) 12)
         (blocked :reason too-hot :message "You discover that they are too hot to eat."))
        ((:open ?self)
         '((set ?self :rmung true)
           (narrate "You devour the delicious food-like substance.")
           (success)))
        (true
         '((set ?self :open true)
           (set ?self :rmung true)
           (narrate "You tear open the package and devour the delicious food-like substance.")
           (success)))))))

(object @coke
  :description "two liter bottle of Classic Coke"
  :location @refrigerator  ; In ZIL: (IN REFRIGERATOR)
  :properties (:takeable true :food true :openable true :size 5 :heat 0)  ; size: 5=full, 4=partly empty, 3=partly full, 2=nearly empty, 1=empty

  :behaviors (
    :examine (fn ()
      (let ((?siz (prop ?self size))
            (?fullness (cond
                         ((= ?siz 1) "n empty")
                         ((= ?siz 2) " nearly empty")
                         ((= ?siz 3) " partly full")
                         ((= ?siz 4) " partly empty")
                         (true " full"))))
        `((focus @coke ,(str "This is a" ?fullness " two-liter bottle of "
                             (if (> ?siz 1) (str (heat-desc ?self) " ") "")
                             "Classic Coke.")) (success))))

    :taste (fn ()
      '((narrate "Tastes like the real thing.") (success)))

    :drink (fn ()
      (cond
        ((> (prop ?self size) 1)
         '((dec ?self :size)
           (narrate "Delicious! Contains caffeine, one of the four basic food groups. Too bad they make it with fructose these days, instead of sucrose. You feel much more alert and awake now.")
           (success)))
        (true
         (blocked :reason empty :message "The bottle is empty."))))

    :open (fn ()
      '((narrate "You fiddle with the cap for a while. What fun! Much better than working on your paper.") (success)))

    :close (fn ()
      '((narrate "You fiddle with the cap for a while. What fun! Much better than working on your paper.") (success)))))

; === Conversation Topics (abstract nouns for ASK/TELL ABOUT) ===
; NOTE: @students is defined in alchemy.grue, @urchins in urchins.grue,
; @lovecraft in alchemy.grue (physical computer), @repeater in lair.grue (physical box).

(object @keys
  :description "keys"
  :location nil
  :properties (:invisible true))

(object @food
  :description "food"
  :location nil
  :properties (:invisible true :known true))

(object @program
  :description "the program"
  :location nil
  :properties (:invisible true :known true))

(object @hand
  :description "your hand"
  :location @player
  :properties (:invisible true :nodesc true))
