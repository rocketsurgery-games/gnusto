; The Lurking Horror - Full Walkthrough Test
; Tests the complete happy path through the game using only player-accessible actions.
;
; Phases:
;   1. PC Login & Dream Sequence - get smooth-stone
;   2. Master Key - trade food for key
;   3. Basement & Equipment - get gloves, crowbar, flask
;   4. Infinite Corridor - get axe from emergency cabinet
;   5. Alchemy Lab - survive ritual, get ring and animate hand
;   6. Urchins - show hand to get bolt cutters, free urchins
;   7. Lair Maze & Final Battle - navigate maze, defeat the Frob
;
; NOTE: Tests marked [WIP] depend on game areas not yet fully implemented.

; =============================================================================
; ACTION LIST DEFINITIONS (must come before tests that use them)
; =============================================================================

; Turn on the PC (player starts in terminal-room, in chair)
(def walkthrough/turn-on-pc
  '((do @chair :sit)
    (do @pc :turn-on)))

; =============================================================================
; INFRASTRUCTURE TESTS
; =============================================================================

; Test new sequential (test) form with bare (do) calls
(test "sequential-test-basic"
  (do @chair :sit)
  (do @pc :turn-on)
  (assert (:powered @pc)))

; Test (run) with action list
(test "run-action-list"
  (run walkthrough/turn-on-pc)
  (assert (:powered @pc)))

; Test assert works
(test "assert-passes"
  :setup ((move @player @terminal-room))
  (assert (loc? @player @terminal-room)))

; Test until loop - the waxer scenario
(test "until-waxer-movement"
  :setup ((move @player @inf-1))
  ; Keep trying to go east until we reach inf-5
  ; The waxer may block us, but wait/process-events should let it pass
  (until (loc? @player @inf-5)
    (do @movement :go east)
    (wait)))

; =============================================================================
; PHASE 1: PC LOGIN & DREAM SEQUENCE
; =============================================================================

(test "walkthrough-phase1-pc-on"
  (run walkthrough/turn-on-pc)
  (assert (:powered @pc)))

; =============================================================================
; PHASE 2: MASTER KEY (from hacker trade)
; =============================================================================

; Navigate from terminal-room to kitchen
(def walkthrough/to-kitchen
  '((do @movement :go south)    ; cs-2nd
    (do @movement :go west)     ; kitchen (via door)
    (do @movement :go north)))  ; kitchen

; Get food from refrigerator
(def walkthrough/get-food
  '((do @refrigerator :open)
    (do @carton :take)))

; Heat food in microwave
(def walkthrough/heat-food
  '((do @microwave :open)
    (do @carton :put @microwave)
    (do @microwave :close)
    (do @microwave :set-timer 300)
    (do @microwave :start)))

; Retrieve heated food from microwave
(def walkthrough/get-heated-food
  '((do @microwave :open)
    (do @carton :take)))

; Return from kitchen to terminal-room
(def walkthrough/kitchen-to-terminal
  '((do @movement :go south)    ; kitchen-hallway
    (do @movement :go east)     ; cs-2nd
    (do @movement :go north)))  ; terminal-room

; Trade food for master key
(def walkthrough/trade-for-key
  '((do @hacker :ask-about @keys)   ; Reveals master key
    (do @hacker :trade @carton @master-key)
    (do @hacker :give @carton)))

(test "walkthrough-phase2-master-key"
  ; Navigate to kitchen
  (run walkthrough/to-kitchen)

  ; Get food from refrigerator
  (run walkthrough/get-food)
  (assert (held? @carton))

  ; Heat food in microwave
  (run walkthrough/heat-food)

  ; Wait for food to heat (chinese-food needs heat >= 12)
  (until (>= (prop @chinese-food heat) 12)
    (wait))

  ; Retrieve heated food
  (run walkthrough/get-heated-food)
  (assert (held? @carton))

  ; Return to terminal room
  (run walkthrough/kitchen-to-terminal)

  ; Trade with hacker
  (run walkthrough/trade-for-key)
  (assert (held? @master-key)))

; =============================================================================
; PHASE 3: BASEMENT & EQUIPMENT
; =============================================================================

; Get equipment from temporary basement
(def walkthrough/get-basement-equipment
  '((do @gloves :take)
    (do @crowbar :take)))

(test "walkthrough-phase3-basement-equipment"
  :setup ((move @player @temporary-basement))

  ; Get basement equipment
  (run walkthrough/get-basement-equipment)
  (assert (held? @gloves))
  (assert (held? @crowbar)))

; Use forklift to clear junk in dead-storage
; NOTE: Vehicle movement (driving forklift between rooms) requires runtime support
; This test verifies the forklift/junk interaction works when in position
(test "walkthrough-phase3-forklift"
  :setup ((move @forklift @dead-storage)  ; Pre-position forklift at dead-storage
          (move @player @forklift)         ; Player starts on forklift
          (set @forklift :powered true)       ; Forklift already running
          (set @junk :moved 0))              ; Reset junk counter

  ; Verify initial state
  (assert (in? @player @forklift))
  (assert (loc? @forklift @dead-storage))

  ; Use forklift to clear junk (need 4 uses to clear path)
  (do @forklift :use @junk)
  (do @forklift :use @junk)
  (do @forklift :use @junk)
  (do @forklift :use @junk)
  (assert (> (:moved @junk) junk-moves-needed)))

; Open manhole in storage-room
(test "walkthrough-phase3-manhole"
  :setup ((move @player @storage-room)
          (move @crowbar @player))

  ; Pry open manhole cover with crowbar
  (do @manhole-cover :pry @crowbar)
  (assert (not (in? @manhole-cover @manhole))))

; =============================================================================
; PHASE 4: INFINITE CORRIDOR & MAINTENANCE MAN
; =============================================================================

; Get floor wax and container
(def walkthrough/get-floor-wax
  '((do @plastic-container :take)
    (do @plastic-container :open)))

; Cut power cord with axe
(def walkthrough/cut-power-cord
  '((do @power-cord :cut)))

(test "walkthrough-phase4-maintenance-waxer"
  :setup ((move @player @inf-1)
          (move @floor-waxer @inf-2)
          (move @maintenance-man @floor-waxer)
          (set @floor-waxer :patrol-started true))

  ; Get floor wax container
  (run walkthrough/get-floor-wax)
  (assert (held? @plastic-container))

  ; Navigate through corridor (waxer may block, but keep trying)
  (until (loc? @player @inf-5)
    (do @movement :go east)
    (wait)))

(test "walkthrough-phase4-cut-cord"
  :setup ((move @player @inf-3)
          (move @floor-waxer @inf-3)
          (move @axe @player)
          (set @power-cord :severed false))

  ; Cut the power cord to disable waxer
  (do @power-cord :cut)
  (assert (prop? @power-cord severed true)))

; =============================================================================
; PHASE 5: ALCHEMY LAB
; =============================================================================

; Test knocking on door gets professor to answer
(test "walkthrough-phase5-knock-door"
  :setup ((move @player @chemistry-bldg)
          (set @professor :dead false)
          (set @professor :visited false))

  ; Knock and wait for answer
  (do @alchemy-door :knock)
  (until (loc? @player @alchemy-dept)
    (wait))

  ; Should now be in alchemy dept with professor
  (assert (loc? @player @alchemy-dept))
  (assert (in? @professor @alchemy-dept)))

; Test showing note to professor
(test "walkthrough-phase5-show-note"
  :setup ((move @player @alchemy-dept)
          (move @professor @alchemy-dept)
          (move @note @player)
          (set @professor :seen-note false)
          (set @professor :mad false))

  ; Show note to professor
  (do @professor :give @note)
  (assert (:seen-note @professor)))

; Test entering lab - professor escorts us
(test "walkthrough-phase5-enter-lab"
  :setup ((move @player @alchemy-dept)
          (move @professor @alchemy-dept)
          (set @professor :seen-note true)
          (set @professor :ritual-stage 0))

  ; Enter lab - professor escorts and triggers ritual
  (do @movement :go south)
  (assert (loc? @player @alchemy-lab))
  (assert (in? @professor @alchemy-lab)))

; Test escaping the ritual
(test "walkthrough-phase5-escape-ritual"
  :setup ((move @player @pentagram)  ; Trapped in pentagram
          (move @professor @alchemy-lab)
          (move @knife @player)
          (set @professor :ritual-stage 3)  ; Ritual in progress
          (set @lab-bench :moved false)
          (set @pentagram :rmung false)
          (set @alchemy-trap-door :open false))

  ; Cut pentagram with knife
  (do @pentagram :cut @knife)
  (assert (:rmung @pentagram))

  ; Exit pentagram
  (do @pentagram :exit)
  (assert (loc? @player @alchemy-lab))

  ; Move lab bench to reveal trapdoor
  (do @lab-bench :move)
  (assert (:moved @lab-bench))

  ; Open trapdoor and escape
  (do @alchemy-trap-door :open)
  (assert (:open @alchemy-trap-door))

  ; Go down to escape
  (do @movement :go down)
  (assert (loc? @player @under-alchemy-lab)))

; Test ritual survival - professor dies when player escapes
; NOTE: The professor-ritual event has :location @alchemy-lab which restricts
; where it runs. This test verifies the final state can be set directly.
(test "walkthrough-phase5-ritual-complete"
  :setup ((move @player @under-alchemy-lab)
          (set @professor :dead true)  ; Simulate ritual completion
          (set @professor :ritual-stage 0))

  ; Professor should be dead after ritual
  (assert (:dead @professor))
  (assert (loc? @player @under-alchemy-lab)))

; Test getting ring after professor dies
(test "walkthrough-phase5-get-ring"
  :setup ((move @player @under-alchemy-lab)
          (set @professor :dead true)
          (set @lab-bench :moved true)
          (set @alchemy-trap-door :open true)
          (move @ring @alchemy-lab))  ; Ring left behind

  ; Go back up to lab
  (do @movement :go up)
  (assert (loc? @player @alchemy-lab))

  ; Take the ring
  (do @ring :take)
  (assert (held? @ring)))

; Test animating the mummified hand
(test "walkthrough-phase5-animate-hand"
  :setup ((move @player @alchemy-lab)
          (move @mummified-hand @player)
          (move @vat @lab-bench)
          (move @elixir @vat)
          (set @mummified-hand :person false)
          (set @mummified-hand :animation-count 0))

  ; Dip hand in vat (put INTO vat)
  (do @vat :put @mummified-hand)
  (assert (in? @mummified-hand @vat))

  ; Wait for hand to animate (3 stages)
  (until (:person @mummified-hand)
    (wait))

  (assert (:person @mummified-hand)))

; Test putting ring on animated hand
(test "walkthrough-phase5-ring-on-hand"
  :setup ((move @player @alchemy-lab)
          (move @mummified-hand @player)
          (move @ring @player)
          (set @mummified-hand :person true))

  ; Put ring on animated hand
  (do @ring :put-on @mummified-hand)
  (assert (in? @ring @mummified-hand)))

; =============================================================================
; PHASE 6: URCHINS
; =============================================================================

; Test urchin barrier blocks passage until freed
(test "walkthrough-phase6-urchin-barrier"
  :setup ((move @player @large-chamber)
          (set @urchins :freed false))

  ; Try to go down - should be blocked by urchins
  (do @movement :go down)
  (assert (loc? @player @large-chamber)))  ; Still here, blocked

(test "walkthrough-phase6-urchins-freed"
  :setup ((move @player @large-chamber)
          (set @urchins :freed true))

  ; Can now pass through to lair
  (do @movement :go down)
  (assert (loc? @player @lair-1)))

; Test showing animated hand to urchin - he drops bolt cutters
(test "walkthrough-phase6-show-hand"
  :setup ((move @player @aero-lobby)
          (move @urchin @aero-lobby)
          (move @mummified-hand @player)
          (set @mummified-hand :person true)  ; Hand is animated
          (move @bolt-cutters @urchin)
          (set @bolt-cutters :invisible true))

  ; Show animated hand to urchin
  (do @urchin :show @mummified-hand)

  ; Urchin should flee and drop bolt cutters
  (assert (not (in? @urchin @aero-lobby)))  ; Urchin fled
  (assert (in? @bolt-cutters @aero-lobby))) ; Bolt cutters dropped here

; Test taking bolt cutters after urchin drops them
(test "walkthrough-phase6-get-bolt-cutters"
  :setup ((move @player @aero-lobby)
          (move @bolt-cutters @aero-lobby)
          (set @bolt-cutters :invisible false))

  ; Take the bolt cutters
  (do @bolt-cutters :take)
  (assert (held? @bolt-cutters)))

; Test cutting urchin wire to free them
(test "walkthrough-phase6-cut-wire"
  :setup ((move @player @large-chamber)
          (move @bolt-cutters @player)
          (move @urchin-wire @large-chamber)
          (set @urchins :freed false))

  ; Cut the wire with bolt cutters
  (do @urchin-wire :cut @bolt-cutters)
  (assert (prop? @urchins freed true)))

; =============================================================================
; PHASE 7: LAIR MAZE & FINAL BATTLE
; =============================================================================

; Test basic lair navigation
(test "walkthrough-phase7-lair-entry"
  :setup ((move @player @lair-1)
          (move @mummified-hand @player)
          (set @mummified-hand :person true)
          (move @ring @mummified-hand))

  ; Hand should help navigate - for now just test we can move
  (do @movement :go north)  ; lair-2
  (assert (not (loc? @player @lair-1))))

; Test freezing slime curtain with nitrogen (final pour)
; NOTE: In the real game, you pour 3 times. This test verifies the final pour works.
(test "walkthrough-phase7-freeze-curtain"
  :setup ((move @player @outer-lair)
          (move @slime-curtain @outer-lair)
          (move @nitrogen @player)
          (set @slime-curtain :nitrogen-count 2))  ; Already poured 2 times

  ; Final pour destroys curtain
  (do @slime-curtain :pour @nitrogen)

  ; Curtain should be destroyed
  (assert (not (in? @slime-curtain @outer-lair))))

; Test unlocking and opening the ancient door
(test "walkthrough-phase7-unlock-door"
  :setup ((move @player @outer-lair)
          (move @slime-curtain nil)  ; Curtain destroyed
          (set @curtain-door :invisible false)
          (set @curtain-door :locked true)
          (set @curtain-door :open false)
          (move @master-key @player))

  ; Unlock door with master key
  (do @curtain-door :unlock @master-key)
  (assert (not (:locked @curtain-door)))

  ; Open the door
  (do @curtain-door :open)
  (assert (:open @curtain-door)))

; Test entering inner lair - direct move for simplicity
; The full barrier mechanics are tested in lair.test.grue
(test "walkthrough-phase7-enter-lair"
  :setup ((move @player @inner-lair))

  ; Verify we're in inner lair
  (assert (loc? @player @inner-lair)))

; Test finding power line in pool
(test "walkthrough-phase7-find-powerline"
  :setup ((move @player @inner-lair)
          (move @high-voltage nil)
          (queue hand-dives))

  ; Search pool to find power line
  (do @lair-pool :reach-in)
  (assert (in? @high-voltage @inner-lair)))

; Test cutting power line with axe
(test "walkthrough-phase7-cut-powerline"
  :setup ((move @player @inner-lair)
          (move @high-voltage @player)
          (set @high-voltage :powered true)  ; Pulled out of water
          (set @high-voltage :rmung false)
          (move @axe @player)
          (set @high-voltage :cut-count 0))

  ; Cut power line 3 times with axe
  (do @high-voltage :cut @axe)
  (do @high-voltage :cut @axe)
  (do @high-voltage :cut @axe)

  ; Line should be cut (exposed conductors)
  (assert (:rmung @high-voltage)))

; Test power line is plugged into socket (end state)
; NOTE: The plug action has complex logic tested elsewhere.
; This test verifies the final state where power line is plugged in.
(test "walkthrough-phase7-plug-powerline"
  :setup ((move @player @inner-lair)
          (move @high-voltage @input-socket)  ; Already plugged in
          (set @high-voltage :rmung true)
          (set @output-cable :rmung true)
          (move @frob @inner-lair)
          (set @frob :count 1))  ; Frob has appeared

  ; Verify power line is in socket and frob is present
  (assert (in? @high-voltage @input-socket))
  (assert (in? @frob @inner-lair)))

; Test throwing stone at frob for victory
(test "walkthrough-phase7-victory"
  :setup ((move @player @inner-lair)
          (move @frob @inner-lair)
          (move @smooth-stone @player)
          (set @frob :count 2))  ; Stone is glowing hot

  ; Throw stone at frob
  (do @frob :attack @smooth-stone)

  ; Victory! Frob should be destroyed
  (assert (not (in? @frob @inner-lair)))
  (assert (= score 100)))

; =============================================================================
; FULL WALKTHROUGH (END-TO-END)
; =============================================================================
;
; This test runs through the complete happy path of The Lurking Horror.
; It starts from the default game state (player in terminal-room) and ends
; with victory in the inner-lair.
;
; The test uses `:setup` in a few places for mechanics that require
; implementation beyond simple actions (vehicle driving, complex barriers).
; These are marked with "SETUP:" comments explaining what's skipped.
;
; Key items collected:
;   - @smooth-stone: From nightmare sequence (Phase 1)
;   - @master-key: Trade with hacker (Phase 2)
;   - @gloves: From temporary-basement (Phase 3)
;   - @crowbar: From temporary-basement (Phase 3)
;   - @flask/@nitrogen: From temporary-lab (Phase 3)
;   - @boots: From brown-basement (Phase 3)
;   - @axe: From maintenance-man (Phase 4)
;   - @knife: From cave-altar (Phase 4)
;   - @mummified-hand: From steam tunnels (Phase 4)
;   - @ring: From alchemy-lab after ritual (Phase 5)
;   - @bolt-cutters: From urchin (Phase 6)

; =============================================================================
; PHASE 1: PC LOGIN & DREAM SEQUENCE
; =============================================================================
; Player logs into PC, reads the strange paper, gets transported to Yuggoth,
; takes the smooth-stone, and wakes back in the terminal room.

(test "walkthrough-full"
  ; --- Phase 1: PC Login & Dream Sequence ---
  ; Turn on PC and log in (no need to sit - can use PC while standing)
  (do @pc :turn-on)
  (do @pc :login "xyzzy")
  (do @pc :password "plugh")
  (assert (:powered @pc))
  (assert (prop? @pc logged-in true))

  ; Navigate to odd-paper and trigger compulsion
  (do @menu-box :click)
  (do @yak-window :click)
  (assert (in? @odd-paper @pc))
  (assert (in? @more-box @pc))

  ; Read the odd-paper to start possession/compulsion
  (do @odd-paper :read)
  (assert (queued? compulsion))

  ; Let compulsion advance through all 4 pages (we're in terminal-room)
  ; Compulsion is queued with delay 2, so first 2 waits count down the delay
  ; Then pages 1-4 fire on subsequent waits; page 4 teleports us to Yuggoth
  (wait)  ; delay countdown
  (wait)  ; delay countdown, page 1 fires
  (wait)  ; page 2
  (wait)  ; page 3
  (wait)  ; page 4 - teleports to @yuggoth
  (assert (loc? @player @yuggoth))

  ; Yuggoth-advance event moves us through the nightmare
  ; Each room's on-enter queues yuggoth-advance with delay 2
  (wait)  ; yuggoth-advance countdown
  (wait)  ; yuggoth-advance fires, to bowl-room
  (assert (loc? @player @bowl-room))
  (wait)  ; yuggoth-advance countdown
  (wait)  ; yuggoth-advance fires, to platform-room
  (assert (loc? @player @platform-room))

  ; Take the smooth-stone - triggers lurker-appears
  (do @smooth-stone :take)
  (assert (held? @smooth-stone))
  (assert (queued? lurker-appears))

  ; Lurker sequence (3 stages) - stage 3 returns us to terminal-room
  (wait)  ; stage 1
  (wait)  ; stage 2
  (wait)  ; stage 3 - wakes in terminal-room
  (assert (loc? @player @terminal-room))
  (assert (held? @smooth-stone))

  ; Hacker-helps event should have been queued by waking
  (assert (queued? hacker-helps))

  ; --- Phase 2: Get Master Key ---
  ; Wait for hacker to finish helping (4 stages)
  (wait)  ; stage 1
  (wait)  ; stage 2
  (wait)  ; stage 3
  (wait)  ; stage 4 - hacker returns to his spot
  (assert (not-queued? hacker-helps))

  ; Navigate to kitchen: terminal-room -> cs-2nd -> kitchen
  (go :direction south)
  (assert (loc? @player @cs-2nd))
  (go :direction west)
  (assert (loc? @player @kitchen))

  ; Get food from refrigerator
  (do @refrigerator :open)
  (do @carton :take)
  (assert (held? @carton))

  ; Heat food in microwave
  (do @microwave :open)
  (do @carton :put @microwave)
  (do @microwave :close)
  (do @microwave :set-timer 300)
  (do @microwave :start)

  ; Wait for food to heat (chinese-food needs heat >= 12)
  (until (>= (prop @chinese-food heat) 12)
    (wait))

  ; Retrieve heated food
  (do @microwave :open)
  (do @carton :take)
  (assert (held? @carton))

  ; Return to terminal room: kitchen -> cs-2nd -> terminal-room
  (go :direction east)
  (assert (loc? @player @cs-2nd))
  (go :direction north)
  (assert (loc? @player @terminal-room))

  ; Trade with hacker for master key
  (do @hacker :ask-about @keys)
  (do @hacker :trade @carton @master-key)
  (do @hacker :give @carton)
  (assert (held? @master-key))

  ; --- Phase 3: Basement Equipment ---
  ; SETUP: Position player for basement sequence (skips stairs navigation)
  ; Real path: cs-2nd -> down -> comp-center -> down -> cs-basement -> east -> temporary-basement

  ; Navigate to basement via stairs: terminal-room -> cs-2nd -> comp-center -> cs-basement
  (go :direction south)
  (assert (loc? @player @cs-2nd))
  (go :direction down)
  (assert (loc? @player @comp-center))
  (go :direction down)
  (assert (loc? @player @cs-basement))

  ; Go to temporary-basement to get gloves and crowbar
  (go :direction east)
  (assert (loc? @player @temporary-basement))
  (do @gloves :take)
  (do @crowbar :take)
  (assert (held? @gloves))
  (assert (held? @crowbar))

  ; Go to temporary-lab to get flask with nitrogen
  (go :direction up)
  (assert (loc? @player @temporary-lab))
  (do @flask :take)
  (assert (held? @flask))

  ; === Forklift/junk puzzle ===
  ; Navigate to aero-basement to get forklift
  (go :direction down)        ; temporary-lab -> temporary-basement
  (go :direction west)        ; temporary-basement -> cs-basement
  (go :direction west)        ; cs-basement -> aero-basement
  (assert (loc? @player @aero-basement))

  ; Enter and operate forklift
  (do @forklift :enter)
  (assert (in? @player @forklift))
  (do @forklift :turn-on)
  (assert (:powered @forklift))

  ; Drive forklift east to dead-storage
  (go :direction east)        ; aero-basement -> cs-basement
  (go :direction east)        ; cs-basement -> temporary-basement
  (go :direction east)        ; temporary-basement -> dead-storage
  (assert (loc? @forklift @dead-storage))

  ; Clear junk with forklift (need 4 uses)
  (do @forklift :use @junk)
  (do @forklift :use @junk)
  (do @forklift :use @junk)
  (do @forklift :use @junk)
  (assert (> (:moved @junk) junk-moves-needed))

  ; Exit forklift and proceed to storage-room
  (do @forklift :exit)
  (assert (loc? @player @dead-storage))
  (go :direction east)
  (assert (loc? @player @storage-room))

  ; Pry open manhole with crowbar
  (do @manhole-cover :pry @crowbar)
  (assert (not (in? @manhole-cover @manhole)))

  ; Go down to brick-tunnel (steam tunnels)
  (go :direction down)
  (assert (loc? @player @brick-tunnel))

  ; --- Phase 3b: Steam Tunnels & Cave Items ---
  ; Navigate to cave-altar to get knife
  (go :direction north)
  (assert (loc? @player @cave-room))
  (go :direction down)
  (assert (loc? @player @cave-altar))
  (do @knife :take)
  (assert (held? @knife))

  ; Back to brick-tunnel
  (go :direction up)
  (assert (loc? @player @cave-room))
  (go :direction south)
  (assert (loc? @player @brick-tunnel))

  ; Navigate back through basement tunnels to infinite corridor
  ; Path: brick-tunnel -> storage-room -> dead-storage -> temp-basement -> cs-basement
  ;       -> aero-basement -> aero-stairs -> aero-lobby -> inf-1
  ; The manhole cover was already removed when we came down
  (go :direction up)       ; brick-tunnel -> storage-room
  (go :direction west)     ; storage-room -> dead-storage
  (go :direction west)     ; dead-storage -> temporary-basement
  (go :direction west)     ; temporary-basement -> cs-basement
  (go :direction west)     ; cs-basement -> aero-basement
  (go :direction west)     ; aero-basement -> aero-stairs
  (go :direction up)       ; aero-stairs -> aero-lobby

  ; --- Phase 4: Infinite Corridor & Axe ---
  ; Going south to inf-1 auto-starts the waxer patrol via on-enter
  (go :direction south)    ; aero-lobby -> inf-1
  (assert (loc? @player @inf-1))

  ; Get plastic container (floor wax) from inf-1
  (do @plastic-container :take)
  (do @plastic-container :open)
  (assert (held? @plastic-container))

  ; Navigate through corridor to inf-4 (emergency cabinet with axe)
  (until (loc? @player @inf-4)
    (do @movement :go east)
    (wait))
  (assert (loc? @player @inf-4))

  ; === Get axe from emergency cabinet ===
  ; Break the glass (requires gloves which player should already have)
  (assert (held? @gloves))
  (do @emergency-cabinet :break)
  (assert (:rmung @emergency-cabinet))

  ; Take the axe
  (do @axe :take)
  (assert (held? @axe))

  ; === Disable floor waxer ===
  ; Cut the power cord - this causes maintenance man to descend and chase
  (do @power-cord :cut)
  (assert (prop? @power-cord severed true))

  ; Pour floor wax to make maintenance man slip and dissolve
  (assert (held? @plastic-container))
  (do @floor-wax :pour)
  (assert (loc? @floor-wax @inf-4))

  ; Wait for maintenance man to dissolve (maint-dissolves event)
  (until (loc? @maintenance-man nil)
    (wait))
  (assert (loc? @maintenance-man nil))

  ; Go east to inf-5
  (go :direction east)       ; inf-4 -> inf-5
  (assert (loc? @player @inf-5))

  ; === Detour: Get note from Great Dome ===
  ; Need note to show professor. Path: inf-5 -> inf-3 -> great-dome -> roof
  (go :direction west)       ; inf-5 -> inf-4
  (go :direction west)       ; inf-4 -> inf-3
  (go :direction up)         ; inf-3 -> great-dome

  ; Wear gloves to safely climb tentacle
  (do @gloves :wear)
  (assert (:wearable @gloves))

  ; Climb tentacle to top of dome (creature flees, drops ladder)
  (go :direction up)         ; great-dome -> top-of-dome via tentacle
  (assert (loc? @player @top-of-dome))
  (assert (:invisible @tentacle))  ; Creature fled
  (assert (in? @dome-ladder @top-of-dome))  ; Ladder available

  ; Go out to roof and up to on-dome
  (do @dome-door :open)
  (go :direction out)        ; top-of-dome -> dome-roof
  (go :direction up)         ; dome-roof -> on-dome
  (assert (loc? @player @on-dome))

  ; Pry bronze plug to reveal secret hole with note
  (do @bronze-plug :pry nil)
  (assert (:rmung @bronze-plug))
  (assert (in? @secret-hole @on-dome))
  (do @note :take)
  (assert (held? @note))

  ; Return: down to dome-roof, in to top-of-dome, down via ladder, down to inf-3
  (go :direction down)       ; on-dome -> dome-roof
  (go :direction in)         ; dome-roof -> top-of-dome
  (go :direction down)       ; top-of-dome -> great-dome via ladder
  (go :direction down)       ; great-dome -> inf-3
  (assert (loc? @player @inf-3))

  ; === Detour: Get boots and hand from Brown Building area ===
  ; Path: inf-3 -> inf-5 -> nutrition-bldg -> brown-tunnel -> brown-basement
  (go :direction east)       ; inf-3 -> inf-4
  (go :direction east)       ; inf-4 -> inf-5
  (go :direction north)      ; inf-5 -> nutrition-bldg
  (go :direction down)       ; nutrition-bldg -> brown-tunnel
  (go :direction se)         ; brown-tunnel -> brown-basement
  (assert (loc? @player @brown-basement))

  ; Get boots
  (do @boots :take)
  (assert (held? @boots))

  ; Go up through Brown Building to roof
  (go :direction up)         ; brown-basement -> brown-building
  (go :direction up)         ; brown-building -> brown-top-floor

  ; Unlock and open roof door with master key
  (do @roof-door :unlock @master-key)
  (assert (no-flag? @roof-door locked))
  (do @roof-door :open)
  (assert (:open @roof-door))

  ; Go to roof and climb to dome
  (go :direction west)       ; brown-top-floor -> brown-roof
  (assert (held? @smooth-stone))  ; Need stone to trigger flier
  (assert (prop? @flier count 0))  ; Flier encounter not started yet
  (go :direction up)         ; brown-roof -> inside-dome (triggers flier if have smooth-stone)
  (assert (loc? @player @inside-dome))
  (assert (queued? flier-approach))  ; Flier event should be queued

  ; Wait for flier to appear on roof (stage 1)
  (wait)
  (assert (prop? @flier count 1))
  (assert (in? @flier @brown-roof))

  ; Search tub to find mummified hand - flier advances to stage 2
  (do @tub :search)
  (assert (:touched @mummified-hand))
  (assert (in? @mummified-hand @tub))

  ; Take hand - flier advances to stage 3
  (do @mummified-hand :take)
  (assert (held? @mummified-hand))

  ; Exit dome before flier enters (stage 5) - we're at stage 3
  ; The flier is on brown-roof blocking our escape route
  (go :direction down)       ; inside-dome -> brown-roof
  (assert (in? @flier @brown-roof))  ; Flier blocking path

  ; Drive off flier with smooth-stone
  (do @flier :attack @smooth-stone)
  (assert (loc? @flier nil))  ; Flier driven away

  ; Return to inf-5 via brown building
  (go :direction east)       ; brown-roof -> brown-top-floor
  (go :direction down)       ; brown-top-floor -> brown-building
  (go :direction down)       ; brown-building -> brown-basement
  (go :direction nw)         ; brown-basement -> brown-tunnel
  (go :direction up)         ; brown-tunnel -> nutrition-bldg
  (go :direction south)      ; nutrition-bldg -> inf-5
  (assert (loc? @player @inf-5))

  ; --- Phase 5: Alchemy Lab ---
  ; Go to chemistry building and knock on alchemy door
  (go :direction south)
  (assert (loc? @player @chemistry-bldg))

  ; Verify alchemy state is correct (default values)
  (assert (not (:dead @professor)))
  (assert (not (:visited @professor)))

  ; Knock and wait for professor to answer
  (do @alchemy-door :knock)
  (until (loc? @player @alchemy-dept)
    (wait))
  (assert (loc? @player @alchemy-dept))

  ; Have note from Great Dome detour
  (assert (held? @note))
  (assert (not (:seen-note @professor)))
  (assert (not (:mad @professor)))

  ; Show note to professor
  (do @professor :give @note)
  (assert (:seen-note @professor))

  ; Enter lab - professor escorts and triggers ritual
  (assert (= (:ritual-stage @professor) 0))
  (go :direction south)
  (assert (loc? @player @alchemy-lab))
  (assert (queued? professor-ritual))

  ; Wait for ritual to progress - professor binds player in pentagram
  ; Stage 1: Player moved to pentagram
  (wait)
  (assert (loc? @player @pentagram))
  (assert (= (:ritual-stage @professor) 1))

  ; Wait until ritual-stage >= 3 (we can cut the pentagram at this point)
  (until (>= (:ritual-stage @professor) 3)
    (wait))
  (assert (>= (:ritual-stage @professor) 3))

  ; At this point the ritual is in progress and we can escape
  ; Verify escape state is correct
  (assert (not (:moved @lab-bench)))
  (assert (no-flag? @pentagram rmung))
  (assert (no-flag? @alchemy-trap-door open))

  ; Cut pentagram with knife to escape
  (do @pentagram :cut @knife)
  (assert (:rmung @pentagram))

  ; Exit pentagram
  (do @pentagram :exit)
  (assert (loc? @player @alchemy-lab))

  ; Move lab bench and escape through trapdoor
  (do @lab-bench :move)
  (do @alchemy-trap-door :open)
  (go :direction down)
  (assert (loc? @player @under-alchemy-lab))

  ; Wait for ritual to complete (stage 8) - professor dies, ring appears
  ; The professor-ritual event handles this automatically when player escapes
  (until (:dead @professor)
    (wait))
  (assert (:dead @professor))
  (assert (= (:ritual-stage @professor) 0))
  (assert (loc? @ring @alchemy-lab))
  (assert (not (queued? professor-ritual)))

  ; The ritual closes the trapdoor, so re-open it to go back up
  (do @alchemy-trap-door :open)
  (assert (:open @alchemy-trap-door))

  ; Go back up to get ring
  (go :direction up)
  (assert (loc? @player @alchemy-lab))
  (do @ring :take)
  (assert (held? @ring))

  ; Hand was obtained from inside-dome during brown building detour
  (assert (held? @mummified-hand))
  (assert (no-flag? @mummified-hand person))  ; Not animated yet
  (assert (= (:animation-count @mummified-hand) 0))
  ; Verify vat and elixir are in their proper locations
  (assert (in? @vat @lab-bench))
  (assert (in? @elixir @vat))

  ; Animate hand by putting in elixir vat
  (do @vat :put @mummified-hand)
  (assert (outcome? success))
  (until (:person @mummified-hand)
    (wait))
  (assert (:person @mummified-hand))

  ; Put ring on animated hand
  (do @mummified-hand :take)
  (do @ring :put-on @mummified-hand)
  (assert (in? @ring @mummified-hand))

  ; --- Phase 6: Urchins ---
  ; Navigate from alchemy-lab to aero-lobby
  ; Path: alchemy-lab -> alchemy-dept -> chemistry-bldg -> inf-5 -> inf-1 -> aero-lobby
  (go :direction north)     ; alchemy-lab -> alchemy-dept
  (go :direction north)     ; alchemy-dept -> chemistry-bldg (door openable from inside)
  (go :direction north)     ; chemistry-bldg -> inf-5
  (go :direction west)      ; inf-5 -> inf-4
  (go :direction west)      ; inf-4 -> inf-3
  (go :direction west)      ; inf-3 -> inf-2
  (go :direction west)      ; inf-2 -> inf-1
  (go :direction north)     ; inf-1 -> aero-lobby
  (assert (loc? @player @aero-lobby))

  ; Verify urchin has bolt-cutters (hidden)
  (assert (in? @urchin @aero-lobby))
  (assert (in? @bolt-cutters @urchin))
  (assert (:invisible @bolt-cutters))

  ; Show animated hand to urchin - he flees and drops bolt cutters
  (do @urchin :show @mummified-hand)
  (assert (not (in? @urchin @aero-lobby)))
  (assert (in? @bolt-cutters @aero-lobby))

  ; Take bolt cutters (INVISIBLE flag was cleared when urchin dropped them)
  (do @bolt-cutters :take)
  (assert (held? @bolt-cutters))

  ; === Navigate through steam tunnels to large-chamber ===
  ; Path: aero-lobby -> aero-stairs -> sub-basement -> tomb
  (go :direction down)      ; aero-lobby -> aero-stairs
  (go :direction down)      ; aero-stairs -> sub-basement
  (go :direction nw)        ; sub-basement -> tomb
  (assert (loc? @player @tomb))

  ; Cut padlock and open hatch to access steam tunnels
  (do @padlock :cut)
  (assert (not (:locked @padlock)))
  (do @access-hatch :open)
  (assert (:open @access-hatch))

  ; Go down to steam tunnel
  (go :direction down)      ; tomb -> tunnel
  (assert (loc? @player @tunnel))

  ; === Rats puzzle ===
  ; Go east to valve, turn on steam to kill rats, wait, then close valve
  (go :direction east)      ; tunnel -> tunnel-east (valve is here)
  (assert (loc? @player @tunnel-east))

  ; Turn on valve to release steam - this starts rats-go-away event
  (do @pressure-valve :turn)
  (assert (:open @pressure-valve))
  (assert (queued? rats-go-away))

  ; Wait for rats to be killed by steam (event fires after ~3 turns)
  (until (loc? @rats nil)
    (wait))
  (assert (loc? @rats nil))

  ; Close valve to clear steam so we can pass west
  (do @pressure-valve :turn)
  (assert (not (:open @pressure-valve)))

  ; Navigate west through now-clear tunnels to large-chamber
  ; Path: tunnel-east -> tunnel -> tunnel-west -> tunnel-entrance -> muddy-tunnel -> large-chamber
  (go :direction west)      ; tunnel-east -> tunnel
  (go :direction west)      ; tunnel -> tunnel-west
  (go :direction west)      ; tunnel-west -> tunnel-entrance
  (go :direction west)      ; tunnel-entrance -> muddy-tunnel
  (go :direction down)      ; muddy-tunnel -> large-chamber
  (assert (loc? @player @large-chamber))

  ; Free the urchins
  (assert (prop? @urchins freed false))

  ; Cut wire to free urchins
  (do @urchin-wire :cut @bolt-cutters)
  (assert (prop? @urchins freed true))

  ; --- Phase 7: Lair Maze & Final Battle ---
  ; Verify required items (all obtained through gameplay)
  (assert (held? @axe))           ; From emergency-cabinet (Phase 4)
  (assert (held? @boots))         ; From brown-basement (brown building detour)
  (do @boots :wear)               ; Wear boots for electrical safety
  (assert (:wearable @boots))
  (assert (:wearable @gloves))  ; Already wearing gloves from great-dome climb
  (assert (in? @nitrogen @flask))  ; Have nitrogen from chem lab
  (assert (prop? @slime-curtain nitrogen-count 0))

  ; Go down to lair-1
  (go :direction down)
  (assert (loc? @player @lair-1))

  ; Navigate through lair maze following hand's guidance
  ; Correct path: lair-1 -> north -> lair-2 -> down -> lair-3 -> south -> lair-4 -> south -> lair-5 -> down -> outer-lair
  (go :direction north)  ; lair-1 -> lair-2
  (go :direction down)   ; lair-2 -> lair-3
  (go :direction south)  ; lair-3 -> lair-4
  (go :direction south)  ; lair-4 -> lair-5
  (go :direction down)   ; lair-5 -> outer-lair
  (assert (loc? @player @outer-lair))

  ; Freeze slime curtain with nitrogen (3 pours)
  (do @slime-curtain :pour @nitrogen)
  (do @slime-curtain :pour @nitrogen)
  (do @slime-curtain :pour @nitrogen)
  (assert (not (in? @slime-curtain @outer-lair)))

  ; Unlock and open the ancient door
  (do @curtain-door :unlock @master-key)
  (do @curtain-door :open)
  (assert (:open @curtain-door))

  ; Enter inner lair through the open door
  (go :direction south)
  (assert (loc? @player @inner-lair))

  ; Search pool to find power line
  ; (hand-dives was queued by on-enter when we came through the door)
  (do @lair-pool :reach-in)
  (assert (in? @high-voltage @inner-lair))

  ; Pull power line out of water
  (do @high-voltage :take)
  (assert (held? @high-voltage))
  (assert (:powered @high-voltage))

  ; Cut power line with axe (3 hits)
  (assert (prop? @high-voltage cut-count 0))
  (do @high-voltage :cut @axe)
  (do @high-voltage :cut @axe)
  (do @high-voltage :cut @axe)
  (assert (:rmung @high-voltage))

  ; Open repeater box and unplug input cable
  (do @repeater :open)
  (do @input-cable :unplug)

  ; Verify endgame state is correct
  (assert (no-flag? @output-cable rmung))  ; Not already cut
  (assert (held? @boots))               ; Boots from brown-basement
  (assert (:wearable @boots))   ; Wearing boots (electrical safety)
  (assert (held? @gloves))              ; Gloves from temporary-basement
  (assert (:wearable @gloves))  ; Wearing gloves (handle conductors)

  ; Plug power line into socket - triggers endgame!
  (do @high-voltage :plug @input-socket)
  (assert (queued? frob-appears))

  ; Frob appears - two stages before we can throw stone
  (wait)  ; stage 1 - frob appears, stone vibrates
  (assert (in? @frob @inner-lair))
  (assert (prop? @frob count 1))
  (wait)  ; stage 2 - stone glowing hot
  (assert (prop? @frob count 2))

  ; Throw smooth-stone at frob for VICTORY!
  (do @frob :attack @smooth-stone)
  (assert (not (in? @frob @inner-lair)))
  (assert (= score 100)))
