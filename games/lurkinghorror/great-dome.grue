; Great Dome - Interior dome climb and tentacle puzzle
; Connected to the Infinite Corridor (stub) and Brown Building.
;
; Rooms:
;   @great-dome - Walkway at dome base with tentacle
;   @top-of-dome - Catwalk at top of dome
;   @dome-roof - Outside on the dome
;   @on-dome - Very top with bronze plug puzzle
;
; Key puzzles:
;   - Climb tentacle wearing gloves
;   - Find ladder dropped by fleeing creature
;   - Bronze plug reveals secret note

; === Stub Rooms ===

(room @inf-3
  :description "Infinite Corridor"
  :ldesc "This is part of the Infinite Corridor. The Great Dome rises above you to the north."
  :properties (:lit true)
  :exits ((up :to @great-dome)))

; === Main Rooms ===

(room @great-dome
  :description "Great Dome"
  :properties (:lit true)
  :exits
    ((down :to @inf-3)
     (up :to @top-of-dome :via @tentacle-climb))
  :visible (@tentacle)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (str "Here a walkway circles the base of a huge ornate dome. Below is the Infinite Corridor."
               (if (not (:touched @dome-ladder))
                 " From stories of Tech Exploring trips, you recall that there is supposed to be a ladder here."
                 "")
               (if (not (:invisible @tentacle))
                 " On the other hand, there is a shiny rope-like thing hanging near where the ladder used to be, and leading upward."
                 ""))))))))

(room @top-of-dome
  :description "Top of Dome"
  :properties (:lit true)
  :exits
    ((out :to @dome-roof :via @dome-door)
     (north :to @dome-roof :via @dome-door)
     (down :to @great-dome :via @tentacle-descend))
  :visible (@tentacle @dome-door @catwalk)

  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (str "Inside the great dome, near the top, a metal catwalk is precariously perched. There is no way further up, but a small metal door is set in the side of the dome."
               (if (:open @dome-door)
                 " Frigid wind and snow blow through the open door."
                 ""))))))

    ; When entering from tentacle, the creature flees and drops the ladder
    :on-enter (fn (?from)
      (cond
        ((and (= ?from @great-dome) (not (:invisible @tentacle)))
          '((set @tentacle :invisible true)
            (set @dome-ladder :touched true)
            (move @dome-ladder ?self)
            (narrate "You stand up on the catwalk, catching your breath for a moment. Your eyes stray along the strand you climbed. It trails along the catwalk, where it joins something large and squishy squatting at the far side. A single, bright-blue eye opens in the squishy mass, and the tentacle (for that's what it is) retracts. The mass almost flows through the spaces in the catwalk railing and drops to the floor fifteen feet below. Before you can react, it's gone.")
            (success)))
        (true (success))))))

(room @dome-roof
  :description "Roof of Great Dome"
  :ldesc "You are perched precariously on the roof of the Great Dome. A set of narrow indentations in the dome provides a dangerous route to the very tip-top of the dome."
  :properties (:lit true :outside true)
  :exits
    ((in :to @top-of-dome :via @dome-door)
     (south :to @top-of-dome :via @dome-door)
     (up :to @on-dome))
  :visible (@dome-door)

  :behaviors (
    :on-enter (fn (?from)
      (cond
        ((= ?from @top-of-dome)
          '((queue freezing)
            (narrate "You enter the freezing, biting cold of the blizzard.")
            (success)))
        (true (success))))))

(room @on-dome
  :description "On the Great Dome"
  :ldesc "This is the very top of the Great Dome, a favorite place for Tech fraternities to install cows, Volkswagen Beetles, giant birthday candles, and other bizarre objects. The top is flat, round, and about five feet in diameter. It's very windy, which has kept the snow from accumulating here. The only way off is down."
  :properties (:lit true :outside true)
  :exits ((down :to @dome-roof))

  :behaviors (
    :on-enter (fn (?from)
      '((narrate "You scramble up the icy surface of the dome, almost slipping a few times, but finally you make it to the top.")
        (success)))))

; === Tentacle Barrier Objects ===

(object @tentacle-climb
  :location @great-dome
  :description "tentacle"
  :properties (:invisible true)
  :behaviors (
    :through (fn ()
      (cond
        ((:invisible @tentacle)
          (blocked :reason no-tentacle :message "There's no way up from here."))
        ((not (:wearable @gloves))
          (blocked :reason burns
                   :message "You start to climb up the strand, but the glistening wet stuff begins to burn your hands. You get a few feet up before the pain is too much. You drop back to the floor."))
        (true
          '((narrate "The wet stuff on the strand sticks to the gloves, but doesn't otherwise affect you. You have a little trouble climbing up to the catwalk, but grab the rail just before your strength gives out. You heave yourself up onto the catwalk.")
            (success)))))))

(object @tentacle-descend
  :location @top-of-dome
  :description "way down"
  :properties (:invisible true)
  :behaviors (
    :through (fn ()
      (cond
        ((in? @dome-ladder @top-of-dome)
          ; Use ladder to climb down
          (success))
        ((not (:invisible @tentacle))
          ; Tentacle is still there
          (cond
            ((:wearable @gloves)
              (success))
            (true
              (blocked :reason burns :message "The tentacle would burn your hands."))))
        (true
          (blocked :reason no-way :message "There's no way down from here."))))))

; === Tentacle Object ===

(object @tentacle
  :location nil  ; Global, present via room :visible
  :description "ropy strand"
  :properties (:nodesc true :invisible false)  ; Not :invisible initially - visible when in @great-dome

  :behaviors (
    :examine (fn ()
      '((focus @tentacle "The strand is wet and glistening. It extends upward into the dome, leading to a narrow catwalk.")
        (success)))

    :take (fn ()
      '((narrate "It's wet, and when you touch it, some of the wetness sticks to your hands, and stings. The strand twitches a little when you touch it.")
        (success)))

    :rub (fn ()
      '((narrate "It's wet, and when you touch it, some of the wetness sticks to your hands, and stings. The strand twitches a little when you touch it.")
        (success)))

    :climb (fn ()
      (redirect :action (do (loc @player) :go up)))))

; === Catwalk ===

(object @catwalk
  :location nil  ; Global
  :description "catwalk"
  :properties (:nodesc true)
  :behaviors (
    :examine (fn ()
      '((focus @catwalk "It's a narrow metal catwalk that circles the interior of the dome near the top.")
        (success)))))

; === Dome Ladder ===

(object @dome-ladder
  :location nil  ; Appears after creature flees
  :description "wooden ladder"
  :properties (:takeable true :size 120 :touched false)

  :behaviors (
    :describe (fn ()
      (cond
        ((not (:touched ?self))
          (success :context ((description "Where the pulpy mass was squatting, a wooden ladder lies on the catwalk."))))
        ((in? ?self @top-of-dome)
          (success :context ((description "A wooden ladder leans against the railing."))))
        (true
          (success :context ((description "A wooden ladder is here."))))))

    :examine (fn ()
      '((focus @dome-ladder "It's a sturdy wooden ladder, about eight feet long.")
        (success)))))

; === Dome Door ===

(object @dome-door
  :location nil  ; Global, present via room :visible
  :description "door"
  :properties (:nodesc true :door true :openable true)
  :behaviors (
    :examine (fn ()
      '((focus @dome-door "It's a small metal door, the same color as the dome.")
        (success)))

    :open (fn ()
      (cond
        ((:open ?self)
          (blocked :reason already-open :message "It's already open."))
        (true
          '((set ?self :open true)
            (narrate "You open the door, and freezing air, blowing snow, and howling wind enter and whip around you.")
            (success)))))

    :close (fn ()
      (cond
        ((not (:open ?self))
          (blocked :reason already-closed :message "It's already closed."))
        (true
          '((set ?self :open false)
            (narrate "You close the door, blocking out the howling wind.")
            (success)))))

    :through (fn ()
      (cond
        ((not (:open ?self))
          (blocked :reason closed :message "The door is closed."))
        (true (success))))))

; === Bronze Plug Puzzle ===

(object @bronze-plug
  :location @on-dome
  :description "bronze plug"
  :fdesc "In the exact center of the flat area is a bronze plug."
  :properties (:takeable true :trytake true :weapon true :rmung false :touched false)
  :behaviors (
    :examine (fn ()
      `((focus @bronze-plug
          ,(str "This is a cylindrical bronze plug about two inches in diameter"
                (if (not (:touched ?self))
                  ". It is set in the center of the flat part of the dome."
                  " and one inch high.")
                ""))
        (success)))

    :take (fn ()
      (cond
        ((not (:rmung ?self))
          (redirect :action (do ?self :pry nil)))
        (true
          (default))))

    :pry (fn (?tool)
      (cond
        ((:rmung ?self)
          (blocked :reason already-removed :message "You've already removed it."))
        (true
          `((set ?self :rmung true)
            (set ?self :touched true)
            (move @secret-hole @on-dome)
            (take ?self)
            (narrate
              ,(str "You pry the plug out of its socket, revealing a cylindrical hole about the same diameter but somewhat deeper. "
                    (if (not (:touched @note))
                      "There is a piece of paper in the hole."
                      (if (in? @note @secret-hole)
                        "There is a piece of paper in the hole."
                        "The hole is empty."))))
            (success)))))

    :put (fn (?container)
      (cond
        ((= ?container @secret-hole)
          '((set ?self :rmung false)
            (move @secret-hole nil)
            (move ?self @on-dome)
            (narrate "You insert the plug in the hole.")
            (success)))
        (true
          (default))))))

(object @secret-hole
  :location nil  ; Appears when plug is removed
  :description "cylindrical hole"
  :properties (:container true :open true :searchable true :capacity 5))

(object @note
  :location @secret-hole
  :description "piece of paper"
  :properties (:takeable true :readable true :rmung false)
  :behaviors (
    :examine (fn ()
      (redirect :action (do ?self :read)))

    :read (fn ()
      `((set ?self :rmung true)
        ,@(if (not (held? ?self)) '((take ?self)) '())
        (narrate "You unroll the piece of paper and read the shaky handwriting:

\"I can no longer face what I've been doing. I can't sleep, I start at the slightest noise, and even dulling my senses with alcohol or drugs is no longer enough. I refuse to participate in what he is doing any more. Either he is insane, or I am insane, or (and this is what I fear most) the universe itself is insane. I have only one final warning: I am the only suicide, but I will not be the final death.\"

The name signed to it is oddly familiar.")
        (success)))))
