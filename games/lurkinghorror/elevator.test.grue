; Elevator System Tests

; === Initial State Tests ===


(test-group "elevator initial state"
  :setup ()

  (test "elevator starts at first floor"
    (do @elevator-door-1 :examine)
    (assert (prop? @cs-elevator-room floor 1)))

  (test "elevator starts stopped"
    (do @elevator-door-1 :examine)
    (assert (prop? @cs-elevator-room stopped true)))

  (test "elevator doors start closed"
    (do @elevator-door-1 :examine)
    (assert (no-flag? @elevator-door-1 open)))
)

(test-group "elevator call buttons"
  :setup ((move @player @cs-2nd))

  (test "push down button calls elevator when elevator not here"
    :setup ((move @player @cs-2nd) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true))
    (do @down-button :push)
    (assert (outcome? success))
    (assert (queued? elevator-moves)))

  (test "push up button when elevator already here opens doors"
    :setup ((move @player @cs-basement) (set @cs-elevator-room :floor 0) (set @cs-elevator-room :stopped true))
    (do @up-button :push)
    (assert (outcome? success))
    (assert (queued? elevator-door-opens)))
)

(test-group "enter elevator"
  :setup ((move @player @comp-center) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true) (set @elevator-door :open true) (set @elevator-door-1 :open true))

  (test "can enter elevator through open doors"
    (go :direction south)
    (assert (loc? @player @cs-elevator-room)))

  (test "cannot enter through closed doors"
    :setup ((move @player @comp-center) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true) (set @elevator-door :open false) (set @elevator-door-1 :open false))
    (go :direction south)
    (assert (outcome? blocked))
    (assert (loc? @player @comp-center)))
)

(test-group "exit elevator"
  :setup ((move @player @cs-elevator-room) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true) (set @elevator-door :open true) (set @elevator-door-1 :open true))

  (test "can exit elevator through open doors"
    (go :direction north)
    (assert (loc? @player @comp-center)))

  (test "cannot exit through closed doors"
    :setup ((move @player @cs-elevator-room) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true) (set @elevator-door :open false))
    (go :direction north)
    (assert (outcome? blocked))
    (assert (loc? @player @cs-elevator-room)))

  (test "cannot exit moving elevator"
    :setup ((move @player @cs-elevator-room) (set @cs-elevator-room :stopped false))
    (go :direction north)
    (assert (outcome? blocked))
    (assert (loc? @player @cs-elevator-room)))
)

(test-group "floor buttons"
  :setup ((move @player @cs-elevator-room) (set @cs-elevator-room :floor 2) (set @cs-elevator-room :stopped true))

  (test "push button 3 starts elevator"
    (do @button-3 :push)
    (assert (outcome? success))
    (assert (queued? elevator-moves)))

  (test "button doesn't light for current floor"
    :setup ((move @player @cs-elevator-room) (set @cs-elevator-room :floor 1))
    (do @button-1 :push)
    (assert (outcome? success)))

  (test "push basement button"
    :setup ((move @player @cs-elevator-room) (set @cs-elevator-room :floor 2))
    (do @basement-button :push)
    (assert (queued? elevator-moves)))
)

(test-group "open and close buttons"
  :setup ((move @player @cs-elevator-room) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true))

  (test "open button opens doors"
    :setup ((set @elevator-door :open false) (set @elevator-door-1 :open false))
    (do @open-button :push)
    (assert (:open @elevator-door))
    (assert (:open @elevator-door-1)))

  (test "close button schedules close"
    :setup ((set @elevator-door :open true) (set @elevator-door-1 :open true))
    (do @close-button :push)
    (assert (queued? elevator-door-closes)))

  (test "open button does nothing when moving"
    :setup ((set @cs-elevator-room :stopped false) (set @elevator-door :open false))
    (do @open-button :push)
    (assert (no-flag? @elevator-door open)))
)

(test-group "door auto-close"
  :setup ((move @player @comp-center) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true) (set @elevator-door :open true) (set @elevator-door-1 :open true) (queue elevator-door-closes 0))

  (test "doors close when event fires"
    (wait)
    (assert (no-flag? @elevator-door open))
    (assert (no-flag? @elevator-door-1 open)))
)

; === End-to-end ride (regression for gnusto-f95a.1 soft-lock) ===
; Before the ZIL-faithful queue contract (gnusto-aab0), a fired one-shot event
; was never dequeued, so elevator-door-opens re-fired every turn, perpetually
; re-arming elevator-door-closes. The doors never shut, so elevator-moves
; (which refuses to move while any door is open) spun forever and the car could
; never leave a floor. These tests ride the whole loop; (until ...) keeps them
; robust against the exact turn counts of the call/scan timing.
; Exercises the DSL lifecycle helpers: (queue-countdown? ...) and (advance N).
(test-group "elevator queue lifecycle"
  :setup ((move @player @cs-2nd) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true))

  (test "calling the elevator queues a one-shot move, which advances then clears"
    (do @down-button :push)
    (assert (queue-countdown? elevator-moves 1))   ; one-shot armed for this turn
    (advance 8)                                     ; ride the scan out to a stop
    (assert (prop? @cs-elevator-room floor 2))      ; arrived at the called floor
    (assert (prop? @cs-elevator-room stopped true))
    (assert (not-queued? elevator-moves))))         ; one-shot chain settled, idle

; Regression for gnusto-f95a.2: waiting on a floor used to be silent while the
; car scanned past. It now narrates the pass (which also explains why a DOWN
; call sends the car UP first).
(test-group "elevator in-transit feedback"
  :setup ((move @player @cs-2nd) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true) (set @cs-elevator-room :direction 1))

  (test "passing the player's floor is narrated, not silent"
    (do @down-button :push)
    (wait)   ; car begins to move
    (wait)   ; car reaches floor 2, passing the player while heading up
    (assert (context? description "The elevator passes your floor, still heading up."))))

(test-group "elevator full ride"
  :setup ((move @player @cs-2nd) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true))

  (test "call, board, ride to the basement, and disembark"
    (do @down-button :push)
    (until (:open @elevator-door-2) (wait))          ; car arrives at floor 2
    (assert (prop? @cs-elevator-room floor 2))
    (go :direction south)                             ; board
    (assert (loc? @player @cs-elevator-room))
    (do @basement-button :push)
    (until (= (:floor @cs-elevator-room) 0) (wait))   ; descend to basement
    (assert (prop? @cs-elevator-room stopped true))
    (assert (not-queued? elevator-moves))             ; car idle, not spinning
    (until (:open @elevator-door-b) (wait))           ; doors open at basement
    (go :direction north)                             ; disembark
    (assert (loc? @player @cs-basement)))
)

(test-group "elevator movement"
  :setup ((move @player @cs-elevator-room) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :stopped true) (set @elevator-door :open false) (set @elevator-door-1 :open false) (set @cs-elevator-room :go-buttons '(false false false true)) (queue elevator-moves 0))

  (test "elevator starts moving on event"
    (wait)
    (assert (prop? @cs-elevator-room stopped false)))

  (test "elevator moves to next floor"
    :setup ((set @cs-elevator-room :stopped false) (set @cs-elevator-room :floor 1) (set @cs-elevator-room :direction 1) (set @cs-elevator-room :go-buttons '(false false false true)) (queue elevator-moves 0))
    (wait)
    (assert (prop? @cs-elevator-room floor 2)))
)
