; === Maintenance Man & Floor Waxer Puzzle ===
; From cs.zil - The Lurking Horror
; The maintenance man and his floor waxer patrol the Infinite Corridor

; ============================================================
; FLOOR WAXER - The vehicle
; ============================================================

(object @floor-waxer
  :location @inf-2
  :description "floor waxer"
  :properties (:vehicle true :surface true :open true :container true :searchable true :going-west false :patrol-started false)  ; going-west: Direction waxer is moving

  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (if (= (loc @maintenance-man) @floor-waxer)
            "A maintenance man is here, riding a floor waxer."
            "A disabled floor waxer looms nearby.")))))

    :examine (fn ()
      `((focus @floor-waxer
          ,(str "It's a large floor waxer, big enough to ride in"
               (if (= (loc @maintenance-man) @floor-waxer)
                 (str ", and in fact there is a maintenance man riding it")
                 "")
               ". It actually looks sort of like a small bulldozer. "
               (if (:severed @power-cord)
                 "Its power cord has been severed."
                 "A thick power cord leads from here to a wall socket somewhere to the west.")))
        (success)))

    :listen (fn ()
      (cond
        ((:severed @power-cord)
          '((narrate "It's silent now.") (success)))
        (true
          `((narrate
              ,(str "It makes a ghastly whirring, whining sound."
                   (if (= (loc @floor-waxer) (loc @player))
                     " This close, it's almost unbearable."
                     "")))
            (success)))))

    :board (fn ()
      (cond
        ((= (loc @maintenance-man) ?self)
          (cond
            ((:severed @power-cord)
              (blocked :reason attacked
                :message "The maintenance man catches you with a surprisingly strong punch as you try to board the waxer. You are sent sprawling."))
            (true
              (blocked :reason occupied
                :message "There's someone in there already."))))
        ((:severed @power-cord)
          (blocked :reason disabled
            :message "The power cord is severed. It's not going anywhere."))
        (true
          (blocked :reason moving
            :message "It's moving too fast to board!"))))))

; ============================================================
; MAINTENANCE MAN - The NPC
; ============================================================

(object @maintenance-man
  :location @floor-waxer
  :description "maintenance man"
  :properties (:person true :slip-seen false :attack-count 0)  ; slip-seen: player saw him slip; attack-count: attack counter

  :behaviors (
    :examine (fn ()
      (cond
        ((:severed @power-cord)
          '((focus @maintenance-man "The maintenance man is very annoyed with you.") (success)))
        (true
          '((focus @maintenance-man "He looks tired, bored, almost zombie-like.") (success)))))

    :ask-about (fn (?topic)
      '((narrate "He doesn't react.") (success)))

    :tell-about (fn (?topic)
      '((narrate "He doesn't react.") (success)))

    :attack (fn ()
      (cond
        ((= (loc @maintenance-man) @floor-waxer)
          (blocked :reason unreachable
            :message "You can't reach him in the floor waxer!"))
        ((not (held? @axe))
          (blocked :reason no-weapon
            :message "You can't hurt him with your hands!"))
        (true
          ; Attacking with axe
          (cond
            ((= (loc @floor-wax) (loc @maintenance-man))
              ; He's slipping - hard to hit
              '((move @axe (loc @maintenance-man))
                (narrate "The axe misses by a mile as the maintenance man slips again!")
                (success)))
            (true
              ; Direct hit - kills him
              '((move @maintenance-man nil)
                (move @axe (loc @player))
                (dequeue maint-attack)
                (narrate "The axe strikes the maintenance man in the side of the neck and his head comes cleanly off. The head bounces once and rolls. As it rolls, it begins to shrink and to change in color. Small hairless bodies flee from the remains of the corpse and scatter into the darkness. You stand there, covered with unspeakable ichor, still clutching the axe. There's nothing much left of the maintenance man but some puddled clothes.")
                (success)))))))))

; ============================================================
; POWER CORD
; ============================================================

(object @power-cord
  :location nil  ; Global - visible from corridor rooms
  :description "power cord"
  :properties (:nodesc true :severed false)  ; Whether the power cord has been cut

  :behaviors (
    :examine (fn ()
      (cond
        ((:severed @power-cord)
          '((focus @power-cord "The thick power cord terminates in a severed stump.") (success)))
        (true
          (let ((?waxer-loc (loc @floor-waxer)))
            `((focus @power-cord
                ,(str "It's a thick black power cord. It runs from a plug on the wall here "
                     (cond
                       ((= ?waxer-loc (loc @player)) "to a large floor waxer.")
                       ((or (= ?waxer-loc @inf-1) (= ?waxer-loc @inf-2)) "away to the east.")
                       (true "away to the west."))))
              (success))))))

    :take (fn ()
      (blocked :reason immovable
        :message "You pull at the power cord, but it won't come loose!"))

    :cut (fn ()
      (cond
        ((:severed @power-cord)
          (blocked :reason already-done
            :message "You've already sliced it once! Trying to make salami?"))
        ((not (held? @axe))
          (blocked :reason no-tool
            :message "You'd need something sharp and heavy to cut that."))
        (true
          '((set @power-cord :severed true)
            (dequeue waxer-moves)
            (queue maint-attack 2)
            (narrate "The axe crashes against the floor, and the power cord severs! The whine of the floor waxer slows, and the maintenance man jerks to alertness.")
            (success)))))))

; ============================================================
; PLASTIC CONTAINER & FLOOR WAX
; ============================================================

(object @plastic-container
  :location @inf-1
  :description "plastic container"
  :properties (:takeable true :container true :readable true :searchable true :openable true)
  :text "\"Frobozz Magic Floor Wax (and Dessert Topping)\""

  :behaviors (
    :examine (fn ()
      `((focus @plastic-container
          ,(str "It's a plain plastic container with something written on it. "
               (if (= (loc @floor-wax) ?self)
                 "Inside is some viscous liquid."
                 "It appears to be empty.")))
        (success)))

    :read (fn ()
      '((narrate "\"Frobozz Magic Floor Wax (and Dessert Topping)\"") (success)))))

(object @floor-wax
  :location @plastic-container
  :description "floor wax"
  :properties (:trytake true :takeable true :touched true)
  :behaviors (
    :describe (fn ()
      ; Only show description when on floor
      (cond
        ((= (loc ?self) (loc @player))
          (success :context
            ((description "The floor here is covered with slippery, messy floor wax."))))
        (true (success))))

    :examine (fn ()
      (cond
        ((= (loc ?self) @plastic-container)
          '((focus @floor-wax "It's a viscous, smelly liquid.") (success)))
        ((= (loc ?self) (loc @player))
          '((focus @floor-wax "The floor is covered from wall to wall with slippery floor wax.") (success)))
        (true
          '((focus @floor-wax "It's a viscous, smelly liquid.") (success)))))

    :pour (fn ()
      (cond
        ((not (or (held? ?self) (held? @plastic-container)))
          (blocked :reason not-held
            :message "You're not carrying it."))
        ((not (= (loc ?self) @plastic-container))
          (blocked :reason empty
            :message "There is no more wax to pour."))
        (true
          (let ((?here (loc @player))
                (?mm-here (= (loc @maintenance-man) ?here)))
            `((move @floor-wax ,?here)
              (narrate
                ,(str "You pour the floor wax all over the floor. It spreads like ants at a picnic."
                      (if (not (:outside ?here))
                        " The floor is now covered from wall to wall with slippery floor wax."
                        "")
                      (if ?mm-here
                        (str " The maintenance man, attempting to get closer to you, enters the "
                             "waxed part of the floor. He begins to slip and slide, barely able "
                             "to maintain his balance, much less advance.")
                        "")))
              (success))))))))

; ============================================================
; EMERGENCY CABINET & AXE
; ============================================================

(object @emergency-cabinet
  :location @inf-4
  :description "emergency cabinet"
  :properties (:container true :transparent true :readable true :searchable true :openable true :rmung false)
  :text "\"In case of emergency, break glass.\""

  :behaviors (
    :describe (fn ()
      (success :context
        ((description
          (str "There is a "
               (if (:rmung ?self) "formerly " "")
               "glass-fronted emergency cabinet here.")))))

    :examine (fn ()
      `((focus @emergency-cabinet
          ,(str "It's one of those little cabinets you see in institutional buildings that "
               "usually contains a fire hose and a fire axe. "
               (if (= (loc @axe) ?self) "This one seems to only have an axe. " "")
               "It "
               (if (:rmung ?self) "had" "has")
               " a transparent window"
               (if (:rmung ?self) " but apparently some vandal smashed it" "")
               ". There is writing on the cabinet."))
        (success)))

    :read (fn ()
      '((narrate "\"In case of emergency, break glass.\"") (success)))

    :open (fn ()
      (cond
        ((not (:rmung ?self))
          (blocked :reason read-sign
            :message "You should read the sign."))
        (true
          '((narrate "It's already open.") (success)))))

    :look-inside (fn ()
      (cond
        ((= (loc @axe) ?self)
          '((narrate "Inside the cabinet you see a fire axe.") (success)))
        (true
          '((narrate "The cabinet is empty.") (success)))))

    :break (fn ()
      (cond
        ((:rmung ?self)
          '((narrate "The cabinet is already smashed.") (success)))
        ((held? @gloves)
          '((set @emergency-cabinet :open true)
            (set @emergency-cabinet :rmung true)
            (narrate "Wearing the heavy gloves, you confidently smash the glass with a blow of your hands!")
            (success)))
        (true
          (blocked :reason bare-hands
            :message "You hit at the glass with your hands, but you can't hit hard enough to break it: you might cut yourself on the glass."))))

    :attack (fn ()
      ; Same as break
      (do ?self :break))))

(object @axe
  :location @emergency-cabinet
  :description "fire axe"
  :properties (:trytake true :takeable true :weapon true)
  :behaviors (
    :take (fn ()
      (cond
        ((and (= (loc ?self) @emergency-cabinet)
              (not (:rmung @emergency-cabinet)))
          (blocked :reason enclosed
            :message "The glass is in the way."))
        ((held? ?self)
          (blocked :reason already-have
            :message "You already have it."))
        (true
          '((move @axe @player)
            (success)))))))

; ============================================================
; WAXER EXIT BARRIER
; ============================================================
; This barrier is used for exits that the floor waxer can block

(object @waxer-exit-barrier
  :location nil
  :description "passage"
  :properties (:invisible true)
  :behaviors (
    :through (fn (?dest ?from)
      (cond
        ; Waxer is here with maintenance man riding
        ((and (= (loc @floor-waxer) ?from)
              (= (loc @maintenance-man) @floor-waxer))
          (cond
            ; Cord severed - maintenance man descends
            ((:severed @power-cord)
              (cond
                ; Floor wax present - can pass
                ((= (loc @floor-wax) (loc @maintenance-man))
                  (success))
                ; No wax - he blocks
                (true
                  '((queue maint-descend)
                    (narrate "The maintenance man, growling foul-sounding imprecations, descends from the floor waxer and blocks your way.")
                    (success)))))
            ; Cord not severed - waxer blocks
            (true
              (blocked :reason waxer-blocking
                :message "In a deft maneuver, the maintenance man steers the floor waxer into your path, blocking your advance."))))

        ; Cord severed, maintenance man loose and chasing
        ((and (:severed @power-cord)
              (= (loc @maintenance-man) ?from)
              (:person @maintenance-man)
              (not (= (loc @floor-wax) ?from)))
          (blocked :reason mm-blocking
            :message "The maintenance man lurches toward you, grasping and panting. There is no way to go around him."))

        ; No obstacle
        (true (success))))))

; ============================================================
; EVENTS
; ============================================================

; Helper to determine waxer next location
(defn waxer-next-loc (?loc ?going-west)
  (cond
    (?going-west
      (cond
        ((= ?loc @inf-5) @inf-4)
        ((= ?loc @inf-4) @inf-3)
        ((= ?loc @inf-3) @inf-2)
        ((= ?loc @inf-2) @inf-1)
        (true @inf-1)))
    (true
      (cond
        ((= ?loc @inf-1) @inf-2)
        ((= ?loc @inf-2) @inf-3)
        ((= ?loc @inf-3) @inf-4)
        ((= ?loc @inf-4) @inf-5)
        (true @inf-5)))))

; Floor waxer movement - patrols the corridor every 5 turns
(event waxer-moves
  :on-turn
    (let ((?loc (loc @floor-waxer)))
      ; Compute new direction - changes at corridor ends
      (let ((?new-west (cond
                         ((and (:going-west @floor-waxer) (= ?loc @inf-1)) false)
                         ((and (not (:going-west @floor-waxer)) (= ?loc @inf-5)) true)
                         (true (:going-west @floor-waxer)))))
        ; Compute next location using new direction
        (let ((?next-loc (waxer-next-loc ?loc ?new-west)))
          ; Generate message
          (let ((?msg
                  (cond
                    ((= (loc @player) ?next-loc)
                      (str "The floor waxer, approaching from the "
                           (if ?new-west "east" "west")
                           ", is now here."))
                    ((= (loc @player) ?loc)
                      (str "The floor waxer waxes away to the "
                           (if ?new-west "west" "east")
                           "."))
                    (true nil))))
            `((set @floor-waxer :going-west ,?new-west)
              (move @floor-waxer ,?next-loc)
              (queue waxer-moves 5)
              (success :context ,(if ?msg `((description ,?msg)) nil))))))))

; Maintenance man attack - chases player after cord is cut
(event maint-attack
  :on-turn
    (let ((?mm-loc (loc @maintenance-man))
          (?player-loc (loc @player)))
      (cond
        ; If in waxer, descend first
        ((= ?mm-loc @floor-waxer)
          (let ((?waxer-loc (loc @floor-waxer)))
            `((move @maintenance-man ,?waxer-loc)
              (queue maint-attack)
              (success :context ((description
                ,(str "The maintenance man, growling foul-sounding imprecations, descends from the floor waxer"
                      (if (= (loc @floor-wax) ?waxer-loc)
                        ". But almost immediately, he slips on the floor wax."
                        " and heads towards you."))))))))

        ; If standing in floor wax, start dissolving
        ((= (loc @floor-wax) ?mm-loc)
          `((queue maint-dissolves 4)
            (dequeue maint-attack)
            (success :context ((description
              ,(if (:slip-seen @maintenance-man)
                 "The maintenance man continues slipping, falling, standing, and so on. He reminds you of a badly made windup toy."
                 "The maintenance man slips on the floor wax!"))))))

        ; If in same room as player with wax, slip
        ((and (= ?mm-loc ?player-loc) (= (loc @floor-wax) ?player-loc))
          '((set @maintenance-man :slip-seen true)
            (queue maint-dissolves 4)
            (dequeue maint-attack)
            (success :context ((description "But he slips on the floor wax! He begins to flail about, barely able to stand.")))))

        ; If in same room, attack
        ((= ?mm-loc ?player-loc)
          (let ((?new-count (+ (:attack-count @maintenance-man) 1)))
            (if (>= ?new-count 3)
              `((set @maintenance-man :attack-count ,?new-count)
                (blocked :reason death
                  :context ((death true)
                            (description "The maintenance man grabs you by the throat and lifts you off the ground with one hand. The hand feels very cold. Just as you expire, you realize you have never seen him blink."))))
              `((set @maintenance-man :attack-count ,?new-count)
                (queue maint-attack)
                (success :context ((description "The maintenance man stares with maniacal intensity at your throat.")))))))

        ; Chase player - move closer
        (true
          (let ((?next-loc
                  (cond
                    ; Move through corridor towards player
                    ((= ?mm-loc @inf-5) @inf-4)
                    ((= ?mm-loc @inf-4) @inf-3)
                    ((= ?mm-loc @inf-3) @inf-2)
                    ((= ?mm-loc @inf-2) @inf-1)
                    (true ?mm-loc))))
            `((move @maintenance-man ,?next-loc)
              (queue maint-attack)
              (success :context ((description "The maintenance man lurches toward you with surprising speed.")))))))))

; Maintenance man dissolves after slipping on wax
(event maint-dissolves
  :on-turn
    (let ((?player-loc (loc @player))
          (?in-corridor (or (= ?player-loc @inf-1) (= ?player-loc @inf-2) (= ?player-loc @inf-3)
                            (= ?player-loc @inf-4) (= ?player-loc @inf-5))))
      `((move @maintenance-man nil)
        (dequeue maint-dissolves)
        (dequeue maint-attack)
        (success :context
          ,(if ?in-corridor
             '((description "The maintenance man appears to shorten and almost dissolve. There is a great commotion, as though he is undergoing a convulsion of some sort, and then he appears to explode into a crowd of small squealing creatures. These, seeing you, scuttle off in the opposite direction and disappear."))
             nil)))))
