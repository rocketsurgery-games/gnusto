; === Tests for Global Objects ===

; Test: Global objects are visible from any location
(test "globals are visible from terminal-room"
  :setup ((move! @player @terminal-room))
  :action (do @me :examine)
  :expect ((outcome? success)))

(test "globals are visible from cs-basement"
  :setup ((move! @player @cs-basement))
  :action (do @hands :examine)
  :expect ((outcome? success)))

; Test: Player body parts
(test "examine yourself"
  :action (do @me :examine)
  :expect ((outcome? success)
           (context? message "You look tired but determined.")))

(test "examine hands"
  :action (do @hands :examine)
  :expect ((outcome? success)
           (context? message "They're still attached to your wrists.")))

(test "examine feet"
  :action (do @feet :examine)
  :expect ((outcome? success)
           (context? message "They're at the ends of your legs, as usual.")))

(test "examine head"
  :action (do @head :examine)
  :expect ((outcome? success)
           (context? message "It's on your shoulders.")))

(test "open eyes"
  :action (do @eyes :open)
  :expect ((outcome? success)
           (context? message "They are.")))

(test "close eyes"
  :action (do @eyes :close)
  :expect ((outcome? success)
           (context? message "That won't help.")))

(test "listen to yourself"
  :action (do @me :listen)
  :expect ((outcome? success)
           (context? message "Yes?")))

(test "wake yourself"
  :action (do @me :wake)
  :expect ((outcome? success)
           (context? message "You already are.")))

(test "follow yourself"
  :action (do @me :follow)
  :expect ((outcome? success)
           (context? message "You're getting ahead of yourself.")))

; Test: Environmental globals
(test "examine wall"
  :action (do @wall :examine)
  :expect ((outcome? success)
           (context? message "It looks like a wall.")))

(test "push wall"
  :action (do @wall :push)
  :expect ((outcome? blocked)
           (reason? solid)))

(test "examine north wall"
  :action (do @north-wall :examine)
  :expect ((outcome? success)
           (context? message "It looks like a wall.")))

(test "examine ground"
  :action (do @ground :examine)
  :expect ((outcome? success)
           (context? message "It's still there.")))

(test "look under ground"
  :action (do @ground :look-under)
  :expect ((outcome? success)
           (context? message "You never did master X-rays. Freshman physics was such a drag.")))

(test "climb ground"
  :action (do @ground :climb)
  :expect ((outcome? blocked)
           (reason? waste)))

(test "ceiling look under"
  :action (do @ceiling :look-under)
  :expect ((outcome? success)
           (context? message "You look around the room.")))

; These global pseudo-objects use the default examine behavior.
; They don't have custom :examine handlers - falls through to builtins.grue default.

(test "examine air"
  :action (do @air :examine)
  :expect ((outcome? success)
           (context? message "You see nothing special about the air.")))

(test "examine dirt"
  :action (do @dirt :examine)
  :expect ((outcome? success)
           (context? message "You see nothing special about the dirt.")))

(test "examine noise"
  :action (do @noise :examine)
  :expect ((outcome? success)
           (context? message "You see nothing special about the noise.")))

; Test: Light controls
(test "turn on light when already lit"
  :setup ((set! lit true))
  :action (do @light :turn-on)
  :expect ((outcome? success)
           (context? message "It's already light.")))

(test "turn off light"
  :action (do @light :turn-off)
  :expect ((outcome? blocked)
           (reason? waste)))

; Test: Snow behavior (depends on room OUTSIDE flag)
(test "examine snow outside"
  :setup ((move! @player @courtyard))  ; @courtyard has OUTSIDE flag
  :action (do @snow :examine)
  :expect ((outcome? success)
           (context? message "It's still coming down.")))

(test "examine snow inside"
  :setup ((move! @player @terminal-room)
          (clear-flag! @terminal-room OUTSIDE))
  :action (do @snow :examine)
  :expect ((outcome? success)
           (context? message "You are inside.")))

; Test: Sleep
(test "find sleep"
  :action (do @global-sleep :find)
  :expect ((outcome? success)
           (context? message "Sleep anywhere.")))

; Test: Room/location reference
(test "examine room"
  :action (do @global-room :examine)
  :expect ((outcome? success)
           (context? message "You look around the room.")))

; Test: Hole
(test "reach in hole"
  :action (do @global-hole :reach-in)
  :expect ((outcome? success)
           (context? message "You find nothing of interest.")))

; Test: Corridor/passage
(test "walk to corridor"
  :action (do @corridor :walk-to)
  :expect ((outcome? success)
           (context? message "Walking around reveals nothing new. To move elsewhere, just type the desired direction.")))
