{
  "mcpServers": {
    "devtools": {
      "type": "http",
      "url": "https://subtext.fullstory.com/mcp/devtools",
      "headers": {
        "Authorization": "Bearer ${SUBTEXT_API_KEY}"
      }
    },
    "devtools-tunnel": {
      "command": "node",
      "args": [
        ".claude/skills/tunnel/client/build/src/index.js",
        "--api-key",
        "$SUBTEXT_API_KEY"
      ]
    }
  }
}
