  ;             CR>)>)>)
  ;       (<VERB? CLOSE LOWER> <COND
  ;         (<FSET? ,PRSO ,OPENBIT> <PUT-GLOBAL ,HERE 0 0> <PUT-GLOBAL ,HERE 1 0> <FCLEAR ,TUNNEL ,ONBIT> <FCLEAR ,TUNNEL-EAST ,ONBIT> <FCLEAR ,TUNNEL-WEST ,ONBIT> <FCLEAR ,ACCESS-HATCH ,OPENBIT> <TELL "The hatch closes"> <IN-DARK?>)>)
