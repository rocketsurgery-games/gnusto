  ;           (<HERE? ,CS-BASEMENT> <TELL "unhook">)
  ;           (<FSET? ,CHAIN-2 ,LOCKED> <TELL "unlock">)
  ;           (ELSE <TELL "unwrap">)> <TELL " it first." CR>)
  ;         (<AND
  ;           ,CHAIN-LOOPED?
  ;           <OR <PRSI? ,ROD> <HELD? ,CHAIN> <NOT <ACCESSIBLE? ,CHAIN>>>> <PERFORM ,V?UNTIE ,CHAIN-2 ,ROD> <RTRUE>)
