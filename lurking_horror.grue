;               <SET
;                 ACNT
;                 <- .ACNT 1>>> <RETURN>)>>)> <COND
;         (<AND
;           <NOT <ZERO? ,P-GWIMBIT>>
;           <NOT
;             <FSET? .OBJ ,P-GWIMBIT>>> <RFALSE>)>)>
