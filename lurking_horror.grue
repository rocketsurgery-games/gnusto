; --- HEAT-CONTENTS ---
; <ROUTINE HEAT-CONTENTS (WHAT TIM "AUX" H)
;   <MAP-CONTENTS
;       (M .WHAT)
;       <COND
;         (<GETPT .M ,P?HEAT> <QUEUE I-COOL 2 T> <SET
;           H
;           <+
;             <GETP .M ,P?HEAT>
;             ,MICROWAVE-TEMP>> <COND
;           (<L? .TIM 0> <SET
;             H
;             <+
;               .H
;               </
;                 .TIM
;                 </ 60 ,MICROWAVE-TEMP>>>>)> <PUTP .M ,P?HEAT .H> <COND
;           (<AND
;             <EQUAL? .M ,HAND>
;             <FSET? .M ,PERSON>> <SETG ANIMATION-COUNT 0> <FCLEAR .M ,PERSON> <COND
;             (<HERE? ,KITCHEN> <TELL
;               CR
;               "The hand scrabbles frantically around inside "
;               THE
;               <LOC ,HAND>
;               ", and
;   then at last lies still."
;               CR>)>)
;           (<AND
;             <EQUAL? .M ,CHINESE-FOOD>
;             <G? .H 20>> <FSET .M ,RMUNGBIT>)>)
;         (ELSE <HEAT-CONTENTS .M .TIM>)>>
; >

