  ;         (<VERB? ATTACK THROUGH> <COND
  ;           (<PRSI? <> ,HANDS> <TELL S "You approach the " "mass and grab onto it."> <JIGS-UP ,TOUCHING-MASS T>)
  ;           (<PRSI? ,HIGH-VOLTAGE> <COND
  ;             (<FSET? ,HIGH-VOLTAGE ,RMUNGBIT> <TELL "Deftly avoiding the exposed wire, the">)
  ;             (ELSE <TELL "The">)> <TELL
  ;             " tentacles grab you and pull you
  ;   into the rippling slime."> <JIGS-UP ,TOUCHING-MASS T>)
  ;           (<FSET? ,PRSI ,WEAPONBIT> <REMOVE ,PRSI> <TELL
