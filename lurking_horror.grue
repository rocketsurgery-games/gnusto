  ;             (<AND <HELD? ,CHAIN> <NOT ,CHAIN-LOOPED?>> <MOVE ,CHAIN ,HERE> <TELL
  ;               "You stretch out towards the hook, find that the whole chain is just too
  ;   much weight, and put most of it on the floor. Much easier! ">)> <MOVE ,CHAIN-1 <LOC ,HOOK>> <SETG CHAIN-HOOKED? ,HOOK> <COND
  ;             (,CHAIN-LOOPED? <REMOVE ,CHAIN>)
  ;             (ELSE <MOVE ,CHAIN ,HERE>)> <TELL
  ;             "You hook the chain to the hook, where it looks quite secure."
  ;             CR>)
  ;           (ELSE <TELL "One end of the chain is all that will fit." CR>)>)
