  :flags (NDESCBIT AN CONTBIT SEARCHBIT OPENABLE)
  :properties
    (
      (capacity 20)
    )

  ; --- ZIL Source ---
  ; <ROUTINE ACCESS-PANEL-F ()
  ;   <COND
  ;       (<VERB? EXAMINE> <COND
  ;         (<NOT
  ;           <FSET? ,ACCESS-PANEL ,OPENBIT>> <TELL
  ;           "This panel presumably opens to access the inner maintenance controls
  ;   of the elevator."
  ;           CR>)
  ;         (ELSE <TELL
