  ;           (<HERE? ,STEAM-TUNNEL-EAST> <TELL "west." CR>)
  ;           (ELSE <TELL "east." CR>)>)
  ;         (ELSE <TELL "east and west along the ceiling." CR>)>)
  ;       (<VERB? CLIMB-FOO CLIMB-ON BOARD> <COND
  ;         (<HERE? ,CS-BASEMENT> <TELL-YUKS>)
  ;         (,ON-CABLE? <TELL ,YOU-ARE ,PERIOD>)
  ;         (ELSE <SETG ON-CABLE? T> <QUEUE I-CABLE-FALL 2> <TELL
  ;           "You leap, grab the damp and moldy bundle of cable, and hang suspended
  ;   off the floor."> <COND
  ;           (,RATS-HERE <TELL " " ,YOU-ARE-NOW "somewhat out of reach of the rats.">)> <CRLF>)>)>
  ; >
