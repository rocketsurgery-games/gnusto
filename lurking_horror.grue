;       <COND
;         (<EQUAL? .C .E> <RFALSE>)
;         (<EQUAL?
;           <GET .C ,C-RTN>
;           .RTN> <COND
;           (<ZERO?
;             <GET .C ,C-TICK>> <RFALSE>)
;           (T <RETURN .C>)>)>
;       <SET
;         C
;         <REST .C ,C-INTLEN>>>
; >

