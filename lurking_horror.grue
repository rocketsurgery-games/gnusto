  ;   <COND
  ;       (<AND
  ;         <IN? ,RATS ,HERE>
  ;         <NOT ,ON-CABLE?>> <SETG
  ;         RATS-HERE
  ;         <+ ,RATS-HERE 1>> <TELL
  ;         "You plunge into the mass of rats, but there are too many of them, and
  ;   you can't force your way past."
  ;         CR> <RFALSE>)
  ;       (<HERE? ,TUNNEL-WEST> ,TUNNEL-ENTRANCE)
  ;       (<HERE? ,TUNNEL> ,TUNNEL-WEST)
