;         (,ZDEBUG <TELL "[Perform: "> % <COND
;           (<GASSIGNED? ZILCH> ' <TELL N .A>)
;           (T ' <PRINT
;             <SPNAME
;               <NTH
;                 ,ACTIONS
;                 <+
;                   <* .A 2>
;                   1>>>>)> <COND
