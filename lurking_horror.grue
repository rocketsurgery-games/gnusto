;         (<EQUAL? ,FLIER-COUNT 2> <TELL CR ,SHAPE-TWITCHES CR>)
;         (<EQUAL? ,FLIER-COUNT 3> <REMOVE ,FLIER-SHAPE> <TELL CR "The shape drops out of view." CR>)
;         (<EQUAL? ,FLIER-COUNT 4> <TELL
