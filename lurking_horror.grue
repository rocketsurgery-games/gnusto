;       (<PRSO? ,INTNUM> <COND
;         (<G? ,P-NUMBER 100> <TELL "Too long!" CR>)
;         (T <SET NUM ,P-NUMBER>)>)>
;   <TELL "Time passes..." CR>
;   <REPEAT
;       ()
;       <COND
;         (<L?
;           <SET
;             NUM
;             <- .NUM 1>>
;           0> <RETURN>)
;         (<CLOCKER> <RETURN>)>>
;   <SETG CLOCK-WAIT T>
; >

