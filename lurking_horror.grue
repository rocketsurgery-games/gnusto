;   <COND
;       (<NOT
;         <DESCRIBE-CONTENTS
;           .OBJ
;           <>
;           <+ ,D-ALL? ,D-PARA?>>> <TELL "The " D .OBJ " is empty.">)>
;   <RTRUE>
; >

