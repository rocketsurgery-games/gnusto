;   <TELL "With ">
;   <A-PRSI?>
; >

; --- WORD-PRINT ---
; <ROUTINE WORD-PRINT (CNT BUF)
;   <REPEAT
;       ()
;       <COND
;         (<DLESS? CNT 0> <RETURN>)
;         (ELSE <PRINTC
;           <GETB ,P-INBUF .BUF>> <SET
;           BUF
;           <+ .BUF 1>>)>>
; >

; --- WT? ---
; <ROUTINE WT? (PTR BIT "AUX" OFFS TYP "OPT" B1)
;   <COND
;       (<BTST
;         <SET
;           TYP
;           <GETB .PTR ,P-PSOFF>>
;         .BIT> <COND
;         (<G? .B1 4> <RTRUE>)
;         (<EQUAL? .BIT ,PS?OBJECT> 1)
;         (T <SET
;           TYP
;           <BAND .TYP ,P-P1BITS>> <COND
;           (<NOT
;             <EQUAL? .TYP .B1>> <SET
;             OFFS
;             <+ .OFFS 1>>)> <GETB .PTR .OFFS>)>)
;       (<EQUAL? .BIT ,PS?ADJECTIVE> <COND
;         (<EQUAL? .PTR ,W?UP ,W?U> <WT? ,W?UP-ARROW ,PS?ADJECTIVE .B1>)
;         (<EQUAL? .PTR ,W?DOWN ,W?D> <WT? ,W?DOWN-ARROW ,PS?ADJECTIVE .B1>)
;         (ELSE <RFALSE>)>)>
; >

; --- YES? ---
; <ROUTINE YES? ()
;   <PRINTI "?|
;   (Y is affirmative): >">
;   <READ ,P-INBUF ,P-LEXV>
;   <COND
;       (<EQUAL?
;         <GET ,P-LEXV 1>
;         ,W?YES
;         ,W?Y> <RTRUE>)
;       (T <RFALSE>)>
; >

; --- YOU-ARE-IN ---
; <ROUTINE YOU-ARE-IN (AV)
;   <TELL
;       ,YOU-ARE
;       <COND (<FSET? .AV ,SURFACEBIT> " on ") (ELSE " in ")>
;       THE
;       .AV
;       "!"
;       CR>
; >

; --- YOU-CANT-X-PRSO ---
; <ROUTINE YOU-CANT-X-PRSO (STR)
;   <TELL ,YOU-CANT .STR " ">
;   <COND (,PRSO <TELL THE ,PRSO>) (ELSE <TELL "that">)>
;   <TELL ,PERIOD>
; >

; --- YOU-CANT-X-THAT ---
; <ROUTINE YOU-CANT-X-THAT (STR)
;   <TELL ,YOU-CANT .STR " that!" CR>
; >

; --- YOU-SEE-NO ---
; <ROUTINE YOU-SEE-NO (OBJ)
;   <TELL "You see no " D .OBJ "." CR>
; >

; --- ZMEMQ ---
; <ROUTINE ZMEMQ (ITM TBL "AUX" CNT "OPT" SIZE)
;   <COND (<NOT .TBL> <RFALSE>)>
;   <COND
;       (<NOT
;         <L? .SIZE 0>> <SET CNT 0>)
;       (ELSE <SET
;         SIZE
;         <GET .TBL 0>>)>
;   <REPEAT
;       ()
;       <COND
;         (<EQUAL?
;           .ITM
;           <GET .TBL .CNT>> <RETURN
;           <REST
;             .TBL
;             <* .CNT 2>>>)
;         (<IGRTR? CNT .SIZE> <RFALSE>)>>
; >

; --- ZMEMQB ---
; <ROUTINE ZMEMQB (ITM TBL SIZE "AUX" CNT)
;   <REPEAT
;       ()
;       <COND
;         (<EQUAL?
;           .ITM
;           <GETB .TBL .CNT>> <RTRUE>)
;         (<IGRTR? CNT .SIZE> <RFALSE>)>>
; >

; === SYNTAX REFERENCE ===
; Verb patterns defining valid command structures.

; VERBOSE (no args) -> V-VERBOSE
; BRIEF (no args) -> V-BRIEF
; SUPER (no args) -> V-SUPER-BRIEF
; DIAGNOSE (no args) -> V-DIAGNOSE
; I (no args) -> V-INVENTORY
; QUIT (no args) -> V-QUIT
; RESTAR (no args) -> V-RESTART
; RESTOR (no args) -> V-RESTORE
; SAVE (no args) -> V-SAVE
; SCORE (no args) -> V-SCORE
; SCRIPT (no args) -> V-SCRIPT
; UNSCRIPT (no args) -> V-UNSCRIPT
; VERSION (no args) -> V-VERSION
; $VERIFY (no args) -> V-$VERIFY
; $VERIFY OBJECT -> V-$VERIFY
; ANSWER (no args) -> V-ANSWER
; ANSWER OBJECT -> V-REPLY
; APPLY OBJECT TO OBJECT [HELD, MANY, HAVE] -> V-PUT PRE=PRE-PUT
; ASK FOR OBJECT -> V-ASK-FOR PRE=PRE-ASK-FOR
; ASK OBJECT FOR OBJECT [FIND, PERSON] -> V-ASK-FOR PRE=PRE-ASK-FOR
; ASK ABOUT OBJECT -> V-ASK-ABOUT PRE=PRE-ASK-ABOUT
; ASK OBJECT ABOUT OBJECT [FIND, PERSON] -> V-ASK-ABOUT PRE=PRE-ASK-ABOUT
; ATTACK OBJECT [FIND, PERSON, ON-GROUND, IN-ROOM] -> V-ATTACK
; ATTACK OBJECT WITH OBJECT [FIND, PERSON, ON-GROUND, IN-ROOM, FIND, WEAPONBIT, HELD, CARRIED, HAVE] -> V-ATTACK
; BITE OBJECT -> V-BITE
; BLOW OUT OBJECT -> V-LAMP-OFF
; BOARD OBJECT [FIND, VEHBIT, ON-GROUND, IN-ROOM] -> V-BOARD PRE=PRE-BOARD
; BURN OBJECT WITH OBJECT [HELD, CARRIED, ON-GROUND, IN-ROOM, HELD, CARRIED, ON-GROUND, IN-ROOM, HAVE] -> V-BURN
; BURN DOWN OBJECT WITH OBJECT [HELD, CARRIED, ON-GROUND, IN-ROOM, HELD, CARRIED, ON-GROUND, IN-ROOM, HAVE] -> V-BURN
; CLIMB OBJECT [ON-GROUND, IN-ROOM] -> V-CLIMB-FOO
; CLIMB ON OBJECT [FIND, VEHBIT, ON-GROUND, IN-ROOM] -> V-CLIMB-ON
; CLIMB UP OBJECT [FIND, RLANDBIT, ON-GROUND, IN-ROOM] -> V-CLIMB-UP
; CLIMB DOWN OBJECT [FIND, RLANDBIT, ON-GROUND, IN-ROOM] -> V-CLIMB-DOWN
; CLIMB OVER OBJECT [ON-GROUND, IN-ROOM] -> V-CLIMB-OVER
; CLIMB IN OBJECT [FIND, VEHBIT, ON-GROUND, IN-ROOM] -> V-BOARD PRE=PRE-BOARD
; CLIMB OFF OBJECT [FIND, RLANDBIT, ON-GROUND, IN-ROOM] -> V-DISEMBARK
; CLIMB OUT OBJECT [FIND, RLANDBIT, ON-GROUND, IN-ROOM] -> V-DISEMBARK
; COVER OBJECT WITH OBJECT [ON-GROUND, IN-ROOM] -> V-SPUT-ON PRE=PRE-SPUT-ON
; DESCEN OBJECT [ON-GROUND, IN-ROOM] -> V-CLIMB-DOWN
; LIE DOWN OBJECT [FIND, RLANDBIT] -> V-SLEEP
; LIE ON OBJECT [FIND, VEHBIT] -> V-BOARD
; CLOSE OBJECT [FIND, CONTBIT, HELD, CARRIED, ON-GROUND, IN-ROOM] -> V-CLOSE
; CLOSE OBJECT WITH OBJECT [FIND, CONTBIT, HELD, CARRIED, ON-GROUND, IN-ROOM, FIND, WEAPONBIT] -> V-CLOSE
; COMPARE OBJECT [MANY] -> V-COMPARE-MANY
; COMPARE OBJECT TO OBJECT -> V-COMPARE
; COMPARE OBJECT WITH OBJECT -> V-COMPARE
; COUNT OBJECT -> V-WASTE-OF-TIME
; COUNT OBJECT IN OBJECT -> V-WASTE-OF-TIME
; CROSS OBJECT -> V-CROSS
; CUT OBJECT WITH OBJECT [FIND, WEAPONBIT, CARRIED, HELD, HAVE] -> V-CUT
; CUT THROUGH OBJECT WITH OBJECT [FIND, WEAPONBIT, CARRIED, HELD, HAVE] -> V-CUT
; SHIT (no args) -> V-CURSE
; CRACK OBJECT [ON-GROUND, IN-ROOM] -> V-MUNG
; CRACK OBJECT WITH OBJECT [ON-GROUND, IN-ROOM, HELD, CARRIED, HELD, CARRIED, TAKE, HAVE] -> V-MUNG
; CRACK DOWN OBJECT WITH OBJECT [ON-GROUND, IN-ROOM, HELD, CARRIED, HELD, CARRIED, TAKE, HAVE] -> V-MUNG
; DIG IN OBJECT -> V-WASTE-OF-TIME
; DIG WITH OBJECT -> V-WASTE-OF-TIME
; DIG THROUGH OBJECT -> V-WASTE-OF-TIME
; DIG OBJECT WITH OBJECT [ON-GROUND, IN-ROOM, FIND, TOOLBIT, HELD, CARRIED, HAVE] -> V-WASTE-OF-TIME
; DIG IN OBJECT WITH OBJECT [ON-GROUND, IN-ROOM, FIND, TOOLBIT, HELD, CARRIED, HAVE] -> V-WASTE-OF-TIME
; DISEMBARK (no args) -> V-DISEMBARK
; DISEMBARK OBJECT [ON-GROUND, IN-ROOM] -> V-DISEMBARK
; DRINK OBJECT [HELD, CARRIED, ON-GROUND, IN-ROOM] -> V-DRINK
; DRINK FROM OBJECT [HELD, CARRIED] -> V-DRINK-FROM
; DROP OBJECT [HELD, MANY, HAVE] -> V-DROP PRE=PRE-DROP
; DROP OBJECT DOWN OBJECT [HELD, MANY, HAVE] -> V-PUT PRE=PRE-PUT
; DROP OBJECT IN OBJECT [HELD, MANY, HAVE] -> V-PUT PRE=PRE-PUT
; DROP OBJECT ON OBJECT [HELD, MANY, HAVE] -> V-PUT PRE=PRE-PUT
; DROP FROM OBJECT -> V-DROP PRE=PRE-DROP
; RELEASE OBJECT -> V-RELEASE
; EAT OBJECT [HELD, CARRIED, ON-GROUND, IN-ROOM, MANY] -> V-EAT
; TASTE OBJECT [HELD, CARRIED, ON-GROUND, IN-ROOM, MANY] -> V-TASTE
; ENTER (no args) -> V-ENTER
; ENTER OBJECT -> V-THROUGH
; EXIT (no args) -> V-EXIT
; EXIT OBJECT -> V-EXIT
