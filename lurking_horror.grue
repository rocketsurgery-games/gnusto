  :description "Steam Tunnel"
  :exits
    (
      (west :to TUNNEL-WEST :per RATS-EXIT)
      (south :to ELEVATOR-PIT :per ELEVATOR-PIT-ENTER)
    )

  ; --- PER Exit Routines ---
