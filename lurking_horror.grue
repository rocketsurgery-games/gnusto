;         .WRD> <PUT .OCL .PTR 0> <PUT .OCL ,P-MATCHLEN .PTR>)>
; >

; --- CLAUSE-COPY ---
; <ROUTINE CLAUSE-COPY (SRC DEST "AUX" IBEG IEND OCL BEG END BB EE OBEG CNT B E)
;   <SET
;       BB
;       <GET ,P-CCTBL ,CC-BEG>>
;   <SET
;       EE
;       <GET ,P-CCTBL ,CC-END>>
;   <SET
;       OCL
;       <GET ,P-CCTBL ,CC-CLAUSE>>
;   <SET
;       IBEG
;       <GET ,P-CCTBL ,CC-IBEG>>
;   <SET
;       IEND
;       <GET ,P-CCTBL ,CC-IEND>>
;   <SET
;       BEG
;       <GET .SRC .BB>>
;   <SET
;       END
;       <GET .SRC .EE>>
;   <SET
;       OBEG
;       <GET .OCL ,P-MATCHLEN>>
;   <REPEAT
;       ()
;       <COND
