; [NEEDS-TRANSLATION] Room STEAM-TUNNEL: ACTION STEAM-TUNNEL-F, PER exits
(room STEAM-TUNNEL
  :description "Steam Tunnel"
  :ldesc "The steam tunnel is narrow here, and its construction is more archaic.
It's now mostly brick, although the floor is concrete. The steam pipe
and coaxial cable continue along their appointed paths. The tunnel is
damp and even a little muddy."
  :exits
    (
      (west :to TUNNEL-WEST :per RATS-EXIT)
      (east :to STEAM-TUNNEL-EAST)
    )

  ; --- PER Exit Routines ---
  ; <ROUTINE RATS-EXIT ("AUX" H)
  ;   <COND
  ;       (<AND
  ;         <IN? ,RATS ,HERE>
  ;         <NOT ,ON-CABLE?>> <SETG
  ;         RATS-HERE
  ;         <+ ,RATS-HERE 1>> <TELL
  ;         "You plunge into the mass of rats, but there are too many of them, and
  ;   you can't force your way past."
  ;         CR> <RFALSE>)
  ;       (<HERE? ,TUNNEL-WEST> ,TUNNEL-ENTRANCE)
  ;       (<HERE? ,TUNNEL> ,TUNNEL-WEST)
  ;       (<HERE? ,TUNNEL-EAST> <STEAM-EXIT>)
  ;       (<HERE? ,STEAM-TUNNEL> ,TUNNEL-EAST)
  ;       (<HERE? ,STEAM-TUNNEL-EAST> ,STEAM-TUNNEL)>
  ; >
  ;
  ; --- End PER Exit Routines ---

  ; --- Room ACTION Routine ---
  ; <ROUTINE STEAM-TUNNEL-F (RARG)
  ;   <COND (<RARG? BEG> <FOOD-FOR-RATS>)>
  ; >
  ; --- End Room ACTION Routine ---
)

; [NEEDS-TRANSLATION] Room STEAM-TUNNEL-EAST: ACTION STEAM-TUNNEL-EAST-F, PER exits
(room STEAM-TUNNEL-EAST
  :description "Steam Tunnel"
  :exits
    (
      (west :to TUNNEL-WEST :per RATS-EXIT)
      (south :to ELEVATOR-PIT :per ELEVATOR-PIT-ENTER)
    )

  ; --- PER Exit Routines ---
