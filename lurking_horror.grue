;       (<EQUAL? .L ,INF-4> ,INF-5)
;       (<EQUAL? .L ,INF-5> <COND
;         (<EQUAL? ,P-WALK-DIR ,P?NORTH> ,NUTRITION-BLDG)
;         (ELSE ,CHEMISTRY-BLDG)>)>
; >

