)

; [NEEDS-TRANSLATION] Room SUB-BASEMENT: PER exits
(room SUB-BASEMENT
  :description "Subbasement"
  :ldesc "This is the subbasement of the Aeronautical Engineering Building. A
stairway leads up. A narrow
crack in the northwest corner of the room opens into a larger
space."
  :flags (ONBIT)
  :exits
    (
      (up :to AERO-STAIRS)
      (nw :to TOMB :per TOMB-SQUEEZE)
    )

  ; --- PER Exit Routines ---
