; --- ORPHAN ---
; <ROUTINE ORPHAN (D1 D2 "AUX" CNT)
;   <COND
;       (<NOT ,P-MERGED> <PUT ,P-OCL1 ,P-MATCHLEN 0> <PUT ,P-OCL2 ,P-MATCHLEN 0>)>
;   <PUT
;       ,P-OVTBL
;       0
;       <GET ,P-VTBL 0>>
;   <PUTB
;       ,P-OVTBL
;       2
;       <GETB ,P-VTBL 2>>
;   <PUTB
;       ,P-OVTBL
;       3
;       <GETB ,P-VTBL 3>>
;   <REPEAT
;       ()
;       <COND
;         (<IGRTR? CNT ,P-ITBLLEN> <RETURN>)
;         (T <PUT
;           ,P-OTBL
;           .CNT
