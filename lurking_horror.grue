;       (ELSE <PUT ,P-CCTBL ,CC-CLAUSE ,P-OCL2>)>
;   <CLAUSE-COPY ,P-OTBL ,P-OTBL>
;   <AND
;       <NOT
;         <EQUAL?
;           <GET ,P-OTBL ,P-NC2>
;           0>>
;       <SETG P-NCN 2>>
;   <SETG P-ACLAUSE <>>
;   <RTRUE>
; >

