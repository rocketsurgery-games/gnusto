;               <+ .CNT 1>>
;             .OCNT> <RETURN>)
;           (T <COND
;             (<EQUAL?
;               <GET ,P-PRSO .CNT>
;               .OBJ> <PUT ,P-PRSO .CNT .VAR> <SET TMP T> <RETURN>)>)>> .TMP)>
; >

