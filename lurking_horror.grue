; --- CLAUSE ---
; <ROUTINE CLAUSE (PTR VAL WRD "AUX" OFF NUM ANDFLG 1ST? NW LW)
;   <SET
;       OFF
;       <*
;         <- ,P-NCN 1>
;         2>>
;   <COND
;       (<NOT
;         <EQUAL? .VAL 0>> <PUT
;         ,P-ITBL
;         <SET
;           NUM
;           <+ ,P-PREP1 .OFF>>
;         .VAL> <PUT
;         ,P-ITBL
;         <+ .NUM 1>
;         .WRD> <SET
;         PTR
;         <+ .PTR ,P-LEXELEN>>)
;       (T <SETG
;         P-LEN
;         <+ ,P-LEN 1>>)>
;   <COND
;       (<ZERO? ,P-LEN> <SETG
;         P-NCN
;         <- ,P-NCN 1>> <RETURN -1>)>
;   <PUT
;       ,P-ITBL
;       <SET
;         NUM
;         <+ ,P-NC1 .OFF>>
;       <REST
;         ,P-LEXV
;         <* .PTR 2>>>
;   <COND
;       (<EQUAL?
;         <GET ,P-LEXV .PTR>
;         ,W?THE
;         ,W?A
;         ,W?AN> <PUT
;         ,P-ITBL
;         .NUM
;         <REST
;           <GET ,P-ITBL .NUM>
;           4>>)>
;   <REPEAT
;       ()
;       <COND
;         (<L?
;           <SETG
;             P-LEN
;             <- ,P-LEN 1>>
;           0> <PUT
;           ,P-ITBL
;           <+ .NUM 1>
;           <REST
;             ,P-LEXV
;             <* .PTR 2>>> <RETURN -1>)>
;       <COND
;         (<SET WRD <KNOWN-WORD? .PTR>> <COND
;           (<ZERO? ,P-LEN> <SET NW 0>)
;           (T <SET
;             NW
;             <GET
;               ,P-LEXV
;               <+ .PTR ,P-LEXELEN>>>)> <COND
;           (<AND
;             <EQUAL? .WRD ,W?QUOTE>
;             <NOT
;               <EQUAL? ,P-ACT ,ACT?TELL ,ACT?SAY>>> <COND (ELSE <RFALSE>)>)
;           (<EQUAL? .WRD ,W?AND ,W?COMMA> <SET ANDFLG .WRD>)
;           (<EQUAL? .WRD ,W?ALL ,W?ONE ,W?BOTH> <COND
;             (<EQUAL? .NW ,W?OF> <SETG
;               P-LEN
;               <- ,P-LEN 1>> <SET
;               PTR
;               <+ .PTR ,P-LEXELEN>>)>)
;           (<OR
;             <EQUAL? .WRD ,W?THEN ,W?PERIOD>
;             <AND
;               <NOT <ZERO?
;                 <WT? .WRD ,PS?PREPOSITION>>>
;               <GET ,P-ITBL ,P-VERB>
;               <NOT .1ST?>>> <SETG
;             P-LEN
;             <+ ,P-LEN 1>> <PUT
;             ,P-ITBL
;             <+ .NUM 1>
;             <REST
;               ,P-LEXV
;               <* .PTR 2>>> <RETURN
;             <- .PTR ,P-LEXELEN>>)
;           (<AND
;             <EQUAL? .ANDFLG ,W?COMMA>
;             <EQUAL?
;               <GET ,P-ITBL ,P-VERB>
;               0>> <SET
;             PTR
;             <- .PTR 4>> <CHANGE-LEXV
;             <+ .PTR 2>
;             ,W?THEN> <SETG
;             P-LEN
;             <+ ,P-LEN 2>>)
;           (<NOT <ZERO?
;             <WT? .WRD ,PS?OBJECT>>> <COND
;             (<AND
;               <G? ,P-LEN 0>
;               <EQUAL? .NW ,W?OF>
;               <NOT
;                 <EQUAL? .WRD ,W?ALL ,W?ONE>>> T)
;             (<AND
;               <NOT
;                 <ZERO?
;                   <WT? .WRD ,PS?ADJECTIVE ,P1?ADJECTIVE>>>
;               <NOT
;                 <EQUAL? .NW 0>>
;               <OR
;                 <WT? .NW ,PS?OBJECT>
;                 <WT? .NW ,PS?ADJECTIVE>>>)
;             (<AND
;               <NOT .ANDFLG>
;               <NOT
;                 <EQUAL? .NW ,W?BUT ,W?EXCEPT>>
;               <NOT
;                 <EQUAL? .NW ,W?AND ,W?COMMA>>> <PUT
;               ,P-ITBL
;               <+ .NUM 1>
;               <REST
;                 ,P-LEXV
;                 <*
;                   <+ .PTR 2>
;                   2>>> <RETURN .PTR>)
;             (T <SET ANDFLG <>>)>)
;           (<OR
;             <NOT <ZERO?
;               <WT? .WRD ,PS?ADJECTIVE>>>
;             <NOT <ZERO?
;               <WT? .WRD ,PS?BUZZ-WORD>>>>)
;           (<NOT <ZERO?
;             <WT? .WRD ,PS?PREPOSITION>>> T)
;           (T <CANT-USE .PTR> <RFALSE>)>)
;         (T <UNKNOWN-WORD .PTR> <RFALSE>)>
;       <SET LW .WRD>
;       <SET 1ST? <>>
;       <SET
;         PTR
;         <+ .PTR ,P-LEXELEN>>>
; >

; --- CLAUSE-ADD ---
