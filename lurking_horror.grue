;         (<EQUAL? .OBJ ,SMOOTH-STONE> <SCORE-OBJECT ,FLIER> <MOVE ,FLIER ,GLOBAL-OBJECTS> <TELL "follows it, screaming frustration into the storm." CR>)
;         (ELSE <TELL "watches it fall with cunning attention." CR>)>)
;       (ELSE <TELL "." CR>)>
; >

