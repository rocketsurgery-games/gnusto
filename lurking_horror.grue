  ;         (<FSET? ,ACCESS-HATCH ,LOCKED> <TELL ,IT-ALREADY-IS>)
  ;         (ELSE <SETG PADLOCK-ON? ,ACCESS-HATCH> <FSET ,PADLOCK ,NDESCBIT> <FCLEAR ,PADLOCK ,OPENBIT> <FSET ,PADLOCK ,LOCKED> <MOVE ,PADLOCK ,ACCESS-HATCH> <FSET ,ACCESS-HATCH ,LOCKED> <FCLEAR ,ACCESS-HATCH ,OPENBIT> <TELL "Locked up safe and secure!" CR>)>)
  ;       (<VERB? LOOK-INSIDE> <COND
