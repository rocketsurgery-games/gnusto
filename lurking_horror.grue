;         .L
;         ,TUNNEL-WEST
;         ,TUNNEL
;         ,TUNNEL-EAST
;         ,STEAM-TUNNEL
;         ,STEAM-TUNNEL-EAST> <RTRUE>)
;       (<AND
;         <EQUAL? .L ,ELEVATOR-PIT>
;         ,BRICK-WALL-FLAG> <RTRUE>)>
; >

; --- INBUF-ADD ---
; <ROUTINE INBUF-ADD (LEN BEG SLOT "AUX" DBEG CTR TMP)
;   <COND
;       (<SET
;         TMP
;         <GET ,OOPS-TABLE ,O-END>> <SET DBEG .TMP>)
;       (T <SET
;         DBEG
;         <+
;           <GETB
;             ,AGAIN-LEXV
;             <SET
;               TMP
;               <GET ,OOPS-TABLE ,O-LENGTH>>>
;           <GETB
;             ,AGAIN-LEXV
;             <+ .TMP 1>>>>)>
;   <PUT
;       ,OOPS-TABLE
;       ,O-END
;       <+ .DBEG .LEN>>
;   <REPEAT
;       ()
;       <PUTB
;         ,OOPS-INBUF
;         <+ .DBEG .CTR>
;         <GETB
;           ,P-INBUF
;           <+ .BEG .CTR>>>
;       <SET
;         CTR
;         <+ .CTR 1>>
;       <COND (<EQUAL? .CTR .LEN> <RETURN>)>>
;   <PUTB ,AGAIN-LEXV .SLOT .DBEG>
;   <PUTB
;       ,AGAIN-LEXV
;       <- .SLOT 1>
;       .LEN>
; >

; --- INBUF-STUFF ---
; <ROUTINE INBUF-STUFF (SRC DEST "AUX" CNT)
;   <SET
;       CNT
;       <-
;         <GETB .SRC 0>
;         1>>
;   <REPEAT
;       ()
;       <PUTB
;         .DEST
;         .CNT
;         <GETB .SRC .CNT>>
;       <COND (<DLESS? CNT 0> <RETURN>)>>
; >

; --- INF-EAST-EXIT ---
