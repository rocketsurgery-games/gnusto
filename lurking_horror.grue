  ;           (ELSE <TELL
  ;             "The forklift is ineffective in manipulating "
  ;             THE
  ;             ,PRSO
  ;             ,PERIOD>)>)
  ;         (<SET O <NOT-REACHABLE?>> <CANT-REACH-FROM-VEHICLE .O>)>)
  ;       (<RARG? <>> <COND
  ;         (<VERB? EXAMINE> <TELL "This is a rusty "> <COND (<FSET? ,FORKLIFT ,POWERBIT> <TELL "and wheezing ">)> <TELL
  ;           "old forklift. It looks like you could
  ;   control it fairly easily, though."
  ;           CR>)
  ;         (<VERB? LAMP-ON LAMP-OFF STOP> <TELL ,YOU-HAVE-TO "get in it first." CR>)
  ;         (<P? (MOVE PRY) JUNK FORKLIFT> <TELL
