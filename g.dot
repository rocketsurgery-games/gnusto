digraph puzzle {
  rankdir=BT;
  node [shape=box];

  // Victory condition
  victory [label="VICTORY" shape=doubleoctagon style=filled fillcolor=green];

  // Puzzle-relevant state
  cell_door_locked [label="@cell-door:locked"];
  cell_door_open [label="@cell-door:open"];
  key_location [label="@key:location"];
  player_dead [label="@player:dead"];
  player_location [label="@player:location"];

  // Dependencies (what must change for victory)
  player_location -> victory;

  // Behavior dependencies (what behaviors read/modify)
  cell_door_locked -> cell_door_open [label="open"];
  cell_door_locked -> player_location [label="go"];
  cell_door_open -> player_location [label="go"];
  key_location -> cell_door_locked [label="unlock"];
  key_location -> cell_door_locked [label="lock"];

  // Winning path
  subgraph cluster_path {
    label="Winning Path";
    style=dashed;
    step0 [label="1. take @key" shape=ellipse];
    step1 [label="2. unlock @cell-door" shape=ellipse];
    step2 [label="3. open @cell-door" shape=ellipse];
    step3 [label="4. go @cell" shape=ellipse];
    step0 -> step1;
    step1 -> step2;
    step2 -> step3;
    step3 -> victory [style=bold];
  }
}