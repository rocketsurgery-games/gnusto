; GRUE Built-in Functions and Default Behaviors
;
; This file provides:
; 1. Convenience predicates built on primitives (held?, here?, in?, etc.)
; 2. Default behaviors for common verbs (take, drop, open, close, etc.)
;
; Bindings available in behaviors:
;   ?self   - the target object
;   ?actor  - who is performing the action (usually PLAYER)

; ============================================================
; CONVENIENCE PREDICATES
; ============================================================
; These predicates are built on top of the primitive functions
; (player), (loc), and (=). They provide a cleaner API for
; common IF queries.

; (held? OBJ) - is OBJ in the player's inventory?
(defn held? (?obj)
  (= (loc ?obj) (player)))

; (here? ARG) - polymorphic location check:
;   If ARG is a room: is the player in that room?
;   If ARG is an object: is the object in the same room as the player?
; This matches ZIL's HERE? which can take either rooms or objects.
(defn here? (?arg)
  (if (room? ?arg)
    (= (loc (player)) ?arg)
    (= (loc ?arg) (loc (player)))))

; (in? OBJ CONTAINER) - is OBJ directly inside CONTAINER?
(defn in? (?obj ?container)
  (= (loc ?obj) ?container))

; (held-by? OBJ HOLDER) - is OBJ held by HOLDER?
(defn held-by? (?obj ?holder)
  (= (loc ?obj) ?holder))

; (at? OBJ OTHER) - is OBJ at the same location as OTHER?
(defn at? (?obj ?other)
  (= (loc ?obj) (loc ?other)))

; (loc? OBJ EXPECTED) - is OBJ at EXPECTED location?
(defn loc? (?obj ?expected)
  (= (loc ?obj) ?expected))

; ============================================================
; SEQUENCE SUGAR
; ============================================================
; Convenience functions for working with collections.

; (first COLL) - get first element, or nil if empty
(defn first (?coll)
  (if (empty? ?coll)
    nil
    (nth ?coll 0)))

; (empty? COLL) - is collection nil or empty?
(defn empty? (?coll)
  (or (nil? ?coll) (= (count ?coll) 0)))

; (inventory) - get player's inventory (excludes invisible items)
(defn inventory ()
  (filter (fn (?x) (not (:invisible ?x))) (contents (player))))

; ============================================================
; LIGHT & DARKNESS
; ============================================================
; The engine's perception layer consults (lit? ROOM) to decide whether the
; player can see (see GrueRuntime.is_room_lit). Darkness is OPT-IN: a room's
; own :lit defaults to true, so only a room declared :lit false can go dark,
; and it becomes lit again if an accessible light source is on.

; (light-source? OBJ) - is OBJ a light source that is currently on?
; Uses defaulted keyword lookups so probing an object that declares neither
; property is safe (returns false rather than raising).
(defn light-source? (?o)
  (and (:lightable ?o false) (:lit ?o false)))

; (accessible-in CONTAINER) - CONTAINER's direct contents, plus (recursively)
; the contents of any OPEN container among them. Lets light (and other
; "reachable" queries) see through an open sack/basket without requiring the
; item to be loose in the room.
(defn accessible-in (?container)
  (reduce
    (fn (?acc ?x)
      (concat (concat ?acc (list ?x))
              (if (:open ?x false) (accessible-in ?x) (list))))
    (list)
    (contents ?container)))

; (accessible ROOM) - objects the player could draw light from: everything in
; the room and everything the player carries, seen through open containers
; (e.g. a lit torch inside an open basket lights the room it sits in).
(defn accessible (?room)
  (concat (accessible-in ?room) (accessible-in (player))))

; (lit? ROOM) - is ROOM lit? Either inherently lit (its :lit, default true) or
; an accessible light source is on.
(defn lit? (?room)
  (or (:lit ?room true)
      (some (fn (?o) (light-source? ?o)) (accessible ?room))))

; ============================================================
; DEFAULT BEHAVIORS
; ============================================================
; These behaviors apply when an object doesn't define its own
; behavior for a verb. They implement standard IF mechanics.

; === take ===
; Default take behavior - requires TAKEBIT flag, object must be accessible

(default take (cond
  ((not (:takeable ?self))
    (blocked :reason not-takeable :message "That's not something you can take."))

  ((held-by? ?self ?actor)
    (blocked :reason already-held :message "You're already carrying that."))

  ((not (visible? ?self))
    (blocked :reason not-here :message "You don't see that here."))

  (true
    '((move ?self ?actor) (narrate "Taken.") (success)))))

; === drop ===
; Default drop behavior - must be holding the object

(default drop (cond
  ((not (held-by? ?self ?actor))
    (blocked :reason not-held :message "You're not carrying that."))

  (true
    '((move ?self (loc ?actor)) (narrate "Dropped.") (success)))))

; === open ===
; Default open behavior for OPENABLE objects

(default open (cond
  ((not (:openable ?self))
    (blocked :reason not-openable :message "That's not something you can open."))

  ((:open ?self)
    (blocked :reason already-open :message "It's already open."))

  (true
    '((set ?self :open true) (narrate "Opened.") (success)))))

; === close ===
; Default close behavior for OPENABLE objects

(default close (cond
  ((not (:openable ?self))
    (blocked :reason not-closeable :message "That's not something you can close."))

  ((not (:open ?self))
    (blocked :reason already-closed :message "It's already closed."))

  (true
    '((set ?self :open false) (narrate "Closed.") (success)))))

; === put ===
; Default put behavior - put an item into a container. Bidirectional: the
; natural-language "put X in Y" is ambiguous about which entity is the target,
; and the LLM can't reliably guess, so we accept BOTH forms (gnusto-1ce1):
;   (do @item :put @container)   - item-first  (?self=item,      ?value=container)
;   (do @container :put @item)   - container-first (?self=container, ?value=item)
; The item-first reading is tried first; if it doesn't apply, the reversed
; reading is used. This also matches the container-first shape of custom :put
; behaviors (e.g. @vat).
(default put (cond
  ; Item-first: ?self is a held item, ?value is a container.
  ((and (held-by? ?self ?actor) (:container ?value))
    (cond
      ((and (:openable ?value) (not (:open ?value)))
        (blocked :reason closed :message "It's closed."))
      (true
        '((move ?self ?value) (narrate "Done.") (success)))))

  ; Container-first: ?self is a container, ?value is a held item.
  ((and (:container ?self) (held-by? ?value ?actor))
    (cond
      ((and (:openable ?self) (not (:open ?self)))
        (blocked :reason closed :message "It's closed."))
      (true
        '((move ?value ?self) (narrate "Done.") (success)))))

  ; Neither reading works - diagnose the most likely intent (item-first).
  ((not (held-by? ?self ?actor))
    (blocked :reason not-held :message "You're not carrying that."))

  ((not (:container ?value))
    (blocked :reason not-container :message "That's not a container."))

  (true
    (blocked :reason cannot-put :message "You can't put that there."))))

; === throw ===
; Default throw behavior. "throw X at Y" naturally parses to (do @X :throw @Y)
; (item-first), but games model throwing-at-a-target as attacking the target
; WITH the item, e.g. (do @frob :attack @stone). Redirect so the natural,
; item-first phrasing works without the LLM having to guess the direction
; (gnusto-7f83; sibling of the bidirectional put, gnusto-1ce1).
; Syntax: (do @item :throw @target)  ->  (do @target :attack @item)

(default throw (cond
  ((not (held-by? ?self ?actor))
    (blocked :reason not-held :message "You're not holding that."))

  ; Thrown AT a target -> attack that target with this item.
  (?value
    (redirect :action (do ?value :attack ?self)))

  ; Bare throw -> it simply lands in the room.
  (true
    '((move ?self (loc ?actor))
      (narrate "You throw it. It clatters to the ground nearby.")
      (success)))))

; === eat ===
; Default eat behavior for FOOD objects (ZIL V-EAT). Consumes the item.
; Games may define their own :eat for special handling (flavor text, effects).

(default eat (cond
  ((not (:food ?self false))
    (blocked :reason not-edible
             :message (str "I don't think that the " (desc ?self) " would agree with you.")))

  ((not (visible? ?self))
    (blocked :reason not-here :message "You don't see that here."))

  (true
    '((move ?self nil)
      (narrate "Thank you very much. It really hit the spot.")
      (success)))))

; === drink ===
; Default drink behavior for DRINKABLE objects (ZIL V-DRINK). Consumes the item.

(default drink (cond
  ((not (:drinkable ?self false))
    (blocked :reason not-drinkable
             :message (str "I don't think that the " (desc ?self) " would agree with you.")))

  ((not (visible? ?self))
    (blocked :reason not-here :message "You don't see that here."))

  (true
    '((move ?self nil)
      (narrate "Thank you very much. I was rather thirsty.")
      (success)))))

; === examine ===
; Default examine behavior - returns generic message when object has no :examine handler

(default examine
  `((narrate ,(str "You see nothing special about the " (desc ?self) ".")) (success)))
