; GRUE Built-in Functions and Default Behaviors
;
; This file provides:
; 1. Convenience predicates built on primitives (held?, here?, in?, etc.)
; 2. Default behaviors for common verbs (take, drop, open, close, etc.)
;
; Bindings available in behaviors:
;   ?self   - the target object
;   ?actor  - who is performing the action (usually PLAYER)

; ============================================================
; CONVENIENCE PREDICATES
; ============================================================
; These predicates are built on top of the primitive functions
; (player), (loc), and (=). They provide a cleaner API for
; common IF queries.

; (held? OBJ) - is OBJ in the player's inventory?
(defn held? (?obj)
  (= (loc ?obj) (player)))

; (here? OBJ) - is OBJ in the same room as the player?
(defn here? (?obj)
  (= (loc ?obj) (loc (player))))

; (in? OBJ CONTAINER) - is OBJ directly inside CONTAINER?
(defn in? (?obj ?container)
  (= (loc ?obj) ?container))

; (held-by? OBJ HOLDER) - is OBJ held by HOLDER?
(defn held-by? (?obj ?holder)
  (= (loc ?obj) ?holder))

; (at? OBJ OTHER) - is OBJ at the same location as OTHER?
(defn at? (?obj ?other)
  (= (loc ?obj) (loc ?other)))

; (loc? OBJ EXPECTED) - is OBJ at EXPECTED location?
(defn loc? (?obj ?expected)
  (= (loc ?obj) ?expected))

; ============================================================
; SEQUENCE SUGAR
; ============================================================
; Convenience functions for working with collections.

; (first COLL) - get first element, or nil if empty
(defn first (?coll)
  (if (empty? ?coll)
    nil
    (nth ?coll 0)))

; (empty? COLL) - is collection nil or empty?
(defn empty? (?coll)
  (or (nil? ?coll) (= (count ?coll) 0)))

; ============================================================
; DEFAULT BEHAVIORS
; ============================================================
; These behaviors apply when an object doesn't define its own
; behavior for a verb. They implement standard IF mechanics.

; === take ===
; Default take behavior - requires TAKEBIT flag, object must be accessible

(default take (cond
  ((not (:takeable ?self))
    (blocked :reason not-takeable :message "That's not something you can take."))

  ((held-by? ?self ?actor)
    (blocked :reason already-held :message "You're already carrying that."))

  ((not (visible? ?self))
    (blocked :reason not-here :message "You don't see that here."))

  (true
    '((move ?self ?actor) (success :message "Taken.")))))

; === drop ===
; Default drop behavior - must be holding the object

(default drop (cond
  ((not (held-by? ?self ?actor))
    (blocked :reason not-held :message "You're not carrying that."))

  (true
    '((move ?self (loc ?actor)) (success :message "Dropped.")))))

; === open ===
; Default open behavior for OPENABLE objects

(default open (cond
  ((not (:openable ?self))
    (blocked :reason not-openable :message "That's not something you can open."))

  ((:open ?self)
    (blocked :reason already-open :message "It's already open."))

  (true
    '((set ?self :open true) (success :message "Opened.")))))

; === close ===
; Default close behavior for OPENABLE objects

(default close (cond
  ((not (:openable ?self))
    (blocked :reason not-closeable :message "That's not something you can close."))

  ((not (:open ?self))
    (blocked :reason already-closed :message "It's already closed."))

  (true
    '((set ?self :open false) (success :message "Closed.")))))

; === put ===
; Default put behavior - put ?self into ?value (the container)
; Syntax: (do @item :put @container)

(default put (cond
  ((not (held-by? ?self ?actor))
    (blocked :reason not-held :message "You're not carrying that."))

  ((not (:container ?value))
    (blocked :reason not-container :message "That's not a container."))

  ; Container must be open (has OPENBIT) or not be openable at all
  ((and (:openable ?value) (not (:open ?value)))
    (blocked :reason closed :message "It's closed."))

  (true
    '((move ?self ?value) (success :message "Done.")))))

; === examine ===
; Default examine behavior - returns generic message when object has no :examine handler

(default examine
  (success :message (str "You see nothing special about the " (desc ?self) ".")))
